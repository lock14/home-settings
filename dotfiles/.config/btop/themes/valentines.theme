# Valentine's Day TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#280716"

# Main text color
theme[main_fg]="#ffe8f2"

# Title color for boxes
theme[title]="#fff5f9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff1744"

# Background color of selected item in processes box
theme[selected_bg]="#420d25"

# Foreground color of selected item in processes box
theme[selected_fg]="#fff5f9"

# Color of inactive/disabled text
theme[inactive_fg]="#a65e7e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c27898"

# Background color of the percentage meters
theme[meter_bg]="#420d25"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ff4081"

# Cpu box outline color
theme[cpu_box]="#a65e7e"

# Memory/disks box outline color
theme[mem_box]="#a65e7e"

# Net up/down box outline color
theme[net_box]="#a65e7e"

# Processes box outline color
theme[proc_box]="#a65e7e"

# Box divider line and small boxes line color
theme[div_line]="#a65e7e"

# Temperature graph colors
theme[temp_start]="#ff4081"
theme[temp_mid]="#ff1744"
theme[temp_end]="#ff0033"

# CPU graph colors
theme[cpu_start]="#ff4081"
theme[cpu_mid]="#ffe082"
theme[cpu_end]="#ff85b3"

# Mem/Disk free meter
theme[free_start]="#a65e7e"
theme[free_mid]="#c27898"
theme[free_end]="#ffe8f2"

# Mem/Disk cached meter
theme[cached_start]="#ffe082"
theme[cached_mid]="#ff85b3"
theme[cached_end]="#e08dff"

# Mem/Disk available meter
theme[available_start]="#ff4081"
theme[available_mid]="#ffe082"
theme[available_end]="#ff85b3"

# Mem/Disk used meter
theme[used_start]="#ff1744"
theme[used_mid]="#ff6e6e"
theme[used_end]="#ff0033"

# Download graph colors
theme[download_start]="#ffe082"
theme[download_mid]="#ff85b3"
theme[download_end]="#e08dff"

# Upload graph colors
theme[upload_start]="#ff4081"
theme[upload_mid]="#ff1744"
theme[upload_end]="#ff6e6e"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ff4081"
theme[process_mid]="#ff1744"
theme[process_end]="#ff0033"
