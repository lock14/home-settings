# Everforest Dark TrueColor theme for btop
# Matches the 16-color semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#2d353b"

# Main text color
theme[main_fg]="#d3c6aa"

# Title color for boxes
theme[title]="#dfd4bc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#dbbc7f"

# Background color of selected item in processes box
theme[selected_bg]="#3a454a"

# Foreground color of selected item in processes box
theme[selected_fg]="#dfd4bc"

# Color of inactive/disabled text
theme[inactive_fg]="#859289"

# Color of text appearing on top of graphs, such as uptime and current network graph scaling
theme[graph_text]="#9da9a0"

# Background color of the percentage meters
theme[meter_bg]="#3a454a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9ec66e"

# Cpu box outline color
theme[cpu_box]="#859289"

# Memory/disks box outline color
theme[mem_box]="#859289"

# Net up/down box outline color
theme[net_box]="#859289"

# Processes box outline color
theme[proc_box]="#859289"

# Box divider line and small boxes line color
theme[div_line]="#859289"

# Temperature graph colors
theme[temp_start]="#9ec66e"
theme[temp_mid]="#dbbc7f"
theme[temp_end]="#e6686b"

# CPU graph colors
theme[cpu_start]="#9ec66e"
theme[cpu_mid]="#83c092"
theme[cpu_end]="#78b4ce"

# Mem/Disk free meter
theme[free_start]="#859289"
theme[free_mid]="#9da9a0"
theme[free_end]="#d3c6aa"

# Mem/Disk cached meter
theme[cached_start]="#83c092"
theme[cached_mid]="#78b4ce"
theme[cached_end]="#ac8ec9"

# Mem/Disk available meter
theme[available_start]="#9ec66e"
theme[available_mid]="#83c092"
theme[available_end]="#78b4ce"

# Mem/Disk used meter
theme[used_start]="#dbbc7f"
theme[used_mid]="#e69875"
theme[used_end]="#e6686b"

# Download graph colors
theme[download_start]="#83c092"
theme[download_mid]="#78b4ce"
theme[download_end]="#ac8ec9"

# Upload graph colors
theme[upload_start]="#9ec66e"
theme[upload_mid]="#dbbc7f"
theme[upload_end]="#e69875"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9ec66e"
theme[process_mid]="#dbbc7f"
theme[process_end]="#e6686b"
