# St. Patrick's Day TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0e1a14"

# Main text color
theme[main_fg]="#bfd6c8"

# Title color for boxes
theme[title]="#d5e8dc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f0c445"

# Background color of selected item in processes box
theme[selected_bg]="#172a21"

# Foreground color of selected item in processes box
theme[selected_fg]="#d5e8dc"

# Color of inactive/disabled text
theme[inactive_fg]="#587a68"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#6f9480"

# Background color of the percentage meters
theme[meter_bg]="#172a21"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#4ad66d"

# Cpu box outline color
theme[cpu_box]="#587a68"

# Memory/disks box outline color
theme[mem_box]="#587a68"

# Net up/down box outline color
theme[net_box]="#587a68"

# Processes box outline color
theme[proc_box]="#587a68"

# Box divider line and small boxes line color
theme[div_line]="#587a68"

# Temperature graph colors
theme[temp_start]="#4ad66d"
theme[temp_mid]="#f0c445"
theme[temp_end]="#e65f5c"

# CPU graph colors
theme[cpu_start]="#4ad66d"
theme[cpu_mid]="#4ad2b8"
theme[cpu_end]="#5aa9e6"

# Mem/Disk free meter
theme[free_start]="#587a68"
theme[free_mid]="#6f9480"
theme[free_end]="#bfd6c8"

# Mem/Disk cached meter
theme[cached_start]="#4ad2b8"
theme[cached_mid]="#5aa9e6"
theme[cached_end]="#9d8df1"

# Mem/Disk available meter
theme[available_start]="#4ad66d"
theme[available_mid]="#4ad2b8"
theme[available_end]="#5aa9e6"

# Mem/Disk used meter
theme[used_start]="#f0c445"
theme[used_mid]="#e68a3e"
theme[used_end]="#e65f5c"

# Download graph colors
theme[download_start]="#4ad2b8"
theme[download_mid]="#5aa9e6"
theme[download_end]="#9d8df1"

# Upload graph colors
theme[upload_start]="#4ad66d"
theme[upload_mid]="#f0c445"
theme[upload_end]="#e68a3e"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#4ad66d"
theme[process_mid]="#f0c445"
theme[process_end]="#e65f5c"
