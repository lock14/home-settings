# St. Patrick's Day TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#042411"

# Main text color
theme[main_fg]="#e3faea"

# Title color for boxes
theme[title]="#f4fff7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffa600"

# Background color of selected item in processes box
theme[selected_bg]="#0a3b1e"

# Foreground color of selected item in processes box
theme[selected_fg]="#f4fff7"

# Color of inactive/disabled text
theme[inactive_fg]="#529e6e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#6bb887"

# Background color of the percentage meters
theme[meter_bg]="#0a3b1e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#00f556"

# Cpu box outline color
theme[cpu_box]="#529e6e"

# Memory/disks box outline color
theme[mem_box]="#529e6e"

# Net up/down box outline color
theme[net_box]="#529e6e"

# Processes box outline color
theme[proc_box]="#529e6e"

# Box divider line and small boxes line color
theme[div_line]="#529e6e"

# Temperature graph colors
theme[temp_start]="#00f556"
theme[temp_mid]="#ffa600"
theme[temp_end]="#ff4757"

# CPU graph colors
theme[cpu_start]="#00f556"
theme[cpu_mid]="#80ff72"
theme[cpu_end]="#ffd700"

# Mem/Disk free meter
theme[free_start]="#529e6e"
theme[free_mid]="#6bb887"
theme[free_end]="#e3faea"

# Mem/Disk cached meter
theme[cached_start]="#80ff72"
theme[cached_mid]="#ffd700"
theme[cached_end]="#4ae8c2"

# Mem/Disk available meter
theme[available_start]="#00f556"
theme[available_mid]="#80ff72"
theme[available_end]="#ffd700"

# Mem/Disk used meter
theme[used_start]="#ffa600"
theme[used_mid]="#ff7b00"
theme[used_end]="#ff4757"

# Download graph colors
theme[download_start]="#80ff72"
theme[download_mid]="#ffd700"
theme[download_end]="#4ae8c2"

# Upload graph colors
theme[upload_start]="#00f556"
theme[upload_mid]="#ffa600"
theme[upload_end]="#ff7b00"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#00f556"
theme[process_mid]="#ffa600"
theme[process_end]="#ff4757"
