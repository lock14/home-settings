# Dracula TrueColor theme for btop
# Matches the 16-color semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#282a36"

# Main text color
theme[main_fg]="#e8e8e2"

# Title color for boxes
theme[title]="#f2f2ec"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f1fa8c"

# Background color of selected item in processes box
theme[selected_bg]="#383b4c"

# Foreground color of selected item in processes box
theme[selected_fg]="#f2f2ec"

# Color of inactive/disabled text
theme[inactive_fg]="#7a89b8"

# Color of text appearing on top of graphs, such as uptime and current network graph scaling
theme[graph_text]="#94a3cc"

# Background color of the percentage meters
theme[meter_bg]="#383b4c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#50fa7b"

# Cpu box outline color
theme[cpu_box]="#7a89b8"

# Memory/disks box outline color
theme[mem_box]="#7a89b8"

# Net up/down box outline color
theme[net_box]="#7a89b8"

# Processes box outline color
theme[proc_box]="#7a89b8"

# Box divider line and small boxes line color
theme[div_line]="#7a89b8"

# Temperature graph colors
theme[temp_start]="#50fa7b"
theme[temp_mid]="#f1fa8c"
theme[temp_end]="#ff5555"

# CPU graph colors
theme[cpu_start]="#50fa7b"
theme[cpu_mid]="#8be9fd"
theme[cpu_end]="#66b2ff"

# Mem/Disk free meter
theme[free_start]="#7a89b8"
theme[free_mid]="#94a3cc"
theme[free_end]="#e8e8e2"

# Mem/Disk cached meter
theme[cached_start]="#8be9fd"
theme[cached_mid]="#66b2ff"
theme[cached_end]="#bd93f9"

# Mem/Disk available meter
theme[available_start]="#50fa7b"
theme[available_mid]="#8be9fd"
theme[available_end]="#66b2ff"

# Mem/Disk used meter
theme[used_start]="#f1fa8c"
theme[used_mid]="#ffb86c"
theme[used_end]="#ff5555"

# Download graph colors
theme[download_start]="#8be9fd"
theme[download_mid]="#66b2ff"
theme[download_end]="#bd93f9"

# Upload graph colors
theme[upload_start]="#50fa7b"
theme[upload_mid]="#f1fa8c"
theme[upload_end]="#ffb86c"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#50fa7b"
theme[process_mid]="#f1fa8c"
theme[process_end]="#ff5555"
