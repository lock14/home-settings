# New Year's TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#07081c"

# Main text color
theme[main_fg]="#eef1ff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#44ff77"

# Background color of selected item in processes box
theme[selected_bg]="#14183d"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#6872aa"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#848fc7"

# Background color of the percentage meters
theme[meter_bg]="#14183d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ffd700"

# Cpu box outline color
theme[cpu_box]="#6872aa"

# Memory/disks box outline color
theme[mem_box]="#6872aa"

# Net up/down box outline color
theme[net_box]="#6872aa"

# Processes box outline color
theme[proc_box]="#6872aa"

# Box divider line and small boxes line color
theme[div_line]="#6872aa"

# Temperature graph colors
theme[temp_start]="#ffd700"
theme[temp_mid]="#44ff77"
theme[temp_end]="#ff1744"

# CPU graph colors
theme[cpu_start]="#ffd700"
theme[cpu_mid]="#ff66c4"
theme[cpu_end]="#00f0ff"

# Mem/Disk free meter
theme[free_start]="#6872aa"
theme[free_mid]="#848fc7"
theme[free_end]="#eef1ff"

# Mem/Disk cached meter
theme[cached_start]="#ff66c4"
theme[cached_mid]="#00f0ff"
theme[cached_end]="#b388ff"

# Mem/Disk available meter
theme[available_start]="#ffd700"
theme[available_mid]="#ff66c4"
theme[available_end]="#00f0ff"

# Mem/Disk used meter
theme[used_start]="#44ff77"
theme[used_mid]="#ff8024"
theme[used_end]="#ff1744"

# Download graph colors
theme[download_start]="#ff66c4"
theme[download_mid]="#00f0ff"
theme[download_end]="#b388ff"

# Upload graph colors
theme[upload_start]="#ffd700"
theme[upload_mid]="#44ff77"
theme[upload_end]="#ff8024"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ffd700"
theme[process_mid]="#44ff77"
theme[process_end]="#ff1744"
