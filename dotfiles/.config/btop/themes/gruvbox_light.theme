# Gruvbox Light TrueColor theme for btop
# Matches the 16-color semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fbf1c7"

# Main text color
theme[main_fg]="#3c3836"

# Title color for boxes
theme[title]="#282828"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#986300"

# Background color of selected item in processes box
theme[selected_bg]="#ebdbb2"

# Foreground color of selected item in processes box
theme[selected_fg]="#282828"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6259"

# Color of text appearing on top of graphs, such as uptime and current network graph scaling
theme[graph_text]="#5c524b"

# Background color of the percentage meters
theme[meter_bg]="#ebdbb2"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#5f6e00"

# Cpu box outline color
theme[cpu_box]="#6e6259"

# Memory/disks box outline color
theme[mem_box]="#6e6259"

# Net up/down box outline color
theme[net_box]="#6e6259"

# Processes box outline color
theme[proc_box]="#6e6259"

# Box divider line and small boxes line color
theme[div_line]="#6e6259"

# Temperature graph colors
theme[temp_start]="#5f6e00"
theme[temp_mid]="#986300"
theme[temp_end]="#9d0006"

# CPU graph colors
theme[cpu_start]="#5f6e00"
theme[cpu_mid]="#2e7352"
theme[cpu_end]="#076678"

# Mem/Disk free meter
theme[free_start]="#6e6259"
theme[free_mid]="#5c524b"
theme[free_end]="#3c3836"

# Mem/Disk cached meter
theme[cached_start]="#2e7352"
theme[cached_mid]="#076678"
theme[cached_end]="#6c469e"

# Mem/Disk available meter
theme[available_start]="#5f6e00"
theme[available_mid]="#2e7352"
theme[available_end]="#076678"

# Mem/Disk used meter
theme[used_start]="#986300"
theme[used_mid]="#af3a03"
theme[used_end]="#9d0006"

# Download graph colors
theme[download_start]="#2e7352"
theme[download_mid]="#076678"
theme[download_end]="#6c469e"

# Upload graph colors
theme[upload_start]="#5f6e00"
theme[upload_mid]="#986300"
theme[upload_end]="#af3a03"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#5f6e00"
theme[process_mid]="#986300"
theme[process_end]="#9d0006"
