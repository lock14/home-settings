# Halloween TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#160824"

# Main text color
theme[main_fg]="#ede2fa"

# Title color for boxes
theme[title]="#f8f2ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffe000"

# Background color of selected item in processes box
theme[selected_bg]="#281040"

# Foreground color of selected item in processes box
theme[selected_fg]="#f8f2ff"

# Color of inactive/disabled text
theme[inactive_fg]="#7d5ba6"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#9b78c4"

# Background color of the percentage meters
theme[meter_bg]="#281040"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ff7518"

# Cpu box outline color
theme[cpu_box]="#7d5ba6"

# Memory/disks box outline color
theme[mem_box]="#7d5ba6"

# Net up/down box outline color
theme[net_box]="#7d5ba6"

# Processes box outline color
theme[proc_box]="#7d5ba6"

# Box divider line and small boxes line color
theme[div_line]="#7d5ba6"

# Temperature graph colors
theme[temp_start]="#ff7518"
theme[temp_mid]="#ffe000"
theme[temp_end]="#ff1744"

# CPU graph colors
theme[cpu_start]="#ff7518"
theme[cpu_mid]="#2ee6d6"
theme[cpu_end]="#55ff47"

# Mem/Disk free meter
theme[free_start]="#7d5ba6"
theme[free_mid]="#9b78c4"
theme[free_end]="#ede2fa"

# Mem/Disk cached meter
theme[cached_start]="#2ee6d6"
theme[cached_mid]="#55ff47"
theme[cached_end]="#c77dff"

# Mem/Disk available meter
theme[available_start]="#ff7518"
theme[available_mid]="#2ee6d6"
theme[available_end]="#55ff47"

# Mem/Disk used meter
theme[used_start]="#ffe000"
theme[used_mid]="#ff3b00"
theme[used_end]="#ff1744"

# Download graph colors
theme[download_start]="#2ee6d6"
theme[download_mid]="#55ff47"
theme[download_end]="#c77dff"

# Upload graph colors
theme[upload_start]="#ff7518"
theme[upload_mid]="#ffe000"
theme[upload_end]="#ff3b00"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ff7518"
theme[process_mid]="#ffe000"
theme[process_end]="#ff1744"
