# Catppuccin Mocha TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#bac2de"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f9e2af"

# Background color of selected item in processes box
theme[selected_bg]="#313244"

# Foreground color of selected item in processes box
theme[selected_fg]="#bac2de"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7086"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#7f849c"

# Background color of the percentage meters
theme[meter_bg]="#313244"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#a6e3a1"

# Cpu box outline color
theme[cpu_box]="#6c7086"

# Memory/disks box outline color
theme[mem_box]="#6c7086"

# Net up/down box outline color
theme[net_box]="#6c7086"

# Processes box outline color
theme[proc_box]="#6c7086"

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph colors
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#94e2d5"
theme[cpu_end]="#89b4fa"

# Mem/Disk free meter
theme[free_start]="#6c7086"
theme[free_mid]="#7f849c"
theme[free_end]="#cdd6f4"

# Mem/Disk cached meter
theme[cached_start]="#94e2d5"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#cba6f7"

# Mem/Disk available meter
theme[available_start]="#a6e3a1"
theme[available_mid]="#94e2d5"
theme[available_end]="#89b4fa"

# Mem/Disk used meter
theme[used_start]="#f9e2af"
theme[used_mid]="#fab387"
theme[used_end]="#f38ba8"

# Download graph colors
theme[download_start]="#94e2d5"
theme[download_mid]="#89b4fa"
theme[download_end]="#cba6f7"

# Upload graph colors
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#f9e2af"
theme[upload_end]="#fab387"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#a6e3a1"
theme[process_mid]="#f9e2af"
theme[process_end]="#f38ba8"
