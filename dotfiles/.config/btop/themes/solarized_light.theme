# Solarized Light TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fdf6e3"

# Main text color
theme[main_fg]="#657b83"

# Title color for boxes
theme[title]="#586e75"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b58900"

# Background color of selected item in processes box
theme[selected_bg]="#eee8d5"

# Foreground color of selected item in processes box
theme[selected_fg]="#586e75"

# Color of inactive/disabled text
theme[inactive_fg]="#93a1a1"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#839496"

# Background color of the percentage meters
theme[meter_bg]="#eee8d5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#859900"

# Cpu box outline color
theme[cpu_box]="#93a1a1"

# Memory/disks box outline color
theme[mem_box]="#93a1a1"

# Net up/down box outline color
theme[net_box]="#93a1a1"

# Processes box outline color
theme[proc_box]="#93a1a1"

# Box divider line and small boxes line color
theme[div_line]="#93a1a1"

# Temperature graph colors
theme[temp_start]="#859900"
theme[temp_mid]="#b58900"
theme[temp_end]="#dc322f"

# CPU graph colors
theme[cpu_start]="#859900"
theme[cpu_mid]="#2aa198"
theme[cpu_end]="#268bd2"

# Mem/Disk free meter
theme[free_start]="#93a1a1"
theme[free_mid]="#839496"
theme[free_end]="#657b83"

# Mem/Disk cached meter
theme[cached_start]="#2aa198"
theme[cached_mid]="#268bd2"
theme[cached_end]="#6c71c4"

# Mem/Disk available meter
theme[available_start]="#859900"
theme[available_mid]="#2aa198"
theme[available_end]="#268bd2"

# Mem/Disk used meter
theme[used_start]="#b58900"
theme[used_mid]="#cb4b16"
theme[used_end]="#dc322f"

# Download graph colors
theme[download_start]="#2aa198"
theme[download_mid]="#268bd2"
theme[download_end]="#6c71c4"

# Upload graph colors
theme[upload_start]="#859900"
theme[upload_mid]="#b58900"
theme[upload_end]="#cb4b16"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#859900"
theme[process_mid]="#b58900"
theme[process_end]="#dc322f"
