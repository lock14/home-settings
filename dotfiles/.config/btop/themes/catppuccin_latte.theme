# Catppuccin Latte TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#eff1f5"

# Main text color
theme[main_fg]="#4c4f69"

# Title color for boxes
theme[title]="#5c5f77"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#df8e1d"

# Background color of selected item in processes box
theme[selected_bg]="#ccd0da"

# Foreground color of selected item in processes box
theme[selected_fg]="#5c5f77"

# Color of inactive/disabled text
theme[inactive_fg]="#8c8fa1"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#7c7f93"

# Background color of the percentage meters
theme[meter_bg]="#ccd0da"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#40a02b"

# Cpu box outline color
theme[cpu_box]="#8c8fa1"

# Memory/disks box outline color
theme[mem_box]="#8c8fa1"

# Net up/down box outline color
theme[net_box]="#8c8fa1"

# Processes box outline color
theme[proc_box]="#8c8fa1"

# Box divider line and small boxes line color
theme[div_line]="#8c8fa1"

# Temperature graph colors
theme[temp_start]="#40a02b"
theme[temp_mid]="#df8e1d"
theme[temp_end]="#d20f39"

# CPU graph colors
theme[cpu_start]="#40a02b"
theme[cpu_mid]="#179299"
theme[cpu_end]="#1e66f5"

# Mem/Disk free meter
theme[free_start]="#8c8fa1"
theme[free_mid]="#7c7f93"
theme[free_end]="#4c4f69"

# Mem/Disk cached meter
theme[cached_start]="#179299"
theme[cached_mid]="#1e66f5"
theme[cached_end]="#8839ef"

# Mem/Disk available meter
theme[available_start]="#40a02b"
theme[available_mid]="#179299"
theme[available_end]="#1e66f5"

# Mem/Disk used meter
theme[used_start]="#df8e1d"
theme[used_mid]="#fe640b"
theme[used_end]="#d20f39"

# Download graph colors
theme[download_start]="#179299"
theme[download_mid]="#1e66f5"
theme[download_end]="#8839ef"

# Upload graph colors
theme[upload_start]="#40a02b"
theme[upload_mid]="#df8e1d"
theme[upload_end]="#fe640b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#40a02b"
theme[process_mid]="#df8e1d"
theme[process_end]="#d20f39"
