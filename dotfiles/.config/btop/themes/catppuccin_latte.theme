# Catppuccin Latte TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#eff1f5"

# Main text color
theme[main_fg]="#4c4f69"

# Title color for boxes
theme[title]="#383a50"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8f5902"

# Background color of selected item in processes box
theme[selected_bg]="#ccd0da"

# Foreground color of selected item in processes box
theme[selected_fg]="#383a50"

# Color of inactive/disabled text
theme[inactive_fg]="#686b7d"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#5c5f77"

# Background color of the percentage meters
theme[meter_bg]="#ccd0da"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#2d761d"

# Cpu box outline color
theme[cpu_box]="#686b7d"

# Memory/disks box outline color
theme[mem_box]="#686b7d"

# Net up/down box outline color
theme[net_box]="#686b7d"

# Processes box outline color
theme[proc_box]="#686b7d"

# Box divider line and small boxes line color
theme[div_line]="#686b7d"

# Temperature graph colors
theme[temp_start]="#2d761d"
theme[temp_mid]="#8f5902"
theme[temp_end]="#d20f39"

# CPU graph colors
theme[cpu_start]="#2d761d"
theme[cpu_mid]="#0e7075"
theme[cpu_end]="#1e66f5"

# Mem/Disk free meter
theme[free_start]="#686b7d"
theme[free_mid]="#5c5f77"
theme[free_end]="#4c4f69"

# Mem/Disk cached meter
theme[cached_start]="#0e7075"
theme[cached_mid]="#1e66f5"
theme[cached_end]="#8839ef"

# Mem/Disk available meter
theme[available_start]="#2d761d"
theme[available_mid]="#0e7075"
theme[available_end]="#1e66f5"

# Mem/Disk used meter
theme[used_start]="#8f5902"
theme[used_mid]="#b34300"
theme[used_end]="#d20f39"

# Download graph colors
theme[download_start]="#0e7075"
theme[download_mid]="#1e66f5"
theme[download_end]="#8839ef"

# Upload graph colors
theme[upload_start]="#2d761d"
theme[upload_mid]="#8f5902"
theme[upload_end]="#b34300"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#2d761d"
theme[process_mid]="#8f5902"
theme[process_end]="#d20f39"
