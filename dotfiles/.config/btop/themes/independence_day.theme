# Independence Day TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#061539"

# Main text color
theme[main_fg]="#f4f7ff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff9f1c"

# Background color of selected item in processes box
theme[selected_bg]="#10275e"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#6384c7"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#82a0e0"

# Background color of the percentage meters
theme[meter_bg]="#10275e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ff2e4c"

# Cpu box outline color
theme[cpu_box]="#6384c7"

# Memory/disks box outline color
theme[mem_box]="#6384c7"

# Net up/down box outline color
theme[net_box]="#6384c7"

# Processes box outline color
theme[proc_box]="#6384c7"

# Box divider line and small boxes line color
theme[div_line]="#6384c7"

# Temperature graph colors
theme[temp_start]="#ff2e4c"
theme[temp_mid]="#ff9f1c"
theme[temp_end]="#ff1744"

# CPU graph colors
theme[cpu_start]="#ff2e4c"
theme[cpu_mid]="#ffd13b"
theme[cpu_end]="#38b6ff"

# Mem/Disk free meter
theme[free_start]="#6384c7"
theme[free_mid]="#82a0e0"
theme[free_end]="#f4f7ff"

# Mem/Disk cached meter
theme[cached_start]="#ffd13b"
theme[cached_mid]="#38b6ff"
theme[cached_end]="#80d4ff"

# Mem/Disk available meter
theme[available_start]="#ff2e4c"
theme[available_mid]="#ffd13b"
theme[available_end]="#38b6ff"

# Mem/Disk used meter
theme[used_start]="#ff9f1c"
theme[used_mid]="#ff5733"
theme[used_end]="#ff1744"

# Download graph colors
theme[download_start]="#ffd13b"
theme[download_mid]="#38b6ff"
theme[download_end]="#80d4ff"

# Upload graph colors
theme[upload_start]="#ff2e4c"
theme[upload_mid]="#ff9f1c"
theme[upload_end]="#ff5733"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ff2e4c"
theme[process_mid]="#ff9f1c"
theme[process_end]="#ff1744"
