# Easter TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fdf7ff"

# Main text color
theme[main_fg]="#3a224d"

# Title color for boxes
theme[title]="#261236"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d98200"

# Background color of selected item in processes box
theme[selected_bg]="#f2e3fa"

# Foreground color of selected item in processes box
theme[selected_fg]="#261236"

# Color of inactive/disabled text
theme[inactive_fg]="#8e6fa3"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#75568a"

# Background color of the percentage meters
theme[meter_bg]="#f2e3fa"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e82e8a"

# Cpu box outline color
theme[cpu_box]="#8e6fa3"

# Memory/disks box outline color
theme[mem_box]="#8e6fa3"

# Net up/down box outline color
theme[net_box]="#8e6fa3"

# Processes box outline color
theme[proc_box]="#8e6fa3"

# Box divider line and small boxes line color
theme[div_line]="#8e6fa3"

# Temperature graph colors
theme[temp_start]="#e82e8a"
theme[temp_mid]="#d98200"
theme[temp_end]="#d50032"

# CPU graph colors
theme[cpu_start]="#e82e8a"
theme[cpu_mid]="#00a86b"
theme[cpu_end]="#0088dd"

# Mem/Disk free meter
theme[free_start]="#8e6fa3"
theme[free_mid]="#75568a"
theme[free_end]="#3a224d"

# Mem/Disk cached meter
theme[cached_start]="#00a86b"
theme[cached_mid]="#0088dd"
theme[cached_end]="#8a2be2"

# Mem/Disk available meter
theme[available_start]="#e82e8a"
theme[available_mid]="#00a86b"
theme[available_end]="#0088dd"

# Mem/Disk used meter
theme[used_start]="#d98200"
theme[used_mid]="#e65100"
theme[used_end]="#d50032"

# Download graph colors
theme[download_start]="#00a86b"
theme[download_mid]="#0088dd"
theme[download_end]="#8a2be2"

# Upload graph colors
theme[upload_start]="#e82e8a"
theme[upload_mid]="#d98200"
theme[upload_end]="#e65100"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#e82e8a"
theme[process_mid]="#d98200"
theme[process_end]="#d50032"
