# OneDark TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#282c34"

# Main text color
theme[main_fg]="#abb2bf"

# Title color for boxes
theme[title]="#c8ccd4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e5c07b"

# Background color of selected item in processes box
theme[selected_bg]="#31353f"

# Foreground color of selected item in processes box
theme[selected_fg]="#c8ccd4"

# Color of inactive/disabled text
theme[inactive_fg]="#5c6370"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#7f848e"

# Background color of the percentage meters
theme[meter_bg]="#31353f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#98c379"

# Cpu box outline color
theme[cpu_box]="#5c6370"

# Memory/disks box outline color
theme[mem_box]="#5c6370"

# Net up/down box outline color
theme[net_box]="#5c6370"

# Processes box outline color
theme[proc_box]="#5c6370"

# Box divider line and small boxes line color
theme[div_line]="#5c6370"

# Temperature graph colors
theme[temp_start]="#98c379"
theme[temp_mid]="#e5c07b"
theme[temp_end]="#e06c75"

# CPU graph colors
theme[cpu_start]="#98c379"
theme[cpu_mid]="#56b6c2"
theme[cpu_end]="#61afef"

# Mem/Disk free meter
theme[free_start]="#5c6370"
theme[free_mid]="#7f848e"
theme[free_end]="#abb2bf"

# Mem/Disk cached meter
theme[cached_start]="#56b6c2"
theme[cached_mid]="#61afef"
theme[cached_end]="#b268ca"

# Mem/Disk available meter
theme[available_start]="#98c379"
theme[available_mid]="#56b6c2"
theme[available_end]="#61afef"

# Mem/Disk used meter
theme[used_start]="#e5c07b"
theme[used_mid]="#d19a66"
theme[used_end]="#e06c75"

# Download graph colors
theme[download_start]="#56b6c2"
theme[download_mid]="#61afef"
theme[download_end]="#b268ca"

# Upload graph colors
theme[upload_start]="#98c379"
theme[upload_mid]="#e5c07b"
theme[upload_end]="#d19a66"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#98c379"
theme[process_mid]="#e5c07b"
theme[process_end]="#e06c75"
