# Rosé Pine TrueColor theme for btop
# Matches the 16-color semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#191724"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#eae8f8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f6c177"

# Background color of selected item in processes box
theme[selected_bg]="#26233a"

# Foreground color of selected item in processes box
theme[selected_fg]="#eae8f8"

# Color of inactive/disabled text
theme[inactive_fg]="#787394"

# Color of text appearing on top of graphs, such as uptime and current network graph scaling
theme[graph_text]="#908caa"

# Background color of the percentage meters
theme[meter_bg]="#26233a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#8ac79a"

# Cpu box outline color
theme[cpu_box]="#787394"

# Memory/disks box outline color
theme[mem_box]="#787394"

# Net up/down box outline color
theme[net_box]="#787394"

# Processes box outline color
theme[proc_box]="#787394"

# Box divider line and small boxes line color
theme[div_line]="#787394"

# Temperature graph colors
theme[temp_start]="#8ac79a"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# CPU graph colors
theme[cpu_start]="#8ac79a"
theme[cpu_mid]="#9ccfd8"
theme[cpu_end]="#67a8ce"

# Mem/Disk free meter
theme[free_start]="#787394"
theme[free_mid]="#908caa"
theme[free_end]="#e0def4"

# Mem/Disk cached meter
theme[cached_start]="#9ccfd8"
theme[cached_mid]="#67a8ce"
theme[cached_end]="#c4a7e7"

# Mem/Disk available meter
theme[available_start]="#8ac79a"
theme[available_mid]="#9ccfd8"
theme[available_end]="#67a8ce"

# Mem/Disk used meter
theme[used_start]="#f6c177"
theme[used_mid]="#ea9a75"
theme[used_end]="#eb6f92"

# Download graph colors
theme[download_start]="#9ccfd8"
theme[download_mid]="#67a8ce"
theme[download_end]="#c4a7e7"

# Upload graph colors
theme[upload_start]="#8ac79a"
theme[upload_mid]="#f6c177"
theme[upload_end]="#ea9a75"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#8ac79a"
theme[process_mid]="#f6c177"
theme[process_end]="#eb6f92"
