# Christmas TrueColor theme for btop
# Matches the 16-slot semantic palette architecture

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#062012"

# Main text color
theme[main_fg]="#f0faf4"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#38e5ff"

# Background color of selected item in processes box
theme[selected_bg]="#0e3820"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#5c9e78"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#78b894"

# Background color of the percentage meters
theme[meter_bg]="#0e3820"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#2ee66b"

# Cpu box outline color
theme[cpu_box]="#5c9e78"

# Memory/disks box outline color
theme[mem_box]="#5c9e78"

# Net up/down box outline color
theme[net_box]="#5c9e78"

# Processes box outline color
theme[proc_box]="#5c9e78"

# Box divider line and small boxes line color
theme[div_line]="#5c9e78"

# Temperature graph colors
theme[temp_start]="#2ee66b"
theme[temp_mid]="#38e5ff"
theme[temp_end]="#ff1738"

# CPU graph colors
theme[cpu_start]="#2ee66b"
theme[cpu_mid]="#ff6b9e"
theme[cpu_end]="#ffd700"

# Mem/Disk free meter
theme[free_start]="#5c9e78"
theme[free_mid]="#78b894"
theme[free_end]="#f0faf4"

# Mem/Disk cached meter
theme[cached_start]="#ff6b9e"
theme[cached_mid]="#ffd700"
theme[cached_end]="#c788ff"

# Mem/Disk available meter
theme[available_start]="#2ee66b"
theme[available_mid]="#ff6b9e"
theme[available_end]="#ffd700"

# Mem/Disk used meter
theme[used_start]="#38e5ff"
theme[used_mid]="#ff7b24"
theme[used_end]="#ff1738"

# Download graph colors
theme[download_start]="#ff6b9e"
theme[download_mid]="#ffd700"
theme[download_end]="#c788ff"

# Upload graph colors
theme[upload_start]="#2ee66b"
theme[upload_mid]="#38e5ff"
theme[upload_end]="#ff7b24"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#2ee66b"
theme[process_mid]="#38e5ff"
theme[process_end]="#ff1738"
