#!/bin/sh

###############################################################################
# Environment Variables & PATH Configuration
###############################################################################

# Default editor
export EDITOR=vim
export SVN_EDITOR="$EDITOR"

# Standard user binaries
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/software/bin:$PATH"

# Go workspace and SDK paths (instant shell startup, zero subprocesses)
export GOPATH="${GOPATH:-$HOME/go}"
export PATH="$GOPATH/bin:$HOME/software/sdk/go/bin:$PATH"

# Mise runtime manager shims
if [ -d "$HOME/.local/share/mise/shims" ]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
