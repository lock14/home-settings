# Unified Shell Aliases (Zsh & Bash)

# git custom workflows
alias gcommit='git add -A && git commit'
alias gamend='git add -A && git commit --amend --no-edit'
alias gfetch='git fetch'
alias gpush='git push origin HEAD'
alias gpushf='git push --force-with-lease origin HEAD'
alias gpull='git pull --rebase --autostash'
alias gup='gfetch && gpull'
alias gprune='git fetch --prune 2>/dev/null; target=$(git show-ref --verify --quiet refs/heads/main && echo main || (git show-ref --verify --quiet refs/heads/master && echo master || git rev-parse --abbrev-ref HEAD 2>/dev/null)); git branch --merged "$target" | sed "s/^[ *]*//" | grep -E -v "^(main|master|$target|$(git rev-parse --abbrev-ref HEAD 2>/dev/null))$" | while read -r b; do [ -n "$b" ] && git branch -d "$b"; done'
alias gpurge='target=$(git show-ref --verify --quiet refs/heads/main && echo main || (git show-ref --verify --quiet refs/heads/master && echo master || git rev-parse --abbrev-ref HEAD 2>/dev/null)); git branch --format="%(refname:short)" | grep -E -v "^(main|master|$target|$(git rev-parse --abbrev-ref HEAD 2>/dev/null))$" | while read -r b; do [ -n "$b" ] && git branch -D "$b"; done'
alias guser-branch='b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); if [ -z "$b" ] || [ "$b" = "HEAD" ]; then echo "Error: not on a valid branch" >&2; false; elif [ "$b" = "main" ] || [ "$b" = "master" ] || [ "$b" = "trunk" ]; then echo "Error: refusing to prefix $b branch" >&2; false; else git branch -m "${USER:-$(whoami)}/$(echo "$b" | sed -E "s|^(${USER:-$(whoami)}/)+||")"; fi'


# editor shortcuts (Neovim default with Vim fallback)
if command -v nvim >/dev/null 2>&1; then
    alias vi='nvim'
    alias vim='nvim'
    alias v='nvim'
else
    alias vi='vim'
    alias v='vim'
fi

# modern file viewing (bat with TrueColor Solarized Dark; cat remains coreutils)
if command -v bat >/dev/null 2>&1; then
    alias b='bat'
elif command -v batcat >/dev/null 2>&1; then
    alias bat='batcat'
    alias b='batcat'
fi

# standard directory listing (GNU ls / BSD ls defaults)
if [ "$(uname -s)" = "Darwin" ]; then
    alias ls='ls -G'
    alias ll='ls -alFG'
    alias la='ls -AG'
    alias l='ls -CFG'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi

# optional modern directory listing (eza shortcuts with MesloLGS NF BMP icon translation)
if command -v eza >/dev/null 2>&1; then
    _home_settings_eza() {
        if [ -t 1 ] && command -v perl >/dev/null 2>&1; then
            COLUMNS="${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}" command eza "$@" --color=always --icons=always | perl -CS -pe 's/\x{e6b2}|\x{e8eb}|\x{f0683}/\x{e615}/g; s/\x{f02a2}/\x{f1d3}/g; s/\x{f03e3}|\x{f00ba}|\x{f0854}/\x{f48a}/g; s/\x{f1183}|\x{f018d}/\x{f489}/g; s/\x{f0219}/\x{f15c}/g; s/\x{f024b}|\x{f0256}/\x{f07b}/g; s/\x{f031b}/\x{f023}/g; s/[\x{f0000}-\x{f1af0}]/\x{f15b}/g'
        elif command -v perl >/dev/null 2>&1; then
            command eza "$@" | perl -CS -pe 's/\x{e6b2}|\x{e8eb}|\x{f0683}/\x{e615}/g; s/\x{f02a2}/\x{f1d3}/g; s/\x{f03e3}|\x{f00ba}|\x{f0854}/\x{f48a}/g; s/\x{f1183}|\x{f018d}/\x{f489}/g; s/\x{f0219}/\x{f15c}/g; s/\x{f024b}|\x{f0256}/\x{f07b}/g; s/\x{f031b}/\x{f023}/g; s/[\x{f0000}-\x{f1af0}]/\x{f15b}/g'
        else
            command eza "$@"
        fi
    }
    alias eza='_home_settings_eza'
    alias e='_home_settings_eza --icons=auto --group-directories-first'
    alias el='_home_settings_eza -la --icons=auto --git --header --group --group-directories-first --time-style=long-iso'
    alias elm='_home_settings_eza -la --icons=auto --git --header --group --group-directories-first --time-style=long-iso --sort=modified'
    alias et='_home_settings_eza --tree --level=2 --icons=auto'
    alias elt='_home_settings_eza -la --tree --level=2 --icons=auto --git --group --time-style=long-iso'
    alias elx='_home_settings_eza -la --icons=auto --git --header --group --group-directories-first --time-style=long-iso -H -i -S --extended'
fi

# golang
alias go-lint='golangci-lint run'
alias go-testall='go test ./...'
alias go-buildall='go build ./...'

# terraform
alias tf='terraform'

# Aux
alias yaml-lint='yamllint -d relaxed'
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    alias fd='fdfind'
fi

# Source custom alias drop-ins (~/.aliases.d/*.sh)
if [ -d "$HOME/.aliases.d" ]; then
    _source_alias_dropins() {
        if [ -n "${ZSH_VERSION:-}" ]; then
            setopt local_options null_glob
        fi
        for _f in "$HOME/.aliases.d"/*.sh; do
            if [ -r "$_f" ]; then
                # shellcheck source=/dev/null
                . "$_f"
            fi
        done
        unset _f
    }
    _source_alias_dropins
    unset -f _source_alias_dropins
fi

