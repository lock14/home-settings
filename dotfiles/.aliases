# Unified Shell Aliases (Zsh and Bash)
# Delegates to modular dotfiles/.config/shell/aliases-core.sh.

_hs_al_mod=""
if [ -n "${BASH_VERSION:-}" ]; then
    eval '_hs_al_src="${BASH_SOURCE[0]:-}"'
    if [ -n "${_hs_al_src:-}" ]; then
        if [ -L "$_hs_al_src" ] && command -v readlink >/dev/null 2>&1; then
            while [ -L "$_hs_al_src" ]; do
                _hs_al_dir="${_hs_al_src%/*}"
                [ "$_hs_al_dir" = "$_hs_al_src" ] && _hs_al_dir="."
                _hs_al_lnk="$(readlink "$_hs_al_src" 2>/dev/null || true)"
                [ -n "$_hs_al_lnk" ] || break
                case "$_hs_al_lnk" in
                    /*) _hs_al_src="$_hs_al_lnk" ;;
                    *)  _hs_al_src="$_hs_al_dir/$_hs_al_lnk" ;;
                esac
            done
        fi
        _hs_al_dir="${_hs_al_src%/*}"
        [ "$_hs_al_dir" = "$_hs_al_src" ] && _hs_al_dir="."
        if [ -r "$_hs_al_dir/.config/shell/aliases-core.sh" ]; then
            _hs_al_mod="$_hs_al_dir/.config/shell/aliases-core.sh"
        fi
    fi
elif [ -n "${ZSH_VERSION:-}" ]; then
    eval '
        _hs_al_had_rpi=${+ZLE_RPROMPT_INDENT}
        _hs_al_rpi=${ZLE_RPROMPT_INDENT:-}
        _hs_al_dir="${${(%):-%x}:A:h}/.config/shell"
        (( _hs_al_had_rpi )) && ZLE_RPROMPT_INDENT=$_hs_al_rpi
        unset _hs_al_had_rpi _hs_al_rpi
    '
    if [ -r "${_hs_al_dir:-}/aliases-core.sh" ]; then
        _hs_al_mod="$_hs_al_dir/aliases-core.sh"
    fi
fi

if [ -z "$_hs_al_mod" ]; then
    if [ -n "${_HS_SHELL_DIR:-}" ] && [ -r "$_HS_SHELL_DIR/aliases-core.sh" ]; then
        _hs_al_mod="$_HS_SHELL_DIR/aliases-core.sh"
    elif [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases-core.sh" ]; then
        _hs_al_mod="${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases-core.sh"
    elif [ -r "$HOME/.config/shell/aliases-core.sh" ]; then
        _hs_al_mod="$HOME/.config/shell/aliases-core.sh"
    fi
fi

if [ -n "$_hs_al_mod" ]; then
    # shellcheck source=/dev/null
    . "$_hs_al_mod"
elif [ -d "$HOME/.aliases.d" ]; then
    for _hs_al_f in "$HOME/.aliases.d"/*.sh; do
        # shellcheck source=/dev/null
        [ -r "$_hs_al_f" ] && . "$_hs_al_f"
    done
    unset _hs_al_f
fi
unset _hs_al_mod _hs_al_src _hs_al_dir _hs_al_lnk
