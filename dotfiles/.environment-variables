#!/bin/sh

###############################################################################
# Environment Variables & PATH Configuration
###############################################################################

# Default editor
export EDITOR=vim
export SVN_EDITOR="$EDITOR"

# Standard user binaries
export PATH="$HOME/.local/bin:$HOME/software/bin:$PATH"

# Go workspace path (instant shell startup, zero subprocesses)
GOPATH_DEFAULT="$HOME/go"
export GOPATH="${GOPATH:-$GOPATH_DEFAULT}"
export PATH="$GOPATH/bin:$PATH"

# Mise runtime manager shims
if [ -d "$HOME/.local/share/mise/shims" ]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
