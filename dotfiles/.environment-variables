#!/bin/sh
# Environment Variables and PATH Configuration (POSIX sh, Bash, and Zsh compatible)
# Delegates to modular dotfiles/.config/shell/env-defaults.sh.

_hs_ev_mod=""
if [ -n "${BASH_VERSION:-}" ]; then
    eval '_hs_ev_src="${BASH_SOURCE[0]:-}"'
    if [ -n "${_hs_ev_src:-}" ]; then
        if [ -L "$_hs_ev_src" ] && command -v readlink >/dev/null 2>&1; then
            while [ -L "$_hs_ev_src" ]; do
                _hs_ev_dir="${_hs_ev_src%/*}"
                [ "$_hs_ev_dir" = "$_hs_ev_src" ] && _hs_ev_dir="."
                _hs_ev_lnk="$(readlink "$_hs_ev_src" 2>/dev/null || true)"
                [ -n "$_hs_ev_lnk" ] || break
                case "$_hs_ev_lnk" in
                    /*) _hs_ev_src="$_hs_ev_lnk" ;;
                    *)  _hs_ev_src="$_hs_ev_dir/$_hs_ev_lnk" ;;
                esac
            done
        fi
        _hs_ev_dir="${_hs_ev_src%/*}"
        [ "$_hs_ev_dir" = "$_hs_ev_src" ] && _hs_ev_dir="."
        if [ -r "$_hs_ev_dir/.config/shell/env-defaults.sh" ]; then
            _hs_ev_mod="$_hs_ev_dir/.config/shell/env-defaults.sh"
        fi
    fi
elif [ -n "${ZSH_VERSION:-}" ]; then
    eval '
        _hs_ev_had_rpi=${+ZLE_RPROMPT_INDENT}
        _hs_ev_rpi=${ZLE_RPROMPT_INDENT:-}
        _hs_ev_dir="${${(%):-%x}:A:h}/.config/shell"
        (( _hs_ev_had_rpi )) && ZLE_RPROMPT_INDENT=$_hs_ev_rpi
        unset _hs_ev_had_rpi _hs_ev_rpi
    '
    if [ -r "${_hs_ev_dir:-}/env-defaults.sh" ]; then
        _hs_ev_mod="$_hs_ev_dir/env-defaults.sh"
    fi
fi

if [ -z "$_hs_ev_mod" ]; then
    if [ -n "${_HS_SHELL_DIR:-}" ] && [ -r "$_HS_SHELL_DIR/env-defaults.sh" ]; then
        _hs_ev_mod="$_HS_SHELL_DIR/env-defaults.sh"
    elif [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env-defaults.sh" ]; then
        _hs_ev_mod="${XDG_CONFIG_HOME:-$HOME/.config}/shell/env-defaults.sh"
    elif [ -r "$HOME/.config/shell/env-defaults.sh" ]; then
        _hs_ev_mod="$HOME/.config/shell/env-defaults.sh"
    fi
fi

if [ -n "$_hs_ev_mod" ]; then
    _HS_ENV_PRESERVE_EXISTING=0
    # shellcheck source=/dev/null
    . "$_hs_ev_mod"
    unset _HS_ENV_PRESERVE_EXISTING
else
    export COLORTERM=truecolor
    export FORCE_HYPERLINK=1
    export PATH="$HOME/.local/bin:$PATH"
    export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"
    export GOCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/go-build"
    export PATH="$GOPATH/bin:$PATH"
    if command -v nvim >/dev/null 2>&1; then export EDITOR=nvim
    elif command -v vim >/dev/null 2>&1; then export EDITOR=vim
    else export EDITOR=vi; fi
    export VISUAL="$EDITOR"
    if [ -S "$HOME/.ssh/ssh_auth_sock" ] || { [ -L "$HOME/.ssh/ssh_auth_sock" ] && [ ! -S "${SSH_AUTH_SOCK:-}" ]; }; then
        export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
    fi
    if [ -d "$HOME/.environment-variables.d" ]; then
        for _hs_ev_f in "$HOME/.environment-variables.d"/*.sh; do
            # shellcheck source=/dev/null
            [ -r "$_hs_ev_f" ] && . "$_hs_ev_f"
        done
        unset _hs_ev_f
    fi
fi
unset _hs_ev_mod _hs_ev_src _hs_ev_dir _hs_ev_lnk
