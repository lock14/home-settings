#!/bin/sh

###############################################################################
# Environment Variables & PATH Configuration
###############################################################################

# Force 24-bit TrueColor across terminal tools (bat, eza, delta)
export COLORTERM=truecolor

# Standard user binaries
export PATH="$HOME/.local/bin:$HOME/software/bin:$PATH"

# Mise runtime manager shims
export MISE_YES=1
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" ]; then
    export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
fi

# Go workspace & build cache (XDG Base Directory compliant)
export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"
export GOCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/go-build"
export PATH="$GOPATH/bin:$PATH"

# Default editor (prefer nvim if available, fallback to vim then vi)
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
    export EDITOR=vim
elif command -v vi >/dev/null 2>&1; then
    export EDITOR=vi
fi
export SVN_EDITOR="$EDITOR"
export VISUAL="$EDITOR"

# bat theme and rendering configuration
export BAT_THEME="Solarized-Dark-TrueColor"
export BAT_OPTS="--italic-text=always"

