#!/bin/zsh

# Solarized Dark TrueColor (Ethan Schoonover palette) for CLI Syntax Highlighting & ZLE
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Commands & Builtins (Solarized Green #859900)
ZSH_HIGHLIGHT_STYLES[command]='fg=#859900,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#859900,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#859900,bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#859900,bold'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#859900'

# Functions & Precommands (Solarized Blue #268BD2)
ZSH_HIGHLIGHT_STYLES[function]='fg=#268BD2,bold'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#268BD2,bold'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=#268BD2'

# Options, Flags & Parameters (Solarized Base0 #839496 - restrained)
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#839496'

# Strings & Quoted Arguments (Solarized Cyan #2AA198)
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#2AA198'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#2AA198'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#2AA198'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#268BD2'

# Variables, Expansions & Assignments (Solarized Base0 #839496)
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=#268BD2'
ZSH_HIGHLIGHT_STYLES[assign]='fg=#839496'

# Substitutions (Solarized Blue #268BD2)
ZSH_HIGHLIGHT_STYLES[command-substitution]='fg=#268BD2'
ZSH_HIGHLIGHT_STYLES[command-substitution-quoted]='fg=#268BD2'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=#268BD2'
ZSH_HIGHLIGHT_STYLES[process-substitution]='fg=#268BD2'

# Numbers, Operators & Punctuation (Solarized Base0 #839496)
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[arithmetic-expansion]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#839496'

# Paths & Directories (Solarized Blue #268BD2 matching dircolors/eza / Base0 #839496)
ZSH_HIGHLIGHT_STYLES[path]='fg=#268BD2'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#839496'

# Unknown Tokens & Errors (Solarized Red #DC322F)
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#DC322F,bold'

# Comments (Solarized Base01 #586E75)
ZSH_HIGHLIGHT_STYLES[comment]='fg=#586E75'

# Default Arguments (Solarized Base0 #839496)
ZSH_HIGHLIGHT_STYLES[default]='fg=#839496'

# Bracket Matching (Solarized Base0 #839496 / Error Red #DC322F)
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=#839496'
ZSH_HIGHLIGHT_STYLES[bracket-error]='fg=#DC322F,bold'

# ZLE Selection, Search & Autosuggestion (Base02 #073642, Base01 #586E75)
zle_highlight=(region:bg=#073642 special:fg=#D33682 isearch:underline,fg=#268BD2)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#586E75'

# Oh-My-Zsh non-interactive auto update (avoids startup prompt)
DISABLE_UPDATE_PROMPT="true"
zstyle ':omz:update' mode auto

# Source modular config files
[ -f "$HOME/.environment-variables" ] && source "$HOME/.environment-variables"
[ -f "$HOME/.zsh-completions" ] && source "$HOME/.zsh-completions"
[ -f "$HOME/.zsh-functions" ] && source "$HOME/.zsh-functions"
[ -f "$HOME/.aliases" ] && source "$HOME/.aliases"
[ -f "$HOME/.zsh-aliases" ] && [ ! -f "$HOME/.aliases" ] && source "$HOME/.zsh-aliases"
[ -f "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"

# LS_COLORS dircolors integration
if command -v dircolors >/dev/null 2>&1 && [ -f "$HOME/.dir-colors/dircolors" ]; then
    eval "$(dircolors "$HOME/.dir-colors/dircolors")"
fi

# Zoxide smart directory jumping (z)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Mise runtime manager hook
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

# FZF fuzzy finder integration (Ctrl+R history, Ctrl+T files, Alt+C cd)
if [[ -o interactive ]] && command -v fzf >/dev/null 2>&1; then
    if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
        source /usr/share/doc/fzf/examples/key-bindings.zsh
        [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh || true
    elif [ -f /usr/share/fzf/key-bindings.zsh ]; then
        source /usr/share/fzf/key-bindings.zsh
        [ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh || true
    elif fzf --zsh >/dev/null 2>&1; then
        eval "$(fzf --zsh)"
    fi
fi

# Ensure Oh-My-Zsh custom plugins are active if installed on disk
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
if [ -f "$ZSH_CUSTOM_DIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && ! (( $+functions[_zsh_autosuggest_suggest] )); then
    source "$ZSH_CUSTOM_DIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [ -f "$ZSH_CUSTOM_DIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && ! (( $+functions[_zsh_highlight] )); then
    source "$ZSH_CUSTOM_DIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

