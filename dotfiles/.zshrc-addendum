#!/bin/zsh
# Zsh Addendum & Interactive Environment Orchestrator
# Resolves modular helpers from dotfiles/.config/shell first, falling back to ~/.config/shell.

() {
    local _hs_had_rpi=${+ZLE_RPROMPT_INDENT} _hs_rpi=${ZLE_RPROMPT_INDENT:-}
    local _hs_dir="${${(%):-%x}:A:h}/.config/shell"
    (( _hs_had_rpi )) && ZLE_RPROMPT_INDENT=$_hs_rpi
    if [[ ! -d "$_hs_dir" ]]; then
        if [[ -n "${_HS_SHELL_DIR:-}" && -d "$_HS_SHELL_DIR" ]]; then
            _hs_dir="$_HS_SHELL_DIR"
        elif [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/shell" ]]; then
            _hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
        elif [[ -d "$HOME/.config/shell" ]]; then
            _hs_dir="$HOME/.config/shell"
        fi
    fi
    if [[ -d "$_hs_dir" ]]; then
        typeset -g _HS_SHELL_DIR="$_hs_dir"
        [[ -r "$_hs_dir/zsh-highlighting.zsh" ]] && source "$_hs_dir/zsh-highlighting.zsh"
        [[ -r "$_hs_dir/functions.sh" ]] && source "$_hs_dir/functions.sh"
    fi
}

# Oh-My-Zsh non-interactive auto update, clean history, and XON/XOFF flow-control disable (frees Ctrl+s)
DISABLE_UPDATE_PROMPT="true"
zstyle ':omz:update' mode auto
setopt HIST_IGNORE_SPACE
setopt NO_FLOW_CONTROL

# Source modular dotfile entrypoints
[ -f "$HOME/.environment-variables" ] && source "$HOME/.environment-variables"
[ -f "$HOME/.zsh-completions" ] && source "$HOME/.zsh-completions"
[ -f "$HOME/.zsh-functions" ] && source "$HOME/.zsh-functions"
[ -f "$HOME/.aliases" ] && source "$HOME/.aliases"
[ -f "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"

if (( $+functions[_hs_sync_active_theme] )); then
    typeset -ga precmd_functions
    if (( ${precmd_functions[(I)_hs_sync_active_theme]} == 0 )); then
        precmd_functions+=(_hs_sync_active_theme)
    fi
fi

# Right prompt flush against screen edge (placed after .p10k.zsh to guard prompt expansion resets)
ZLE_RPROMPT_INDENT=0

# LS_COLORS dircolors integration (skip when pre-compiled TrueColor LS_COLORS is loaded from theme-env.sh)
if { [ -z "${_HS_LOADED_THEME:-}" ] || [ -z "${LS_COLORS:-}" ]; } && command -v dircolors >/dev/null 2>&1 && [ -f "$HOME/.dir-colors/dircolors" ]; then
    eval "$(dircolors -b "$HOME/.dir-colors/dircolors")"
fi

# Mise runtime manager hook (activated ahead of zoxide so zoxide resolves directly without shim overhead)
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

# Zoxide smart directory jumping (z)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Keep stale working directory recovery at the front of precmd_functions (ahead of mise) and preexec_functions
if (( $+functions[_hs_recover_stale_cwd] )); then
    typeset -ga precmd_functions preexec_functions
    precmd_functions=(_hs_recover_stale_cwd ${precmd_functions:#_hs_recover_stale_cwd})
    preexec_functions=(_hs_recover_stale_cwd ${preexec_functions:#_hs_recover_stale_cwd})
fi

# Word navigation on Alt+Left/Right and macOS Option+Left/Right (CSI 1;3 and ESC-CSI sequences)
if [[ -o interactive ]]; then
    for _hs_km in emacs viins; do
        bindkey -M "$_hs_km" '^[[1;3D' backward-word
        bindkey -M "$_hs_km" '^[[1;3C' forward-word
        bindkey -M "$_hs_km" '^[^[[D' backward-word
        bindkey -M "$_hs_km" '^[^[[C' forward-word
    done
    unset _hs_km
fi

# FZF fuzzy finder integration (Ctrl+R history, Ctrl+T files, Alt+C cd)
if [[ -o interactive ]] && (( $+functions[_hs_init_fzf] )); then
    _hs_init_fzf zsh || true
fi

# Ensure Oh-My-Zsh custom plugins are active if installed on disk
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
if [ -f "$ZSH_CUSTOM_DIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && ! (( $+functions[_zsh_autosuggest_suggest] )); then
    source "$ZSH_CUSTOM_DIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [ -f "$ZSH_CUSTOM_DIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && ! (( $+functions[_zsh_highlight] )); then
    source "$ZSH_CUSTOM_DIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
