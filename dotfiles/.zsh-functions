#!/bin/zsh

# general functions

# Hybrid IDE RPC-aware editor launcher (`v [files...]`)
# Routes file opens into the active Tmux + Neovim IDE pane when $NVIM_IDE_SOCKET is live,
# while keeping $EDITOR=nvim intact so `git commit` / `gcommit` blocks properly.
unalias v 2>/dev/null || true
v() {
    local sock="${NVIM_IDE_SOCKET:-}"
    local pane="${NVIM_IDE_PANE:-}"
    local tmux_sock=""
    if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        tmux_sock="$(tmux show-options -qv @ide_socket 2>/dev/null || true)"
        if [ -z "$tmux_sock" ]; then
            local env_sock
            env_sock="$(tmux show-environment NVIM_IDE_SOCKET 2>/dev/null || true)"
            if [[ "$env_sock" == NVIM_IDE_SOCKET=* ]]; then
                tmux_sock="${env_sock#NVIM_IDE_SOCKET=}"
            fi
        fi
        [ -z "$sock" ] && sock="$tmux_sock"
    fi
    if [ -z "$pane" ] && [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        pane="$(tmux show-options -qv @ide_editor_pane 2>/dev/null || true)"
        if [ -z "$pane" ]; then
            local env_pane
            env_pane="$(tmux show-environment NVIM_IDE_PANE 2>/dev/null || true)"
            if [[ "$env_pane" == NVIM_IDE_PANE=* ]]; then
                pane="${env_pane#NVIM_IDE_PANE=}"
            fi
        fi
    fi

    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        if nvim --server "$sock" --remote-expr "execute(\"if (&filetype ==# 'netrw' || &filetype ==# 'ide_tree') && winnr('\\$') > 1 | wincmd p | endif\")" >/dev/null 2>&1; then
            if [ "$#" -gt 0 ]; then
                local -a abs_args=()
                local arg
                for arg in "$@"; do
                    if [[ "$arg" == /* ]]; then
                        abs_args+=("$arg")
                    else
                        abs_args+=("${arg:A}")
                    fi
                done
                nvim --server "$sock" --remote "${abs_args[@]}"
            fi
            if [ -n "${TMUX:-}" ] && { [ -z "$tmux_sock" ] || [ "$sock" = "$tmux_sock" ]; }; then
                if [ -x "$HOME/.local/bin/ide" ]; then
                    "$HOME/.local/bin/ide" --show-editor >/dev/null 2>&1 || true
                elif command -v ide >/dev/null 2>&1; then
                    ide --show-editor >/dev/null 2>&1 || true
                elif [ -n "$pane" ]; then
                    tmux select-window -t "$pane" 2>/dev/null || true
                    tmux select-pane -t "$pane" 2>/dev/null || true
                fi
            fi
            return 0
        else
            rm -f "$sock" 2>/dev/null || true
        fi
    fi

    if command -v nvim >/dev/null 2>&1; then
        nvim "$@"
    elif command -v vim >/dev/null 2>&1; then
        vim "$@"
    else
        vi "$@"
    fi
}

fs() {
    local fd_cmd=""
    if (( $+commands[fd] )); then
        fd_cmd="fd"
    elif (( $+commands[fdfind] )); then
        fd_cmd="fdfind"
    elif command -v fd >/dev/null 2>&1; then
        fd_cmd="fd"
    elif command -v fdfind >/dev/null 2>&1; then
        fd_cmd="fdfind"
    else
        echo "Error: 'fd' (or 'fdfind') is not installed." >&2
        return 1
    fi

    if ! command -v tree >/dev/null 2>&1 && ! (( $+commands[tree] )); then
        echo "Error: 'tree' is not installed." >&2
        return 1
    fi

    "$fd_cmd" --no-ignore-vcs "$@" | tree --fromfile
}

# git functions

gsync() {
    local current_branch target_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || {
        echo "Error: not in a git repository" >&2
        return 1
    }

    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        echo "Error: working directory has uncommitted changes. Please stash or commit before running gsync." >&2
        return 1
    fi

    if git show-ref --verify --quiet refs/heads/main; then
        target_branch="main"
    elif git show-ref --verify --quiet refs/heads/master; then
        target_branch="master"
    else
        echo "Error: neither 'main' nor 'master' branch found locally." >&2
        return 1
    fi

    if [ "$current_branch" = "$target_branch" ]; then
        git pull --rebase origin "$target_branch"
    else
        git checkout "$target_branch" && \
        git pull --rebase origin "$target_branch" && \
        git checkout "$current_branch" && \
        git rebase "$target_branch"
    fi
}

# Source custom function drop-ins (~/.zsh-functions.d/*.zsh)
if [ -d "$HOME/.zsh-functions.d" ]; then
    for f in "$HOME/.zsh-functions.d"/*.zsh(N); do
        if [ -r "$f" ]; then
            source "$f"
        fi
    done
fi
