#!/bin/zsh
# Modular Zsh Functions Loader
# Sources shared cross-shell IDE/Git helpers, Zsh theme synchronization hooks,
# and optional user drop-ins from ~/.zsh-functions.d/*.zsh.

() {
    local _hs_had_rpi=${+ZLE_RPROMPT_INDENT} _hs_rpi=${ZLE_RPROMPT_INDENT:-}
    local _hs_dir="${${(%):-%x}:A:h}/.config/shell"
    (( _hs_had_rpi )) && ZLE_RPROMPT_INDENT=$_hs_rpi
    if [[ ! -d "$_hs_dir" ]]; then
        if [[ -n "${_HS_SHELL_DIR:-}" && -d "$_HS_SHELL_DIR" ]]; then
            _hs_dir="$_HS_SHELL_DIR"
        elif [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/shell" ]]; then
            _hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
        elif [[ -d "$HOME/.config/shell" ]]; then
            _hs_dir="$HOME/.config/shell"
        fi
    fi
    if [[ -d "$_hs_dir" ]]; then
        typeset -g _HS_SHELL_DIR="$_hs_dir"
        [[ -r "$_hs_dir/functions.sh" ]] && source "$_hs_dir/functions.sh"
        [[ -r "$_hs_dir/zsh-theme-sync.zsh" ]] && source "$_hs_dir/zsh-theme-sync.zsh"
    fi
}

# Source custom function drop-ins (~/.zsh-functions.d/*.zsh)
if [ -d "$HOME/.zsh-functions.d" ]; then
    for _hs_zf in "$HOME/.zsh-functions.d"/*.zsh(N); do
        if [ -r "$_hs_zf" ]; then
            source "$_hs_zf"
        fi
    done
    unset _hs_zf
fi
