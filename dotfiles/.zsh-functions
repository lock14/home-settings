#!/bin/zsh

# general functions

fs() {
    local fd_cmd=""
    if (( $+commands[fd] )); then
        fd_cmd="fd"
    elif (( $+commands[fdfind] )); then
        fd_cmd="fdfind"
    elif type -p fd >/dev/null 2>&1; then
        fd_cmd="fd"
    elif type -p fdfind >/dev/null 2>&1; then
        fd_cmd="fdfind"
    elif command -v fdfind >/dev/null 2>&1; then
        fd_cmd="fdfind"
    elif command -v fd >/dev/null 2>&1; then
        fd_cmd="fd"
    else
        echo "Error: 'fd' (or 'fdfind') is not installed." >&2
        return 1
    fi

    if ! (( $+commands[tree] )) && ! type -p tree >/dev/null 2>&1 && ! command -v tree >/dev/null 2>&1; then
        echo "Error: 'tree' is not installed." >&2
        return 1
    fi

    "$fd_cmd" --no-ignore-vcs "$@" | tree --fromfile
}

# git functions

gsync() {
    local current_branch target_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || {
        echo "Error: not in a git repository" >&2
        return 1
    }

    if git show-ref --verify --quiet refs/heads/main; then
        target_branch="main"
    elif git show-ref --verify --quiet refs/heads/master; then
        target_branch="master"
    else
        echo "Error: neither 'main' nor 'master' branch found locally." >&2
        return 1
    fi

    git checkout "$target_branch" && \
    git pull --rebase origin "$target_branch" && \
    git checkout "$current_branch" && \
    git rebase "$target_branch"
}
