#!/bin/bash
# custom env variables
[ -f "$HOME/.environment-variables" ] && source "$HOME/.environment-variables"
[ -f "$HOME/.aliases" ] && source "$HOME/.aliases"
[ -f "$HOME/.zsh-aliases" ] && [ ! -f "$HOME/.aliases" ] && source "$HOME/.zsh-aliases"

if command -v dircolors >/dev/null 2>&1 && [ -f "$HOME/.dir-colors/dircolors" ]; then
    eval "$(dircolors "$HOME/.dir-colors/dircolors")"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

if [[ "$-" == *i* ]] && command -v fzf >/dev/null 2>&1; then
    if [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
        source /usr/share/doc/fzf/examples/key-bindings.bash
        [ -f /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash || true
    elif [ -f /usr/share/fzf/key-bindings.bash ]; then
        source /usr/share/fzf/key-bindings.bash
        [ -f /usr/share/fzf/completion.bash ] && source /usr/share/fzf/completion.bash || true
    elif fzf --bash >/dev/null 2>&1; then
        eval "$(fzf --bash)"
    fi
fi

