# custom env variables
[ -f "$HOME/.environment_variables" ] && source "$HOME/.environment_variables"
if command -v dircolors >/dev/null 2>&1 && [ -f "$HOME/.dir_colors/dircolors" ]; then
    eval "$(dircolors "$HOME/.dir_colors/dircolors")"
fi
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi
