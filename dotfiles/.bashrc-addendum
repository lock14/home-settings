    _hs_src="${BASH_SOURCE[0]}"
    _hs_sdir="${_hs_src%/*}"
    [ "$_hs_sdir" = "$_hs_src" ] && _hs_sdir="."
    if _hs_abs_dir="$(cd "$_hs_sdir" 2>/dev/null && pwd -P)"; then
        _HS_BASHRC_SELF_PATH="$_hs_abs_dir/${_hs_src##*/}"
    fi
    if [ -L "$_hs_src" ] && command -v readlink >/dev/null 2>&1; then
        while [ -L "$_hs_src" ]; do
            _hs_dir="${_hs_src%/*}"
            [ "$_hs_dir" = "$_hs_src" ] && _hs_dir="."
            _hs_link="$(readlink "$_hs_src" 2>/dev/null || true)"
            [ -n "$_hs_link" ] || break
            [[ "$_hs_link" != /* ]] && _hs_src="$_hs_dir/$_hs_link" || _hs_src="$_hs_link"
        done
    fi
    _hs_dir="${_hs_src%/*}"
    [ "$_hs_dir" = "$_hs_src" ] && _hs_dir="."
    if [ -d "$_hs_dir/../colors/themes" ]; then
        _HS_BASHRC_REPO_ROOT="$(cd -P "$_hs_dir/.." 2>/dev/null && pwd || true)"
    fi
    unset _hs_src _hs_sdir _hs_abs_dir _hs_dir _hs_link
fi

