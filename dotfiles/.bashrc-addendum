EOF
}

_hs_bash_emit_live_osc() {
    [ -z "${NO_COLOR:-}" ] || return 0
    [ "${TERM:-}" != "linux" ] && [ "${TERM:-}" != "dumb" ] || return 0
    if [ ! -t 1 ] && [ "${THEME_FORCE_OSC:-0}" != "1" ]; then
        return 0
    fi
    local -a slots=(
        "$_HS_C_B02" "$_HS_C_RED" "$_HS_C_GRN" "$_HS_C_YEL"
        "$_HS_C_BLU" "$_HS_C_MAG" "$_HS_C_CYA" "$_HS_C_B2"
        "$_HS_C_B01" "$_HS_C_ORA" "$_HS_C_B01" "$_HS_C_B00"
        "$_HS_C_B0"  "$_HS_C_VIO" "$_HS_C_B1"  "$_HS_C_B3"
    )
    local out="" s idx
    for s in $'\033]10;'"${_HS_C_B0}"$'\007' $'\033]11;'"${_HS_C_B03}"$'\007' $'\033]12;'"${_HS_C_B0}"$'\007'; do
        if [ -n "${TMUX:-}" ]; then
            out="${out}"$'\033Ptmux;\033'"${s}"$'\033\\'
        else
            out="${out}${s}"
        fi
    done
    for ((idx = 0; idx < 16; idx++)); do
        s=$'\033]4;'"${idx};${slots[$idx]}"$'\007'
        if [ -n "${TMUX:-}" ]; then
            out="${out}"$'\033Ptmux;\033'"${s}"$'\033\\'
        else
            out="${out}${s}"
        fi
    done
    printf '%s' "$out"
}

_hs_bash_swatch_strip() {
    local out="" hex c
    for hex in "$_HS_C_B03" "$_HS_C_B0" "$_HS_C_GRN" "$_HS_C_BLU" "$_HS_C_YEL" "$_HS_C_VIO" "$_HS_C_CYA" "$_HS_C_MAG" "$_HS_C_ORA" "$_HS_C_RED"; do
        _hs_bash_rgb_semi "$hex"
        c="$REPLY"
        out="${out}"$'\033[38;2;'"${c}m██"
    done
    REPLY="${out}"$'\033[0m'
}

_hs_bash_list_themes() {
    local current_slug="$1" plain="${2:-0}"
    _hs_bash_collect_all_slugs
    local s mark disp_label src_kind
    if [ "$plain" -eq 1 ]; then
        for s in "${_HS_ALL_SLUGS[@]}"; do
            printf '%s\n' "$s"
        done
        return 0
    fi
    local use_color=0
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "linux" ]; then
        use_color=1
    fi
    for s in "${_HS_ALL_SLUGS[@]}"; do
        _hs_bash_resolve_slug_to_raw "$s" || continue
        src_kind="builtin"
        [ -n "${_HS_RESOLVED_UFILE:-}" ] && src_kind="user"
        _hs_bash_finalize_palette "$s"
        mark=" "
        [ "$s" = "$current_slug" ] && mark="*"
        disp_label="$_HS_C_LABEL"
        if _hs_bash_holiday_icon "$s"; then
            disp_label="$REPLY $disp_label"
        fi
        if [ "$use_color" -eq 1 ]; then
            _hs_bash_swatch_strip
            printf '%s %-18s %-6s %-7s %s  %s\n' "$mark" "$s" "[$_HS_C_MODE]" "$src_kind" "$REPLY" "$disp_label"
        else
            printf '%s %-20s %-6s %s\n' "$mark" "$s" "[$_HS_C_MODE]" "$disp_label"
        fi
    done
    return 0
}

_hs_bash_create_user_theme() {
    local new_name="${1:-}" base_name="${2:-solarized-dark}" force="${3:-0}"
    _hs_bash_norm_slug "$new_name"
    local slug="$REPLY"
    if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || [ "$slug" = "active-theme" ]; then
        echo "theme: invalid theme name '$new_name' (use lowercase letters, numbers, and hyphens)" >&2
        return 1
    fi
    _hs_bash_norm_slug "$base_name"
    local base_slug="$REPLY"
    if [ -z "$base_slug" ] || ! _hs_bash_resolve_slug_to_raw "$base_slug"; then
        echo "theme: unknown base theme '$base_name'" >&2
        return 1
    fi
    _hs_bash_finalize_palette "$base_slug"
    local base_id="$_HS_C_ID" base_label="$_HS_C_LABEL" base_mode="$_HS_C_MODE"
    local user_dir="${HOME_SETTINGS_USER_THEMES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/themes}"
    local target_path="$user_dir/$slug.theme"
    if [ -e "$target_path" ] && [ "$force" -eq 0 ]; then
        echo "theme: custom theme file already exists: $target_path (use --force to overwrite)" >&2
        return 1
    fi
    local part="" cap="" label="" pascal="" rest_slug="$slug"
    while [ -n "$rest_slug" ]; do
        if [[ "$rest_slug" == *-* ]]; then
            part="${rest_slug%%-*}"
            rest_slug="${rest_slug#*-}"
        else
            part="$rest_slug"
            rest_slug=""
        fi
        if [ -n "$part" ]; then
            cap="${part:0:1}"
            case "$cap" in
                a) cap=A ;; b) cap=B ;; c) cap=C ;; d) cap=D ;; e) cap=E ;; f) cap=F ;;
                g) cap=G ;; h) cap=H ;; i) cap=I ;; j) cap=J ;; k) cap=K ;; l) cap=L ;;
                m) cap=M ;; n) cap=N ;; o) cap=O ;; p) cap=P ;; q) cap=Q ;; r) cap=R ;;
                s) cap=S ;; t) cap=T ;; u) cap=U ;; v) cap=V ;; w) cap=W ;; x) cap=X ;;
                y) cap=Y ;; z) cap=Z ;;
            esac
            label="${label:+$label }${cap}${part:1}"
            pascal="${pascal:+$pascal-}${cap}${part:1}"
        fi
    done
    local snake_slug="${slug//-/_}"
    local tmp_target="$target_path.tmp.$$.${BASHPID:-0}"
    if ! mkdir -p "$user_dir" 2>/dev/null || ! (
        cat > "$tmp_target" <<EOF
# Custom User Theme: $slug (based on $base_id)
THEME_ID="$slug"
THEME_LABEL="$label"
THEME_DESCRIPTION="Custom $base_mode theme based on $base_label"
THEME_MODE="$base_mode"
BAT_THEME_NAME="${pascal}-TrueColor"
BTOP_THEME_NAME="$snake_slug"
GHOSTTY_THEME_NAME="$label"

# Monotone Surface & Content Ramp
BASE03="$_HS_C_B03"
BASE02="$_HS_C_B02"
BASE04="$_HS_C_B04"
BASE01="$_HS_C_B01"
BASE00="$_HS_C_B00"
BASE0="$_HS_C_B0"
BASE1="$_HS_C_B1"
BASE2="$_HS_C_B2"
BASE3="$_HS_C_B3"

# Semantic Accent Palette
YELLOW="$_HS_C_YEL"
ORANGE="$_HS_C_ORA"
RED="$_HS_C_RED"
MAGENTA="$_HS_C_MAG"
VIOLET="$_HS_C_VIO"
BLUE="$_HS_C_BLU"
CYAN="$_HS_C_CYA"
GREEN="$_HS_C_GRN"

# Diff & Search Surface Tints
MIX_GREEN="$_HS_C_MGRN"
MIX_RED="$_HS_C_MRED"
MIX_YELLOW="$_HS_C_MYEL"
MIX_BLUE="$_HS_C_MBLU"
MIX_MAGENTA="$_HS_C_MMAG"
MIX_BASE1="$_HS_C_MB1"
EOF
    ) 2>/dev/null || ! mv -f "$tmp_target" "$target_path" 2>/dev/null; then
        rm -f "$tmp_target" 2>/dev/null || true
        echo "theme: cannot write custom theme file: $target_path" >&2
        return 1
    fi
    printf '%s\n' "$target_path"
    return 0
}

_hs_bash_render_preview() {
    local slug="${1:-}"
    (
        _hs_bash_resolve_slug_to_raw "$slug" || { echo "Error: unknown theme '$slug'." >&2; exit 1; }
        _hs_bash_finalize_palette "$slug"
        if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "linux" ]; then
            printf 'Theme: %s (%s) [%s]\n  bg=%s surface=%s fg=%s comment=%s\n  green=%s yellow=%s blue=%s cyan=%s magenta=%s violet=%s orange=%s red=%s\n' \
                "$_HS_C_LABEL" "$_HS_C_ID" "$_HS_C_MODE" "$_HS_C_B03" "$_HS_C_B02" "$_HS_C_B0" "$_HS_C_B01" \
                "$_HS_C_GRN" "$_HS_C_YEL" "$_HS_C_BLU" "$_HS_C_CYA" "$_HS_C_MAG" "$_HS_C_VIO" "$_HS_C_ORA" "$_HS_C_RED"
            exit 0
        fi
        local b03 b02 b01 b0 b1 yel ora red mag vio blu cya grn
        _hs_bash_rgb_semi "$_HS_C_B03"; b03="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_B02"; b02="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_B01"; b01="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_B0";  b0="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_B1";  b1="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_YEL"; yel="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_ORA"; ora="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_RED"; red="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_MAG"; mag="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_VIO"; vio="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_BLU"; blu="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_CYA"; cya="$REPLY"
        _hs_bash_rgb_semi "$_HS_C_GRN"; grn="$REPLY"
        printf '\033[48;2;%sm\033[38;2;%sm  %s (%s) [%s]  \033[0m\n' "$b02" "$b1" "$_HS_C_LABEL" "$_HS_C_ID" "$_HS_C_MODE"
        printf '\033[48;2;%sm  \033[38;2;%sm// Comment %s\033[0m\n' "$b03" "$b01" "$_HS_C_B01"
        printf '\033[48;2;%sm  \033[38;2;%smfunc\033[38;2;%sm \033[38;2;%smServe\033[38;2;%sm(port \033[38;2;%smint\033[38;2;%sm) { \033[38;2;%smif\033[38;2;%sm port == \033[38;2;%sm443\033[38;2;%sm { \033[38;2;%smreturn\033[38;2;%sm \033[38;2;%sm"tls"\033[38;2;%sm } }  \033[0m\n' \
            "$b03" "$grn" "$b0" "$blu" "$b0" "$grn" "$b0" "$yel" "$b0" "$mag" "$b0" "$yel" "$b0" "$cya" "$b0"
        printf '  \033[38;2;%sm██\033[0m GRN \033[38;2;%sm██\033[0m YEL \033[38;2;%sm██\033[0m BLU \033[38;2;%sm██\033[0m CYA \033[38;2;%sm██\033[0m MAG \033[38;2;%sm██\033[0m VIO \033[38;2;%sm██\033[0m ORA \033[38;2;%sm██\033[0m RED\n' \
            "$grn" "$yel" "$blu" "$cya" "$mag" "$vio" "$ora" "$red"
    )
}

_hs_bash_standalone_current_slug() {
    local hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/home-settings" cur=""
    if [ -r "$hs_dir/theme" ]; then
        IFS= read -r cur < "$hs_dir/theme" || true
        cur="${cur//$'\r'/}"
        _hs_bash_norm_slug "$cur"
        cur="$REPLY"
    fi
    if [ -z "$cur" ]; then
        cur="${_HS_LOADED_THEME:-${HOME_SETTINGS_THEME:-solarized-dark}}"
        _hs_bash_norm_slug "$cur"
        cur="${REPLY:-solarized-dark}"
    fi
    REPLY="$cur"
}

# Zero-dependency standalone theme manager (used when bin/theme is absent on 2-file remote servers)
_hs_bash_standalone_theme() {
    local act="" target="" base_name="solarized-dark" force=0 plain=0 no_live=0 dry_run=0 end_opts=0
    while [ $# -gt 0 ]; do
        if [ "$end_opts" -eq 0 ] && [ "$1" = "--" ]; then
            end_opts=1
            shift
            continue
        fi
        if [ "$end_opts" -eq 0 ]; then
            case "$1" in
                -h|--help)
                    cat <<'EOF'
Usage: theme [OPTIONS] [THEME_NAME]

Standalone Bash color theme manager (17 built-in + custom ${XDG_CONFIG_HOME:-$HOME/.config}/themes/*.{theme,conf}).

Options:
  -s, --set <NAME>       Apply theme <NAME>
  --holiday              Apply nearest upcoming or active US Holiday theme
  -l, --list             List all available themes
  --plain                Print theme slugs only (one per line)
  -c, --current          Print currently active theme slug
  -p, --preview [NAME]   Render a TrueColor palette preview
  --env [NAME]           Output shell export commands for [NAME]
  --create <NAME>        Create a custom user theme file
  --from <BASE>          Base theme when used with --create (default: solarized-dark)
  -f, --force            Overwrite existing custom theme file with --create
  --path                 Print user custom themes directory path
  --no-live              Write state without emitting live terminal OSC sequences
  -n, --dry-run [NAME]   Validate and preview target updates without modifying state
  -h, --help             Show this help message
EOF
                    return 0
                    ;;
                --path)
                    printf '%s\n' "${HOME_SETTINGS_USER_THEMES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/themes}"
                    return 0
                    ;;
                -c|--current)
                    act="current"
                    shift
                    continue
                    ;;
                -l|--list)
                    act="list"
                    shift
                    continue
                    ;;
                --plain)
                    plain=1
                    [ -z "$act" ] && act="list"
                    shift
                    continue
                    ;;
                --no-live)
                    no_live=1
                    shift
                    continue
                    ;;
                -f|--force)
                    force=1
                    shift
                    continue
                    ;;
                --holiday)
                    act="holiday"
                    shift
                    continue
                    ;;
                -n|--dry-run)
                    dry_run=1
                    if [ $# -ge 2 ] && [[ "${2:-}" != -* ]]; then
                        target="$2"
                        shift 2
                    else
                        shift
                    fi
                    continue
                    ;;
                --dry-run=*)
                    dry_run=1
                    target="${1#*=}"
                    shift
                    continue
                    ;;
                -p|--preview)
                    act="preview"
                    if [ $# -ge 2 ] && [[ "${2:-}" != -* ]]; then
                        target="$2"
                        shift 2
                    else
                        shift
                    fi
                    continue
                    ;;
                --preview=*)
                    act="preview"
                    target="${1#*=}"
                    shift
                    continue
                    ;;
                --env)
                    act="env"
                    if [ $# -ge 2 ] && [[ "${2:-}" != -* ]]; then
                        target="$2"
                        shift 2
                    else
                        shift
                    fi
                    continue
                    ;;
                --env=*)
                    act="env"
                    target="${1#*=}"
                    shift
                    continue
                    ;;
                --create)
                    if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                        echo "theme: option '--create' requires a new theme name" >&2
                        return 1
                    fi
                    act="create"
                    target="$2"
                    shift 2
                    continue
                    ;;
                --create=*)
                    act="create"
                    target="${1#*=}"
                    if [ -z "$target" ]; then
                        echo "theme: option '--create' requires a new theme name" >&2
                        return 1
                    fi
                    shift
                    continue
                    ;;
                --from)
                    if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                        echo "theme: option '--from' requires a base theme name" >&2
                        return 1
                    fi
                    base_name="$2"
                    shift 2
                    continue
                    ;;
                --from=*)
                    base_name="${1#*=}"
                    if [ -z "$base_name" ]; then
                        echo "theme: option '--from' requires a base theme name" >&2
                        return 1
                    fi
                    shift
                    continue
                    ;;
                -s|--set)
                    if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                        echo "Error: '$1' requires a theme name." >&2
                        return 1
                    fi
                    act="set"
                    target="$2"
                    shift 2
                    continue
                    ;;
                --set=*)
                    act="set"
                    target="${1#*=}"
                    if [ -z "$target" ]; then
                        echo "Error: '--set=' requires a theme name." >&2
                        return 1
                    fi
                    shift
                    continue
                    ;;
                -*)
                    echo "Error: unsupported option '$1' in standalone mode." >&2
                    return 1
                    ;;
            esac
        fi
        if [ -n "$target" ] || { [ -n "$act" ] && [ "$act" != "set" ] && [ "$act" != "preview" ] && [ "$act" != "env" ]; }; then
            echo "Error: unexpected argument '$1'." >&2
            return 1
        fi
        [ -z "$act" ] && act="set"
        target="$1"
        shift
    done

    _hs_bash_standalone_current_slug
    local current_slug="$REPLY"

    if [ "$act" = "current" ]; then
        printf '%s\n' "$current_slug"
        return 0
    fi

    if [ "$act" = "list" ]; then
        _hs_bash_list_themes "$current_slug" "$plain"
        return 0
    fi

    if [ "$act" = "create" ]; then
        _hs_bash_create_user_theme "$target" "$base_name" "$force"
        return $?
    fi

    if [ "$act" = "preview" ]; then
        [ -z "$target" ] && target="$current_slug"
        _hs_bash_render_preview "$target"
        return $?
    fi

    if [ "$act" = "env" ]; then
        [ -z "$target" ] && target="$current_slug"
        (
            _hs_bash_resolve_slug_to_raw "$target" || { echo "Error: unknown theme '$target'." >&2; exit 1; }
            _hs_bash_finalize_palette "$target"
            _hs_bash_emit_theme_env_sh
        )
        return $?
    fi

    if [ "$act" = "holiday" ]; then
        _hs_bash_nearest_holiday || return 1
        target="$REPLY"
        act="set"
    fi

    if [ "$dry_run" -eq 1 ] && { [ -n "$target" ] || { { [ ! -t 0 ] || [ ! -t 1 ]; } && [ "${THEME_FORCE_FZF:-0}" != "1" ]; }; }; then
        [ -z "$target" ] && target="$current_slug"
        (
            _hs_bash_resolve_slug_to_raw "$target" || { echo "Error: unknown theme '$target'." >&2; exit 1; }
            _hs_bash_finalize_palette "$target"
            local hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/home-settings"
            printf '[DRY-RUN] Theme: %s (%s, %s)\n  Would write: %s/active-theme.theme\n  Would write: %s/theme-env.sh\n  Would write: %s/theme\n' \
                "$_HS_C_ID" "$_HS_C_LABEL" "$_HS_C_MODE" "$hs_dir" "$hs_dir" "$hs_dir"
        )
        return $?
    fi

    if [ -z "$act" ] && [ -z "$target" ]; then
        if { [ -t 0 ] && [ -t 1 ]; } || [ "${THEME_FORCE_FZF:-0}" = "1" ]; then
            if command -v fzf >/dev/null 2>&1; then
                _hs_bash_collect_all_slugs
                local fzf_lines="" s act_tag src_kind disp_label strip
                for s in "${_HS_ALL_SLUGS[@]}"; do
                    _hs_bash_resolve_slug_to_raw "$s" || continue
                    src_kind="builtin"
                    [ -n "${_HS_RESOLVED_UFILE:-}" ] && src_kind="user"
                    _hs_bash_finalize_palette "$s"
                    act_tag="        "
                    [ "$s" = "$current_slug" ] && act_tag="(active)"
                    _hs_bash_swatch_strip
                    strip="$REPLY"
                    disp_label="$_HS_C_LABEL"
                    if _hs_bash_holiday_icon "$s"; then
                        disp_label="$REPLY $disp_label"
                    fi
                    local row=""
                    printf -v row '%-18s  %-8s  %-5s  %-7s  %s  %s\n' "$s" "$act_tag" "$_HS_C_MODE" "$src_kind" "$strip" "$disp_label"
                    fzf_lines="${fzf_lines}${row}"
                done
                if ! _hs_bash_resolve_slug_to_raw "$current_slug"; then
                    _hs_bash_builtin_spec "solarized-dark" && _hs_bash_unpack_spec_to_raw "solarized-dark" "$REPLY"
                fi
                _hs_bash_finalize_palette "$current_slug"
                local fzf_colors="--color=bg+:${_HS_C_B02},bg:${_HS_C_B03},spinner:${_HS_C_CYA},hl:${_HS_C_BLU},fg:${_HS_C_B0},header:${_HS_C_B01},info:${_HS_C_YEL},pointer:${_HS_C_CYA},marker:${_HS_C_GRN},fg+:${_HS_C_B1},prompt:${_HS_C_BLU},hl+:${_HS_C_BLU}"
                local -a preview_args=()
                if [ -n "${_HS_BASHRC_SELF_PATH:-}" ] && [ -r "$_HS_BASHRC_SELF_PATH" ]; then
                    local sq_bash="'${BASH//\'/\'\\\'\'}'"
                    local sq_self="'${_HS_BASHRC_SELF_PATH//\'/\'\\\'\'}'"
                    preview_args=(
                        "--preview=${sq_bash} -c '. \"\$1\" >/dev/null 2>&1 && _hs_bash_render_preview \"\$2\"' _ ${sq_self} {1}"
                        "--preview-window=right:60%:nowrap:noinfo"
                    )
                fi
                local picked="" fzf_rc=0
                picked="$(printf '%s' "$fzf_lines" | fzf --ansi --no-multi --reverse --height=80% --border=rounded --prompt="Theme > " --header="Select a color theme (Enter to apply, Esc to cancel)" ${preview_args[@]+"${preview_args[@]}"} "$fzf_colors")" || fzf_rc=$?
                if [ "$fzf_rc" -eq 130 ] || [ -z "$picked" ]; then
                    return 0
                fi
                if [ "$fzf_rc" -ne 0 ]; then
                    return "$fzf_rc"
                fi
                picked="${picked#"${picked%%[![:space:]]*}"}"
                if [[ "$picked" == "* "* ]]; then
                    picked="${picked#\* }"
                    picked="${picked#"${picked%%[![:space:]]*}"}"
                fi
                target="${picked%%[[:space:]]*}"
                act="set"
            else
                _hs_bash_list_themes "$current_slug" 0
                return 0
            fi
        else
            _hs_bash_list_themes "$current_slug" 0
            return 0
        fi
    fi

    if [ "$dry_run" -eq 1 ]; then
        [ -z "$target" ] && target="$current_slug"
        (
            _hs_bash_resolve_slug_to_raw "$target" || { echo "Error: unknown theme '$target'." >&2; exit 1; }
            _hs_bash_finalize_palette "$target"
            local hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/home-settings"
            printf '[DRY-RUN] Theme: %s (%s, %s)\n  Would write: %s/active-theme.theme\n  Would write: %s/theme-env.sh\n  Would write: %s/theme\n' \
                "$_HS_C_ID" "$_HS_C_LABEL" "$_HS_C_MODE" "$hs_dir" "$hs_dir" "$hs_dir"
        )
        return $?
    fi

    _hs_bash_norm_slug "$target"
    local norm_target="$REPLY"
    if [ -z "$norm_target" ] || ! ( _hs_bash_resolve_slug_to_raw "$norm_target" >/dev/null 2>&1 ); then
        echo "Error: unknown theme '$target'." >&2
        return 1
    fi

    _hs_bash_resolve_slug_to_raw "$norm_target" || return 1
    _hs_bash_finalize_palette "$norm_target"

    local hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/home-settings"
    local tmp_sfx="$$.${BASHPID:-0}"
    if ! mkdir -p "$hs_dir" 2>/dev/null || \
       ! ( _hs_bash_emit_active_theme_file > "$hs_dir/active-theme.theme.tmp.$tmp_sfx" ) 2>/dev/null || \
       ! mv -f "$hs_dir/active-theme.theme.tmp.$tmp_sfx" "$hs_dir/active-theme.theme" 2>/dev/null || \
       ! ( _hs_bash_emit_theme_env_sh > "$hs_dir/theme-env.sh.tmp.$tmp_sfx" ) 2>/dev/null || \
       ! mv -f "$hs_dir/theme-env.sh.tmp.$tmp_sfx" "$hs_dir/theme-env.sh" 2>/dev/null || \
       ! ( printf '%s\n' "$_HS_C_ID" > "$hs_dir/theme.tmp.$tmp_sfx" ) 2>/dev/null || \
       ! mv -f "$hs_dir/theme.tmp.$tmp_sfx" "$hs_dir/theme" 2>/dev/null; then
        rm -f "$hs_dir/active-theme.theme.tmp.$tmp_sfx" "$hs_dir/theme-env.sh.tmp.$tmp_sfx" "$hs_dir/theme.tmp.$tmp_sfx" 2>/dev/null || true
        echo "Error: cannot write theme state in '$hs_dir'." >&2
        return 1
    fi

    local applied_label="$_HS_C_LABEL" applied_id="$_HS_C_ID"
    unset HOME_SETTINGS_THEME_FILE
    _HS_USER_ENV_THEME=""
    _HS_USER_ENV_TFILE=""
    _HS_LAST_SEEN_TFILE="__UNSET__"
    _HS_LOADED_TFILE_RAW=""
    _HS_LOADED_TFILE_PATH=""
    _hs_bash_apply_finalized_palette
    local env_raw=""
    IFS= read -r -d '' env_raw < "$hs_dir/theme-env.sh" || true
    _HS_LOADED_ENV_RAW="$env_raw"
    _HS_LOADED_UFILE_RAW=""
    if [ -n "${_HS_RESOLVED_UFILE:-}" ] && [ -r "$_HS_RESOLVED_UFILE" ]; then
        IFS= read -r -d '' _HS_LOADED_UFILE_RAW < "$_HS_RESOLVED_UFILE" || true
    fi

    if [ "$no_live" -eq 0 ]; then
        _hs_bash_emit_live_osc
    fi
    _solarized_bash_prompt
    printf 'Applied theme: %s (%s)\n' "$applied_label" "$applied_id"
    return 0
}

# Color theme manager wrapper (`theme [name | options]`)
theme() {
    local theme_bin=""
    if [ -x "$HOME/.local/bin/theme" ]; then
        theme_bin="$HOME/.local/bin/theme"
    elif type -P theme >/dev/null 2>&1; then
        theme_bin="$(type -P theme)"
    else
        _hs_bash_standalone_theme "$@"
        return $?
    fi

    local is_query=0
    local arg
    for arg in "$@"; do
        case "$arg" in
            -l|--list|--plain|-c|--current|-p|--preview|--preview=*|--env|--env=*|--create|--create=*|--path|-n|--dry-run|--dry-run=*|-h|--help|--sync-assets)
                is_query=1
                break
                ;;
        esac
    done
    local has_target=0
    for arg in "$@"; do
        if [ "$arg" != "--no-live" ]; then
            has_target=1
            break
        fi
    done
    if [ "$has_target" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; } && [ "${THEME_FORCE_FZF:-0}" != "1" ]; then
        is_query=1
    fi

    local rc=0
    THEME_SHELL_WRAPPER=1 "$theme_bin" "$@" || rc=$?
    if [ "$rc" -eq 130 ]; then
        return 0
    fi
    if [ "$rc" -eq 0 ] && [ "$is_query" -eq 0 ]; then
        unset HOME_SETTINGS_THEME_FILE
        _HS_USER_ENV_THEME=""
        _HS_USER_ENV_TFILE=""
        _HS_LAST_SEEN_TFILE="__UNSET__"
        _HS_LOADED_TFILE_RAW=""
        _HS_LOADED_TFILE_PATH=""
        local hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/home-settings"
        if [ -r "$hs_dir/theme-env.sh" ]; then
            local env_raw=""
            IFS= read -r -d '' env_raw < "$hs_dir/theme-env.sh" || true
            _HS_LOADED_ENV_RAW="$env_raw"
            # shellcheck source=/dev/null
            . "$hs_dir/theme-env.sh"
            [[ "${LS_COLORS:-}" == *"38;2;"* ]] && _HS_LAST_TC_LS_COLORS="$LS_COLORS"
            _HS_INTERNAL_ENV_THEME="${HOME_SETTINGS_THEME:-}"
            if ! _hs_bash_is_truecolor && [[ "${LS_COLORS:-}" == *"38;2;"* ]]; then
                _hs_bash_apply_ansi_ls_colors
            fi
        fi
        _solarized_bash_prompt
    fi
    return "$rc"
}

_theme_bash_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]:-}"
    local prev="${COMP_WORDS[COMP_CWORD-1]:-}"
    local opts="-l --list --plain -c --current -s --set --holiday -p --preview --env --create --from -f --force --path --no-live -n --dry-run -h --help"
    local themes=""
    local theme_bin=""
    if [ -x "$HOME/.local/bin/theme" ]; then
        theme_bin="$HOME/.local/bin/theme"
    elif type -P theme >/dev/null 2>&1; then
        theme_bin="$(type -P theme)"
    fi
    if [ -n "$theme_bin" ]; then
        themes="$("$theme_bin" --list --plain 2>/dev/null || true)"
    fi
    if [ -z "$themes" ]; then
        _hs_bash_collect_all_slugs
        themes="${_HS_ALL_SLUGS[*]}"
    fi
    case "$prev" in
        -s|--set|-p|--preview|--env|--from|-n|--dry-run)
            # shellcheck disable=SC2207
            COMPREPLY=($(compgen -W "$themes" -- "$cur"))
            return 0
            ;;
    esac
    if [[ "$cur" == -* ]]; then
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    else
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "$themes $opts" -- "$cur"))
    fi
}
