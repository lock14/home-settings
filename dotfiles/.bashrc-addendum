                }

                if (color_mode == "none") {
                    s_rst = ""; s_bdr = ""; s_dim = ""; s_fg = ""; s_hl = ""
                    s_sel_bg = ""; s_sel_fg = ""; s_sel_hl = ""; s_sel_dim = ""
                    s_ptr = ""; s_prm = ""; s_inf = ""
                } else if (color_mode == "tc") {
                    s_rst = esc "[0m"
                    s_bdr = esc "[38;2;" c_b01 "m"
                    s_dim = s_bdr
                    s_fg = esc "[38;2;" c_b0 "m"
                    s_hl = esc "[38;2;" c_blu "m"
                    s_sel_bg = esc "[48;2;" c_b02 "m"
                    s_sel_fg = esc "[38;2;" c_b1 ";48;2;" c_b02 "m"
                    s_sel_hl = esc "[38;2;" c_blu ";48;2;" c_b02 "m"
                    s_sel_dim = esc "[38;2;" c_b01 ";48;2;" c_b02 "m"
                    s_ptr = esc "[38;2;" c_grn ";48;2;" c_b02 "m"
                    s_prm = esc "[38;2;" c_yel "m"
                    s_inf = esc "[38;2;" c_yel "m"
                } else {
                    s_rst = esc "[0m"
                    s_bdr = esc "[90m"
                    s_dim = s_bdr
                    s_fg = esc "[37m"
                    s_hl = esc "[36m"
                    s_sel_bg = esc "[40m"
                    s_sel_fg = esc "[97;40m"
                    s_sel_hl = esc "[36;40m"
                    s_sel_dim = esc "[90;40m"
                    s_ptr = esc "[32;40m"
                    s_prm = esc "[33m"
                    s_inf = esc "[33m"
                }

                h = item_rows + 3
                buf = esc "[?25l" esc "[?7l"
                if (prev_h + 0 == 0) {
                    buf = buf "\n\r"
                } else {
                    up = (cur_off + 0) - 1
                    if (up > 0) buf = buf esc "[" up "A\r"
                    else buf = buf "\r"
                }

                # Line 1: Top border with title/hints and match count
                cnt_lbl = " " match_cnt "/" total_cnt " "
                title_lbl = (cols >= 56) ? " History (Enter/Tab: place, Esc: cancel) " : " History "
                inner_top = cols - 2
                rem_top = inner_top - length(title_lbl) - length(cnt_lbl)
                if (rem_top < 0) {
                    title_lbl = ""
                    rem_top = inner_top - length(cnt_lbl)
                }
                if (rem_top < 0) {
                    cnt_lbl = ""
                    rem_top = inner_top
                }
                buf = buf s_bdr tl title_lbl rep_str(hbar, rem_top) s_inf cnt_lbl s_bdr tr s_rst "\n\r"

                # Line 2: Search query bar
                q_clean = q
                gsub(/[[:cntrl:]]/, " ", q_clean)
                q_avail = cols - 6
                if (q_avail < 1) q_avail = 1
                q_disp = clip_query_tail(q_clean, q_avail, ell)
                q_cur_col = 5 + q_shown_w
                if (q_cur_col > cols - 1) q_cur_col = cols - 1
                buf = buf s_bdr vbar s_rst " " s_prm q_sym s_fg q_disp s_rst esc "[K" esc "[" cols "G" s_bdr vbar s_rst "\n\r"

                # Lines 3 .. 2 + item_rows: History rows
                avail_item = cols - 6
                if (avail_item < 1) avail_item = 1
                for (r = 0; r < item_rows; r++) {
                    idx0 = win + r
                    if (match_cnt == 0 && r == 0) {
                        msg = (total_cnt == 0) ? "(history is empty)" : "(no matching history entries)"
                        if (length(msg) > avail_item) msg = substr(msg, 1, avail_item)
                        buf = buf s_bdr vbar s_rst "   " s_dim msg s_rst esc "[K" esc "[" cols "G" s_bdr vbar s_rst "\n\r"
                    } else if (idx0 < match_cnt) {
                        is_s = (idx0 == sel) ? 1 : 0
                        row_txt = render_item(m_raw[idx0 + 1], is_s, avail_item)
                        if (is_s) {
                            buf = buf s_bdr vbar s_sel_bg " " s_ptr ptr " " row_txt s_sel_bg esc "[K" esc "[" cols "G" s_rst s_bdr vbar s_rst "\n\r"
                        } else {
                            buf = buf s_bdr vbar s_rst "   " row_txt s_rst esc "[K" esc "[" cols "G" s_bdr vbar s_rst "\n\r"
                        }
                    } else {
                        buf = buf s_bdr vbar s_rst esc "[K" esc "[" cols "G" s_bdr vbar s_rst "\n\r"
                    }
                }

                # Line h: Clear from col 1 to end of screen (wiping leftover rows after shrink without scrolling), then draw bottom border
                buf = buf esc "[J" s_bdr bl rep_str(hbar, cols - 2) br s_rst

                # Park visible cursor right after query on Line 2 (h - 2 lines above Line h)
                up_q = h - 2
                if (up_q > 0) buf = buf esc "[" up_q "A"
                buf = buf esc "[" q_cur_col "G" esc "[?7h" esc "[?25h"

                printf "%s", buf > frame_out
                close(frame_out)
            }
        ' "$tmp_idx"

        local meta_hdr=""
        {
            IFS= read -r meta_hdr || true
            IFS= read -r sel_raw || true
        } < "$tmp_meta"
        if [ -n "$meta_hdr" ]; then
            sel_idx="${meta_hdr%% *}"
            local rest_m="${meta_hdr#* }"
            win_start="${rest_m%% *}"
            match_cnt="${rest_m##* }"
        fi

        if [ "$do_paint" -eq 1 ]; then
            local frame_data=""
            IFS= read -r -d '' frame_data < "$tmp_frame" || true
            printf '%s' "$frame_data" >/dev/tty
            prev_h=$((item_rows + 3))
            cursor_off=2
        fi
    }

    _hs_drawer_read_byte() {
        local allow_winch="${1:-0}"
        REPLY=""
        if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
            local k="" rc=0 cur_sz=""
            while true; do
                k=""
                rc=0
                LC_ALL=C IFS= read -r -d '' -n 1 -t 0.25 k </dev/tty || rc=$?
                if [ "$rc" -eq 0 ]; then
                    REPLY="$k"
                    return 0
                fi
                if [ "$allow_winch" -eq 1 ]; then
                    if [ "$winch_flag" -eq 1 ]; then
                        return 2
                    fi
                    if [ "$rc" -gt 128 ]; then
                        cur_sz="$(stty size </dev/tty || printf '%s %s' "$tty_rows" "$tty_cols")"
                        if [ "$cur_sz" != "$tty_rows $tty_cols" ]; then
                            winch_flag=1
                            return 2
                        fi
                    fi
                fi
                if [ "$rc" -gt 128 ]; then
                    continue
                fi
                return 1
            done
        else
            local raw=""
            raw="$(dd bs=1 count=1 </dev/tty 2>/dev/null; printf x)" || {
                [ "$allow_winch" -eq 1 ] && [ "$winch_flag" -eq 1 ] && return 2
                return 1
            }
            raw="${raw%x}"
            if [ -z "$raw" ]; then
                [ "$allow_winch" -eq 1 ] && [ "$winch_flag" -eq 1 ] && return 2
                return 1
            fi
            REPLY="$raw"
            return 0
        fi
    }

    _hs_drawer_read_esc_byte() {
        REPLY=""
        if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
            local k=""
            if LC_ALL=C IFS= read -r -d '' -n 1 -t 0.05 k </dev/tty; then
                REPLY="$k"
                return 0
            fi
            return 1
        else
            local raw=""
            stty min 0 time 1 </dev/tty
            raw="$(dd bs=1 count=1 </dev/tty 2>/dev/null; printf x)" || true
            stty min 1 time 0 </dev/tty
            raw="${raw%x}"
            [ -n "$raw" ] || return 1
            REPLY="$raw"
            return 0
        fi
    }

    local dirty=0 has_pushed=0 pushed_byte=""
    _hs_drawer_eval 1

    while true; do
        if [ "$winch_flag" -eq 1 ]; then
            winch_flag=0
            _hs_drawer_eval 1
        fi
        local ch=""
        if [ "$has_pushed" -eq 1 ]; then
            ch="$pushed_byte"
            has_pushed=0
            pushed_byte=""
        else
            if [ "$dirty" -eq 1 ]; then
                _hs_drawer_eval 1
                dirty=0
            fi
            local rb_rc=0
            _hs_drawer_read_byte 1 || rb_rc=$?
            if [ "$rb_rc" -eq 2 ] || { [ "$rb_rc" -ne 0 ] && [ "$winch_flag" -eq 1 ]; }; then
                continue
            elif [ "$rb_rc" -ne 0 ]; then
                exit 130
            fi
            ch="$REPLY"
        fi

        local ord=0
        if [ -n "$ch" ]; then
            LC_ALL=C printf -v ord '%d' "'$ch"
        fi

        case "$ord" in
            3|7)
                # Ctrl+c or Ctrl+g: cancel cleanly without mutating READLINE_LINE
                exit 130
                ;;
            4)
                # Ctrl+d: cancel when query is empty
                [ -z "$query" ] && exit 130
                ;;
            9|10|13)
                # Tab, LF, or CR: flush any dirty query, then place selection without auto-executing
                if [ "$dirty" -eq 1 ]; then
                    sel_idx=0
                    win_start=0
                    _hs_drawer_eval 0
                    dirty=0
                fi
                if [ "$match_cnt" -gt 0 ] && [ -n "$sel_raw" ]; then
                    local final_cmd="${sel_raw//$'\034'/$'\n'}"
                    printf '%s' "$final_cmd" >&3
                    exit 0
                elif [ -n "$query" ]; then
                    printf '%s' "$query" >&3
                    exit 0
                fi
                exit 130
                ;;
            14|18)
                # Ctrl+n or Ctrl+r: next older match (down)
                if [ "$dirty" -eq 1 ]; then
                    sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                fi
                sel_idx=$((sel_idx + 1))
                _hs_drawer_eval 1
                ;;
            16|19)
                # Ctrl+p or Ctrl+s: previous newer match (up)
                if [ "$dirty" -eq 1 ]; then
                    sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                fi
                [ "$sel_idx" -gt 0 ] && sel_idx=$((sel_idx - 1))
                _hs_drawer_eval 1
                ;;
            21)
                # Ctrl+u: clear query
                if [ -n "$query" ]; then
                    query=""
                    sel_idx=0
                    win_start=0
                    dirty=1
                fi
                ;;
            23)
                # Ctrl+w: delete previous word
                if [ -n "$query" ]; then
                    local trimmed="${query%"${query##*[![:space:]]}"}"
                    local last_word="${trimmed##*[[:space:]]}"
                    query="${trimmed%"$last_word"}"
                    sel_idx=0
                    win_start=0
                    dirty=1
                fi
                ;;
            8|127)
                # Backspace
                if [ -n "$query" ]; then
                    _hs_bash_utf8_pop_char "$query"
                    query="$REPLY"
                    sel_idx=0
                    win_start=0
                    dirty=1
                fi
                ;;
            27)
                # ESC or CSI/SS3/bracketed-paste sequence
                if ! _hs_drawer_read_esc_byte; then
                    exit 130
                fi
                local e1="$REPLY"
                if [ "$e1" = "[" ] || [ "$e1" = "O" ]; then
                    if ! _hs_drawer_read_esc_byte; then
                        exit 130
                    fi
                    local seq="$REPLY"
                    if [ "$e1" = "[" ]; then
                        case "$seq" in
                            [0-9])
                                while _hs_drawer_read_esc_byte; do
                                    seq="${seq}${REPLY}"
                                    case "$REPLY" in
                                        [~A-Za-z]) break ;;
                                    esac
                                done
                                ;;
                        esac
                    fi
                    case "${e1}${seq}" in
                        "[A"|"OA")
                            if [ "$dirty" -eq 1 ]; then
                                sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                            fi
                            [ "$sel_idx" -gt 0 ] && sel_idx=$((sel_idx - 1))
                            _hs_drawer_eval 1
                            ;;
                        "[B"|"OB")
                            if [ "$dirty" -eq 1 ]; then
                                sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                            fi
                            sel_idx=$((sel_idx + 1))
                            _hs_drawer_eval 1
                            ;;
                        "[5~")
                            if [ "$dirty" -eq 1 ]; then
                                sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                            fi
                            sel_idx=$((sel_idx - item_rows))
                            [ "$sel_idx" -lt 0 ] && sel_idx=0
                            _hs_drawer_eval 1
                            ;;
                        "[6~")
                            if [ "$dirty" -eq 1 ]; then
                                sel_idx=0; win_start=0; _hs_drawer_eval 0; dirty=0
                            fi
                            sel_idx=$((sel_idx + item_rows))
                            _hs_drawer_eval 1
                            ;;
                        "[200~")
                            # Bracketed paste: accumulate until \e[201~ without treating embedded newlines as Enter
                            local paste_buf=""
                            while _hs_drawer_read_byte; do
                                [ "$REPLY" = $'\003' ] && exit 130
                                paste_buf="${paste_buf}${REPLY}"
                                if [[ "$paste_buf" == *$'\033[201~' ]]; then
                                    paste_buf="${paste_buf%$'\033[201~'}"
                                    break
                                fi
                            done
                            paste_buf="${paste_buf//$'\r'/ }"
                            paste_buf="${paste_buf//$'\n'/ }"
                            paste_buf="${paste_buf//$'\t'/ }"
                            if [ -n "$paste_buf" ]; then
                                query="${query}${paste_buf}"
                                sel_idx=0
                                win_start=0
                                dirty=1
                            fi
                            ;;
                    esac
                fi
                ;;
            *)
                if [ "$ord" -ge 32 ]; then
                    query="${query}${ch}"
                    sel_idx=0
                    win_start=0
                    dirty=1
                    if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
                        local nk="" nord=0
                        while LC_ALL=C IFS= read -r -d '' -n 1 -t 0.002 nk </dev/tty; do
                            nord=0
                            [ -n "$nk" ] && LC_ALL=C printf -v nord '%d' "'$nk"
                            if [ "$nord" -ge 32 ] && [ "$nord" -ne 127 ]; then
                                query="${query}${nk}"
                            else
                                has_pushed=1
                                pushed_byte="$nk"
                                break
                            fi
                        done
                    fi
                fi
                ;;
        esac
    done
)

_hs_bash_history_widget() {
    local picked=""
    if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
        if picked="$(_hs_bash_history_drawer "${READLINE_LINE:-}")"; then
            READLINE_LINE="$picked"
            READLINE_POINT=2147483647
        fi
    else
        if picked="$(_hs_bash_history_drawer "")" && [ -n "$picked" ]; then
            local HISTCONTROL="" HISTIGNORE="" HISTTIMEFORMAT="" _hs_hnum=""
            builtin history -s -- "$picked"
            _hs_hnum="$(builtin history 1)"
            _hs_hnum="${_hs_hnum#"${_hs_hnum%%[! ]*}"}"
            _hs_hnum="${_hs_hnum%%[!0-9]*}"
            if [ -n "$_hs_hnum" ]; then
                builtin bind -m emacs-standard "\"\C-x\C-r2\": \"\e${_hs_hnum}\C-x\C-r0\C-e\""
                builtin bind -m vi-command "\"\C-x\C-r2\": \"${_hs_hnum}\C-x\C-r0A\""
                builtin bind -m vi-insert "\"\C-x\C-r2\": \"\e${_hs_hnum}\C-x\C-r0A\""
                return 0
            fi
        fi
        builtin bind -m emacs-standard '"\C-x\C-r2": "\C-x\C-r9"'
        builtin bind -m vi-command '"\C-x\C-r2": "\C-x\C-r9"'
        builtin bind -m vi-insert '"\C-x\C-r2": "\C-x\C-r9"'
    fi
}

if [[ "$-" == *i* ]]; then
    [ -t 0 ] && stty -ixon
    shopt -s histappend checkwinsize cdspell cmdhist histverify
    if (( BASH_VERSINFO[0] >= 4 )); then
        shopt -s autocd dirspell
    fi

    if [[ -o emacs || -o vi ]]; then
        [ -z "${_HS_RL_VARS:-}" ] && _HS_RL_VARS="$(builtin bind -v)"
        [[ "$_HS_RL_VARS" == *"completion-ignore-case"* ]] && builtin bind 'set completion-ignore-case on'
        [[ "$_HS_RL_VARS" == *"show-all-if-ambiguous"* ]] && builtin bind 'set show-all-if-ambiguous on'
        if [[ "$_HS_RL_VARS" == *"colored-stats"* ]]; then
            if [ -n "${NO_COLOR:-}" ]; then
                builtin bind 'set colored-stats off'
            else
                builtin bind 'set colored-stats on'
            fi
        fi
        [[ "$_HS_RL_VARS" == *"colored-completion-prefix"* ]] && builtin bind 'set colored-completion-prefix off'
        [[ "$_HS_RL_VARS" == *"revert-all-at-newline"* ]] && builtin bind 'set revert-all-at-newline on'
        [[ "$_HS_RL_VARS" == *"search-ignore-case"* ]] && builtin bind 'set search-ignore-case on'
        _hs_bash_refresh_readline_region

        for _hs_km in emacs-standard vi-insert vi-command; do
            builtin bind -m "$_hs_km" '"\e[A": history-search-backward'
            builtin bind -m "$_hs_km" '"\e[B": history-search-forward'
            builtin bind -m "$_hs_km" '"\eOA": history-search-backward'
            builtin bind -m "$_hs_km" '"\eOB": history-search-forward'
        done
        unset _hs_km
    fi

    # shellcheck disable=SC2128,SC2178
    if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
        if [[ " ${PROMPT_COMMAND[*]:-} " != *" _solarized_bash_prompt "* ]]; then
            PROMPT_COMMAND=("_solarized_bash_prompt" ${PROMPT_COMMAND[@]+"${PROMPT_COMMAND[@]}"})
        fi
    elif [[ ";${PROMPT_COMMAND:-};" != *";_solarized_bash_prompt;"* ]]; then
        PROMPT_COMMAND="_solarized_bash_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    fi
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

if [[ "$-" == *i* ]]; then
    _hs_fzf_bound=0
    if command -v fzf >/dev/null 2>&1; then
        if fzf --bash >/dev/null 2>&1; then
            eval "$(fzf --bash)"
            _hs_fzf_bound=1
        else
            for _hs_fzf_dir in \
                "$HOME/.fzf/shell" \
                /opt/homebrew/opt/fzf/shell \
                /usr/local/opt/fzf/shell \
                /usr/share/fzf/shell \
                /usr/share/fzf \
                /usr/share/doc/fzf/examples; do
                if [ -f "$_hs_fzf_dir/key-bindings.bash" ]; then
                    # shellcheck source=/dev/null
                    source "$_hs_fzf_dir/key-bindings.bash"
                    # shellcheck source=/dev/null
                    [ -f "$_hs_fzf_dir/completion.bash" ] && source "$_hs_fzf_dir/completion.bash" || true
                    _hs_fzf_bound=1
                    break
                fi
            done
            unset _hs_fzf_dir
        fi
    fi
    if [ "$_hs_fzf_bound" -eq 0 ] && [[ -o emacs || -o vi ]] && [ "${HOME_SETTINGS_BASH_CTRL_R:-}" != "native" ]; then
        if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
            for _hs_km in emacs-standard vi-insert vi-command; do
                builtin bind -m "$_hs_km" -x '"\C-r": _hs_bash_history_widget'
            done
            unset _hs_km
        else
            builtin bind -m emacs-standard '"\C-x\C-r0": fetch-history'
            builtin bind -m emacs-standard '"\C-x\C-r9": redraw-current-line'
            builtin bind -m vi-command '"\C-x\C-r0": fetch-history'
            builtin bind -m vi-command '"\C-x\C-r9": redraw-current-line'
            builtin bind -m vi-insert '"\C-x\C-r9": redraw-current-line'
            for _hs_km in emacs-standard vi-insert vi-command; do
                builtin bind -m "$_hs_km" -x '"\C-x\C-r1": _hs_bash_history_widget'
                builtin bind -m "$_hs_km" '"\C-r": "\C-x\C-r1\C-x\C-r2"'
            done
            unset _hs_km
        fi
    fi
    unset _hs_fzf_bound
fi

