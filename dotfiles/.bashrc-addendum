#!/bin/bash
# Bash Addendum & Modular Shell Orchestrator (Bash 3.2+ compatible)
# Resolves shared and Bash-specific modules from dotfiles/.config/shell first,
# falling back to ${XDG_CONFIG_HOME:-$HOME/.config}/shell.

# 1. Reset prior theme session state and capture caller overrides
_HS_CALLER_COLORTERM_SET="${COLORTERM+1}"
_HS_CALLER_COLORTERM_VAL="${COLORTERM:-}"
_HS_CALLER_THEME_PRE="${HOME_SETTINGS_THEME:-}"
_HS_CALLER_TFILE_PRE="${HOME_SETTINGS_THEME_FILE:-}"
if [ -n "${_HS_LOADED_THEME:-}" ]; then
    unset HOME_SETTINGS_THEME_MODE BAT_THEME FZF_DEFAULT_OPTS EZA_COLORS EXA_COLORS JQ_COLORS LS_COLORS \
        LESS_TERMCAP_mb LESS_TERMCAP_md LESS_TERMCAP_me LESS_TERMCAP_so LESS_TERMCAP_se LESS_TERMCAP_us LESS_TERMCAP_ue
fi
unset _HS_LOADED_THEME _HS_LOADED_ENV_RAW _HS_LOADED_UFILE_RAW _HS_LOADED_TFILE_RAW _HS_LOADED_TFILE_PATH _HS_INTERNAL_ENV_THEME _HS_USER_ENV_THEME _HS_USER_ENV_TFILE _HS_POST_SOURCE_SYNC _HS_LAST_SEEN_TFILE _HS_LAST_TC_LS_COLORS \
    _HS_PROMPT_OS_ICON _HS_PROMPT_BG_BASE02 _HS_PROMPT_CAP_BASE02 _HS_PROMPT_CAP_RED \
    _HS_PROMPT_FG_BASE02 _HS_PROMPT_FG_BASE01 _HS_PROMPT_FG_BASE00 _HS_PROMPT_FG_BASE0 _HS_PROMPT_FG_BASE1 \
    _HS_PROMPT_FG_YELLOW _HS_PROMPT_FG_ORANGE _HS_PROMPT_FG_RED _HS_PROMPT_FG_VIOLET _HS_PROMPT_FG_BLUE _HS_PROMPT_FG_CYAN _HS_PROMPT_FG_GREEN \
    _HS_ESC_ORANGE _HS_ESC_BLUE _HS_ESC_CYAN _HS_ESC_BASE0 _HS_ESC_BASE01 \
    _SOLARIZED_PROMPT_OS_ICON_CACHED _SOLARIZED_PROMPT_OSTYPE_CACHED _HS_RL_VARS _HS_LAST_RL_REGION_SPEC

# 2. Resolve physical script path, repository root, and modular shell directory (zero unnecessary forks)
_HS_BASHRC_SELF_PATH=""
_HS_BASHRC_REPO_ROOT=""
_hs_resolved_shell_dir=""
if [ -n "${BASH_SOURCE[0]:-}" ]; then
    _hs_src="${BASH_SOURCE[0]}"
    case "$_hs_src" in
        /*) _HS_BASHRC_SELF_PATH="$_hs_src" ;;
        *)
            _hs_sdir="${_hs_src%/*}"
            [ "$_hs_sdir" = "$_hs_src" ] && _hs_sdir="."
            if _hs_abs_dir="$(cd "$_hs_sdir" 2>/dev/null && pwd -P)"; then
                _HS_BASHRC_SELF_PATH="$_hs_abs_dir/${_hs_src##*/}"
                _hs_src="$_HS_BASHRC_SELF_PATH"
            fi
            ;;
    esac
    if [ -L "$_hs_src" ] && command -v readlink >/dev/null 2>&1; then
        while [ -L "$_hs_src" ]; do
            _hs_dir="${_hs_src%/*}"
            [ "$_hs_dir" = "$_hs_src" ] && _hs_dir="."
            _hs_link="$(readlink "$_hs_src" 2>/dev/null || true)"
            [ -n "$_hs_link" ] || break
            case "$_hs_link" in
                /*) _hs_src="$_hs_link" ;;
                *)  _hs_src="$_hs_dir/$_hs_link" ;;
            esac
        done
    fi
    _hs_dir="${_hs_src%/*}"
    [ "$_hs_dir" = "$_hs_src" ] && _hs_dir="."
    if [ -d "$_hs_dir/.config/shell" ]; then
        _hs_resolved_shell_dir="$_hs_dir/.config/shell"
    fi
    if [ -d "$_hs_dir/../colors/themes" ]; then
        _HS_BASHRC_REPO_ROOT="${_hs_dir%/dotfiles}"
        if [ ! -d "$_HS_BASHRC_REPO_ROOT/colors/themes" ]; then
            _HS_BASHRC_REPO_ROOT="$(cd -P "$_hs_dir/.." 2>/dev/null && pwd || true)"
        fi
    fi
    unset _hs_src _hs_sdir _hs_abs_dir _hs_dir _hs_link
fi
if [ -z "$_hs_resolved_shell_dir" ]; then
    if [ -n "${_HS_SHELL_DIR:-}" ] && [ -d "$_HS_SHELL_DIR" ]; then
        _hs_resolved_shell_dir="$_HS_SHELL_DIR"
    elif [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/shell" ]; then
        _hs_resolved_shell_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
    elif [ -d "$HOME/.config/shell" ]; then
        _hs_resolved_shell_dir="$HOME/.config/shell"
    fi
fi
[ -n "$_hs_resolved_shell_dir" ] && _HS_SHELL_DIR="$_hs_resolved_shell_dir"
unset _hs_resolved_shell_dir

# 3. Environment variables & history defaults
if [ -f "$HOME/.environment-variables" ]; then
    # shellcheck source=/dev/null
    source "$HOME/.environment-variables"
    if [ -n "$_HS_CALLER_COLORTERM_SET" ]; then
        export COLORTERM="$_HS_CALLER_COLORTERM_VAL"
    fi
elif [ -n "${_HS_SHELL_DIR:-}" ] && [ -r "$_HS_SHELL_DIR/env-defaults.sh" ]; then
    _HS_ENV_PRESERVE_EXISTING=1
    # shellcheck source=/dev/null
    source "$_HS_SHELL_DIR/env-defaults.sh"
    unset _HS_ENV_PRESERVE_EXISTING
else
    [ -z "$_HS_CALLER_COLORTERM_SET" ] && export COLORTERM="truecolor" || export COLORTERM="$_HS_CALLER_COLORTERM_VAL"
    export FORCE_HYPERLINK="${FORCE_HYPERLINK:-1}"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
    export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"
    export GOCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/go-build"
    case ":$PATH:" in *":$GOPATH/bin:"*) ;; *) export PATH="$GOPATH/bin:$PATH" ;; esac
    if command -v nvim >/dev/null 2>&1; then export EDITOR=nvim
    elif command -v vim >/dev/null 2>&1; then export EDITOR=vim
    else export EDITOR=vi; fi
    export VISUAL="$EDITOR"
fi

case "${HISTSIZE-}" in
    ""|500|1000|2000) export HISTSIZE=50000 ;;
    *) export HISTSIZE ;;
esac
case "${HISTFILESIZE-}" in
    ""|500|1000|2000) export HISTFILESIZE=100000 ;;
    *) export HISTFILESIZE ;;
esac
case "${HISTCONTROL-}" in
    ""|ignoredups|ignoreboth|ignoredups:ignorespace|ignorespace:ignoredups)
        export HISTCONTROL="ignoreboth:erasedups"
        ;;
    *)
        export HISTCONTROL
        ;;
esac

# 4. Load modular palette, aliases, shared functions, VCS prompt, theme CLI, completions, & Ctrl+r drawer
if [ -n "${_HS_SHELL_DIR:-}" ] && [ -r "$_HS_SHELL_DIR/bash-palette.sh" ]; then
    # shellcheck source=/dev/null
    source "$_HS_SHELL_DIR/bash-palette.sh"
    unset _HS_LOADED_ENV_RAW _HS_LOADED_UFILE_RAW _HS_LOADED_TFILE_RAW _HS_LOADED_TFILE_PATH
    _hs_bash_sync_theme_state 1
    if ! _hs_bash_is_truecolor || [ -z "${_HS_LOADED_THEME:-}" ] || [ -z "${LS_COLORS:-}" ]; then
        _hs_bash_apply_ansi_ls_colors
    fi
fi
unset _HS_CALLER_COLORTERM_SET _HS_CALLER_COLORTERM_VAL _HS_CALLER_THEME_PRE _HS_CALLER_TFILE_PRE

if [ -f "$HOME/.aliases" ]; then
    # shellcheck source=/dev/null
    source "$HOME/.aliases"
elif [ -n "${_HS_SHELL_DIR:-}" ] && [ -r "$_HS_SHELL_DIR/aliases-core.sh" ]; then
    # shellcheck source=/dev/null
    source "$_HS_SHELL_DIR/aliases-core.sh"
fi
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'

if [ -n "${_HS_SHELL_DIR:-}" ]; then
    for _hs_bmod in \
        functions.sh \
        bash-vcs-prompt.sh \
        bash-theme-cli.sh \
        terraform-flags.sh \
        bash-completions.sh \
        bash-history-drawer.sh; do
        if [ -r "$_HS_SHELL_DIR/$_hs_bmod" ]; then
            # shellcheck source=/dev/null
            source "$_HS_SHELL_DIR/$_hs_bmod"
        fi
    done
    unset _hs_bmod
fi

if ! declare -F _solarized_bash_prompt >/dev/null 2>&1; then
    _solarized_bash_prompt() { PS1='\u@\h:\w\$ '; }
fi

_solarized_bash_prompt
_HS_POST_SOURCE_SYNC=1

# 5. Interactive Readline hardening, Mise/Zoxide hooks, PROMPT_COMMAND, & FZF / Ctrl+r drawer binding
if [[ "$-" == *i* ]]; then
    [ -t 0 ] && stty -ixon
    shopt -s histappend checkwinsize cdspell cmdhist histverify
    if (( BASH_VERSINFO[0] >= 4 )); then
        shopt -s autocd dirspell
    fi

    if [[ -o emacs || -o vi ]]; then
        [ -z "${_HS_RL_VARS:-}" ] && _HS_RL_VARS="$(builtin bind -v)"
        [[ "$_HS_RL_VARS" == *"completion-ignore-case"* ]] && builtin bind 'set completion-ignore-case on'
        [[ "$_HS_RL_VARS" == *"show-all-if-ambiguous"* ]] && builtin bind 'set show-all-if-ambiguous on'
        if [[ "$_HS_RL_VARS" == *"colored-stats"* ]]; then
            if [ -n "${NO_COLOR:-}" ]; then
                builtin bind 'set colored-stats off'
            else
                builtin bind 'set colored-stats on'
            fi
        fi
        [[ "$_HS_RL_VARS" == *"colored-completion-prefix"* ]] && builtin bind 'set colored-completion-prefix off'
        [[ "$_HS_RL_VARS" == *"revert-all-at-newline"* ]] && builtin bind 'set revert-all-at-newline on'
        [[ "$_HS_RL_VARS" == *"search-ignore-case"* ]] && builtin bind 'set search-ignore-case on'
        declare -F _hs_bash_refresh_readline_region >/dev/null 2>&1 && _hs_bash_refresh_readline_region

        for _hs_km in emacs-standard vi-insert vi-command; do
            builtin bind -m "$_hs_km" '"\e[A": history-search-backward'
            builtin bind -m "$_hs_km" '"\e[B": history-search-forward'
            builtin bind -m "$_hs_km" '"\eOA": history-search-backward'
            builtin bind -m "$_hs_km" '"\eOB": history-search-forward'
        done
        unset _hs_km
    fi
fi

# Mise runtime manager hook (activated ahead of zoxide so zoxide resolves directly without shim overhead)
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# Zoxide smart directory jumping (z)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if [[ "$-" == *i* ]]; then
    _hs_pc_is_arr=0
    if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1) )); then
        eval '_hs_pc_attr="${PROMPT_COMMAND@a}"'
        [[ "${_hs_pc_attr:-}" == *a* ]] && _hs_pc_is_arr=1
        unset _hs_pc_attr
    fi
    # shellcheck disable=SC2128,SC2178
    if [ "$_hs_pc_is_arr" -eq 1 ]; then
        _hs_pc=("_solarized_bash_prompt")
        for _hs_pc_item in ${PROMPT_COMMAND[@]+"${PROMPT_COMMAND[@]}"}; do
            if [ -n "$_hs_pc_item" ] && [ "$_hs_pc_item" != "_solarized_bash_prompt" ]; then
                _hs_pc+=("$_hs_pc_item")
            fi
        done
        PROMPT_COMMAND=("${_hs_pc[@]}")
        unset _hs_pc _hs_pc_item
    else
        _hs_pc_rest=""
        _hs_pc_raw="${PROMPT_COMMAND:-}"
        while [ -n "$_hs_pc_raw" ]; do
            if [[ "$_hs_pc_raw" == *";"* ]]; then
                _hs_pc_item="${_hs_pc_raw%%;*}"
                _hs_pc_raw="${_hs_pc_raw#*;}"
            else
                _hs_pc_item="$_hs_pc_raw"
                _hs_pc_raw=""
            fi
            _hs_pc_trim="${_hs_pc_item#"${_hs_pc_item%%[![:space:]]*}"}"
            _hs_pc_trim="${_hs_pc_trim%"${_hs_pc_trim##*[![:space:]]}"}"
            if [ -n "$_hs_pc_trim" ] && [ "$_hs_pc_trim" != "_solarized_bash_prompt" ]; then
                _hs_pc_rest="${_hs_pc_rest:+$_hs_pc_rest;}$_hs_pc_trim"
            fi
        done
        PROMPT_COMMAND="_solarized_bash_prompt${_hs_pc_rest:+;$_hs_pc_rest}"
        unset _hs_pc_rest _hs_pc_raw _hs_pc_item _hs_pc_trim
    fi
    unset _hs_pc_is_arr

    _hs_fzf_bound=0
    if declare -F _hs_init_fzf >/dev/null 2>&1 && _hs_init_fzf bash; then
        _hs_fzf_bound=1
    fi
    if [ "$_hs_fzf_bound" -eq 0 ] && [[ -o emacs || -o vi ]] && [ "${HOME_SETTINGS_BASH_CTRL_R:-}" != "native" ] && declare -F _hs_bash_history_widget >/dev/null 2>&1; then
        if [ "${_HS_BASH_FORCE_LEGACY_CTRL_R:-0}" != "1" ] && (( BASH_VERSINFO[0] >= 4 )); then
            for _hs_km in emacs-standard vi-insert vi-command; do
                builtin bind -m "$_hs_km" -x '"\C-r": _hs_bash_history_widget'
            done
            unset _hs_km
        else
            builtin bind -m emacs-standard '"\C-x\C-r0": fetch-history'
            builtin bind -m emacs-standard '"\C-x\C-r9": redraw-current-line'
            builtin bind -m vi-command '"\C-x\C-r0": fetch-history'
            builtin bind -m vi-command '"\C-x\C-r9": redraw-current-line'
            builtin bind -m vi-insert '"\C-x\C-r9": redraw-current-line'
            for _hs_km in emacs-standard vi-insert vi-command; do
                builtin bind -m "$_hs_km" -x '"\C-x\C-r1": _hs_bash_history_widget'
                builtin bind -m "$_hs_km" '"\C-r": "\C-x\C-r1\C-x\C-r2"'
            done
            unset _hs_km
        fi
    fi
    unset _hs_fzf_bound
fi
