_hs_bash_utf8_pop_char() {
    local s="${1:-}" len b ch
    len="${#s}"
    [ "$len" -eq 0 ] && { REPLY=""; return 0; }
    local LC_ALL=C
    len="${#s}"
    local cut=1
    while [ "$cut" -lt "$len" ] && [ "$cut" -lt 4 ]; do
        ch="${s:len-cut:1}"
        printf -v b '%d' "'$ch"
        if [ "$b" -ge 128 ] && [ "$b" -le 191 ]; then
            cut=$((cut + 1))
        else
            break
        fi
    done
    REPLY="${s:0:len-cut}"
}

_hs_bash_hist_build_index() {
    local mode="${1:-fast}"
    if [ -z "$(builtin history 1)" ]; then
        return 0
    fi
    if [ "$mode" = "full" ]; then
        builtin fc -lr 1
    else
        builtin fc -lr -50
    fi | LC_ALL=C awk '
        function emit_cur() {
            if (has_cur && cur != "" && !seen[cur]++) {
                print cur
            }
        }
        {
            sub(/\r$/, "")
            gsub(/\034/, " ")
        }
        match($0, /^[[:space:]]*[0-9]+\t[ *]/) {
            hdr = substr($0, 1, RLENGTH)
            rest = substr($0, RLENGTH + 1)
            sub(/^[[:space:]]*/, "", hdr)
            sub(/\t.*$/, "", hdr)
            num = hdr + 0
            if (!has_cur || num < prev_num) {
                emit_cur()
                cur = rest
                prev_num = num
                has_cur = 1
                next
            }
        }
        has_cur {
            cur = cur "\034" $0
        }
        END {
            emit_cur()
        }
    '
}

