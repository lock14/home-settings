#!/bin/zsh
# Modular Autocompletions Loader for Zsh
# Registers ~/.zsh/completions, `_theme`, `_ide`, and `_terraform`.

if [ -d "$HOME/.zsh/completions" ]; then
    fpath=("$HOME/.zsh/completions" $fpath)

    if (( $+functions[compdef] )); then
        () {
            local comp_file cmd_name
            for comp_file in "$HOME/.zsh/completions"/_*(N); do
                [ -f "$comp_file" ] || continue
                cmd_name="${comp_file:t}"
                cmd_name="${cmd_name#_}"
                autoload -Uz "${comp_file:t}"
                compdef "${comp_file:t}" "$cmd_name" 2>/dev/null || true
            done
        }
    fi
fi

# Completion for `theme` CLI and shell function
_theme() {
    local -a opts themes
    opts=(
        '-l:List available color themes'
        '--list:List available color themes'
        '--plain:Print theme slugs only (one per line) when listing'
        '-c:Print active theme identifier'
        '--current:Print active theme identifier'
        '-s:Apply the specified color theme'
        '--set:Apply the specified color theme'
        '--holiday:Apply the nearest upcoming or active US Holiday theme'
        '-p:Render TrueColor palette and syntax preview'
        '--preview:Render TrueColor palette and syntax preview'
        '--env:Print shell environment exports for theme'
        '--create:Scaffold a custom user theme file'
        '--from:Base theme template for --create'
        '-f:Overwrite existing custom user theme file'
        '--force:Overwrite existing custom user theme file'
        '--path:Print custom user themes directory path'
        '--no-live:Skip live terminal, Tmux, and Neovim reloads'
        '-n:Validate and show planned updates without writing files'
        '--dry-run:Validate and show planned updates without writing files'
        '-h:Show help message'
        '--help:Show help message'
    )
    if [[ "${words[CURRENT-1]:-}" != (-s|--set|-p|--preview|--env|--from|-n|--dry-run) ]] && \
       [[ "${words[CURRENT]:-}" != (--set=*|--preview=*|--env=*|--from=*|--dry-run=*) ]] && \
       [[ "${words[CURRENT]:-}" == -* ]]; then
        _describe -t options 'theme option' opts
        return
    fi
    local theme_bin=""
    if [ -x "$HOME/.local/bin/theme" ]; then
        theme_bin="$HOME/.local/bin/theme"
    elif whence -p theme >/dev/null 2>&1; then
        theme_bin="$(whence -p theme)"
    fi
    if [ -n "$theme_bin" ]; then
        themes=(${(f)"$("$theme_bin" --list --plain 2>/dev/null)"})
    else
        local _hs_comp_repo="${${(%):-%x}:A:h:h}"
        if [[ -d "$_hs_comp_repo/colors/themes" ]]; then
            local _hs_ucfg="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
            themes=(
                "$_hs_comp_repo/colors/themes"/*.theme(N:t:r)
                "$_hs_ucfg"/*.theme(N:t:r)
                "$_hs_ucfg"/*.conf(N:t:r)
            )
            themes=(${(u)themes:#active-theme})
        else
# BEGIN GENERATED BUILTIN THEMES
        themes=(solarized-dark solarized-light catppuccin-mocha catppuccin-latte gruvbox-dark gruvbox-light rose-pine rose-pine-dawn everforest-dark tokyonight-night kanagawa-wave dracula nord onedark new-years valentines st-patricks easter independence-day halloween thanksgiving christmas)
# END GENERATED BUILTIN THEMES
        fi
    fi
    if [[ "${words[CURRENT]:-}" == (--set=*|--preview=*|--env=*|--from=*|--dry-run=*) ]]; then
        (( ${+compstate} && $+builtins[compset] )) && compset -P 1 '*=' || true
        _describe -t themes 'color theme' themes
        return
    fi
    if [[ "${words[CURRENT-1]:-}" == (-s|--set|-p|--preview|--env|--from|-n|--dry-run) ]]; then
        _describe -t themes 'color theme' themes
        return
    fi
    _describe -t themes 'color theme' themes
    _describe -t options 'theme option' opts
}
if (( $+functions[compdef] )); then
    compdef _theme theme 2>/dev/null || true
fi

# Load modular `_ide` and `_terraform` completion engines
() {
    local _hs_had_rpi=${+ZLE_RPROMPT_INDENT} _hs_rpi=${ZLE_RPROMPT_INDENT:-}
    local _hs_dir="${${(%):-%x}:A:h}/.config/shell"
    (( _hs_had_rpi )) && ZLE_RPROMPT_INDENT=$_hs_rpi
    if [[ ! -d "$_hs_dir" ]]; then
        if [[ -n "${_HS_SHELL_DIR:-}" && -d "$_HS_SHELL_DIR" ]]; then
            _hs_dir="$_HS_SHELL_DIR"
        elif [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/shell" ]]; then
            _hs_dir="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
        elif [[ -d "$HOME/.config/shell" ]]; then
            _hs_dir="$HOME/.config/shell"
        fi
    fi
    if [[ -d "$_hs_dir" ]]; then
        typeset -g _HS_SHELL_DIR="$_hs_dir"
        [[ -r "$_hs_dir/terraform-flags.sh" ]] && source "$_hs_dir/terraform-flags.sh"
        [[ -r "$_hs_dir/completions-ide.zsh" ]] && source "$_hs_dir/completions-ide.zsh"
        [[ -r "$_hs_dir/completions-terraform.zsh" ]] && source "$_hs_dir/completions-terraform.zsh"
    fi
}
