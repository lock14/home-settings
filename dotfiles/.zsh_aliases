#!/bin/zsh

# git
alias gcommit='git add -A && git commit'
alias gamend='git add -A && git commit --amend --no-edit'
alias gfetch='git fetch'
alias gpush='git push origin HEAD'
alias gpushf='git push --force-with-lease origin HEAD'
alias gpull='git pull --rebase origin HEAD'
alias gprune='git branch --format="%(refname:short)" | grep -E -v "^(main|master)$" | xargs -r git branch -D'
alias gup='gfetch && gpull'
alias fix-abcxyz-branch-name='git branch -m "$USER/$(git rev-parse --abbrev-ref HEAD)"'

# golang
alias go_lint='CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"; mkdir -p "$CACHE_DIR"; if [ ! -f "$CACHE_DIR/golangci.yml" ]; then curl -fsSL https://raw.githubusercontent.com/abcxyz/pkg/main/.golangci.yml > "$CACHE_DIR/golangci.yml"; fi; golangci-lint run -c "$CACHE_DIR/golangci.yml"'
alias go_testall='go test ./...'
alias go_buildall='go build ./...'

# terraform
alias tf='terraform'

# Aux
alias yaml_lint='yamllint -c ~/.yamllint.yml'
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    alias fd='fdfind'
fi
