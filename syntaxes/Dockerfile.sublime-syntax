%YAML 1.2
---
# Authentic Solarized Dark TrueColor Dockerfile / Containerfile Syntax
# Enforces the Universal Semantic Color Contract:
# - BuildKit parser directives (# syntax=..., # escape=...) in Solarized Orange (keyword.control.directive.dockerfile)
# - Comments in Base01 Dim (comment.line.number-sign.dockerfile)
# - Instructions (FROM, AS, ARG, ENV, RUN, COPY, ADD, WORKDIR, EXPOSE, USER, LABEL, HEALTHCHECK, ENTRYPOINT, CMD, etc.) in Solarized Green
# - Stage aliases (FROM ... AS builder) in Solarized Blue (entity.name.stage.dockerfile)
# - Instruction & CLI flags (--mount=..., --from=..., --chown=..., --interval=...) in calm Base0 Grey (variable.parameter.flag.dockerfile)
# - Embedded shell control flow (if, then, else, elif, fi, for, in, do, done, case, esac) in Solarized Yellow (keyword.control.dockerfile)
# - ALL_CAPS environment & build variables in Solarized Magenta (variable.other.constant.dockerfile)
# - Numbers, ports, and booleans in Solarized Magenta (constant.numeric.dockerfile, constant.language.boolean.dockerfile)
# - Quoted strings in Solarized Cyan (string.quoted.double.dockerfile, string.quoted.single.dockerfile)
# - Variable expansion sigils ($, ${, }) in calm Base0 Grey (punctuation.definition.variable.dockerfile)
name: Dockerfile
scope: source.dockerfile
version: 2

file_extensions:
  - Dockerfile
  - dockerfile
  - Containerfile
  - containerfile

first_line_match: |-
  (?xi:
    ^ \s* \# \s* (?:syntax|escape) \s* =
    | ^ \s* FROM \s+ \S+
  )

variables:
  instruction: '(?:FROM|ARG|ENV|RUN|CMD|LABEL|MAINTAINER|EXPOSE|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL|CROSS_BUILD)'
  all_caps: '[A-Z][A-Z0-9_]+'
  ident: '[a-zA-Z_][a-zA-Z0-9_]*'

contexts:
  main:
    - include: directives
    - include: comments
    - include: from-instruction
    - include: instructions
    - include: body

  directives:
    - match: '^(\s*#\s*(?:syntax|escape)\s*=.*$)'
      scope: keyword.control.directive.dockerfile

  comments:
    - match: '^\s*#.*$'
      scope: comment.line.number-sign.dockerfile

  from-instruction:
    - match: '^\s*(FROM)\b'
      captures:
        1: keyword.other.special-method.dockerfile
      push:
        - match: '(?<!\\)$'
          pop: true
        - match: '\\$'
          scope: punctuation.separator.continuation.dockerfile
        - match: '--[a-zA-Z0-9_-]+(?:=[^\s\\]+)?'
          scope: variable.parameter.flag.dockerfile
        - match: '\b(AS)\s+([a-zA-Z0-9._-]+)'
          captures:
            1: keyword.other.special-method.dockerfile
            2: entity.name.stage.dockerfile
        - include: expansions
        - match: '[:@]'
          scope: punctuation.separator.dockerfile
        - match: '[^\s\\:$@]+'
          scope: variable.other.image.dockerfile

  instructions:
    # HEALTHCHECK instruction can contain nested CMD
    - match: '^\s*(HEALTHCHECK)\b'
      captures:
        1: keyword.other.special-method.dockerfile
    - match: '(?<=\s)(CMD)\b'
      captures:
        1: keyword.other.special-method.dockerfile
    - match: '^\s*({{instruction}})\b'
      captures:
        1: keyword.other.special-method.dockerfile

  body:
    - match: '\\$'
      scope: punctuation.separator.continuation.dockerfile
    - include: flags
    - include: strings
    - include: expansions
    - include: shell-control-flow
    - include: redirections
    - include: constants-and-numbers
    - include: punctuation-and-words

  flags:
    # Long and short flags (--mount=type=cache,target=/go/pkg/mod, --from=builder, -fsS, -trimpath)
    - match: '(?<=\s)(?:--[a-zA-Z0-9_-]+(?:=[^\s"''\\]+)?|-[a-zA-Z0-9]+)(?=\s|$|=)'
      scope: variable.parameter.flag.dockerfile

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.dockerfile
      push:
        - meta_scope: string.quoted.double.dockerfile
        - match: '"'
          scope: punctuation.definition.string.end.dockerfile
          pop: true
        - match: '\\.'
          scope: constant.character.escape.dockerfile
        - include: expansions
    - match: "'"
      scope: punctuation.definition.string.begin.dockerfile
      push:
        - meta_scope: string.quoted.single.dockerfile
        - match: "'"
          scope: punctuation.definition.string.end.dockerfile
          pop: true

  expansions:
    - match: '\$\{'
      scope: punctuation.definition.variable.begin.dockerfile
      push:
        - meta_content_scope: meta.expansion.dockerfile
        - match: '\}'
          scope: punctuation.definition.variable.end.dockerfile
          pop: true
        - match: '(:[-=?+]|%%?|##?|//?)'
          scope: keyword.operator.expansion.dockerfile
        - match: '\b{{all_caps}}\b'
          scope: variable.other.constant.dockerfile
        - match: '\b{{ident}}\b'
          scope: variable.other.dockerfile
        - match: '\b\d+\b'
          scope: constant.numeric.dockerfile
    - match: '(\$)({{all_caps}})\b'
      captures:
        1: punctuation.definition.variable.dockerfile
        2: variable.other.constant.dockerfile
    - match: '(\$)({{ident}})\b'
      captures:
        1: punctuation.definition.variable.dockerfile
        2: variable.other.dockerfile

  shell-control-flow:
    - match: '(?<=\s|^|;)\b(if|then|else|elif|fi|for|in|do|done|case|esac|while|until)\b(?=\s|;|$)'
      scope: keyword.control.dockerfile

  redirections:
    - match: '(\d+)?(>&|<&)(\d+)'
      captures:
        1: constant.numeric.file-descriptor.dockerfile
        2: keyword.operator.redirect.dockerfile
        3: constant.numeric.file-descriptor.dockerfile

  constants-and-numbers:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.dockerfile
    - match: '\b{{all_caps}}\b'
      scope: variable.other.constant.dockerfile
    # Port numbers with optional /tcp or /udp protocol suffix (e.g. 8080/tcp)
    - match: '(?<=\s)(\d+)(/(?:tcp|udp))\b'
      captures:
        1: constant.numeric.port.dockerfile
        2: variable.other.protocol.dockerfile
    # Numeric values and version numbers after = or whitespace or : (e.g. =1.24.1, =3.21, =8080, 10001:10001)
    - match: '(?<==|\s|:)(\d+(?:\.\d+)*)(?=\s|:|;|\\|$)'
      scope: constant.numeric.dockerfile

  punctuation-and-words:
    - match: '[\[\]{}(),;:=|&]'
      scope: punctuation.separator.dockerfile
    - match: '[^\s"''\[\]{}(),;:=|&\\$]+'
      scope: variable.other.dockerfile
