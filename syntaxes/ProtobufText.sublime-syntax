%YAML 1.2
---
# Solarized Dark Protocol Buffers Text Format (.textproto / .pbtxt) Syntax Package for bat / Sublime Text
# Complies with Universal Semantic Color Contract:
# - Message Block Field Headers (recorded_at {, route_quotas <, metrics: [{) in Solarized Blue (entity.name.section.message.textproto)
# - Scalar & Array Field Keys (batch_id:, sequence_num:, quantile_bounds:) in Solarized Green (support.type.property-name.textproto)
# - Bracketed Extension & Any Type URL Identifiers ([telemetry.v1.routing_extension], [type.example.com/...]) in Solarized Violet (entity.name.namespace.textproto)
# - String Values & Escape Sequences in Solarized Cyan (string.quoted.*.textproto, constant.character.escape.textproto)
# - Numeric Values (integers, negative numbers, hex, octal, floats, inf, -inf, nan) in Solarized Magenta (constant.numeric.*.textproto)
# - Booleans (true, false) & Enum Constants (NODE_STATE_ACTIVE) in Solarized Magenta (constant.language.boolean.textproto, constant.other.enum.textproto)
# - Structural Brackets, Delimiters & Separators (:, {, }, <, >, [, ], ,, ;, ., /) in calm Base0 Grey
# - Comments (# ...) in Solarized Base01 Dim (comment.line.number-sign.textproto)

name: Protocol Buffer (TEXT)
scope: source.textproto
version: 2

file_extensions:
  - pb.txt
  - proto.text
  - textpb
  - pbtxt
  - prototxt
  - textproto

contexts:
  prototype:
    - include: comments

  comments:
    - match: '(#).*$'
      scope: comment.line.number-sign.textproto
      captures:
        1: punctuation.definition.comment.textproto

  main:
    - include: bracketed-type-header
    - include: message-field-header
    - include: scalar-field-key
    - include: strings
    - include: values
    - include: punctuation

  bracketed-type-header:
    - match: '(?:(\[)(?=\s*[A-Za-z_][A-Za-z0-9_./]*\s*\]\s*[:\{<])|^\s*(\[)(?=\s*[A-Za-z_][A-Za-z0-9_./]*\s*\]\s*(?:#.*)?$))'
      captures:
        1: punctuation.section.brackets.begin.textproto
        2: punctuation.section.brackets.begin.textproto
      push:
        - match: '(\])'
          captures:
            1: punctuation.section.brackets.end.textproto
          pop: true
        - match: '[./]'
          scope: punctuation.separator.namespace.textproto
        - match: '[A-Za-z_][A-Za-z0-9_]*'
          scope: entity.name.namespace.textproto

  message-field-header:
    - match: '\b([A-Za-z_][A-Za-z0-9_]*)\b(?=\s*:?\s*(?:\{|<|\[\s*(?:\{|<)))'
      captures:
        1: entity.name.section.message.textproto

  scalar-field-key:
    - match: '\b([A-Za-z_][A-Za-z0-9_]*)\b(?=\s*:)'
      captures:
        1: support.type.property-name.textproto

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.textproto
      push:
        - meta_scope: string.quoted.double.textproto
        - match: '"'
          scope: punctuation.definition.string.end.textproto
          pop: true
        - match: '\\(?:[abfnrtv\\''"?]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3})'
          scope: constant.character.escape.textproto
    - match: "'"
      scope: punctuation.definition.string.begin.textproto
      push:
        - meta_scope: string.quoted.single.textproto
        - match: "'"
          scope: punctuation.definition.string.end.textproto
          pop: true
        - match: '\\(?:[abfnrtv\\''"?]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3})'
          scope: constant.character.escape.textproto

  values:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.textproto
    - match: '[-+]?\b(inf|infinity|nan)\b'
      scope: constant.numeric.float.special.textproto
    - match: '[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+\.[0-9]*(?:[eE][-+]?[0-9]+)?[fF]?|\.[0-9]+(?:[eE][-+]?[0-9]+)?[fF]?|[0-9]+[eE][-+]?[0-9]+[fF]?|0[0-7]+|[0-9]+[fF]?)\b'
      scope: constant.numeric.textproto
    - match: '\b([A-Za-z_][A-Za-z0-9_]*)\b'
      scope: constant.other.enum.textproto

  punctuation:
    - match: '[:;,./]'
      scope: punctuation.separator.textproto
    - match: '[\{\}\[\]<>]'
      scope: punctuation.section.brackets.textproto
