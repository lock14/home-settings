#!/bin/bash

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

UPPER="A-Z"
LOWER="a-z"
NUMBERS="0-9"
SYMBOLS='!@#$%^&*()_+=[]{}|:,.<>?'

LENGTH="16"
USE_UPPER=0
USE_LOWER=0
USE_NUMBERS=0
USE_SYMBOLS=0

usage() {
    echo "usage: $(basename "$0") [-u -l -n -s] <length>"
}

while getopts ":ulnsht" opt; do
  case ${opt} in
    u )
      USE_UPPER=1
      ;;
    l )
      USE_LOWER=1
      ;;
    n )
      USE_NUMBERS=1
      ;;
    s )
      USE_SYMBOLS=1
      ;;
    h )
      usage
      exit 0
      ;;
    t )
      set -o xtrace # toggle trace
      ;;
    \? )
      echo "Invalid option: $OPTARG" 1>&2
      usage
      exit 1
      ;;
    : )
      echo "Invalid option: $OPTARG requires an argument" 1>&2
      usage
      exit 1
      ;;
  esac
done
shift $((OPTIND -1))

if [ "${1:-}" != "" ]; then
  LENGTH="$1"
fi

if [ "$LENGTH" = "" ]; then
  echo "error: a length must be provided" >&2
  usage >&2
  exit 1
fi

INTEGER='^[0-9]+$'
if ! [[ $LENGTH =~ $INTEGER ]] || [ "$LENGTH" -le 0 ]; then
   echo "error: $LENGTH is not a valid positive length" >&2
   usage >&2
   exit 1
fi

if [ "$USE_UPPER" -eq 0 ] && [ "$USE_LOWER" -eq 0 ] && [ "$USE_NUMBERS" -eq 0 ] && [ "$USE_SYMBOLS" -eq 0 ]; then
  USE_UPPER=1
  USE_LOWER=1
  USE_NUMBERS=1
  USE_SYMBOLS=1
fi

CHARACTER_SET=""
[ "$USE_UPPER" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}$UPPER"
[ "$USE_LOWER" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}$LOWER"
[ "$USE_NUMBERS" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}$NUMBERS"
[ "$USE_SYMBOLS" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}$SYMBOLS"
# Place hyphen strictly at the end of the character set so tr treats it as a literal rather than a range
[ "$USE_SYMBOLS" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}-"

# Disable pipefail because head -c closes the pipe early, causing tr to receive SIGPIPE (Broken pipe)
set +o pipefail
< /dev/urandom LC_ALL=C tr -dc -- "$CHARACTER_SET" | head -c "$LENGTH"
set -o pipefail
echo

