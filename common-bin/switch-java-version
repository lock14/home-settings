#!/bin/bash
# Switch or list active Java SDK versions across modern Ubuntu (22.04+) and Fedora (38+)
# Only active non-EOL LTS releases are supported (Java 17, 21).

set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") [-j <version> | -l]"
    echo "  -j <version>   Switch Java to active LTS version: 17, 21"
    echo "  -l             List available Java alternatives"
    echo "  -h             Show this help message"
}

LIST_MODE=false
JDK_INPUT=""

while getopts ":j:lh" opt; do
    case ${opt} in
        l)
            LIST_MODE=true
            ;;
        j)
            JDK_INPUT="$OPTARG"
            ;;
        h)
            usage
            exit 0
            ;;
        \?)
            echo "Invalid option: -$OPTARG" 1>&2
            usage
            exit 1
            ;;
        :)
            echo "Invalid option: -$OPTARG requires an argument" 1>&2
            usage
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

# Detect backend
detect_backend() {
    if command -v update-java-alternatives &>/dev/null; then
        echo "debian"
    elif command -v update-alternatives &>/dev/null; then
        echo "redhat"
    else
        echo "unknown"
    fi
}

BACKEND="$(detect_backend)"

if [ "$BACKEND" = "unknown" ]; then
    echo "Error: Neither update-java-alternatives nor update-alternatives was found on this system." >&2
    exit 1
fi

# List mode does not require root on Fedora or Ubuntu
if [ "$LIST_MODE" = true ]; then
    if [ "$BACKEND" = "debian" ]; then
        update-java-alternatives --list 2>/dev/null || true
    else
        update-alternatives --display java 2>/dev/null || true
    fi
    exit 0
fi

if [ -z "$JDK_INPUT" ]; then
    echo "Error: No JDK version specified." >&2
    usage
    exit 2
fi

# Normalize version and validate BEFORE escalating to sudo
clean_ver="${JDK_INPUT#openjdk-}"
clean_ver="${clean_ver#java-}"
clean_ver="${clean_ver#1.}"
clean_ver="${clean_ver%.0}"
clean_ver="${clean_ver%-jdk}"
clean_ver="${clean_ver%-openjdk}"
clean_ver="${clean_ver%-devel}"

case "$clean_ver" in
    17|21|25) ;;
    8|11)
        echo "Error: JDK '$JDK_INPUT' is End-of-Life (EOL). Supported active LTS versions: 17, 21" >&2
        exit 3
        ;;
    *)
        echo "Error: '$JDK_INPUT' is not a supported Java LTS version. Choose from: 17, 21" >&2
        exit 3
        ;;
esac

# Auto-elevate with sudo if not root
if [ "$EUID" -ne 0 ]; then
    exec sudo "$0" -j "$clean_ver"
fi

ARCH="$(dpkg --print-architecture 2>/dev/null || true)"
if [ -z "$ARCH" ]; then
    case "$(uname -m)" in
        x86_64) ARCH="amd64" ;;
        aarch64|arm64) ARCH="arm64" ;;
        *) ARCH="$(uname -m)" ;;
    esac
fi

if [ "$BACKEND" = "debian" ]; then
    target1="java-1.${clean_ver}.0-openjdk-${ARCH}"
    target2="java-${clean_ver}-openjdk-${ARCH}"
    echo "Switching Java alternative to $target1 / $target2..."
    update-java-alternatives -s "$target1" 2>/dev/null || update-java-alternatives -s "$target2" 2>/dev/null || true
    if [ -d "/usr/lib/jvm/$target1" ]; then
        rm -f /usr/lib/jvm/default-jdk
        ln -sf "/usr/lib/jvm/$target1" /usr/lib/jvm/default-jdk
    elif [ -d "/usr/lib/jvm/$target2" ]; then
        rm -f /usr/lib/jvm/default-jdk
        ln -sf "/usr/lib/jvm/$target2" /usr/lib/jvm/default-jdk
    fi
else
    # RedHat / Fedora
    alt_target="java-${clean_ver}-openjdk.${ARCH}"
    echo "Switching Java alternative to $alt_target..."
    update-alternatives --set java "$alt_target"
    update-alternatives --set javac "$alt_target"
fi

echo "Java version switched successfully."
java -version 2>&1 | head -n 1
