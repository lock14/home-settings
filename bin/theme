#!/usr/bin/env bash
# ==============================================================================
# bin/theme — Unified Multi-Theme Color Scheme Manager
# ==============================================================================
# Manages built-in TrueColor themes (colors/themes/*.theme) and custom user themes across
# terminal emulators, Neovim, Vim, Tmux, bat, delta, btop, tealdeer, fzf, eza,
# jq, less, dircolors, Powerlevel10k, Zsh, and Bash via libexec/theme_lib/*.py.
#
# Ghostty generator keybinding contract (implemented in libexec/theme_lib/generators.py):
#   keybind = ctrl+shift+d=new_split:auto
#   keybind = ctrl+shift+w=close_surface
#   keybind = ctrl+shift+enter=toggle_split_zoom
#   keybind = ctrl+shift+h=goto_split:left
#   keybind = ctrl+shift+j=goto_split:bottom
#   keybind = ctrl+shift+k=goto_split:top
#   keybind = ctrl+shift+l=goto_split:right
#   keybind = ctrl+shift+t=new_tab
#   keybind = alt+left=text:\x1b[1;3D
#   keybind = alt+right=text:\x1b[1;3C
#   keybind = alt+up=text:\x1b[1;3A
#   keybind = alt+down=text:\x1b[1;3B
# ==============================================================================

set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
REPO_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"

IFS= read -r -d '' THEME_PY_SRC <<'PY' || true
from __future__ import annotations

import sys

if not getattr(sys, "pycache_prefix", None):
    sys.dont_write_bytecode = True
if sys.path[:1] == [""]:
    sys.path.pop(0)
sys.path.insert(0, sys.argv.pop(1))

from theme_lib.cli import main

if __name__ == "__main__":
    sys.exit(main())
PY

if [ -z "${THEME_PY_BIN:-}" ]; then
    THEME_PY_BIN="python3"
    if [ -x /usr/bin/python3 ]; then
        THEME_PY_BIN="/usr/bin/python3"
    fi
fi
if [ -z "${PYTHONPYCACHEPREFIX:-}" ]; then
    _theme_cache_base="${XDG_CACHE_HOME:-${HOME%/}/.cache}"
    if [ -n "$_theme_cache_base" ]; then
        export PYTHONPYCACHEPREFIX="${_theme_cache_base%/}/home-settings/pycache"
    fi
    unset _theme_cache_base
fi
PYTHONSAFEPATH=1 exec "$THEME_PY_BIN" -S -c "$THEME_PY_SRC" "$REPO_DIR/libexec" "$REPO_DIR" "$@"
