def generate_p10k_theme_text(theme):
    return f"""# Generated by bin/theme — Powerlevel10k Palette Remap ({theme['THEME_ID']})
() {{
  typeset -gA _HS_P10K_BASE_SCALARS _HS_P10K_BASE_ARRAYS _HS_P10K_BASE_HEX
  local _hs_param _hs_val _hs_hex _hs_tok
  if (( ! ${{#_HS_P10K_BASE_SCALARS}} )); then
    for _hs_param in ${{(k)parameters[(I)POWERLEVEL9K_*]}}; do
      [[ "$_hs_param" == "POWERLEVEL9K_GITSTATUS_DIR" ]] && continue
      case "${{(Pt)_hs_param}}" in
        scalar*)
          _hs_val="${{(P)_hs_param}}"
          _HS_P10K_BASE_SCALARS[$_hs_param]="$_hs_val"
          [[ "$_hs_val" == *"#"* ]] && _HS_P10K_BASE_HEX[$_hs_param]="$_hs_val"
          ;;
        array*)
          local -a _hs_arr_copy
          _hs_arr_copy=( "${{(@P)_hs_param}}" )
          if (( ${{#_hs_arr_copy}} == 0 )); then
            _HS_P10K_BASE_ARRAYS[$_hs_param]=$'\\x01EMPTY\\x01'
          else
            _HS_P10K_BASE_ARRAYS[$_hs_param]="${{(pj:\\0:)_hs_param}}"
          fi
          ;;
      esac
    done
  else
    for _hs_param in ${{(k)parameters[(I)POWERLEVEL9K_*]}}; do
      [[ "$_hs_param" == "POWERLEVEL9K_GITSTATUS_DIR" ]] && continue
      if (( ! ${{+_HS_P10K_BASE_SCALARS[$_hs_param]}} && ! ${{+_HS_P10K_BASE_ARRAYS[$_hs_param]}} )); then
        unset "$_hs_param"
      fi
    done
    for _hs_param _hs_val in "${{(@kv)_HS_P10K_BASE_SCALARS}}"; do
      typeset -g "$_hs_param=$_hs_val"
    done
    for _hs_param _hs_val in "${{(@kv)_HS_P10K_BASE_ARRAYS}}"; do
      if [[ "$_hs_val" == $'\\x01EMPTY\\x01' ]]; then
        set -A "$_hs_param"
      else
        set -A "$_hs_param" "${{(@0)_hs_val}}"
      fi
    done
    if (( ! ${{#_HS_P10K_BASE_HEX}} )); then
      for _hs_param _hs_val in "${{(@kv)_HS_P10K_BASE_SCALARS}}"; do
        [[ "$_hs_val" == *"#"* ]] && _HS_P10K_BASE_HEX[$_hs_param]="$_hs_val"
      done
    fi
  fi
  local -A _hs_p10k_to_slot=(
    '#002B36' '__HS_BASE03__'
    '#073642' '__HS_BASE02__'
    '#586E75' '__HS_BASE01__'
    '#657B83' '__HS_BASE00__'
    '#839496' '__HS_BASE0__'
    '#93A1A1' '__HS_BASE1__'
    '#EEE8D5' '__HS_BASE2__'
    '#FDF6E3' '__HS_BASE3__'
    '#B58900' '__HS_YELLOW__'
    '#CB4B16' '__HS_ORANGE__'
    '#DC322F' '__HS_RED__'
    '#D33682' '__HS_MAGENTA__'
    '#6C71C4' '__HS_VIOLET__'
    '#268BD2' '__HS_BLUE__'
    '#2AA198' '__HS_CYAN__'
    '#859900' '__HS_GREEN__'
  )
  local -A _hs_p10k_from_slot=(
    '__HS_BASE03__'  '{theme["BASE03"]}'
    '__HS_BASE02__'  '{theme["BASE02"]}'
    '__HS_BASE01__'  '{theme["BASE01"]}'
    '__HS_BASE00__'  '{theme["BASE00"]}'
    '__HS_BASE0__'   '{theme["BASE0"]}'
    '__HS_BASE1__'   '{theme["BASE1"]}'
    '__HS_BASE2__'   '{theme["BASE2"]}'
    '__HS_BASE3__'   '{theme["BASE3"]}'
    '__HS_YELLOW__'  '{theme["YELLOW"]}'
    '__HS_ORANGE__'  '{theme["ORANGE"]}'
    '__HS_RED__'     '{theme["RED"]}'
    '__HS_MAGENTA__' '{theme["MAGENTA"]}'
    '__HS_VIOLET__'  '{theme["VIOLET"]}'
    '__HS_BLUE__'    '{theme["BLUE"]}'
    '__HS_CYAN__'    '{theme["CYAN"]}'
    '__HS_GREEN__'   '{theme["GREEN"]}'
  )
  for _hs_param _hs_val in "${{(@kv)_HS_P10K_BASE_HEX}}"; do
    for _hs_hex _hs_tok in "${{(@kv)_hs_p10k_to_slot}}"; do
      if [[ "$_hs_val" == *"$_hs_hex"* ]]; then
        _hs_val="${{_hs_val//$_hs_hex/$_hs_tok}}"
      fi
    done
    for _hs_tok _hs_hex in "${{(@kv)_hs_p10k_from_slot}}"; do
      if [[ "$_hs_val" == *"$_hs_tok"* ]]; then
        _hs_val="${{_hs_val//$_hs_tok/$_hs_hex}}"
      fi
    done
    typeset -g "$_hs_param=$_hs_val"
  done
  if [[ -n "{HOLIDAY_META.get(theme['THEME_ID'], {}).get('icon', '')}" ]]; then
    typeset -g POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION='{HOLIDAY_META.get(theme["THEME_ID"], {}).get("icon", "")}'
  else
    unset POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION
  fi
}}
"""


def generate_tmux_theme_text(theme):
    b03 = theme["BASE03"]
    b02 = theme["BASE02"]
    b01 = theme["BASE01"]
    b00 = theme["BASE00"]
    b0 = theme["BASE0"]
    b1 = theme["BASE1"]
    yellow = theme["YELLOW"]
    orange = theme["ORANGE"]
    red = theme["RED"]
    magenta = theme["MAGENTA"]
    violet = theme["VIOLET"]
    blue = theme["BLUE"]
    cyan = theme["CYAN"]
    green = theme["GREEN"]
    hmeta = HOLIDAY_META.get(theme["THEME_ID"])
    session_icon = hmeta["icon"] if hmeta else ""
    holiday_right_segment = (
        f"#{{?#{{||:#{{==:#{{client_width}},0}},#{{>=:#{{client_width}},105}}}},#[fg={b00}#,bg={b02}#,nobold] #[fg={yellow}#,bg={b02}#,nobold]{hmeta['badge']} ,}}"
        if hmeta
        else ""
    )

    return f"""# Generated by bin/theme — Tmux Status Bar & Borders ({theme['THEME_ID']})
set -g pane-border-style "fg={b01},bg={b03}"
set -g pane-active-border-style "fg={b01},bg={b03}"
set -g popup-border-style "fg={b01},bg={b03}"
set -g popup-style "fg={b0},bg={b03}"
set -g mode-style "fg={b1},bg={b02}"
set -g message-style "fg={b1},bg={b02}"
set -g message-command-style "fg={b1},bg={b02}"
set -g status-style "fg={b0},bg={b02}"

set -g status-left "#[fg={blue},bg={b02},nobold] {session_icon} #S #[fg={b00},bg={b02},nobold] "

set -g @ide_tab_ai '#{{?#{{==:#{{@ide_role}},ai}}, #[fg={cyan}#,bg={b02}#,nobold]▸ 󰚩 #[fg={b1}#,bg={b02}#,nobold]#{{?#{{!=:#{{@ide_ai_cli}},}},#{{@ide_ai_cli}},AI}} (Alt+a),#{{?#{{==:#{{@ide_ai_parked}},1}}, #[fg={b01}#,bg={b02}#,nobold]󰚩 #{{?#{{!=:#{{@ide_ai_cli}},}},#{{@ide_ai_cli}},AI}} [Alt+a], #[fg={b0}#,bg={b02}#,nobold]󰚩 #{{?#{{!=:#{{@ide_ai_cli}},}},#{{@ide_ai_cli}},AI}} (Alt+a)}}}}'
set -g @ide_tab_ed '#{{?#{{==:#{{@ide_role}},editor}},#[fg={blue}#,bg={b02}#,nobold]▸  #[fg={b1}#,bg={b02}#,nobold]Editor (Alt+e),#{{?#{{==:#{{@ide_ed_parked}},1}},#[fg={b01}#,bg={b02}#,nobold] Editor [Alt+E],#[fg={b0}#,bg={b02}#,nobold] Editor (Alt+e)}}}}'
set -g @ide_tab_term '#{{?#{{==:#{{@ide_role}},term}},#[fg={green}#,bg={b02}#,nobold]▸  #[fg={b1}#,bg={b02}#,nobold]Shell (Alt+t) ,#{{?#{{==:#{{@ide_term_parked}},1}},#[fg={b01}#,bg={b02}#,nobold] Shell [Alt+T] ,#[fg={b0}#,bg={b02}#,nobold] Shell (Alt+t) }}}}'

setw -g window-status-format "#{{?#{{m/r:^_ide_park_,#W}},,#[fg={b01}#,bg={b02}#,nobold] #I:#W }}"
setw -g window-status-current-format "#{{?#{{==:#W,ide}},#{{E:@ide_tab_ai}}#[fg={b01}#,bg={b02}#,nobold] · #{{E:@ide_tab_ed}}#[fg={b01}#,bg={b02}#,nobold] · #{{E:@ide_tab_term}}#{{?window_zoomed_flag,#[fg={b00}#,bg={b02}#,nobold] #[fg={orange}#,bg={b02}#,nobold]󰁌 ZOOM (Alt+z) ,}},#[fg={b1}#,bg={b02}#,nobold] #I:#W#{{?window_zoomed_flag, #[fg={orange}]󰁌 ZOOM,}} }}"
setw -g window-status-separator ""

set -g status-right "#{{?client_prefix,#[fg={b00}#,bg={b02}#,nobold] #[fg={orange}#,bg={b02}#,nobold]󰘳 PREFIX #[fg={b00}#,bg={b02}#,nobold] #[fg={b0}#,bg={b02}#,nobold]#{{?#{{>=:#{{client_width}},120}},HJKL resize · |/- split · b bar · ? keys ,? keys }},#{{?pane_in_mode,#[fg={b00}#,bg={b02}#,nobold] #[fg={magenta}#,bg={b02}#,nobold]󰆏 COPY#{{?#{{!=:#{{scroll_position}},}}, [#{{scroll_position}}/#{{history_size}}],}} #[fg={b00}#,bg={b02}#,nobold] #[fg={b0}#,bg={b02}#,nobold]#{{?#{{>=:#{{client_width}},120}},Alt+c copy · Alt+v paste · Esc clear ,Alt+c · Esc }},#{{?pane_synchronized,#[fg={b00}#,bg={b02}#,nobold] #[fg={red}#,bg={b02}#,nobold]󰓦 SYNC ,}}#{{?#{{||:#{{!=:#{{SSH_CONNECTION}},}},#{{!=:#{{SSH_TTY}},}}}},#[fg={b00}#,bg={b02}#,nobold] #[fg={violet}#,bg={b02}#,nobold]󰣀 #h ,}}#{{?#{{&&:#{{!=:#{{@ide_workdir}},}},#{{!=:#{{@ide_workdir}},#{{@ide_initial_root}}}}}},#[fg={b00}#,bg={b02}#,nobold] #[fg={blue}#,bg={b02}#,nobold]󰉋 #{{b:@ide_workdir}} ,}}{holiday_right_segment}#[fg={b00}#,bg={b02}#,nobold] #[fg={b0}#,bg={b02}#,nobold]󰋖 Help (Alt+?) }}}}"
"""


def sync_symlink(src_path, dst_path):
    dst_path.parent.mkdir(parents=True, exist_ok=True)
    if dst_path.is_symlink():
        dst_path.unlink()
    elif dst_path.exists():
        ts = int(time.time())
        bak = dst_path.parent / f"{dst_path.name}.bak.{ts}"
        idx = 1
        while bak.exists() or bak.is_symlink():
            bak = dst_path.parent / f"{dst_path.name}.bak.{ts}.{idx}"
            idx += 1
        dst_path.rename(bak)
    dst_path.symlink_to(src_path)


def sync_managed_repo_assets(repo_dir):
    base_tmtheme = (repo_dir / "colors" / "Solarized-Dark-TrueColor.tmTheme").read_text(encoding="utf-8")
    themes = discover_themes(repo_dir)
    for slug in MANAGED_ORDER:
        t = themes[slug]
        tm_path = repo_dir / "colors" / f"{t['BAT_THEME_NAME']}.tmTheme"
        if slug != "solarized-dark":
            tm_path.write_text(generate_tmtheme_text(base_tmtheme, t), encoding="utf-8")

        btop_path = repo_dir / "dotfiles" / ".config" / "btop" / "themes" / f"{t['BTOP_THEME_NAME']}.theme"
        if slug != "solarized-dark":
            btop_path.write_text(generate_btop_theme_text(t), encoding="utf-8")

        ghostty_path = repo_dir / "dotfiles" / ".config" / "ghostty" / "themes" / t["GHOSTTY_THEME_NAME"]
        if slug != "solarized-dark":
            ghostty_path.write_text(generate_ghostty_theme_text(t), encoding="utf-8")


def emit_live_osc_sequences(theme):
    if not (sys.stdout.isatty() or os.environ.get("THEME_FORCE_OSC") == "1"):
        return
    if os.environ.get("NO_COLOR"):
        return
    in_tmux = bool(os.environ.get("TMUX"))
    palette_slots = [
        (0, theme["BASE02"]),
        (1, theme["RED"]),
        (2, theme["GREEN"]),
        (3, theme["YELLOW"]),
        (4, theme["BLUE"]),
        (5, theme["MAGENTA"]),
        (6, theme["CYAN"]),
        (7, theme["BASE2"]),
        (8, theme["BASE01"]),
        (9, theme["ORANGE"]),
        (10, theme["BASE01"]),
        (11, theme["BASE00"]),
        (12, theme["BASE0"]),
        (13, theme["VIOLET"]),
        (14, theme["BASE1"]),
        (15, theme["BASE3"]),
    ]
    seqs = [
        f"\033]10;{theme['BASE0']}\007",
        f"\033]11;{theme['BASE03']}\007",
        f"\033]12;{theme['BASE0']}\007",
    ]
    for idx, col in palette_slots:
        seqs.append(f"\033]4;{idx};{col}\007")

    out = []
    for s in seqs:
        if in_tmux:
            escaped = s.replace("\033", "\033\033")
            out.append(f"\033Ptmux;{escaped}\033\\")
        else:
            out.append(s)
    try:
        sys.stdout.write("".join(out))
        sys.stdout.flush()
    except OSError:
        pass


def broadcast_live_reloads(theme, state_dir, repo_dir):
    emit_live_osc_sequences(theme)

    # 1. Live Tmux reload if running inside tmux or if THEME_LIVE_TMUX / TMUX_TMPDIR is active
    tmux_conf = state_dir / "tmux-theme.conf"
    if shutil.which("tmux") and tmux_conf.is_file():
        if os.environ.get("TMUX") or os.environ.get("TMUX_TMPDIR") or os.environ.get("THEME_LIVE_TMUX") == "1":
            subprocess.run(
                ["tmux", "source-file", str(tmux_conf)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            for k, v in (
                ("HOME_SETTINGS_THEME", theme["THEME_ID"]),
                ("BAT_THEME", theme["BAT_THEME_NAME"]),
            ):
                subprocess.run(
                    ["tmux", "set-environment", "-g", k, v],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )

    # 2. Live Neovim RPC reload
    if shutil.which("nvim") and os.environ.get("THEME_LIVE_NVIM", "1") != "0":
        skip_sock = os.environ.get("THEME_SKIP_NVIM_SOCKET", "").strip()
        skip_resolved = Path(skip_sock).resolve() if skip_sock else None
        sockets = []
        sock_dir_override = os.environ.get("THEME_NVIM_SOCKET_DIR", "").strip()
        env_sock = os.environ.get("NVIM_IDE_SOCKET", "").strip()
        if env_sock:
            sockets.append(Path(env_sock))
        if sock_dir_override:
            sock_dir_path = Path(sock_dir_override)
            if sock_dir_path.is_dir():
                for pat in ("*.sock", "nvim.*.0", "*/nvim.*.0"):
                    for p in sock_dir_path.glob(pat):
                        if p not in sockets:
                            sockets.append(p)
        else:
            for p in Path("/tmp").glob("nvim-ide-*.sock"):
                if p not in sockets:
                    sockets.append(p)
            xdg_rt = os.environ.get("XDG_RUNTIME_DIR", "").strip()
            if xdg_rt and Path(xdg_rt).is_dir():
                for p in Path(xdg_rt).glob("nvim.*.0"):
                    if p not in sockets:
                        sockets.append(p)
            try:
                nvim_user = os.environ.get("USER", "").strip() or getpass.getuser()
            except Exception:
                nvim_user = ""
            if nvim_user:
                tmp_candidates = [Path("/tmp")]
                env_tmp = os.environ.get("TMPDIR", "").strip()
                if env_tmp:
                    env_tmp_path = Path(env_tmp)
                    if env_tmp_path not in tmp_candidates:
                        tmp_candidates.insert(0, env_tmp_path)
                for base_tmp in tmp_candidates:
                    user_nvim_dir = base_tmp / f"nvim.{nvim_user}"
                    if user_nvim_dir.is_dir():
                        for pat in ("nvim.*.0", "*/nvim.*.0"):
                            for p in user_nvim_dir.glob(pat):
                                if p not in sockets:
                                    sockets.append(p)
        for sock in sockets:
            try:
                if skip_resolved and sock.resolve() == skip_resolved:
                    continue
                st = sock.stat()
                if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
                    subprocess.run(
                        [
                            "nvim",
                            "--headless",
                            "--server",
                            str(sock),
                            "--remote-expr",
                            "v:lua.apply_home_settings_theme()",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=3,
                        check=False,
                    )
            except (OSError, subprocess.SubprocessError):
                pass

    # 3. Terminal emulator profile updates (Ghostty SIGUSR2, GNOME Terminal on Linux, Terminal.app on macOS)
    if os.environ.get("THEME_UPDATE_TERMINAL_PROFILE", "1") != "0":
        if shutil.which("pkill"):
            for proc_name in ("ghostty", "Ghostty"):
                subprocess.run(
                    ["pkill", "-USR2", "-u", str(os.getuid()), "-x", proc_name],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
        is_macos = sys.platform == "darwin" or os.environ.get("OS") == "macos"
        if is_macos:
            mt_script = repo_dir / "bin" / "macos-terminal-solarized"
            if mt_script.is_file():
                subprocess.run(
                    [str(mt_script), f"--theme={theme['THEME_ID']}"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
        else:
            gt_script = repo_dir / "bin" / "gnome-terminal-solarized"
            if gt_script.is_file() and shutil.which("dconf") and shutil.which("gsettings"):
                subprocess.run(
                    [str(gt_script), f"--theme={theme['THEME_ID']}"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )


def apply_theme(theme, repo_dir, dry_run=False, no_live=False):
    cfg_dir = get_xdg_config_home()
    state_dir = cfg_dir / "home-settings"
    active_dir = state_dir / "active"
    bat_themes_dir = cfg_dir / "bat" / "themes"
    bat_Theme_file = bat_themes_dir / f"{theme['BAT_THEME_NAME']}.tmTheme"

    if dry_run:
        print(f"[DRY-RUN] Theme: {theme['THEME_LABEL']} ({theme['THEME_ID']}, mode={theme['THEME_MODE']}, source={theme['SOURCE']})")
        print(f"[DRY-RUN] Would write active state: {state_dir / 'theme'}")
        print(f"[DRY-RUN] Would write active palette: {state_dir / 'active-theme.theme'}")
        print(f"[DRY-RUN] Would write shell environment: {state_dir / 'theme-env.sh'}")
        print(f"[DRY-RUN] Would write Zsh & p10k theme: {state_dir / 'zsh-theme.zsh'}, {state_dir / 'p10k-theme.zsh'}")
        print(f"[DRY-RUN] Would write Tmux theme: {state_dir / 'tmux-theme.conf'}")
        print(f"[DRY-RUN] Would update Ghostty config ({theme['GHOSTTY_THEME_NAME']}): {cfg_dir / 'ghostty' / 'config'}")
        print(f"[DRY-RUN] Would update btop config ({theme['BTOP_THEME_NAME']}): {cfg_dir / 'btop' / 'btop.conf'}")
        print(f"[DRY-RUN] Would update Git delta config ({theme['BAT_THEME_NAME']}): {cfg_dir / 'git' / 'config'}")
        print(f"[DRY-RUN] Would update tealdeer config: {cfg_dir / 'tealdeer' / 'config.toml'}")
        print(f"[DRY-RUN] Would ensure bat theme: {bat_Theme_file}")
        print("[DRY-RUN] Would broadcast live reload to Tmux, Neovim RPC, and terminal OSC palette")
        return 0

    state_dir.mkdir(parents=True, exist_ok=True)
    active_dir.mkdir(parents=True, exist_ok=True)

    (state_dir / "theme").write_text(f"{theme['THEME_ID']}\n", encoding="utf-8")
    (state_dir / "active-theme.theme").write_text(generate_active_theme_file_text(theme), encoding="utf-8")
    (state_dir / "theme-env.sh").write_text(generate_theme_env_sh(theme, repo_dir), encoding="utf-8")
    (state_dir / "zsh-theme.zsh").write_text(generate_zsh_theme_text(theme), encoding="utf-8")
    (state_dir / "p10k-theme.zsh").write_text(generate_p10k_theme_text(theme), encoding="utf-8")
    (state_dir / "tmux-theme.conf").write_text(generate_tmux_theme_text(theme), encoding="utf-8")
    (state_dir / "delta-theme.gitconfig").write_text(generate_git_config_text(theme), encoding="utf-8")

    # Materialize active app directories under state_dir/active/ so tracked repo dotfiles are never dirtied
    # 1. Ghostty
    active_ghostty = active_dir / "ghostty"
    active_ghostty_themes = active_ghostty / "themes"
    active_ghostty_themes.mkdir(parents=True, exist_ok=True)
    repo_ghostty_themes = repo_dir / "dotfiles" / ".config" / "ghostty" / "themes"
    if repo_ghostty_themes.is_dir():
        for gt in repo_ghostty_themes.iterdir():
            if gt.is_file():
                sync_symlink(gt, active_ghostty_themes / gt.name)
    custom_gt_path = active_ghostty_themes / theme["GHOSTTY_THEME_NAME"]
    if theme["SOURCE"] == "user" or not (repo_ghostty_themes / theme["GHOSTTY_THEME_NAME"]).is_file():
        if custom_gt_path.is_symlink():
            custom_gt_path.unlink()
        custom_gt_path.write_text(generate_ghostty_theme_text(theme), encoding="utf-8")
    (active_ghostty / "config").write_text(generate_ghostty_config_text(theme), encoding="utf-8")
    if theme["THEME_ID"] == "solarized-dark" and (repo_dir / "dotfiles" / ".config" / "ghostty").is_dir():
        sync_symlink(repo_dir / "dotfiles" / ".config" / "ghostty", cfg_dir / "ghostty")
    else:
        sync_symlink(active_ghostty, cfg_dir / "ghostty")
    if sys.platform == "darwin" or os.environ.get("OS") == "macos":
        macos_gt_dir = Path.home() / "Library" / "Application Support" / "com.mitchellh.ghostty"
        macos_gt_dir.mkdir(parents=True, exist_ok=True)
        sync_symlink(cfg_dir / "ghostty" / "config", macos_gt_dir / "config")
        sync_symlink(cfg_dir / "ghostty" / "themes", macos_gt_dir / "themes")

    # 2. btop
    active_btop = active_dir / "btop"
    active_btop_themes = active_btop / "themes"
    active_btop_themes.mkdir(parents=True, exist_ok=True)
    repo_btop_themes = repo_dir / "dotfiles" / ".config" / "btop" / "themes"
    if repo_btop_themes.is_dir():
        for bt in repo_btop_themes.iterdir():
            if bt.is_file():
                sync_symlink(bt, active_btop_themes / bt.name)
    custom_bt_path = active_btop_themes / f"{theme['BTOP_THEME_NAME']}.theme"
    if theme["SOURCE"] == "user" or not (repo_btop_themes / f"{theme['BTOP_THEME_NAME']}.theme").is_file():
        if custom_bt_path.is_symlink():
            custom_bt_path.unlink()
        custom_bt_path.write_text(generate_btop_theme_text(theme), encoding="utf-8")
    (active_btop / "btop.conf").write_text(generate_btop_config_text(theme, repo_dir), encoding="utf-8")
    if theme["THEME_ID"] == "solarized-dark" and (repo_dir / "dotfiles" / ".config" / "btop").is_dir():
        sync_symlink(repo_dir / "dotfiles" / ".config" / "btop", cfg_dir / "btop")
    else:
        sync_symlink(active_btop, cfg_dir / "btop")

    # 3. git / delta (keep cfg_dir / "git" as a real directory so user ignore/attributes survive)
    active_git = active_dir / "git"
    active_git.mkdir(parents=True, exist_ok=True)
    (active_git / "config").write_text(generate_git_config_text(theme), encoding="utf-8")
    git_cfg_dir = cfg_dir / "git"
    if git_cfg_dir.is_symlink():
        git_cfg_dir.unlink()
    git_cfg_dir.mkdir(parents=True, exist_ok=True)
    if theme["THEME_ID"] == "solarized-dark" and (repo_dir / "dotfiles" / ".config" / "git" / "config").is_file():
        sync_symlink(repo_dir / "dotfiles" / ".config" / "git" / "config", git_cfg_dir / "config")
    else:
        sync_symlink(active_git / "config", git_cfg_dir / "config")

    # 4. tealdeer
    active_tealdeer = active_dir / "tealdeer"
    active_tealdeer.mkdir(parents=True, exist_ok=True)
    (active_tealdeer / "config.toml").write_text(generate_tealdeer_config_text(theme), encoding="utf-8")
    if theme["THEME_ID"] == "solarized-dark" and (repo_dir / "dotfiles" / ".config" / "tealdeer").is_dir():
        sync_symlink(repo_dir / "dotfiles" / ".config" / "tealdeer", cfg_dir / "tealdeer")
    else:
        sync_symlink(active_tealdeer, cfg_dir / "tealdeer")

    # 5. bat .tmTheme
    bat_themes_dir.mkdir(parents=True, exist_ok=True)
    need_bat_rebuild = False
    colors_dir = repo_dir / "colors"
    if colors_dir.is_dir():
        for tm_src in sorted(colors_dir.glob("*.tmTheme")):
            dst_tm = bat_themes_dir / tm_src.name
            if not dst_tm.exists():
                sync_symlink(tm_src, dst_tm)
                need_bat_rebuild = True
    repo_tm = colors_dir / f"{theme['BAT_THEME_NAME']}.tmTheme"
    if repo_tm.is_file() and theme["SOURCE"] != "user":
        if not bat_Theme_file.exists():
            sync_symlink(repo_tm, bat_Theme_file)
            need_bat_rebuild = True
    else:
        base_tm = (colors_dir / "Solarized-Dark-TrueColor.tmTheme").read_text(encoding="utf-8")
        if bat_Theme_file.is_symlink():
            bat_Theme_file.unlink()
        bat_Theme_file.write_text(generate_tmtheme_text(base_tm, theme), encoding="utf-8")
        need_bat_rebuild = True

    bat_cache_bin = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "bat" / "themes.bin"
    if not bat_cache_bin.is_file():
        need_bat_rebuild = True
    else:
        try:
            cache_mtime = bat_cache_bin.stat().st_mtime
            for tm_item in bat_themes_dir.glob("*.tmTheme"):
                if tm_item.exists() and tm_item.stat().st_mtime > cache_mtime:
                    need_bat_rebuild = True
                    break
        except OSError:
            need_bat_rebuild = True

    if need_bat_rebuild:
        bat_exe = shutil.which("bat") or shutil.which("batcat")
        if bat_exe:
            subprocess.run(
                [bat_exe, "cache", "--build"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    if not no_live:
        broadcast_live_reloads(theme, state_dir, repo_dir)

    print(f"Applied theme: {theme['THEME_LABEL']} ({theme['THEME_ID']})")
    return 0


ANSI_SGR_RE = re.compile(r"\033\[[0-9;]*m")


def fg_esc(hex_str):
    r, g, b = hex_to_rgb(hex_str)
    return f"\033[38;2;{r};{g};{b}m"


def bg_esc(hex_str):
    r, g, b = hex_to_rgb(hex_str)
    return f"\033[48;2;{r};{g};{b}m"


def visible_len(s):
    plain = ANSI_SGR_RE.sub("", s)
    total = 0
    for ch in plain:
        cp = ord(ch)
        if 0x1F300 <= cp <= 0x1FAFF or ch == "✨":
            total += 2
        else:
            total += 1
    return total


def pad_preview_line(content, bg_code, width, left_pad=2):
    rst = "\033[0m"
    prefix = f"{bg_code}{' ' * left_pad}{content}{bg_code}"
    vlen = visible_len(prefix)
    rem = max(0, width - vlen)
    return f"{prefix}{' ' * rem}{rst}"


def render_preview(theme):
    fzf_cols = os.environ.get("FZF_PREVIEW_COLUMNS", "").strip()
    fzf_lines = os.environ.get("FZF_PREVIEW_LINES", "").strip()
    in_fzf = bool(fzf_cols and fzf_lines)

    try:
        width = max(60, int(fzf_cols)) if fzf_cols else 94
    except ValueError:
        width = 94
    try:
        target_height = max(24, int(fzf_lines)) if fzf_lines else 0
    except ValueError:
        target_height = 0

    b03 = bg_esc(theme["BASE03"])
    b02 = bg_esc(theme["BASE02"])
    b_grn = bg_esc(theme["MIX_GREEN"])
    b_red = bg_esc(theme["MIX_RED"])

    c_b01 = fg_esc(theme["BASE01"])
    c_b00 = fg_esc(theme["BASE00"])
    c_b0 = fg_esc(theme["BASE0"])
    c_b1 = fg_esc(theme["BASE1"])
    c_ylw = fg_esc(theme["YELLOW"])
    c_org = fg_esc(theme["ORANGE"])
    c_red = fg_esc(theme["RED"])
    c_mag = fg_esc(theme["MAGENTA"])
    c_vio = fg_esc(theme["VIOLET"])
    c_blu = fg_esc(theme["BLUE"])
    c_cyn = fg_esc(theme["CYAN"])
    c_grn = fg_esc(theme["GREEN"])

    hmeta = HOLIDAY_META.get(theme["THEME_ID"])
    session_icon = hmeta["icon"] if hmeta else ""
    prompt_icon = hmeta["icon"] if hmeta else ""

    rule_width = max(40, min(width - 4, 88))
    lines = []
    if hmeta:
        lines.append(pad_preview_line(f"{c_ylw}{hmeta['banner']}", b02, width))
    lines.extend(
        [
            pad_preview_line(
                f"{c_org}{theme['THEME_LABEL']} {c_b01}({theme['THEME_ID']} | {theme['THEME_MODE']} | {theme['SOURCE']})",
                b02,
                width,
            ),
            pad_preview_line(f"{c_b0}{theme['THEME_DESCRIPTION']}", b02, width),
            pad_preview_line(f"{c_blu}Monotone Surface & Content Ramp:", b03, width),
        ]
    )

    mono_row = []
    for k in ("BASE03", "BASE02", "BASE01", "BASE00", "BASE0", "BASE1", "BASE2", "BASE3"):
        mono_row.append(f"{fg_esc(theme[k])}██ {c_b0}{k.lower()}:{theme[k]}")
    lines.append(pad_preview_line("  ".join(mono_row[:4]), b03, width, left_pad=4))
    lines.append(pad_preview_line("  ".join(mono_row[4:]), b03, width, left_pad=4))

    lines.append(pad_preview_line(f"{c_blu}Semantic Accent Architecture:", b03, width))
    roles = [
        ("YELLOW", "control flow"),
        ("ORANGE", "preprocessor / H1"),
        ("RED", "errors / deletions"),
        ("MAGENTA", "constants / numbers"),
        ("VIOLET", "imports / attributes"),
        ("BLUE", "function defs / H2"),
        ("CYAN", "strings / escapes"),
        ("GREEN", "keywords / types"),
    ]
    for i in range(0, len(roles), 2):
        k1, r1 = roles[i]
        k2, r2 = roles[i + 1]
        col1 = f"{fg_esc(theme[k1])}██ {c_b1}{k1:<7} {c_b01}{theme[k1]} {c_b0}({r1:<18})"
        col2 = f"{fg_esc(theme[k2])}██ {c_b1}{k2:<7} {c_b01}{theme[k2]} {c_b0}({r2})"
        lines.append(pad_preview_line(f"{col1}   {col2}", b03, width, left_pad=4))

    lines.append(pad_preview_line(f"{c_b01}{'─' * rule_width}", b03, width))
    lines.append(pad_preview_line(f"{c_blu}Converged Semantic Code Preview:", b03, width))
    if hmeta and width < 88:
        status_preview_line = (
            f"{c_blu}{session_icon} ide {c_b00}\uE0B1 {c_cyn}▸ 󰚩 agy {c_b01}· {c_b0} Editor {c_b01}· {c_b0} Shell"
            f"  {c_b00}\uE0B3 {c_ylw}{hmeta['badge']}"
        )
    else:
        status_preview_line = (
            f"{c_blu}{session_icon} ide {c_b00}\uE0B1 {c_cyn}▸ 󰚩 agy {c_b1}(Alt+a) {c_b01}· {c_b0} Editor (Alt+e) {c_b01}· {c_b0} Shell (Alt+t)"
            + (f"  {c_b00}\uE0B3 {c_ylw}{hmeta['badge']}" if hmeta else "")
        )
    lines.extend(
        [
            pad_preview_line(f"{c_b01}// {theme['THEME_LABEL']} — 6-Pillar Semantic Highlighting", b03, width, left_pad=4),
            pad_preview_line(f"{c_org}#include {c_cyn}<stdio.h>", b03, width, left_pad=4),
            pad_preview_line(f"{c_vio}import {c_vio}core::telemetry{c_b0};", b03, width, left_pad=4),
            pad_preview_line(f"{c_vio}#[derive(Clone)]", b03, width, left_pad=4),
            pad_preview_line(
                f"{c_grn}pub fn {c_blu}classify_sample{c_b0}(val: {c_grn}i64{c_b0}) -> {c_b0}Option<{c_grn}bool{c_b0}> {{",
                b03,
                width,
                left_pad=4,
            ),
            pad_preview_line(f"    {c_ylw}if {c_b0}val >= {c_mag}42 {c_b0}{{", b03, width, left_pad=4),
            pad_preview_line(f"    {c_red}-   {c_ylw}return {c_b0}Some({c_mag}false{c_b0});", b_red, width, left_pad=4),
            pad_preview_line(f"    {c_grn}+   {c_ylw}return {c_b0}Some({c_mag}true{c_b0});", b_grn, width, left_pad=4),
            pad_preview_line(f"    {c_b0}}}", b03, width, left_pad=4),
            pad_preview_line(f"    {c_b0}emit_log({c_cyn}\"status: %s\\n\"{c_b0});", b03, width, left_pad=4),
            pad_preview_line(f"    {c_ylw}return {c_mag}None{c_b0};", b03, width, left_pad=4),
            pad_preview_line(f"{c_b0}}}", b03, width, left_pad=4),
            pad_preview_line(status_preview_line, b02, width),
            pad_preview_line(
                f"{c_b0}{prompt_icon} {c_b01}\uE0B1 {c_blu}~/home-settings {c_b01}\uE0B1 {c_grn} main ✔ {c_grn}❯ {c_grn}theme {c_cyn}{theme['THEME_ID']}",
                b03,
                width,
            ),
        ]
    )

    if in_fzf and target_height > len(lines):
        while len(lines) < target_height:
            lines.append(pad_preview_line("", b03, width))

    print("\n".join(lines))
    return 0


def format_swatch_strip(theme):
    rst = "\033[0m"
    swatches = [
        fg_esc(theme[k]) + "██"
        for k in ("BASE03", "BASE0", "GREEN", "BLUE", "YELLOW", "VIOLET", "CYAN", "MAGENTA", "ORANGE", "RED")
    ]
    return "".join(swatches) + rst


def list_themes(themes, current_slug, plain=False):
    use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    ordered_slugs = [s for s in MANAGED_ORDER if s in themes]
    for s in sorted(themes.keys()):
        if s not in ordered_slugs:
            ordered_slugs.append(s)

    for slug in ordered_slugs:
        if plain:
            print(slug)
            continue
        t = themes[slug]
        marker = "*" if slug == current_slug else " "
        hmeta = HOLIDAY_META.get(slug)
        display_label = f"{hmeta['icon']} {t['THEME_LABEL']}" if hmeta else t["THEME_LABEL"]
        if use_color:
            strip = format_swatch_strip(t)
            print(
                f"{marker} {slug:<18} {t['THEME_MODE']:<5}  {t['SOURCE']:<7}  {strip}  {display_label} — {t['THEME_DESCRIPTION']}"
            )
        else:
            print(
                f"{marker} {slug:<18} {t['THEME_MODE']:<5}  {t['SOURCE']:<7}  {display_label} — {t['THEME_DESCRIPTION']}"
            )
    return 0


def run_fzf_picker(themes, current_slug, repo_dir, dry_run=False, no_live=False):
    in_wrapper = os.environ.get("THEME_SHELL_WRAPPER") == "1"
    fzf_bin = shutil.which("fzf")
    if not fzf_bin:
        rc = list_themes(themes, current_slug)
        return 130 if (in_wrapper and rc == 0) else rc

    ordered_slugs = [s for s in MANAGED_ORDER if s in themes]
    for s in sorted(themes.keys()):
        if s not in ordered_slugs:
            ordered_slugs.append(s)

    lines = []
    for slug in ordered_slugs:
        t = themes[slug]
        active_tag = "(active)" if slug == current_slug else "        "
        strip = format_swatch_strip(t)
        hmeta = HOLIDAY_META.get(slug)
        display_label = f"{hmeta['icon']} {t['THEME_LABEL']}" if hmeta else t["THEME_LABEL"]
        lines.append(f"{slug:<18}  {active_tag}  {t['THEME_MODE']:<5}  {t['SOURCE']:<7}  {strip}  {display_label}")

    cur = themes[current_slug]
    fzf_colors = (
        f"--color=bg+:{cur['BASE02']},bg:{cur['BASE03']},spinner:{cur['CYAN']},"
        f"hl:{cur['BLUE']},fg:{cur['BASE0']},header:{cur['BASE01']},"
        f"info:{cur['YELLOW']},pointer:{cur['CYAN']},marker:{cur['GREEN']},"
        f"fg+:{cur['BASE1']},prompt:{cur['BLUE']},hl+:{cur['BLUE']}"
    )
    self_bin = str(repo_dir / "bin" / "theme")
    preview_cmd = f"{shlex.quote(self_bin)} --preview {{1}}"
    cmd = [
        fzf_bin,
        "--ansi",
        "--no-multi",
        "--reverse",
        "--no-scrollbar",
        "--height=80%",
        "--border=rounded",
        "--prompt=Theme > ",
        "--header=Select a color theme (Enter to apply, Esc to cancel)",
        f"--preview={preview_cmd}",
        "--preview-window=right:60%:nowrap:noinfo",
        fzf_colors,
    ]
    proc = subprocess.run(cmd, input="\n".join(lines) + "\n", text=True, capture_output=True, check=False)
    if proc.returncode != 0:
        return 130 if in_wrapper else 0
    selected = proc.stdout.strip()
    if not selected:
        return 130 if in_wrapper else 0
    tokens = selected.split()
    chosen_slug = (tokens[1] if tokens and tokens[0] == "*" and len(tokens) > 1 else tokens[0]).strip().lower()
    if chosen_slug not in themes:
        sys.stderr.write(f"theme: unknown theme selected: {chosen_slug}\n")
        return 1
    return apply_theme(themes[chosen_slug], repo_dir, dry_run=dry_run, no_live=no_live)


def create_user_theme(new_name, base_slug, themes, force=False):
    slug = new_name.strip().lower().replace("_", "-")
    if not SLUG_RE.match(slug):
        sys.stderr.write(f"theme: invalid theme name '{new_name}' (use lowercase letters, numbers, and hyphens)\n")
        return 1
    base_key = base_slug.strip().lower().replace("_", "-")
    if base_key not in themes:
        sys.stderr.write(f"theme: unknown base theme '{base_slug}'\n")
        return 1
    base = themes[base_key]
    user_dir = get_user_themes_dirs()[0]
    user_dir.mkdir(parents=True, exist_ok=True)
    target_path = user_dir / f"{slug}.theme"
    if target_path.exists() and not force:
        sys.stderr.write(f"theme: custom theme file already exists: {target_path} (use --force to overwrite)\n")
        return 1

    label = slug_to_label(slug)
    pascal_slug = "-".join(part.capitalize() for part in slug.split("-") if part)
    snake_slug = slug.replace("-", "_")
    content = f"""# Custom User Theme: {slug} (based on {base['THEME_ID']})
THEME_ID="{slug}"
THEME_LABEL="{label}"
THEME_DESCRIPTION="Custom {base['THEME_MODE']} theme based on {base['THEME_LABEL']}"
THEME_MODE="{base['THEME_MODE']}"
BAT_THEME_NAME="{pascal_slug}-TrueColor"
BTOP_THEME_NAME="{snake_slug}"
GHOSTTY_THEME_NAME="{label}"

# Monotone Surface & Content Ramp
BASE03="{base['BASE03']}"
BASE02="{base['BASE02']}"
BASE04="{base['BASE04']}"
BASE01="{base['BASE01']}"
BASE00="{base['BASE00']}"
BASE0="{base['BASE0']}"
BASE1="{base['BASE1']}"
BASE2="{base['BASE2']}"
BASE3="{base['BASE3']}"

# Semantic Accent Palette
YELLOW="{base['YELLOW']}"
ORANGE="{base['ORANGE']}"
RED="{base['RED']}"
MAGENTA="{base['MAGENTA']}"
VIOLET="{base['VIOLET']}"
BLUE="{base['BLUE']}"
CYAN="{base['CYAN']}"
GREEN="{base['GREEN']}"

# Diff & Search Surface Tints
MIX_GREEN="{base['MIX_GREEN']}"
MIX_RED="{base['MIX_RED']}"
MIX_YELLOW="{base['MIX_YELLOW']}"
MIX_BLUE="{base['MIX_BLUE']}"
MIX_MAGENTA="{base['MIX_MAGENTA']}"
MIX_BASE1="{base['MIX_BASE1']}"
"""
    target_path.write_text(content, encoding="utf-8")
    print(str(target_path))
    return 0


def main():
    repo_dir = Path(sys.argv[1]).resolve()
    args = sys.argv[2:]

    action = None
    target_name = None
    base_name = "solarized-dark"
    force = False
    dry_run = False
    no_live = False
    plain = False

    i = 0
    end_of_opts = False
    while i < len(args):
        arg = args[i]
        if not end_of_opts and arg == "--":
            end_of_opts = True
        elif not end_of_opts and arg in ("-h", "--help"):
            print(USAGE_TEXT, end="")
            return 0
        elif not end_of_opts and arg == "--sync-assets":
            action = "sync-assets"
        elif not end_of_opts and arg in ("-l", "--list"):
            action = "list"
        elif not end_of_opts and arg == "--plain":
            plain = True
            if action is None:
                action = "list"
        elif not end_of_opts and arg in ("-c", "--current"):
            action = "current"
        elif not end_of_opts and arg == "--path":
            action = "path"
        elif not end_of_opts and arg in ("-n", "--dry-run"):
            dry_run = True
        elif not end_of_opts and arg == "--no-live":
            no_live = True
        elif not end_of_opts and arg in ("-f", "--force"):
            force = True
        elif not end_of_opts and arg == "--holiday":
            action = "set"
            target_name = resolve_nearest_holiday_slug()
        elif not end_of_opts and arg in ("-s", "--set"):
            if i + 1 >= len(args) or not args[i + 1].strip() or args[i + 1].startswith("-"):
                sys.stderr.write(f"theme: option '{arg}' requires a theme name\n")
                return 1
            action = "set"
            target_name = args[i + 1]
            i += 1
        elif not end_of_opts and arg.startswith("--set="):
            val = arg.split("=", 1)[1]
            if not val.strip():
                sys.stderr.write("theme: option '--set' requires a theme name\n")
                return 1
            action = "set"
            target_name = val
        elif not end_of_opts and arg in ("-p", "--preview"):
            action = "preview"
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                if not args[i + 1].strip():
                    sys.stderr.write(f"theme: option '{arg}' requires a theme name\n")
                    return 1
                target_name = args[i + 1]
                i += 1
        elif not end_of_opts and arg.startswith("--preview="):
            val = arg.split("=", 1)[1]
            if not val.strip():
                sys.stderr.write("theme: option '--preview' requires a theme name\n")
                return 1
            action = "preview"
            target_name = val
        elif not end_of_opts and arg == "--env":
            action = "env"
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                if not args[i + 1].strip():
                    sys.stderr.write("theme: option '--env' requires a theme name\n")
                    return 1
                target_name = args[i + 1]
                i += 1
        elif not end_of_opts and arg.startswith("--env="):
            val = arg.split("=", 1)[1]
            if not val.strip():
                sys.stderr.write("theme: option '--env' requires a theme name\n")
                return 1
            action = "env"
            target_name = val
        elif not end_of_opts and arg == "--create":
            if i + 1 >= len(args) or not args[i + 1].strip() or args[i + 1].startswith("-"):
                sys.stderr.write("theme: option '--create' requires a new theme name\n")
                return 1
            action = "create"
            target_name = args[i + 1]
            i += 1
        elif not end_of_opts and arg.startswith("--create="):
            val = arg.split("=", 1)[1]
            if not val.strip():
                sys.stderr.write("theme: option '--create' requires a new theme name\n")
                return 1
            action = "create"
            target_name = val
        elif not end_of_opts and arg == "--from":
            if i + 1 >= len(args) or not args[i + 1].strip() or args[i + 1].startswith("-"):
                sys.stderr.write("theme: option '--from' requires a base theme name\n")
                return 1
            base_name = args[i + 1]
            i += 1
        elif not end_of_opts and arg.startswith("--from="):
            val = arg.split("=", 1)[1]
            if not val.strip():
                sys.stderr.write("theme: option '--from' requires a base theme name\n")
                return 1
            base_name = val
        elif not end_of_opts and arg.startswith("-"):
            sys.stderr.write(f"theme: unknown option '{arg}' (try 'theme --help')\n")
            return 1
        else:
            if not arg.strip():
                sys.stderr.write("theme: theme name must not be empty\n")
                return 1
            if target_name is not None:
                sys.stderr.write(f"theme: unexpected extra argument '{arg}'\n")
                return 1
            target_name = arg
            if action is None:
                action = "set"
        i += 1

    if action == "sync-assets":
        sync_managed_repo_assets(repo_dir)
        return 0

    try:
        themes = discover_themes(repo_dir)
    except ValueError as err:
        sys.stderr.write(f"theme: {err}\n")
        return 1

    current_slug = get_current_theme_slug(themes)

    if action == "list":
        return list_themes(themes, current_slug, plain=plain)
    if action == "current":
        print(current_slug)
        return 0
    if action == "path":
        print(str(get_user_themes_dirs()[0]))
        return 0
    if action == "create":
        return create_user_theme(target_name, base_name, themes, force=force)

    if action in ("preview", "env"):
        raw_target = current_slug if target_name is None else target_name
        slug = raw_target.strip().lower().replace("_", "-")
        if slug not in themes:
            sys.stderr.write(f"theme: unknown theme '{raw_target}' (run 'theme --list' to see available themes)\n")
            return 1
        if action == "preview":
            return render_preview(themes[slug])
        print(generate_theme_env_sh(themes[slug], repo_dir), end="")
        return 0

    if action == "set" or (dry_run and target_name is not None):
        raw_target = current_slug if target_name is None else target_name
        slug = raw_target.strip().lower().replace("_", "-")
        if slug not in themes:
            sys.stderr.write(f"theme: unknown theme '{raw_target}' (run 'theme --list' to see available themes)\n")
            return 1
        return apply_theme(themes[slug], repo_dir, dry_run=dry_run, no_live=no_live)

    if dry_run and target_name is None:
        return apply_theme(themes[current_slug], repo_dir, dry_run=True, no_live=no_live)

    # No arguments: interactive fzf picker when TTY or forced, else list themes
    if (sys.stdin.isatty() and sys.stdout.isatty()) or os.environ.get("THEME_FORCE_FZF") == "1":
        return run_fzf_picker(themes, current_slug, repo_dir, dry_run=dry_run, no_live=no_live)
    return list_themes(themes, current_slug)


if __name__ == "__main__":
    sys.exit(main())
PY

exec python3 -c "$THEME_PY_SRC" "$REPO_DIR" "$@"
