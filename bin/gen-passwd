#!/bin/bash
# Generate random passwords from /dev/urandom with selectable character classes.

set -euo pipefail

UPPER="A-Z"
LOWER="a-z"
NUMBERS="0-9"
SYMBOLS='!@#$%^&*()_+=[]{}|:,.<>?'

LENGTH="16"
USE_UPPER=0
USE_LOWER=0
USE_NUMBERS=0
USE_SYMBOLS=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [-u] [-l] [-n] [-s] [-t] [-h] [length]

Generate a random password from /dev/urandom (default length: 16, all character sets).

Options:
  -u          Include uppercase letters (A-Z)
  -l          Include lowercase letters (a-z)
  -n          Include numbers (0-9)
  -s          Include symbols
  -t          Enable trace output (xtrace)
  -h, --help  Show this help message
EOF
}

for arg in "$@"; do
    case "$arg" in
        --) break ;;
        --help)
            usage
            exit 0
            ;;
    esac
done

while getopts ":ulnsht" opt; do
    case "$opt" in
        u) USE_UPPER=1 ;;
        l) USE_LOWER=1 ;;
        n) USE_NUMBERS=1 ;;
        s) USE_SYMBOLS=1 ;;
        h)
            usage
            exit 0
            ;;
        t) set -o xtrace ;;
        \?)
            echo "Invalid option: $OPTARG" >&2
            usage >&2
            exit 1
            ;;
        :)
            echo "Invalid option: $OPTARG requires an argument" >&2
            usage >&2
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

if [ "${1:-}" != "" ]; then
    LENGTH="$1"
fi

if ! [[ "$LENGTH" =~ ^[0-9]+$ ]] || [ "$LENGTH" -le 0 ]; then
    echo "Error: $LENGTH is not a valid positive length" >&2
    usage >&2
    exit 1
fi

if [ "$USE_UPPER" -eq 0 ] && [ "$USE_LOWER" -eq 0 ] && [ "$USE_NUMBERS" -eq 0 ] && [ "$USE_SYMBOLS" -eq 0 ]; then
    USE_UPPER=1
    USE_LOWER=1
    USE_NUMBERS=1
    USE_SYMBOLS=1
fi

CHARACTER_SET=""
[ "$USE_UPPER" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}${UPPER}"
[ "$USE_LOWER" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}${LOWER}"
[ "$USE_NUMBERS" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}${NUMBERS}"
# Append hyphen strictly last so tr treats it as a literal rather than a character range
[ "$USE_SYMBOLS" -eq 1 ] && CHARACTER_SET="${CHARACTER_SET}${SYMBOLS}-"

# Disable pipefail briefly because head -c closes the pipe once LENGTH bytes are read
set +o pipefail
< /dev/urandom LC_ALL=C tr -dc -- "$CHARACTER_SET" | head -c "$LENGTH"
set -o pipefail
echo
