#!/bin/bash
# ==============================================================================
# bin/update-system — Cross-Platform System & Package Maintenance Utility
# ==============================================================================
# Supports Ubuntu/Debian (APT), Fedora/RHEL (DNF), macOS (Homebrew), Arch Linux,
# Universal packages (Snap, Flatpak, Mac App Store), and Developer Toolchains.
# ==============================================================================

set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
REPO_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=/dev/null
. "$REPO_DIR/setup/lib/log.sh"
# shellcheck source=/dev/null
. "$REPO_DIR/setup/lib/os.sh"
# shellcheck source=/dev/null
. "$REPO_DIR/setup/lib/pkg.sh"
# shellcheck source=/dev/null
. "$REPO_DIR/setup/lib/shell-env.sh"

# Configuration flags
DRY_RUN=false
NON_INTERACTIVE=true
SYSTEM_ONLY=false
SKIP_SNAPS=false
SKIP_FLATPAK=false
WITH_DEV=false
DO_CLEANUP=true
INCLUDE_MACOS_SYSTEM=false
TARGET_OS=""

usage() {
    cat <<'EOF'
Usage: update-system [OPTIONS]

Cross-platform system, package, and toolchain maintenance utility.

Options:
  --all                Include developer toolchains (mise, rustup, elan, Oh-My-Zsh, completions)
  --system-only        Update only the native OS package manager (skip Snaps, Flatpaks, and toolchains)
  --skip <target,...>  Skip comma-separated phases: snaps, flatpak, cleanup
  --macos-system       Run macOS Apple Software Update (macOS only)
  --os <distro>        Override OS detection: ubuntu, fedora, macos, or arch
  -i, --interactive    Prompt for confirmation during package updates (default: non-interactive)
  -n, --dry-run        Preview commands without modifying the system
  -h, --help           Display this help message and exit

Examples:
  update-system                      # Update OS packages, Snaps, and Flatpaks
  update-system --all                # Include Mise, Rustup, Elan, and Oh-My-Zsh toolchains
  update-system --skip snaps,cleanup # Skip Snap refresh and autoremove phases
  update-system -n                   # Preview actions without executing
EOF
}

parse_skip_targets() {
    local raw="$1" tok
    local -a items=()
    IFS=',' read -r -a items <<< "$raw"
    if [ "${#items[@]}" -eq 0 ] || [ -z "$raw" ]; then
        log_error "Option --skip requires one or more targets (snaps, flatpak, cleanup)"
        exit 1
    fi
    for tok in "${items[@]}"; do
        tok="${tok#"${tok%%[![:space:]]*}"}"
        tok="${tok%"${tok##*[![:space:]]}"}"
        case "$tok" in
            snaps)   SKIP_SNAPS=true ;;
            flatpak) SKIP_FLATPAK=true ;;
            cleanup) DO_CLEANUP=false ;;
            *)
                log_error "Invalid --skip target '$tok' (expected: snaps, flatpak, cleanup)"
                exit 1
                ;;
        esac
    done
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -n|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -i|--interactive)
            NON_INTERACTIVE=false
            shift
            ;;
        --all)
            WITH_DEV=true
            SYSTEM_ONLY=false
            shift
            ;;
        --system-only)
            SYSTEM_ONLY=true
            WITH_DEV=false
            shift
            ;;
        --skip)
            if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                log_error "Option --skip requires comma-separated targets (snaps, flatpak, cleanup)"
                exit 1
            fi
            parse_skip_targets "$2"
            shift 2
            ;;
        --skip=*)
            parse_skip_targets "${1#--skip=}"
            shift
            ;;
        --macos-system)
            INCLUDE_MACOS_SYSTEM=true
            shift
            ;;
        --os)
            if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                log_error "Option --os requires an argument (ubuntu, fedora, macos, or arch)"
                exit 1
            fi
            TARGET_OS="$2"
            shift 2
            ;;
        --os=*)
            TARGET_OS="${1#--os=}"
            if [ -z "$TARGET_OS" ]; then
                log_error "Option --os requires an argument (ubuntu, fedora, macos, or arch)"
                exit 1
            fi
            shift
            ;;
        *)
            log_error "Unknown option '$1' (run 'update-system --help' for usage)"
            exit 1
            ;;
    esac
done

export DRY_RUN TARGET_OS
OS="$(detect_os)"
case "$OS" in
    ubuntu|fedora|macos|arch) ;;
    *)
        log_error "Unsupported operating system family: '$OS'. Supported: ubuntu, fedora, macos, arch."
        exit 1
        ;;
esac

log_header "System Update Orchestrator"
echo "  Target OS     : $OS"
echo "  Interactive   : $([ "$NON_INTERACTIVE" = true ] && echo "No (auto -y)" || echo "Yes")"
echo "  Scope         : $([ "$SYSTEM_ONLY" = true ] && echo "Native OS Packages Only" || echo "System + App Runtimes$([ "$WITH_DEV" = true ] && echo " + Dev Tools" || echo "")")"
[ "$DRY_RUN" = true ] && echo "  Mode          : DRY RUN (Preview only, no system changes)"

if [ "$OS" != "macos" ] || [ "$INCLUDE_MACOS_SYSTEM" = true ]; then
    ensure_sudo
fi

START_TIME="$(date +%s)"

# 1. Native OS Package Manager
log_header "Native OS Package Manager ($OS)"
pkg_upgrade_native "$OS" "$NON_INTERACTIVE" "$DO_CLEANUP" "$INCLUDE_MACOS_SYSTEM"
log_success "Native OS package management finished."

# 2. Universal Application Packages (Snap, Flatpak, Mac App Store)
if [ "$SYSTEM_ONLY" = false ]; then
    pkg_upgrade_universal "$OS" "$NON_INTERACTIVE" "$DO_CLEANUP" "$SKIP_SNAPS" "$SKIP_FLATPAK"
fi

# 3. Developer Toolchains (Mise, Rustup, Elan, Oh-My-Zsh, CLI Completions)
if [ "$WITH_DEV" = true ]; then
    log_header "Developer Toolchains & Runtimes"

    refresh_dev_paths() {
        prepend_existing_paths \
            "$HOME/.local/bin" \
            "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" \
            "${ELAN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/elan}/bin"
    }
    refresh_dev_paths

    if command -v mise >/dev/null 2>&1 || [ "$DRY_RUN" = true ]; then
        log_step "Updating Mise plugins and toolchain runtimes..."
        run_cmd mise plugins update
        run_cmd mise upgrade
        if [ "$DO_CLEANUP" = true ]; then
            log_step "Pruning old Mise toolchain versions..."
            run_cmd mise prune -y
        fi
        refresh_dev_paths
        log_success "Mise toolchains updated."
    fi

    if command -v rustup >/dev/null 2>&1 || [ "$DRY_RUN" = true ]; then
        log_step "Updating Rustup toolchains and components..."
        run_cmd rustup update
        log_success "Rustup toolchains updated."
    fi

    if command -v elan >/dev/null 2>&1 || [ "$DRY_RUN" = true ]; then
        log_step "Updating Lean 4 toolchains via elan..."
        ELAN_HOME="${ELAN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/elan}" run_cmd elan update
        log_success "Lean 4 toolchains updated."
    fi

    update_oh_my_zsh_stack

    completions_dir="$HOME/.zsh/completions"
    if [ -d "$completions_dir" ]; then
        log_step "Refreshing CLI tab completions in $completions_dir..."
        if [ "$DRY_RUN" = true ]; then
            echo "  [DryRun] Refresh CLI tab completions in $completions_dir"
        else
            sync_zsh_cli_completions "$completions_dir" false
        fi
        log_success "CLI tab completions refreshed."
    fi
fi

DURATION=$(( $(date +%s) - START_TIME ))
log_header "Update Complete"
log_success "All requested updates completed successfully in ${DURATION}s."
