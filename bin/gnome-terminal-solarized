#!/bin/bash
# Configures authentic 24-bit Solarized Dark TrueColor profile for GNOME Terminal.
# Sets MesloLGS Nerd Font Mono 12 font, Solarized Dark palette, base02 highlight, and block cursor.

set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" 2>/dev/null && pwd || pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" 2>/dev/null && pwd || pwd)"
REPO_DIR="$(cd -P "$SCRIPT_DIR/.." 2>/dev/null && pwd || pwd)"
DCONF_FILE="$REPO_DIR/colors/gnome-terminal-solarized.dconf"

PROFILE_UUID="321fa646-e6ab-45a1-88d8-00aa66d158d8"
PROFILE_NAME="Solarized Dark"
LEGACY_PROFILE_UUID="11f5ebd6-faab-4bd3-8336-868a6b52ac0d"
FACTORY_EMPTY_UUID="b1dcc9dd-5262-4d8d-a863-c897e6d979b9"

DRY_RUN=false
THEME_NAME="${HOME_SETTINGS_THEME:-}"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Configures authentic 24-bit TrueColor profile for GNOME Terminal.

Options:
  --theme <name>  Color theme to apply (default: solarized-dark)
  --dry-run       Preview configuration changes without applying them
  -h, --help      Display this help message
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --theme)
            if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                echo "Error: --theme requires a theme name" >&2
                exit 1
            fi
            THEME_NAME="$2"
            shift 2
            ;;
        --theme=*)
            THEME_NAME="${1#--theme=}"
            if [ -z "$THEME_NAME" ]; then
                echo "Error: --theme requires a theme name" >&2
                exit 1
            fi
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

IFS= read -r -d '' RESOLVE_THEME_PY <<'PY' || true
import os
from pathlib import Path
import re
import sys

DARK_DEFAULTS = {
    "THEME_MODE": "dark",
    "BASE03": "#002B36",
    "BASE02": "#073642",
    "BASE01": "#586E75",
    "BASE00": "#657B83",
    "BASE0": "#839496",
    "BASE1": "#93A1A1",
    "BASE2": "#EEE8D5",
    "BASE3": "#FDF6E3",
    "YELLOW": "#B58900",
    "ORANGE": "#CB4B16",
    "RED": "#DC322F",
    "MAGENTA": "#D33682",
    "VIOLET": "#6C71C4",
    "BLUE": "#268BD2",
    "CYAN": "#2AA198",
    "GREEN": "#859900",
}

LIGHT_DEFAULTS = dict(
    DARK_DEFAULTS,
    THEME_MODE="light",
    BASE03="#FDF6E3",
    BASE02="#EEE8D5",
    BASE01="#93A1A1",
    BASE00="#839496",
    BASE0="#657B83",
    BASE1="#586E75",
    BASE2="#073642",
    BASE3="#002B36",
)

COLOR_KEYS = [
    "BASE03", "BASE02", "BASE01", "BASE00",
    "BASE0", "BASE1", "BASE2", "BASE3",
    "YELLOW", "ORANGE", "RED", "MAGENTA",
    "VIOLET", "BLUE", "CYAN", "GREEN",
]

HEX_RE = re.compile(r"^#[0-9A-Fa-f]{6}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
ASSIGN_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$")


def parse_theme_kv(path):
    parsed = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export ") or line.startswith("export\t"):
            line = line[6:].strip()
        m = ASSIGN_RE.match(line)
        if not m:
            continue
        k, v = m.group(1), m.group(2).strip()
        if v and v[0] in ("'", '"'):
            q = v[0]
            end_idx = v.find(q, 1)
            if end_idx != -1:
                rest = v[end_idx + 1 :].strip()
                if not rest or rest.startswith("#"):
                    v = v[1:end_idx]
        else:
            v = re.split(r"\s+#", v, maxsplit=1)[0].strip()
        parsed[k] = v
    return parsed


def gvariant_quote(text):
    out = ['"']
    for ch in text:
        cp = ord(ch)
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif 0x20 <= cp <= 0x7E:
            out.append(ch)
        elif cp <= 0xFFFF:
            out.append(f"\\u{cp:04x}")
        else:
            out.append(f"\\U{cp:08x}")
    out.append('"')
    return "".join(out)


repo_dir = Path(sys.argv[1])
raw_name = sys.argv[2].strip()
slug = (raw_name or "solarized-dark").lower().replace("_", "-")
if not SLUG_RE.match(slug):
    sys.stderr.write(f"Error: Unknown theme '{raw_name}'\n")
    sys.exit(1)

xdg_cfg = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
user_dir_1 = Path(os.environ.get("HOME_SETTINGS_USER_THEMES_DIR", str(xdg_cfg / "themes")))
user_dir_2 = xdg_cfg / "home-settings" / "themes"

parsed = None
direct_user_candidates = [
    user_dir_1 / f"{slug}.theme",
    user_dir_1 / f"{slug}.conf",
    user_dir_2 / f"{slug}.theme",
    user_dir_2 / f"{slug}.conf",
]
for cand in direct_user_candidates:
    if cand.is_file():
        parsed = parse_theme_kv(cand)
        break

if parsed is None:
    for udir in (user_dir_1, user_dir_2):
        if not udir.is_dir():
            continue
        for cand in sorted(list(udir.glob("*.theme")) + list(udir.glob("*.conf"))):
            if not cand.is_file():
                continue
            kv = parse_theme_kv(cand)
            cand_id = kv.get("THEME_ID", cand.stem).strip().lower().replace("_", "-")
            if cand_id == slug:
                parsed = kv
                break
        if parsed is not None:
            break

if parsed is None:
    builtin_cand = repo_dir / "colors" / "themes" / f"{slug}.theme"
    if builtin_cand.is_file():
        parsed = parse_theme_kv(builtin_cand)

if parsed is None:
    active_snap = xdg_cfg / "home-settings" / "active-theme.theme"
    if active_snap.is_file():
        kv = parse_theme_kv(active_snap)
        if kv.get("THEME_ID", "").strip().lower().replace("_", "-") == slug:
            parsed = kv

if parsed is None:
    if slug == "solarized-dark":
        parsed = {"THEME_ID": "solarized-dark", "THEME_LABEL": "Solarized Dark"}
    else:
        sys.stderr.write(f"Error: Unknown theme '{raw_name or slug}'\n")
        sys.exit(1)

mode = parsed.get("THEME_MODE", "dark").strip().lower()
base = dict(LIGHT_DEFAULTS if mode == "light" else DARK_DEFAULTS)
base.update(parsed)
label = base.get("THEME_LABEL") or " ".join(w.capitalize() for w in slug.split("-") if w)
for ck in COLOR_KEYS:
    val = base.get(ck, "").strip()
    if not HEX_RE.match(val):
        sys.stderr.write(f"Error: Invalid hex color {ck}='{val}' in theme '{slug}'\n")
        sys.exit(1)
    base[ck] = val.upper()

fields = [label, gvariant_quote(label)] + [base[ck] for ck in COLOR_KEYS]
sys.stdout.write("\0".join(fields) + "\0")
PY

THEME_BLOB_FILE="$(mktemp)"
if ! python3 -c "$RESOLVE_THEME_PY" "$REPO_DIR" "$THEME_NAME" > "$THEME_BLOB_FILE"; then
    rm -f "$THEME_BLOB_FILE"
    exit 1
fi
{
    IFS= read -r -d '' THEME_LABEL
    IFS= read -r -d '' GVARIANT_VISIBLE_NAME
    IFS= read -r -d '' BASE03
    IFS= read -r -d '' BASE02
    IFS= read -r -d '' BASE01
    IFS= read -r -d '' BASE00
    IFS= read -r -d '' BASE0
    IFS= read -r -d '' BASE1
    IFS= read -r -d '' BASE2
    IFS= read -r -d '' BASE3
    IFS= read -r -d '' YELLOW
    IFS= read -r -d '' ORANGE
    IFS= read -r -d '' RED
    IFS= read -r -d '' MAGENTA
    IFS= read -r -d '' VIOLET
    IFS= read -r -d '' BLUE
    IFS= read -r -d '' CYAN
    IFS= read -r -d '' GREEN
} < "$THEME_BLOB_FILE"
rm -f "$THEME_BLOB_FILE"
PROFILE_NAME="$THEME_LABEL"

# Check if GNOME Terminal and dconf/gsettings tooling are available
if ! command -v dconf >/dev/null 2>&1 || ! command -v gsettings >/dev/null 2>&1; then
    echo "  dconf or gsettings not found; skipping GNOME Terminal configuration."
    exit 0
fi

uid_val="$(id -u)"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$uid_val/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid_val/bus"
fi

schemas="$(gsettings list-schemas 2>/dev/null || true)"
if ! grep -Fq "org.gnome.Terminal.ProfilesList" <<< "$schemas"; then
    echo "  GNOME Terminal schema not installed; skipping GNOME Terminal configuration."
    exit 0
fi

echo "  Configuring GNOME Terminal with authentic $PROFILE_NAME profile..."

if [ "$DRY_RUN" = true ]; then
    echo "  [DryRun] Apply $PROFILE_NAME profile ($PROFILE_UUID) to /org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/"
    echo "  [DryRun] Set /org/gnome/terminal/legacy/profiles:/default to '$PROFILE_UUID'"
    echo "  [DryRun] Remove legacy custom profile ($LEGACY_PROFILE_UUID) if present"
    exit 0
fi

# Load base profile configuration (font, cursor shape, blink mode, bold settings)
if [ -f "$DCONF_FILE" ]; then
    dconf load "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/" < "$DCONF_FILE"
else
    # Fallback to direct dconf writes if asset file is not found
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/visible-name" "$GVARIANT_VISIBLE_NAME"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/use-theme-colors" "false"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/use-theme-transparency" "false"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/background-color" "'#002B36'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/foreground-color" "'#839496'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/bold-color" "'#93A1A1'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/bold-color-same-as-fg" "false"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-colors-set" "true"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-background-color" "'#839496'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-foreground-color" "'#002B36'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-shape" "'block'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-blink-mode" "'off'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/highlight-colors-set" "true"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/highlight-background-color" "'#073642'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/highlight-foreground-color" "'#93A1A1'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/use-system-font" "false"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/font" "'MesloLGS Nerd Font Mono 12'"
    dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/palette" "['#073642', '#DC322F', '#859900', '#B58900', '#268BD2', '#D33682', '#2AA198', '#EEE8D5', '#586E75', '#CB4B16', '#586E75', '#657B83', '#839496', '#6C71C4', '#93A1A1', '#FDF6E3']"
fi

dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/visible-name" "$GVARIANT_VISIBLE_NAME"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/background-color" "'$BASE03'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/foreground-color" "'$BASE0'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/bold-color" "'$BASE1'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-background-color" "'$BASE0'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/cursor-foreground-color" "'$BASE03'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/highlight-background-color" "'$BASE02'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/highlight-foreground-color" "'$BASE1'"
dconf write "/org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID/palette" "['$BASE02', '$RED', '$GREEN', '$YELLOW', '$BLUE', '$MAGENTA', '$CYAN', '$BASE2', '$BASE01', '$ORANGE', '$BASE01', '$BASE00', '$BASE0', '$VIOLET', '$BASE1', '$BASE3']"

# Clean up legacy custom profile keys if present
dconf reset -f "/org/gnome/terminal/legacy/profiles:/:$LEGACY_PROFILE_UUID/"

# Clean up empty factory profile if it has no custom settings
if [ -z "$(dconf dump "/org/gnome/terminal/legacy/profiles:/:$FACTORY_EMPTY_UUID/" 2>/dev/null || true)" ]; then
    dconf reset -f "/org/gnome/terminal/legacy/profiles:/:$FACTORY_EMPTY_UUID/"
fi

# Update profiles list and set default
CURRENT_LIST="$(dconf read /org/gnome/terminal/legacy/profiles:/list 2>/dev/null || echo "[]")"
NEW_LIST="$(python3 - "$CURRENT_LIST" "$LEGACY_PROFILE_UUID" "$FACTORY_EMPTY_UUID" "$PROFILE_UUID" <<'PY' 2>/dev/null || echo "['$PROFILE_UUID']"
import ast
import sys

val, legacy_uuid, factory_uuid, profile_uuid = sys.argv[1:5]
try:
    parsed_list = ast.literal_eval(val.strip()) if val.strip() else []
    if not isinstance(parsed_list, list):
        parsed_list = []
except Exception:
    parsed_list = []

parsed_list = [u for u in parsed_list if u not in (legacy_uuid, factory_uuid)]
if profile_uuid not in parsed_list:
    parsed_list.append(profile_uuid)
print(repr(parsed_list))
PY
)"

dconf write /org/gnome/terminal/legacy/profiles:/list "$NEW_LIST"
dconf write /org/gnome/terminal/legacy/profiles:/default "'$PROFILE_UUID'"

# Ensure menu bar mnemonics (Alt+f, Alt+e, Alt+h, etc.) are disabled so Alt+h/j/k/l pass cleanly to Tmux/Neovim
gsettings set org.gnome.Terminal.Legacy.Settings mnemonics-enabled false 2>/dev/null || \
    dconf write /org/gnome/terminal/legacy/mnemonics-enabled "false" 2>/dev/null || true

# Ensure no profile (in list or lingering) retains legacy MesloLGS NF font
for prof in $(dconf list /org/gnome/terminal/legacy/profiles:/ 2>/dev/null | grep '^:' | tr -d ':/' || true); do
    p_font="$(dconf read "/org/gnome/terminal/legacy/profiles:/:$prof/font" 2>/dev/null || true)"
    if [ "$p_font" = "'MesloLGS NF 12'" ] || [ "$p_font" = "'MesloLGS Nerd Font 12'" ]; then
        dconf write "/org/gnome/terminal/legacy/profiles:/:$prof/font" "'MesloLGS Nerd Font Mono 12'"
    fi
done

echo "  GNOME Terminal profile '$PROFILE_NAME' successfully configured as default."

