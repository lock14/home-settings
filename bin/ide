#!/usr/bin/env bash
# ==============================================================================
# bin/ide — Hybrid Terminal IDE Workspace Launcher (Tmux + Neovim RPC + AI)
# ==============================================================================
# Default Layout (--3pane, 3-pane hybrid with In-Place Main Pane Toggle):
#   - Left Pane (20% width, full height): Persistent Directory Tree (`SolarizedIdeTree`)
#   - Top-Right Main Pane (80% width, 75% height): Toggles in-place (Alt+a / Space+a / Ctrl+b a)
#     between Neovim (listening on $NVIM_IDE_SOCKET) and the AI Agent CLI
#     controlled by $IDE_AI_CLI (agy | claude | codex)
#   - Bottom-Right Pane (80% width, 25% height): Permanently anchored interactive shell
#   - Floating Modal (Alt+Shift+a): Optional overlay popup
#
# Optional Layout (--2pane):
#   - Top Main Pane (75% height): Toggles in-place between Neovim and AI Agent CLI
#   - Bottom Pane (25% height): Permanently anchored interactive shell
# ==============================================================================

set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

usage() {
    cat <<'EOF'
Usage: ide [OPTIONS] [DIRECTORY]

Launch or attach to a Solarized Dark Tmux + Neovim IDE workspace session.

Options:
  --3pane                  Launch default 3-pane hybrid layout (Left 20% Directory Tree, Top-Right 80%x75% Main [Editor <-> AI], Bottom-Right 80%x25% Shell)
  --2pane                  Launch 2-pane hybrid layout (Top 75% Main [Editor <-> AI], Bottom 25% Shell)
  --ai, --agent <CLI>      Select AI CLI agent: agy (default), claude, or codex (overrides $IDE_AI_CLI)
  --open <FILE>            Open <FILE> in the Main Editor pane via RPC and focus Editor
  --preview <FILE>         Preview <FILE> in the Main Editor pane via RPC while keeping focus in Tree
  cd, --cd [DIR]           Dive into <DIR> (or --reset / ~ for initial root), setting Working Directory across Tree, Editor, Shell, and AI
  --toggle [SESSION]       Toggle the Main Pane in-place between the Text Editor and the AI Agent
  --show-editor [SESSION]  Ensure the Text Editor pane is swapped into the Main Pane and focused
  --show-ai [SESSION]      Ensure the AI Agent pane is swapped into the Main Pane and focused
  quit, -q, --quit         Safely quit the entire IDE workspace (checks for unsaved Neovim buffers first)
  -f, --force              Force-quit when used with --quit (discards unsaved Neovim buffers)
  --detach                 Create/update workspace session in background without attaching
  --kill [NAME]            Terminate the specified IDE session (or current directory's session)
  --list                   List active tmux IDE sessions
  -h, --help               Show this help message and exit

Environment Variables:
  IDE_AI_CLI               AI CLI tool for the Main Pane toggle: agy (default), claude, or codex
EOF
}

if ! command -v tmux >/dev/null 2>&1; then
    echo "Error: 'tmux' is not installed. Run './setup.sh' to install core packages." >&2
    exit 1
fi

LAYOUT_MODE="3pane"
ACTION="launch"
DETACH_MODE="${IDE_NO_ATTACH:-0}"
FORCE_QUIT="0"
AI_CLI="${IDE_AI_CLI:-agy}"
AI_CLI_FROM_FLAG="0"
TARGET_ARG=""
OPEN_FILE=""
CD_TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        --2pane)
            LAYOUT_MODE="2pane"
            shift
            ;;
        --3pane)
            LAYOUT_MODE="3pane"
            shift
            ;;
        --ai|--agent)
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: '$1' requires an argument (agy, claude, or codex)." >&2
                exit 1
            fi
            AI_CLI="$2"
            AI_CLI_FROM_FLAG="1"
            shift 2
            ;;
        --ai=*|--agent=*)
            AI_CLI="${1#*=}"
            AI_CLI_FROM_FLAG="1"
            shift
            ;;
        --open)
            ACTION="open"
            if [ $# -lt 2 ]; then
                echo "Error: '--open' requires a file path." >&2
                exit 1
            fi
            OPEN_FILE="$2"
            shift 2
            ;;
        --preview)
            ACTION="preview"
            if [ $# -lt 2 ]; then
                echo "Error: '--preview' requires a file path." >&2
                exit 1
            fi
            OPEN_FILE="$2"
            shift 2
            ;;
        cd|--cd)
            ACTION="cd"
            if [ $# -gt 1 ]; then
                CD_TARGET="$2"
                shift 2
            else
                CD_TARGET="$PWD"
                shift
            fi
            ;;
        --toggle)
            ACTION="toggle"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --show-editor)
            ACTION="show-editor"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --show-ai)
            ACTION="show-ai"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --run-ai-popup)
            ACTION="run-ai-popup"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --copy)
            ACTION="copy"
            shift
            ;;
        --paste)
            ACTION="paste"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --open-link)
            ACTION="open-link"
            LINK_HREF="${2:-}"
            LINK_WORD="${3:-}"
            LINK_CWD="${4:-}"
            shift $(( $# >= 4 ? 4 : $# ))
            ;;
        quit|-q|--quit)
            ACTION="quit"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        -f|--force)
            FORCE_QUIT="1"
            shift
            ;;
        --detach)
            DETACH_MODE="1"
            shift
            ;;
        --list)
            ACTION="list"
            shift
            ;;
        --kill)
            ACTION="kill"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option '$1'" >&2
            usage >&2
            exit 1
            ;;
        *)
            TARGET_ARG="$1"
            shift
            ;;
    esac
done

case "$AI_CLI" in
    agy|claude|codex)
        export IDE_AI_CLI="$AI_CLI"
        ;;
    openai)
        export IDE_AI_CLI="codex"
        ;;
    *)
        if command -v "$AI_CLI" >/dev/null 2>&1 || [ -x "$AI_CLI" ] || [ "$AI_CLI_FROM_FLAG" = "0" ]; then
            export IDE_AI_CLI="$AI_CLI"
        else
            echo "Error: Invalid AI CLI '$AI_CLI'. Supported values are: agy, claude, codex (or an executable on PATH)." >&2
            exit 1
        fi
        ;;
esac

resolve_ai_cmd() {
    local cli="$1"
    case "$cli" in
        claude)
            if command -v claude >/dev/null 2>&1; then
                printf "claude"
                return 0
            fi
            ;;
        codex|openai)
            if command -v codex >/dev/null 2>&1; then
                printf "codex"
                return 0
            fi
            ;;
        agy)
            if command -v agy >/dev/null 2>&1; then
                printf "agy"
                return 0
            fi
            ;;
        *)
            if command -v "$cli" >/dev/null 2>&1 || [ -x "$cli" ]; then
                printf "%s" "$cli"
                return 0
            else
                printf "%s -ic %q" "${SHELL:-/bin/zsh}" "$cli"
                return 0
            fi
            ;;
    esac

    # Fallback chain if selected preset is not installed: agy -> claude -> codex
    if command -v agy >/dev/null 2>&1; then
        printf "agy"
        return 0
    elif command -v claude >/dev/null 2>&1; then
        printf "claude"
        return 0
    elif command -v codex >/dev/null 2>&1; then
        printf "codex"
        return 0
    fi
    return 1
}

sanitize_session_name() {
    local raw="$1"
    local cleaned
    cleaned="$(basename "$raw" | tr '.: ' '---' | tr -cd '[:alnum:]_-')"
    if [ -z "$cleaned" ]; then
        cleaned="workspace"
    fi
    printf "ide-%s" "$cleaned"
}

resolve_target_session() {
    local arg="${1:-}"
    if [ -n "$arg" ]; then
        if [[ "$arg" == ide-* ]]; then
            printf "%s" "$arg"
        elif [ -d "$arg" ]; then
            sanitize_session_name "$(cd "$arg" && pwd)"
        else
            printf "ide-%s" "$(printf "%s" "$arg" | tr '.: ' '---' | tr -cd '[:alnum:]_-')"
        fi
    elif [ -n "${TMUX:-}" ]; then
        tmux display-message -p "#{session_name}" 2>/dev/null || sanitize_session_name "$PWD"
    else
        sanitize_session_name "$PWD"
    fi
}

get_ide_var() {
    local sess="$1"
    local opt_name="$2"
    local env_name="$3"
    local val
    val="$(tmux show-options -qv -t "$sess" "$opt_name" 2>/dev/null || true)"
    if [ -z "$val" ]; then
        val="$(tmux show-environment -t "$sess" "$env_name" 2>/dev/null | sed -n "s/^${env_name}=//p")"
    fi
    printf "%s" "$val"
}

set_ide_var() {
    local sess="$1"
    local opt_name="$2"
    local env_name="$3"
    local val="$4"
    tmux set-option -q -t "$sess" "$opt_name" "$val" 2>/dev/null || true
    tmux set-environment -t "$sess" "$env_name" "$val" 2>/dev/null || true
}

pane_exists() {
    local pane="${1:-}"
    [ -n "$pane" ] && [ "$(tmux display-message -p -t "$pane" "#{pane_id}" 2>/dev/null || true)" = "$pane" ]
}

window_exists() {
    local win="${1:-}"
    [ -n "$win" ] && [ "$(tmux display-message -p -t "$win" "#{window_id}" 2>/dev/null || true)" = "$win" ]
}

resolve_role_pane() {
    local sess="$1"
    local role="$2"
    local opt_name="$3"
    local env_name="$4"
    local pane
    pane="$(get_ide_var "$sess" "$opt_name" "$env_name")"
    if ! pane_exists "$pane"; then
        pane="$(tmux list-panes -s -t "$sess" -F "#{pane_id} #{@ide_role}" 2>/dev/null | awk -v r="$role" '$2 == r { print $1; exit }')"
        if [ -n "$pane" ]; then
            set_ide_var "$sess" "$opt_name" "$env_name" "$pane"
        fi
    fi
    printf "%s" "$pane"
}

toggle_main_pane() {
    local mode="${1:-toggle}" # toggle | editor | ai
    local sess
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! tmux has-session -t "$sess" 2>/dev/null; then
        echo "Error: No active tmux session '$sess'." >&2
        return 1
    fi

    local main_win editor_pane ai_pane term_pane tree_pane layout_mode ai_cli cur_dir sock
    main_win="$(get_ide_var "$sess" "@ide_main_win" "IDE_MAIN_WIN")"
    tree_pane="$(resolve_role_pane "$sess" "tree" "@ide_tree_pane" "IDE_TREE_PANE")"
    editor_pane="$(resolve_role_pane "$sess" "editor" "@ide_editor_pane" "NVIM_IDE_PANE")"
    ai_pane="$(resolve_role_pane "$sess" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
    term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"
    layout_mode="$(get_ide_var "$sess" "@ide_layout_mode" "IDE_LAYOUT_MODE")"
    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    [ -z "$sock" ] && sock="${XDG_RUNTIME_DIR:-/tmp}/nvim-ide-${sess}.sock"
    ai_cli="$(get_ide_var "$sess" "@ide_ai_cli" "IDE_AI_CLI")"
    [ -z "$ai_cli" ] && ai_cli="${IDE_AI_CLI:-agy}"

    if ! window_exists "$main_win"; then
        if pane_exists "$term_pane"; then
            main_win="$(tmux display-message -p -t "$term_pane" "#{window_id}")"
        elif pane_exists "$tree_pane"; then
            main_win="$(tmux display-message -p -t "$tree_pane" "#{window_id}")"
        else
            main_win="$(tmux list-windows -t "$sess" -F "#{window_id} #{window_name}" | awk '$2 != "_swap" { print $1; exit }')"
        fi
        set_ide_var "$sess" "@ide_main_win" "IDE_MAIN_WIN" "$main_win"
    fi

    # Geometry fallback if session was created before per-pane @ide_role tags existed:
    # In a 3-pane layout, Left is at left=0, Top-Right Editor is at left>0 && top==0, Bottom-Right Term is at top>0
    if ! pane_exists "$tree_pane"; then
        local win_pane_cnt
        win_pane_cnt="$(tmux list-panes -t "$main_win" | wc -l | tr -d ' ')"
        if [ "${win_pane_cnt:-0}" -ge 3 ]; then
            tree_pane="$(tmux list-panes -t "$main_win" -F "#{pane_left} #{pane_top} #{pane_id}" | sort -n -k1,1 -k2,2 | awk 'NR==1 { print $3 }')"
            tmux set-option -p -t "$tree_pane" @ide_role "tree" 2>/dev/null || true
            set_ide_var "$sess" "@ide_tree_pane" "IDE_TREE_PANE" "$tree_pane"
        fi
    fi

    if ! pane_exists "$editor_pane" || [ "$editor_pane" = "$tree_pane" ]; then
        editor_pane="$(tmux list-panes -t "$main_win" -F "#{pane_top} #{pane_left} #{pane_id}" | awk -v tp="$tree_pane" -v tm="$term_pane" '$3 != tp && $3 != tm { print $1, $2, $3 }' | sort -n -k1,1 -k2,2r | awk 'NR==1 { print $3 }')"
        if [ -n "$editor_pane" ]; then
            tmux set-option -p -t "$editor_pane" @ide_role "editor" 2>/dev/null || true
            set_ide_var "$sess" "@ide_editor_pane" "NVIM_IDE_PANE" "$editor_pane"
        fi
    fi

    cur_dir="$(tmux display-message -p -t "$editor_pane" "#{pane_current_path}" 2>/dev/null || pwd)"

    # Unzoom main window prior to any split/swap so geometry is preserved
    if [ "$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "1" ]; then
        tmux resize-pane -Z -t "$main_win"
    fi

    # Lazily provision the persistent Left Directory Pane ONLY if main_win has < 3 panes and not in --2pane mode
    if [ "${layout_mode:-3pane}" != "2pane" ]; then
        if ! pane_exists "$tree_pane"; then
            [ -n "$sock" ] && rm -f "${sock}.tree"
            tree_pane="$(tmux split-window -f -h -b -P -F "#{pane_id}" -t "$main_win" -l 20% -c "$cur_dir")"
            tmux set-option -p -t "$tree_pane" @ide_role "tree" 2>/dev/null || true
            set_ide_var "$sess" "@ide_tree_pane" "IDE_TREE_PANE" "$tree_pane"
            set_ide_var "$sess" "@ide_layout_mode" "IDE_LAYOUT_MODE" "3pane"
            if command -v nvim >/dev/null 2>&1; then
                tmux send-keys -t "$tree_pane" "IDE_INITIAL_ROOT='$cur_dir' NVIM_IDE_TREE=1 NVIM_IDE_SOCKET='$sock' nvim --listen '${sock}.tree' ." C-m
            fi
        fi
    fi

    # Lazily create or recreate the background AI pane if not yet present
    if ! pane_exists "$ai_pane"; then
        ai_pane="$(tmux new-window -d -P -F "#{pane_id}" -t "${sess}:" -n "_swap" -c "$cur_dir")"
        tmux set-option -p -t "$ai_pane" @ide_role "ai" 2>/dev/null || true
        set_ide_var "$sess" "@ide_ai_pane" "IDE_AI_PANE" "$ai_pane"
        local ai_run_cmd
        if ai_run_cmd="$(resolve_ai_cmd "$ai_cli")"; then
            tmux send-keys -t "$ai_pane" "$ai_run_cmd" C-m
        fi
    fi

    local editor_win swap_win
    editor_win="$(tmux display-message -p -t "$editor_pane" "#{window_id}")"

    if [ "$editor_win" = "$main_win" ]; then
        # Editor is currently occupying the Top-Right Main Pane
        if [ "$mode" = "editor" ]; then
            tmux select-window -t "$main_win"
            tmux select-pane -t "$editor_pane"
            return 0
        fi
        tmux swap-pane -d -s "$editor_pane" -t "$ai_pane"
        swap_win="$(tmux display-message -p -t "$editor_pane" "#{window_id}")"
        tmux rename-window -t "$swap_win" "_swap" 2>/dev/null || true
        tmux rename-window -t "$main_win" "ai" 2>/dev/null || true
        tmux select-window -t "$main_win"
        tmux select-pane -t "$ai_pane"
    else
        # AI Agent is currently occupying the Top-Right Main Pane
        if [ "$mode" = "ai" ]; then
            tmux select-window -t "$main_win"
            tmux select-pane -t "$ai_pane"
            return 0
        fi
        tmux swap-pane -d -s "$ai_pane" -t "$editor_pane"
        swap_win="$(tmux display-message -p -t "$ai_pane" "#{window_id}")"
        tmux rename-window -t "$swap_win" "_swap" 2>/dev/null || true
        tmux rename-window -t "$main_win" "code" 2>/dev/null || true
        if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
            nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
        fi
        tmux select-window -t "$main_win"
        tmux select-pane -t "$editor_pane"
    fi
}

open_in_editor() {
    local filepath="$1"
    local focus="${2:-1}"
    local sess sock tree_pane dir base
    if [[ "$filepath" != /* ]]; then
        dir="$(dirname -- "$filepath")"
        base="$(basename -- "$filepath")"
        if [ -d "$dir" ]; then
            filepath="$(cd -- "$dir" && pwd -P)/$base"
        else
            filepath="$PWD/${filepath#./}"
        fi
    fi
    sess="$(resolve_target_session "$TARGET_ARG")"
    toggle_main_pane "editor"
    tree_pane="$(get_ide_var "$sess" "@ide_tree_pane" "IDE_TREE_PANE")"
    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-expr "execute(\"if (&filetype ==# 'netrw' || &filetype ==# 'ide_tree') && winnr('\\$') > 1 | wincmd p | endif\")" >/dev/null 2>&1 || true
        nvim --headless --server "$sock" --remote "$filepath" >/dev/null 2>&1 || true
    fi
    if [ "$focus" = "0" ] && pane_exists "$tree_pane"; then
        tmux select-pane -t "$tree_pane"
    fi
}

run_ai_popup() {
    local sess
    sess="$(resolve_target_session "$TARGET_ARG")"
    tmux set-option -t "ai-${sess}" status off >/dev/null 2>&1 || true
    local ai_cli
    ai_cli="$(get_ide_var "$sess" "@ide_ai_cli" "IDE_AI_CLI")"
    [ -z "$ai_cli" ] && ai_cli="${IDE_AI_CLI:-agy}"
    local ai_cmd
    if ai_cmd="$(resolve_ai_cmd "$ai_cli")"; then
        eval "$ai_cmd" || true
    fi
    exec "${SHELL:-/bin/zsh}" -l
}

quit_ide() {
    local sess sock modified mod_expr
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! tmux has-session -t "$sess" 2>/dev/null; then
        echo "No active IDE session named '$sess'."
        return 0
    fi

    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    if [ "$FORCE_QUIT" != "1" ] && [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        mod_expr='len(filter(getbufinfo({"bufmodified": 1}), "getbufvar(v:val.bufnr, \"&buftype\") ==# \"\" && (!empty(v:val.name) || join(getbufline(v:val.bufnr, 1, \"$\"), \"\") !~# \"^\\\\s*$\")"))'
        modified="$(nvim --headless --server "$sock" --remote-expr "$mod_expr" 2>/dev/null | tr -cd '0-9' || echo 0)"
        if [ "${modified:-0}" -gt 0 ] 2>/dev/null; then
            toggle_main_pane "editor" || true
            nvim --headless --server "$sock" --remote-send "<C-\\><C-n>:redraw! | echohl ErrorMsg | echo \"Unsaved changes in ${modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q (:Q!) to force-quit\" | echohl None<CR>" >/dev/null 2>&1 || true
            tmux display-message -d 4000 -t "$sess" "Unsaved changes in ${modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q to force-quit" 2>/dev/null || true
            echo "Aborted quit: unsaved changes in Neovim buffer(s). Save first or use 'ide quit --force' (Alt+Shift+Q)." >&2
            return 1
        fi
    fi

    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-send "<C-\\><C-n>:qa!<CR>" >/dev/null 2>&1 || true
    fi

    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
    rm -f "$sock" "${sock}.tree" "${RUNTIME_DIR}/nvim-${sess}.sock" "${RUNTIME_DIR}/nvim-ide-${sess}.sock" "${RUNTIME_DIR}/nvim-ide-${sess}.sock.tree"
    tmux kill-session -t "ai-${sess}" 2>/dev/null || true
    tmux kill-session -t "agy-${sess}" 2>/dev/null || true
    tmux kill-session -t "$sess" 2>/dev/null || true
}

cd_ide_workspace() {
    local raw_target="${1:-$PWD}"
    local sess init_root cur_workdir target_dir sock tree_sock tree_pane term_pane ai_pane ai_cli ai_run_cmd term_cmd term_path escaped_dir
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! tmux has-session -t "$sess" 2>/dev/null; then
        echo "Error: No active IDE session '$sess'." >&2
        return 1
    fi

    init_root="$(get_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT")"
    cur_workdir="$(get_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR")"
    [ -z "$cur_workdir" ] && cur_workdir="${init_root:-$PWD}"

    if [ "$raw_target" = "--reset" ] || [ "$raw_target" = "~" ] || [ "$raw_target" = "-" ]; then
        if [ -n "$init_root" ] && [ -d "$init_root" ]; then
            target_dir="$init_root"
        else
            target_dir="$cur_workdir"
        fi
    elif [[ "$raw_target" == /* ]]; then
        target_dir="$raw_target"
    else
        if [ -d "$cur_workdir/$raw_target" ]; then
            target_dir="$cur_workdir/$raw_target"
        elif [ -n "$init_root" ] && [ -d "$init_root/$raw_target" ]; then
            target_dir="$init_root/$raw_target"
        else
            target_dir="$PWD/$raw_target"
        fi
    fi

    if [ ! -d "$target_dir" ]; then
        echo "Error: Directory '$target_dir' does not exist." >&2
        return 1
    fi
    target_dir="$(cd "$target_dir" && pwd -P)"
    [ -z "$init_root" ] && set_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT" "$target_dir"
    set_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR" "$target_dir"

    # 0. Update Tmux session default working directory for new panes/popups
    tmux attach-session -t "$sess" -c "$target_dir" >/dev/null 2>&1 || true

    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    tree_sock="${sock}.tree"
    tree_pane="$(resolve_role_pane "$sess" "tree" "@ide_tree_pane" "IDE_TREE_PANE")"
    term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"
    ai_pane="$(resolve_role_pane "$sess" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
    ai_cli="$(get_ide_var "$sess" "@ide_ai_cli" "IDE_AI_CLI")"
    [ -z "$ai_cli" ] && ai_cli="${IDE_AI_CLI:-agy}"

    escaped_dir="${target_dir//\'/\'\'}"

    # 1. Re-root Left Directory Tree (@ide_role=tree)
    if [ -n "$sock" ] && [ -S "$tree_sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$tree_sock" --remote-expr "v:lua.IdeTree.set_root('$escaped_dir')" >/dev/null 2>&1 || true
    elif pane_exists "$tree_pane"; then
        tmux send-keys -t "$tree_pane" Escape ":lua if _G.IdeTree then _G.IdeTree.set_root('$escaped_dir') end" C-m
    fi

    # 2. Update Top-Right Main Neovim Editor (@ide_role=editor) working directory
    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-expr "execute('cd ' . fnameescape('$escaped_dir'))" >/dev/null 2>&1 || true
    fi

    # 3. Update Bottom-Right Terminal Shell (@ide_role=term) if idle at zsh/bash prompt
    if [ "${IDE_CD_SKIP_SHELL:-0}" != "1" ] && pane_exists "$term_pane"; then
        term_cmd="$(tmux display-message -p -t "$term_pane" "#{pane_current_command}" 2>/dev/null || true)"
        term_path="$(tmux display-message -p -t "$term_pane" "#{pane_current_path}" 2>/dev/null || true)"
        if [[ "$term_cmd" == zsh* || "$term_cmd" == bash* || "$term_cmd" == sh* ]] && [ "$term_path" != "$target_dir" ]; then
            tmux send-keys -t "$term_pane" C-u " builtin cd -- $(printf '%q' "$target_dir")" C-m
        fi
    fi

    # 4. Update AI Agent Pane (@ide_role=ai) working directory (respawn in $target_dir with --continue)
    if pane_exists "$ai_pane"; then
        local ai_cwd
        ai_cwd="$(tmux display-message -p -t "$ai_pane" "#{pane_current_path}" 2>/dev/null || true)"
        if [ "$ai_cwd" != "$target_dir" ]; then
            tmux respawn-pane -k -t "$ai_pane" -c "$target_dir" -e "IDE_AI_CLI=$ai_cli" -e "NVIM_IDE_SOCKET=$sock" 2>/dev/null || \
                tmux respawn-pane -k -t "$ai_pane" -c "$target_dir" "env IDE_AI_CLI='$ai_cli' NVIM_IDE_SOCKET='$sock' ${SHELL:-/bin/zsh} -l" 2>/dev/null || true
            if ai_run_cmd="$(resolve_ai_cmd "$ai_cli")"; then
                case "$ai_run_cmd" in
                    jetski-cli|claude)
                        tmux send-keys -t "$ai_pane" "$ai_run_cmd -c || $ai_run_cmd" C-m
                        ;;
                    *)
                        tmux send-keys -t "$ai_pane" "$ai_run_cmd" C-m
                        ;;
                esac
            fi
        fi
    fi

    tmux display-message -d 2500 -t "$sess" "IDE Working Directory -> $target_dir" 2>/dev/null || true
}

copy_to_system_clipboard() {
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/ide-clip.XXXXXX")"
    cat > "$tmp"
    if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        tmux load-buffer "$tmp" 2>/dev/null || true
    fi
    if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xsel -ip < "$tmp" 2>/dev/null || true
        xsel -ib < "$tmp" 2>/dev/null || true
    elif command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        nohup xclip -selection primary -i < "$tmp" >/dev/null 2>&1 &
        nohup xclip -selection clipboard -i < "$tmp" >/dev/null 2>&1 &
    fi
    if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-copy --primary < "$tmp" >/dev/null 2>&1 || true
        wl-copy < "$tmp" >/dev/null 2>&1 || true
    fi
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy < "$tmp" 2>/dev/null || true
    fi
    rm -f "$tmp"
}

paste_from_system_clipboard() {
    local target_pane="${1:-}"
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/ide-paste.XXXXXX")"
    : > "$tmp"

    if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xsel -op > "$tmp" 2>/dev/null || true
        if [ ! -s "$tmp" ]; then
            xsel -ob > "$tmp" 2>/dev/null || true
        fi
    fi
    if [ ! -s "$tmp" ] && command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xclip -selection primary -t UTF8_STRING -o > "$tmp" 2>/dev/null || \
            xclip -selection primary -o > "$tmp" 2>/dev/null || \
            xclip -selection clipboard -t UTF8_STRING -o > "$tmp" 2>/dev/null || \
            xclip -selection clipboard -o > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v wl-paste >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-paste --primary --no-newline > "$tmp" 2>/dev/null || \
            wl-paste --no-newline > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v pbpaste >/dev/null 2>&1; then
        pbpaste > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v tmux >/dev/null 2>&1; then
        tmux show-buffer > "$tmp" 2>/dev/null || true
    fi

    if [ -s "$tmp" ] && command -v tmux >/dev/null 2>&1; then
        tmux load-buffer "$tmp" 2>/dev/null || true
        if [ -n "$target_pane" ]; then
            tmux paste-buffer -p -t "$target_pane" 2>/dev/null || true
        else
            tmux paste-buffer -p 2>/dev/null || true
        fi
    fi
    rm -f "$tmp"
}

open_browser_url() {
    local url="$1"
    [ -z "$url" ] && return 1
    if command -v xdg-open >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        nohup xdg-open "$url" >/dev/null 2>&1 &
        return 0
    elif command -v google-chrome >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        nohup google-chrome "$url" >/dev/null 2>&1 &
        return 0
    elif command -v open >/dev/null 2>&1; then
        nohup open "$url" >/dev/null 2>&1 &
        return 0
    fi
    return 1
}

open_ide_link() {
    local href="${1:-}"
    local word="${2:-}"
    local cwd="${3:-$PWD}"

    # 1. Explicit OSC 8 hyperlink (`#{mouse_hyperlink}`) from prompt (`//depot/...`, `@CL`, Git branch) or AI CLI (`file://...`)
    if [ -n "$href" ]; then
        if [[ "$href" == file://* ]]; then
            local fpath="${href#file://}"
            fpath="${fpath#localhost}"
            local line=""
            if [[ "$fpath" == *#L* ]]; then
                line="${fpath##*#L}"
                line="${line%%[^0-9]*}"
                fpath="${fpath%%#*}"
            fi
            if [ -f "$fpath" ]; then
                open_in_editor "$fpath" "1"
                if [ -n "$line" ]; then
                    local sess sock
                    sess="$(resolve_target_session "$TARGET_ARG")"
                    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
                    [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1 && nvim --headless --server "$sock" --remote-expr "execute('$line')" >/dev/null 2>&1 || true
                fi
                return 0
            elif [ -d "$fpath" ]; then
                cd_ide_workspace "$fpath"
                return 0
            fi
        elif [[ "$href" == http://* || "$href" == https://* ]]; then
            open_browser_url "$href"
            return $?
        fi
    fi

    # 2. Fallback to clicked word (`#{mouse_word}`) when clicking plain text or prompt tokens
    word="${word#"${word%%[![:space:]]*}"}"
    word="${word%"${word##*[![:space:]]}"}"
    # Strip surrounding punctuation/brackets/quotes
    word="${word#[\(\[\{\<\"\'\`]}"
    word="${word%[\)\]\}\>\"\'\`,;.]}"
    [ -z "$word" ] && return 0

    if [[ "$word" == http://* || "$word" == https://* ]]; then
        open_browser_url "$word"
        return $?
    elif [[ "$word" == //depot* ]]; then
        local exp_path="$word"
        exp_path="${exp_path/#\/\/depot\/google3\/j\/c\/g///depot/google3/java/com/google}"
        exp_path="${exp_path/#\/\/depot\/google3\/jt\/c\/g///depot/google3/javatests/com/google}"
        open_browser_url "http://cs/piper///depot/${exp_path#//depot/}"
        return $?
    elif [[ "$word" =~ ^@?([0-9]{6,10})$ ]]; then
        open_browser_url "http://cl/${BASH_REMATCH[1]}"
        return $?
    elif [[ "$word" =~ ^(cl|b|go)/([A-Za-z0-9_.-]+)$ ]]; then
        open_browser_url "http://${word}"
        return $?
    fi

    # Check if word is a local file path (optionally with :line:col)
    local clean_file="$word"
    local file_line=""
    if [[ "$clean_file" =~ ^([^:]+):([0-9]+)(:[0-9]+)?$ ]]; then
        clean_file="${BASH_REMATCH[1]}"
        file_line="${BASH_REMATCH[2]}"
    fi
    [[ "$clean_file" == \~/* ]] && clean_file="$HOME/${clean_file#\~/}"
    [[ "$clean_file" != /* && -n "$cwd" ]] && clean_file="$cwd/$clean_file"
    if [ -f "$clean_file" ]; then
        open_in_editor "$clean_file" "1"
        if [ -n "$file_line" ]; then
            local sess sock
            sess="$(resolve_target_session "$TARGET_ARG")"
            sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
            [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1 && nvim --headless --server "$sock" --remote-expr "execute('$file_line')" >/dev/null 2>&1 || true
        fi
        return 0
    fi
}

if [ "$ACTION" = "copy" ]; then
    copy_to_system_clipboard
    exit 0
elif [ "$ACTION" = "paste" ]; then
    paste_from_system_clipboard "$TARGET_ARG"
    exit 0
elif [ "$ACTION" = "open-link" ]; then
    open_ide_link "${LINK_HREF:-}" "${LINK_WORD:-}" "${LINK_CWD:-}"
    exit 0
elif [ "$ACTION" = "open" ]; then
    open_in_editor "$OPEN_FILE" "1"
    exit 0
elif [ "$ACTION" = "preview" ]; then
    open_in_editor "$OPEN_FILE" "0"
    exit 0
elif [ "$ACTION" = "cd" ]; then
    cd_ide_workspace "$CD_TARGET"
    exit $?
elif [ "$ACTION" = "toggle" ]; then
    toggle_main_pane "toggle"
    exit 0
elif [ "$ACTION" = "show-editor" ]; then
    toggle_main_pane "editor"
    exit 0
elif [ "$ACTION" = "show-ai" ]; then
    toggle_main_pane "ai"
    exit 0
elif [ "$ACTION" = "run-ai-popup" ]; then
    run_ai_popup
    exit 0
elif [ "$ACTION" = "quit" ]; then
    quit_ide
    exit $?
fi

if [ "$ACTION" = "list" ]; then
    tmux list-sessions 2>/dev/null || echo "No active tmux sessions."
    exit 0
fi

if [ "$ACTION" = "kill" ]; then
    FORCE_QUIT="1"
    quit_ide
    echo "Terminated IDE session: $(resolve_target_session "$TARGET_ARG")"
    exit 0
fi

TARGET_DIR="${TARGET_ARG:-$PWD}"
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

SESSION="$(sanitize_session_name "$TARGET_DIR")"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
NVIM_SOCKET="${RUNTIME_DIR}/nvim-ide-${SESSION}.sock"

# Ensure X11 / Wayland display & auth variables are populated for Tmux & Neovim clipboard (xclip / wl-copy)
if [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ]; then
    export DISPLAY=":0"
fi
uid_num="$(id -u 2>/dev/null || true)"
if [ -n "$uid_num" ] && [ -d "/run/user/$uid_num" ]; then
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$uid_num/wayland-0" ]; then
        export WAYLAND_DISPLAY="wayland-0"
    fi
    if [ -z "${XAUTHORITY:-}" ]; then
        for auth_candidate in "/run/user/$uid_num"/.mutter-Xwaylandauth.*; do
            if [ -f "$auth_candidate" ]; then
                export XAUTHORITY="$auth_candidate"
                break
            fi
        done
    fi
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    # Clean up any stale socket from an abnormal exit
    rm -f "$NVIM_SOCKET" "${NVIM_SOCKET}.tree"

    COLS="$(tput cols 2>/dev/null || echo 160)"
    LINES="$(tput lines 2>/dev/null || echo 48)"
    [ "$COLS" -lt 80 ] && COLS=160
    [ "$LINES" -lt 24 ] && LINES=48

    if [ "$LAYOUT_MODE" = "3pane" ]; then
        PANE_TREE="$(tmux new-session -d -P -F "#{pane_id}" -s "$SESSION" -n "code" -c "$TARGET_DIR" -x "$COLS" -y "$LINES" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
        MAIN_WIN="$(tmux display-message -p -t "$PANE_TREE" "#{window_id}")"
        tmux set-option -p -t "$PANE_TREE" @ide_role "tree"
        set_ide_var "$SESSION" "@ide_tree_pane" "IDE_TREE_PANE" "$PANE_TREE"
        PANE_EDITOR="$(tmux split-window -h -P -F "#{pane_id}" -t "$PANE_TREE" -l 80% -c "$TARGET_DIR" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
        NVIM_LAYOUT_ENV="0"
    else
        PANE_EDITOR="$(tmux new-session -d -P -F "#{pane_id}" -s "$SESSION" -n "code" -c "$TARGET_DIR" -x "$COLS" -y "$LINES" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
        MAIN_WIN="$(tmux display-message -p -t "$PANE_EDITOR" "#{window_id}")"
        NVIM_LAYOUT_ENV="1"
    fi

    tmux set-option -p -t "$PANE_EDITOR" @ide_role "editor"
    set_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI" "$IDE_AI_CLI"
    set_ide_var "$SESSION" "@ide_socket" "NVIM_IDE_SOCKET" "$NVIM_SOCKET"
    set_ide_var "$SESSION" "@ide_initial_root" "IDE_INITIAL_ROOT" "$TARGET_DIR"
    set_ide_var "$SESSION" "@ide_workdir" "IDE_WORKDIR" "$TARGET_DIR"
    set_ide_var "$SESSION" "@ide_main_win" "IDE_MAIN_WIN" "$MAIN_WIN"
    set_ide_var "$SESSION" "@ide_editor_pane" "NVIM_IDE_PANE" "$PANE_EDITOR"
    set_ide_var "$SESSION" "@ide_layout_mode" "IDE_LAYOUT_MODE" "$LAYOUT_MODE"

    PANE_TERM="$(tmux split-window -v -P -F "#{pane_id}" -t "$PANE_EDITOR" -l 25% -c "$TARGET_DIR" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "NVIM_IDE_PANE=$PANE_EDITOR" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
    tmux set-option -p -t "$PANE_TERM" @ide_role "term"
    set_ide_var "$SESSION" "@ide_term_pane" "IDE_TERM_PANE" "$PANE_TERM"

    # Create detached background AI Agent pane for instant in-place swapping (Alt+a)
    PANE_AI="$(tmux new-window -d -P -F "#{pane_id}" -t "${SESSION}:" -n "_swap" -c "$TARGET_DIR" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
    tmux set-option -p -t "$PANE_AI" @ide_role "ai"
    set_ide_var "$SESSION" "@ide_ai_pane" "IDE_AI_PANE" "$PANE_AI"

    if command -v nvim >/dev/null 2>&1; then
        if [ "$LAYOUT_MODE" = "3pane" ]; then
            tmux send-keys -t "$PANE_TREE" "IDE_INITIAL_ROOT='$TARGET_DIR' NVIM_IDE_TREE=1 NVIM_IDE_SOCKET='$NVIM_SOCKET' nvim --listen '${NVIM_SOCKET}.tree' ." C-m
        fi
        tmux send-keys -t "$PANE_EDITOR" "IDE_INITIAL_ROOT='$TARGET_DIR' NVIM_IDE_LAYOUT=$NVIM_LAYOUT_ENV NVIM_IDE_SOCKET='$NVIM_SOCKET' nvim --listen '$NVIM_SOCKET'" C-m
    elif command -v vim >/dev/null 2>&1; then
        if [ "$LAYOUT_MODE" = "3pane" ]; then
            tmux send-keys -t "$PANE_TREE" "vim ." C-m
        fi
        tmux send-keys -t "$PANE_EDITOR" "vim" C-m
    fi

    if AI_RUN_CMD="$(resolve_ai_cmd "$IDE_AI_CLI")"; then
        tmux send-keys -t "$PANE_AI" "$AI_RUN_CMD" C-m
    fi

    tmux select-window -t "$MAIN_WIN"
    tmux select-pane -t "$PANE_EDITOR"
else
    # Only update IDE_AI_CLI on an existing session when --ai was explicitly passed
    if [ "$AI_CLI_FROM_FLAG" = "1" ]; then
        EXISTING_AI_CLI="$(get_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI")"
        set_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI" "$IDE_AI_CLI"
        if [ "$IDE_AI_CLI" != "$EXISTING_AI_CLI" ]; then
            tmux kill-session -t "ai-${SESSION}" 2>/dev/null || true
            AI_PANE_ID="$(resolve_role_pane "$SESSION" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
            if pane_exists "$AI_PANE_ID"; then
                tmux respawn-pane -k -t "$AI_PANE_ID" -c "$TARGET_DIR" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" 2>/dev/null || \
                    tmux respawn-pane -k -t "$AI_PANE_ID" -c "$TARGET_DIR" "env IDE_AI_CLI='$IDE_AI_CLI' NVIM_IDE_SOCKET='$NVIM_SOCKET' ${SHELL:-/bin/zsh} -l" 2>/dev/null || true
                if AI_RUN_CMD="$(resolve_ai_cmd "$IDE_AI_CLI")"; then
                    tmux send-keys -t "$AI_PANE_ID" "$AI_RUN_CMD" C-m
                fi
            fi
        fi
    fi
fi

for display_var in DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS; do
    if [ -n "${!display_var:-}" ]; then
        tmux set-environment -t "$SESSION" "$display_var" "${!display_var}" 2>/dev/null || true
    fi
done

if [ "$DETACH_MODE" = "1" ]; then
    exit 0
fi

if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$SESSION"
else
    exec tmux attach-session -t "$SESSION"
fi
