#!/usr/bin/env bash
# ==============================================================================
# bin/ide — Hybrid Terminal IDE Workspace Launcher (Tmux + Neovim RPC + AI)
# ==============================================================================
# Default Layout (--3pane, Inverted-T AI-First, Single Neovim Server, Zero _swap Window):
#   - Top-Left Pane (50% width × 75% height): AI Agent CLI (@ide_role=ai, initial focus)
#     controlled by $IDE_AI_CLI (agy | claude | codex)
#   - Top-Right Pane (50% width × 75% height): Main Editor (@ide_role=editor)
#     listening on $NVIM_IDE_SOCKET with AI Live-Follow Mode (IdeFollow)
#     and in-process SolarizedIdeTree (<leader>e)
#   - Bottom Pane (100% width × 25% height): Full-Width Interactive Shell (@ide_role=term)
#   - Floating Modal (Alt+Shift+a): Optional overlay popup
#
# Optional Layout (--2pane):
#   - Left Pane (50% width × 100% height): AI Agent CLI (@ide_role=ai, initial focus)
#   - Right Pane (50% width × 100% height): Main Editor (@ide_role=editor)
# ==============================================================================

set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

usage() {
    cat <<'EOF'
Usage: ide [OPTIONS] [DIRECTORY]

Launch or attach to a Solarized Dark Tmux + Neovim IDE workspace session.

Options:
  --3pane                  Launch default 3-pane layout (Top-Left 50%x75% AI, Top-Right 50%x75% Editor, Bottom 100%x25% Shell)
  --2pane                  Launch 2-pane layout (Left 50%x100% AI, Right 50%x100% Editor)
  --ai, --agent <CLI>      Select AI CLI agent: agy (default), claude, or codex (overrides $IDE_AI_CLI)
  --open <FILE>            Open <FILE> in the Main Editor pane via RPC and focus Editor
  --preview <FILE>         Preview <FILE> in the Main Editor pane via RPC without changing focus
  cd, --cd [DIR]           Dive into <DIR> (or --reset / ~ for initial root), setting Working Directory across Editor and Shell
  --toggle [SESSION]       Toggle focus between the AI Agent and the Text Editor (unparking if hidden)
  --show-editor [SESSION]  Focus the Text Editor pane (unparking if hidden), or bounce back if already focused
  --show-ai [SESSION]      Focus the AI Agent pane (unparking if hidden), or bounce back if already focused
  --show-term [SESSION]    Focus the Interactive Shell pane (unparking if hidden), or bounce back if already focused
  --toggle-editor [SESSION] Hide or reappear the Text Editor pane (Alt+Shift+E)
  --toggle-ai [SESSION]    Hide or reappear the AI Agent pane
  --toggle-term [SESSION]  Hide or reappear the Interactive Shell pane (Alt+Shift+T)
  --swap <DIR> [SESSION]   Swap the active pane with its neighbor in <DIR> (left|down|up|right, Alt+Shift+H/J/K/L)
  quit, -q, --quit [NAME]  Safely quit IDE session NAME (checks for unsaved Neovim buffers first)
  -f, --force              Force-quit when used with --quit (discards unsaved Neovim buffers)
  --detach                 Create/update workspace session in background without attaching
  --kill [NAME]            Force-quit IDE session NAME without the unsaved-buffer check
  --list                   List active tmux IDE sessions
  -h, --help               Show this help message and exit

Without NAME / SESSION, session commands act only on the ide-* session of the calling pane
(outside tmux: the current directory's session), never on any other tmux session.

Environment Variables:
  IDE_AI_CLI               AI CLI tool for the AI Agent pane: agy (default), claude, or codex
  IDE_LINK_RULES           Untracked Ctrl+click link rules (default: ${XDG_CONFIG_HOME:-~/.config}/ide/links.sh)
                           defining `ide_resolve_link WORD CWD`, which prints a URL to open for WORD
EOF
}

if ! command -v tmux >/dev/null 2>&1; then
    echo "Error: 'tmux' is not installed. Run './setup.sh' to install core packages." >&2
    exit 1
fi

LAYOUT_MODE="3pane"
ACTION="launch"
DETACH_MODE="${IDE_NO_ATTACH:-0}"
FORCE_QUIT="0"
AI_CLI="${IDE_AI_CLI:-agy}"
AI_CLI_FROM_FLAG="0"
TARGET_ARG=""
OPEN_FILE=""
CD_TARGET=""
SWAP_DIR=""

while [ $# -gt 0 ]; do
    case "$1" in
        --2pane)
            LAYOUT_MODE="2pane"
            shift
            ;;
        --3pane)
            LAYOUT_MODE="3pane"
            shift
            ;;
        --ai|--agent)
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: '$1' requires an argument (agy, claude, or codex)." >&2
                exit 1
            fi
            AI_CLI="$2"
            AI_CLI_FROM_FLAG="1"
            shift 2
            ;;
        --ai=*|--agent=*)
            AI_CLI="${1#*=}"
            AI_CLI_FROM_FLAG="1"
            shift
            ;;
        --open)
            ACTION="open"
            if [ $# -lt 2 ]; then
                echo "Error: '--open' requires a file path." >&2
                exit 1
            fi
            OPEN_FILE="$2"
            shift 2
            ;;
        --preview)
            ACTION="preview"
            if [ $# -lt 2 ]; then
                echo "Error: '--preview' requires a file path." >&2
                exit 1
            fi
            OPEN_FILE="$2"
            shift 2
            ;;
        cd|--cd)
            ACTION="cd"
            if [ $# -gt 1 ]; then
                CD_TARGET="$2"
                shift 2
            else
                CD_TARGET="$PWD"
                shift
            fi
            ;;
        --toggle)
            ACTION="toggle"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --show-editor)
            ACTION="show-editor"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --focus-editor)
            ACTION="focus-editor"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --show-ai)
            ACTION="show-ai"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --show-term)
            ACTION="show-term"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --toggle-editor)
            ACTION="toggle-editor"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --toggle-ai)
            ACTION="toggle-ai"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --toggle-term)
            ACTION="toggle-term"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --swap)
            ACTION="swap"
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: '--swap' requires a direction (left, down, up, or right)." >&2
                exit 1
            fi
            SWAP_DIR="$2"
            if [ $# -gt 2 ] && [[ "$3" != -* ]]; then
                TARGET_ARG="$3"
                shift 3
            else
                shift 2
            fi
            ;;
        --swap=*)
            ACTION="swap"
            SWAP_DIR="${1#*=}"
            if [ -z "$SWAP_DIR" ]; then
                echo "Error: '--swap' requires a direction (left, down, up, or right)." >&2
                exit 1
            fi
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --run-ai-popup)
            ACTION="run-ai-popup"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --copy)
            ACTION="copy"
            shift
            ;;
        --paste)
            ACTION="paste"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        --open-link)
            ACTION="open-link"
            if [ $# -ge 4 ] && [ -d "${4:-}" ]; then
                LINK_HREF="${2:-}"
                LINK_WORD="${3:-}"
                LINK_CWD="${4:-}"
                if [ $# -ge 5 ]; then
                    TARGET_ARG="${5:-}"
                    shift 5
                else
                    shift 4
                fi
            elif [ $# -ge 3 ] && [ -d "${3:-}" ]; then
                # Unquoted empty #{q:mouse_hyperlink} collapsed: --open-link <word> <cwd> [session]
                LINK_HREF=""
                LINK_WORD="${2:-}"
                LINK_CWD="${3:-}"
                if [ $# -ge 4 ]; then
                    TARGET_ARG="${4:-}"
                    shift 4
                else
                    shift 3
                fi
            elif [ $# -ge 2 ] && [ -d "${2:-}" ]; then
                # Both #{q:mouse_hyperlink} and #{q:mouse_word} collapsed: --open-link <cwd> [session]
                LINK_HREF=""
                LINK_WORD=""
                LINK_CWD="${2:-}"
                if [ $# -ge 3 ]; then
                    TARGET_ARG="${3:-}"
                    shift 3
                else
                    shift 2
                fi
            else
                LINK_HREF="${2:-}"
                LINK_WORD="${3:-}"
                LINK_CWD="${4:-}"
                if [ $# -ge 5 ]; then
                    TARGET_ARG="${5:-}"
                    shift 5
                else
                    shift $(( $# >= 4 ? 4 : $# ))
                fi
            fi
            ;;
        quit|-q|--quit)
            ACTION="quit"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        -f|--force)
            FORCE_QUIT="1"
            shift
            ;;
        --detach)
            DETACH_MODE="1"
            shift
            ;;
        --list)
            ACTION="list"
            shift
            ;;
        --kill)
            ACTION="kill"
            if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
                TARGET_ARG="$2"
                shift 2
            else
                shift
            fi
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option '$1'" >&2
            usage >&2
            exit 1
            ;;
        *)
            TARGET_ARG="$1"
            shift
            ;;
    esac
done

case "$AI_CLI" in
    agy|claude|codex)
        export IDE_AI_CLI="$AI_CLI"
        ;;
    openai)
        export IDE_AI_CLI="codex"
        ;;
    *)
        if command -v "$AI_CLI" >/dev/null 2>&1 || [ -x "$AI_CLI" ] || [ "$AI_CLI_FROM_FLAG" = "0" ]; then
            export IDE_AI_CLI="$AI_CLI"
        else
            echo "Error: Invalid AI CLI '$AI_CLI'. Supported values are: agy, claude, codex (or an executable on PATH)." >&2
            exit 1
        fi
        ;;
esac

resolve_ai_cmd() {
    local cli="$1"
    case "$cli" in
        claude)
            if command -v claude >/dev/null 2>&1; then
                printf "claude"
                return 0
            fi
            ;;
        codex|openai)
            if command -v codex >/dev/null 2>&1; then
                printf "codex"
                return 0
            fi
            ;;
        agy)
            if command -v agy >/dev/null 2>&1; then
                printf "agy"
                return 0
            fi
            ;;
        *)
            if command -v "$cli" >/dev/null 2>&1 || [ -x "$cli" ]; then
                printf "%s" "$cli"
                return 0
            else
                printf "%s -ic %q" "${SHELL:-/bin/zsh}" "$cli"
                return 0
            fi
            ;;
    esac

    # Fallback chain if selected preset is not installed: agy -> claude -> codex
    if command -v agy >/dev/null 2>&1; then
        printf "agy"
        return 0
    elif command -v claude >/dev/null 2>&1; then
        printf "claude"
        return 0
    elif command -v codex >/dev/null 2>&1; then
        printf "codex"
        return 0
    fi
    return 1
}

sanitize_session_name() {
    local raw="$1"
    local cleaned
    cleaned="$(basename "$raw" | tr '.: ' '---' | tr -cd '[:alnum:]_-')"
    if [ -z "$cleaned" ]; then
        cleaned="workspace"
    fi
    printf "ide-%s" "$cleaned"
}

# Exact session lookup: when no session is named exactly NAME, a bare `-t NAME` falls back to
# prefix and pattern matching (`ide-api` would hit `ide-api-gateway`); `-t =NAME` never does.
# Pane- and window-type commands (show-options, set-option, display-message, list-panes) need
# `-t =NAME:` instead: tmux applies the `=` only to the part of the target the command expects.
session_exists() {
    [ -n "${1:-}" ] && tmux has-session -t "=$1" 2>/dev/null
}

missing_session_msg() {
    if [ -n "${1:-}" ]; then
        printf "No active IDE session named '%s'." "$1"
    else
        printf "Not inside an ide session (pass a session name, e.g. 'ide --quit ide-<dir>')."
    fi
}

# The ide session owning the calling pane ($TMUX_PANE), or the session a run-shell job was started
# for (the id at the end of $TMUX), looked up by exact id. tmux is never asked for "the current
# session" untargeted: once the caller's pane is gone (like the `ide --quit` job of an Editor whose
# session is being killed), it answers with the most recently used session, so a quit would land
# on an unrelated session and cascade through all of them. Prints nothing outside ide-* sessions.
current_ide_session() {
    local server_pid target found
    server_pid="${TMUX%,*}"
    server_pid="${server_pid##*,}"
    if [ -n "${TMUX_PANE:-}" ]; then
        target="$TMUX_PANE"
    else
        target="\$${TMUX##*,}"
    fi
    found="$(tmux display-message -p -t "$target" "#{pid} #{session_name}" 2>/dev/null || true)"
    # Another server pid means the caller's server is gone and a new one took over its socket
    [ "${found%% *}" = "$server_pid" ] || return 0
    case "${found#* }" in
        ide-*) printf "%s" "${found#* }" ;;
    esac
}

resolve_target_session() {
    local arg="${1:-}"
    if [ -n "$arg" ]; then
        if [[ "$arg" == ide-* ]]; then
            printf "%s" "$arg"
        elif [ -d "$arg" ]; then
            sanitize_session_name "$(cd "$arg" && pwd)"
        else
            printf "ide-%s" "$(printf "%s" "$arg" | tr '.: ' '---' | tr -cd '[:alnum:]_-')"
        fi
    elif [ -n "${TMUX:-}" ]; then
        current_ide_session
    else
        sanitize_session_name "$PWD"
    fi
}

get_ide_var() {
    local sess="$1"
    local opt_name="$2"
    local env_name="$3"
    local val
    val="$(tmux show-options -qv -t "=${sess}:" "$opt_name" 2>/dev/null || true)"
    if [ -z "$val" ]; then
        val="$(tmux show-environment -t "=$sess" "$env_name" 2>/dev/null | sed -n "s/^${env_name}=//p")"
    fi
    printf "%s" "$val"
}

set_ide_var() {
    local sess="$1"
    local opt_name="$2"
    local env_name="$3"
    local val="$4"
    tmux set-option -q -t "=${sess}:" "$opt_name" "$val" 2>/dev/null || true
    tmux set-environment -t "=$sess" "$env_name" "$val" 2>/dev/null || true
}

pane_exists() {
    local pane="${1:-}"
    [ -n "$pane" ] && [ "$(tmux display-message -p -t "$pane" "#{pane_id}" 2>/dev/null || true)" = "$pane" ]
}

window_exists() {
    local win="${1:-}"
    [ -n "$win" ] && [ "$(tmux display-message -p -t "$win" "#{window_id}" 2>/dev/null || true)" = "$win" ]
}

pane_in_win() {
    local pane="${1:-}"
    local win="${2:-}"
    [ -n "$pane" ] && [ -n "$win" ] && [ "$(tmux display-message -p -t "$pane" "#{window_id}" 2>/dev/null || true)" = "$win" ]
}

pane_is_parked() {
    local pane="${1:-}"
    local win="${2:-}"
    pane_exists "$pane" && [ -n "$win" ] && [ "$(tmux display-message -p -t "$pane" "#{window_id}" 2>/dev/null || true)" != "$win" ]
}

resolve_main_win() {
    local sess="$1"
    local editor_pane="${2:-}"
    local ai_pane="${3:-}"
    local term_pane="${4:-}"
    local main_win wname p
    main_win="$(get_ide_var "$sess" "@ide_main_win" "IDE_MAIN_WIN")"
    if window_exists "$main_win"; then
        wname="$(tmux display-message -p -t "$main_win" "#{window_name}" 2>/dev/null || true)"
        if [[ "$wname" != _ide_park_* ]]; then
            printf "%s" "$main_win"
            return 0
        fi
    fi
    for p in "$editor_pane" "$ai_pane" "$term_pane"; do
        if pane_exists "$p"; then
            wname="$(tmux display-message -p -t "$p" "#{window_name}" 2>/dev/null || true)"
            if [[ "$wname" != _ide_park_* ]]; then
                main_win="$(tmux display-message -p -t "$p" "#{window_id}" 2>/dev/null || true)"
                if [ -n "$main_win" ]; then
                    set_ide_var "$sess" "@ide_main_win" "IDE_MAIN_WIN" "$main_win"
                    printf "%s" "$main_win"
                    return 0
                fi
            fi
        fi
    done
    main_win="$(tmux list-windows -t "=$sess" -F "#{window_id} #{window_name}" 2>/dev/null | awk '$2 !~ /^_ide_park_/ { print $1; exit }')"
    if [ -z "$main_win" ]; then
        main_win="$(tmux list-windows -t "=$sess" -F "#{window_id}" 2>/dev/null | head -n 1)"
    fi
    if [ -n "$main_win" ]; then
        set_ide_var "$sess" "@ide_main_win" "IDE_MAIN_WIN" "$main_win"
    fi
    printf "%s" "$main_win"
}

resolve_role_pane() {
    local sess="$1"
    local role="$2"
    local opt_name="$3"
    local env_name="$4"
    local pane
    pane="$(get_ide_var "$sess" "$opt_name" "$env_name")"
    if ! pane_exists "$pane"; then
        pane="$(tmux list-panes -s -t "=${sess}:" -F "#{pane_id} #{@ide_role}" 2>/dev/null | awk -v r="$role" '$2 == r { print $1; exit }')"
        if [ -n "$pane" ]; then
            set_ide_var "$sess" "$opt_name" "$env_name" "$pane"
        fi
    fi
    printf "%s" "$pane"
}

focus_pane_preserving_zoom() {
    local win="$1"
    local target_pane="$2"
    local cur_pane was_zoomed
    cur_pane="$(tmux display-message -p -t "$win" "#{pane_id}" 2>/dev/null || true)"
    if [ -n "$cur_pane" ] && [ "$cur_pane" != "$target_pane" ]; then
        tmux set-option -w -t "$win" @ide_last_pane "$cur_pane" 2>/dev/null || true
    fi
    was_zoomed="$(tmux display-message -p -t "$win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)"
    tmux select-window -t "$win" 2>/dev/null || true
    tmux select-pane -t "$target_pane"
    if [ "$was_zoomed" = "1" ] && [ "$(tmux display-message -p -t "$win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "0" ]; then
        tmux resize-pane -Z -t "$target_pane"
    fi
}

clamp_dim() {
    local val="${1:-0}"
    local total="${2:-100}"
    local fallback="${3:-50}"
    local min_v=$(( total / 10 ))
    [ "$min_v" -lt 4 ] && min_v=4
    local max_v=$(( total - min_v ))
    [ "$max_v" -lt "$min_v" ] && max_v="$min_v"
    if ! [[ "$val" =~ ^[0-9]+$ ]] || [ "$val" -le 0 ]; then
        val="$fallback"
    fi
    [ "$val" -lt "$min_v" ] && val="$min_v"
    [ "$val" -gt "$max_v" ] && val="$max_v"
    printf "%s" "$val"
}

pane_for_role() {
    local role="$1"
    local ai_pane="$2"
    local editor_pane="$3"
    local term_pane="$4"
    case "$role" in
        ai)     printf "%s" "$ai_pane" ;;
        editor) printf "%s" "$editor_pane" ;;
        term)   printf "%s" "$term_pane" ;;
    esac
}

LAYOUT_BAR_ROLE="term"
LAYOUT_BAR_BEFORE="0"
LAYOUT_LEFT_ROLE="ai"
LAYOUT_RIGHT_ROLE="editor"
resolve_layout_roles() {
    local sess="$1"
    local ed_before term_before
    ed_before="$(get_ide_var "$sess" "@ide_editor_before" "IDE_EDITOR_BEFORE")"
    term_before="$(get_ide_var "$sess" "@ide_term_before" "IDE_TERM_BEFORE")"
    LAYOUT_BAR_ROLE="$(get_ide_var "$sess" "@ide_bar_role" "IDE_BAR_ROLE")"
    LAYOUT_BAR_BEFORE="$(get_ide_var "$sess" "@ide_bar_before" "IDE_BAR_BEFORE")"
    LAYOUT_LEFT_ROLE="$(get_ide_var "$sess" "@ide_left_role" "IDE_LEFT_ROLE")"
    LAYOUT_RIGHT_ROLE="$(get_ide_var "$sess" "@ide_right_role" "IDE_RIGHT_ROLE")"

    [ -z "$LAYOUT_BAR_ROLE" ] && LAYOUT_BAR_ROLE="term"
    [ -z "$LAYOUT_BAR_BEFORE" ] && LAYOUT_BAR_BEFORE="${term_before:-0}"

    if [ -z "$LAYOUT_LEFT_ROLE" ] || [ -z "$LAYOUT_RIGHT_ROLE" ] || \
       [ "$LAYOUT_LEFT_ROLE" = "$LAYOUT_RIGHT_ROLE" ] || \
       [ "$LAYOUT_LEFT_ROLE" = "$LAYOUT_BAR_ROLE" ] || \
       [ "$LAYOUT_RIGHT_ROLE" = "$LAYOUT_BAR_ROLE" ]; then
        case "$LAYOUT_BAR_ROLE" in
            term)
                if [ "$ed_before" = "1" ]; then
                    LAYOUT_LEFT_ROLE="editor"
                    LAYOUT_RIGHT_ROLE="ai"
                else
                    LAYOUT_LEFT_ROLE="ai"
                    LAYOUT_RIGHT_ROLE="editor"
                fi
                ;;
            ai)
                if [ "$ed_before" = "1" ]; then
                    LAYOUT_LEFT_ROLE="editor"
                    LAYOUT_RIGHT_ROLE="term"
                else
                    LAYOUT_LEFT_ROLE="term"
                    LAYOUT_RIGHT_ROLE="editor"
                fi
                ;;
            editor)
                LAYOUT_LEFT_ROLE="ai"
                LAYOUT_RIGHT_ROLE="term"
                ;;
        esac
    fi
}

record_main_geometry() {
    local sess="$1"
    local main_win="$2"
    local ai_pane="$3"
    local editor_pane="$4"
    local term_pane="$5"
    local ai_in=0 ed_in=0 term_in=0
    local ai_left=0 ai_top=0 ai_w=0 ai_h=0
    local ed_left=0 ed_top=0 ed_w=0 ed_h=0
    local term_left=0 term_top=0 term_w=0 term_h=0

    if pane_in_win "$ai_pane" "$main_win"; then
        ai_in=1
        read -r ai_left ai_top ai_w ai_h <<< "$(tmux display-message -p -t "$ai_pane" "#{pane_left} #{pane_top} #{pane_width} #{pane_height}" 2>/dev/null || echo "0 0 0 0")"
    fi
    if pane_in_win "$editor_pane" "$main_win"; then
        ed_in=1
        read -r ed_left ed_top ed_w ed_h <<< "$(tmux display-message -p -t "$editor_pane" "#{pane_left} #{pane_top} #{pane_width} #{pane_height}" 2>/dev/null || echo "0 0 0 0")"
    fi
    if pane_in_win "$term_pane" "$main_win"; then
        term_in=1
        read -r term_left term_top term_w term_h <<< "$(tmux display-message -p -t "$term_pane" "#{pane_left} #{pane_top} #{pane_width} #{pane_height}" 2>/dev/null || echo "0 0 0 0")"
    fi

    if [ "$ai_in" = "1" ] && [ "$ed_in" = "1" ] && [ "$term_in" = "1" ]; then
        local pair_a="" pair_b="" bar_role=""
        local pa_left=0 pa_top=0 pa_w=0 pb_left=0 pb_w=0 bar_top=0 bar_h=0
        if [ "${ai_top:-0}" -eq "${ed_top:-0}" ] && [ "${term_top:-0}" -ne "${ai_top:-0}" ]; then
            pair_a="ai"; pa_left="${ai_left:-0}"; pa_top="${ai_top:-0}"; pa_w="${ai_w:-0}"
            pair_b="editor"; pb_left="${ed_left:-0}"; pb_w="${ed_w:-0}"
            bar_role="term"; bar_top="${term_top:-0}"; bar_h="${term_h:-0}"
        elif [ "${ed_top:-0}" -eq "${term_top:-0}" ] && [ "${ai_top:-0}" -ne "${ed_top:-0}" ]; then
            pair_a="editor"; pa_left="${ed_left:-0}"; pa_top="${ed_top:-0}"; pa_w="${ed_w:-0}"
            pair_b="term"; pb_left="${term_left:-0}"; pb_w="${term_w:-0}"
            bar_role="ai"; bar_top="${ai_top:-0}"; bar_h="${ai_h:-0}"
        elif [ "${ai_top:-0}" -eq "${term_top:-0}" ] && [ "${ed_top:-0}" -ne "${ai_top:-0}" ]; then
            pair_a="ai"; pa_left="${ai_left:-0}"; pa_top="${ai_top:-0}"; pa_w="${ai_w:-0}"
            pair_b="term"; pb_left="${term_left:-0}"; pb_w="${term_w:-0}"
            bar_role="editor"; bar_top="${ed_top:-0}"; bar_h="${ed_h:-0}"
        fi

        if [ -n "$bar_role" ]; then
            local left_role right_role left_w right_w bar_before="0"
            if [ "$pa_left" -le "$pb_left" ]; then
                left_role="$pair_a"; left_w="$pa_w"
                right_role="$pair_b"; right_w="$pb_w"
            else
                left_role="$pair_b"; left_w="$pb_w"
                right_role="$pair_a"; right_w="$pa_w"
            fi
            [ "$bar_top" -lt "$pa_top" ] && bar_before="1"

            set_ide_var "$sess" "@ide_bar_role" "IDE_BAR_ROLE" "$bar_role"
            set_ide_var "$sess" "@ide_bar_before" "IDE_BAR_BEFORE" "$bar_before"
            set_ide_var "$sess" "@ide_term_before" "IDE_TERM_BEFORE" "$bar_before"
            if [ "${bar_h:-0}" -gt 0 ]; then
                set_ide_var "$sess" "@ide_bar_height" "IDE_BAR_HEIGHT" "$bar_h"
                set_ide_var "$sess" "@ide_term_height" "IDE_TERM_HEIGHT" "$bar_h"
            fi
            set_ide_var "$sess" "@ide_left_role" "IDE_LEFT_ROLE" "$left_role"
            set_ide_var "$sess" "@ide_right_role" "IDE_RIGHT_ROLE" "$right_role"
            [ "${left_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_left_width" "IDE_LEFT_WIDTH" "$left_w"
            [ "${right_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_right_width" "IDE_RIGHT_WIDTH" "$right_w"

            if [ "$bar_role" = "term" ]; then
                [ "${ed_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_editor_width" "IDE_EDITOR_WIDTH" "$ed_w"
                [ "${ai_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_ai_width" "IDE_AI_WIDTH" "$ai_w"
            elif [ "$left_role" = "editor" ] || [ "$right_role" = "editor" ]; then
                [ "${ed_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_editor_width" "IDE_EDITOR_WIDTH" "$ed_w"
            elif [ "$left_role" = "ai" ] || [ "$right_role" = "ai" ]; then
                [ "${ai_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_ai_width" "IDE_AI_WIDTH" "$ai_w"
            fi

            if [ "$left_role" = "editor" ]; then
                set_ide_var "$sess" "@ide_editor_before" "IDE_EDITOR_BEFORE" "1"
            else
                set_ide_var "$sess" "@ide_editor_before" "IDE_EDITOR_BEFORE" "0"
            fi
            if [ "$bar_role" = "term" ] && [ "$bar_before" = "0" ] && [ "$left_role" = "ai" ]; then
                set_ide_var "$sess" "@ide_swapped" "IDE_SWAPPED" "0"
            else
                set_ide_var "$sess" "@ide_swapped" "IDE_SWAPPED" "1"
            fi
            return 0
        fi
    fi

    local r1="" r2="" r3="" l1=0 t1=0 w1=0 h1=0 l2=0 t2=0 w2=0 h2=0
    if [ "$ai_in" = "1" ] && [ "$ed_in" = "1" ] && [ "$term_in" = "0" ]; then
        r1="ai"; l1="${ai_left:-0}"; t1="${ai_top:-0}"; w1="${ai_w:-0}"; h1="${ai_h:-0}"
        r2="editor"; l2="${ed_left:-0}"; t2="${ed_top:-0}"; w2="${ed_w:-0}"; h2="${ed_h:-0}"
        r3="term"
    elif [ "$ai_in" = "1" ] && [ "$term_in" = "1" ] && [ "$ed_in" = "0" ]; then
        r1="ai"; l1="${ai_left:-0}"; t1="${ai_top:-0}"; w1="${ai_w:-0}"; h1="${ai_h:-0}"
        r2="term"; l2="${term_left:-0}"; t2="${term_top:-0}"; w2="${term_w:-0}"; h2="${term_h:-0}"
        r3="editor"
    elif [ "$ed_in" = "1" ] && [ "$term_in" = "1" ] && [ "$ai_in" = "0" ]; then
        r1="editor"; l1="${ed_left:-0}"; t1="${ed_top:-0}"; w1="${ed_w:-0}"; h1="${ed_h:-0}"
        r2="term"; l2="${term_left:-0}"; t2="${term_top:-0}"; w2="${term_w:-0}"; h2="${term_h:-0}"
        r3="ai"
    fi

    if [ -n "$r1" ] && [ -n "$r2" ]; then
        if [ "$t1" -eq "$t2" ]; then
            local left_role right_role left_w right_w
            if [ "$l1" -le "$l2" ]; then
                left_role="$r1"; left_w="$w1"
                right_role="$r2"; right_w="$w2"
            else
                left_role="$r2"; left_w="$w2"
                right_role="$r1"; right_w="$w1"
            fi
            set_ide_var "$sess" "@ide_bar_role" "IDE_BAR_ROLE" "$r3"
            set_ide_var "$sess" "@ide_left_role" "IDE_LEFT_ROLE" "$left_role"
            set_ide_var "$sess" "@ide_right_role" "IDE_RIGHT_ROLE" "$right_role"
            [ "${left_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_left_width" "IDE_LEFT_WIDTH" "$left_w"
            [ "${right_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_right_width" "IDE_RIGHT_WIDTH" "$right_w"
            if [ "$r3" = "term" ]; then
                [ "${ed_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_editor_width" "IDE_EDITOR_WIDTH" "$ed_w"
                [ "${ai_w:-0}" -gt 0 ] && set_ide_var "$sess" "@ide_ai_width" "IDE_AI_WIDTH" "$ai_w"
            fi
            if [ "$left_role" = "editor" ]; then
                set_ide_var "$sess" "@ide_editor_before" "IDE_EDITOR_BEFORE" "1"
                set_ide_var "$sess" "@ide_swapped" "IDE_SWAPPED" "1"
            else
                set_ide_var "$sess" "@ide_editor_before" "IDE_EDITOR_BEFORE" "0"
                [ "$r3" = "term" ] && set_ide_var "$sess" "@ide_swapped" "IDE_SWAPPED" "0"
            fi
        else
            resolve_layout_roles "$sess"
            local bar_h=0 bar_before="0"
            if [ "$r1" = "$LAYOUT_BAR_ROLE" ]; then
                bar_h="$h1"
                [ "$t1" -lt "$t2" ] && bar_before="1"
            elif [ "$r2" = "$LAYOUT_BAR_ROLE" ]; then
                bar_h="$h2"
                [ "$t2" -lt "$t1" ] && bar_before="1"
            else
                set_ide_var "$sess" "@ide_bar_role" "IDE_BAR_ROLE" "$r2"
                bar_h="$h2"
                [ "$t2" -lt "$t1" ] && bar_before="1"
            fi
            set_ide_var "$sess" "@ide_bar_before" "IDE_BAR_BEFORE" "$bar_before"
            set_ide_var "$sess" "@ide_term_before" "IDE_TERM_BEFORE" "$bar_before"
            if [ "${bar_h:-0}" -gt 0 ]; then
                set_ide_var "$sess" "@ide_bar_height" "IDE_BAR_HEIGHT" "$bar_h"
                set_ide_var "$sess" "@ide_term_height" "IDE_TERM_HEIGHT" "$bar_h"
            fi
        fi
    fi
}

unpark_role_pane() {
    local sess="$1"
    local role="$2"
    local main_win="$3"
    local ai_pane="$4"
    local editor_pane="$5"
    local term_pane="$6"
    local sock="${7:-}"
    local target_pane
    target_pane="$(pane_for_role "$role" "$ai_pane" "$editor_pane" "$term_pane")"
    pane_is_parked "$target_pane" "$main_win" || return 0

    if [ "$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "1" ]; then
        tmux resize-pane -Z -t "$main_win" 2>/dev/null || true
    fi

    local win_w win_h
    read -r win_w win_h <<< "$(tmux display-message -p -t "$main_win" "#{window_width} #{window_height}" 2>/dev/null || echo "160 48")"
    [ "${win_w:-0}" -lt 20 ] && win_w=160
    [ "${win_h:-0}" -lt 10 ] && win_h=48

    resolve_layout_roles "$sess"

    if [ "$role" = "$LAYOUT_BAR_ROLE" ]; then
        local saved_h bar_h anchor_pane
        saved_h="$(get_ide_var "$sess" "@ide_bar_height" "IDE_BAR_HEIGHT")"
        [ -z "$saved_h" ] && saved_h="$(get_ide_var "$sess" "@ide_term_height" "IDE_TERM_HEIGHT")"
        bar_h="$(clamp_dim "$saved_h" "$win_h" "$(( win_h / 4 ))")"
        anchor_pane="$(tmux list-panes -t "$main_win" -F "#{pane_id}" 2>/dev/null | head -n 1)"
        if [ "$LAYOUT_BAR_BEFORE" = "1" ]; then
            tmux join-pane -d -f -b -v -l "$bar_h" -s "$target_pane" -t "$anchor_pane"
        else
            tmux join-pane -d -f -v -l "$bar_h" -s "$target_pane" -t "$anchor_pane"
        fi
    else
        local sibling_role join_before="0" sibling_pane
        if [ "$role" = "$LAYOUT_LEFT_ROLE" ]; then
            sibling_role="$LAYOUT_RIGHT_ROLE"
            join_before="1"
        else
            sibling_role="$LAYOUT_LEFT_ROLE"
            join_before="0"
        fi
        sibling_pane="$(pane_for_role "$sibling_role" "$ai_pane" "$editor_pane" "$term_pane")"
        if pane_in_win "$sibling_pane" "$main_win"; then
            local saved_w target_w
            if [ "$join_before" = "1" ]; then
                saved_w="$(get_ide_var "$sess" "@ide_left_width" "IDE_LEFT_WIDTH")"
            else
                saved_w="$(get_ide_var "$sess" "@ide_right_width" "IDE_RIGHT_WIDTH")"
            fi
            if [ -z "$saved_w" ]; then
                if [ "$role" = "editor" ]; then
                    saved_w="$(get_ide_var "$sess" "@ide_editor_width" "IDE_EDITOR_WIDTH")"
                elif [ "$role" = "ai" ]; then
                    saved_w="$(get_ide_var "$sess" "@ide_ai_width" "IDE_AI_WIDTH")"
                fi
            fi
            target_w="$(clamp_dim "$saved_w" "$win_w" "$(( win_w / 2 ))")"
            if [ "$join_before" = "1" ]; then
                tmux join-pane -d -b -h -l "$target_w" -s "$target_pane" -t "$sibling_pane"
            else
                tmux join-pane -d -h -l "$target_w" -s "$target_pane" -t "$sibling_pane"
            fi
        else
            local saved_bh bar_h pair_h anchor_pane
            saved_bh="$(get_ide_var "$sess" "@ide_bar_height" "IDE_BAR_HEIGHT")"
            [ -z "$saved_bh" ] && saved_bh="$(get_ide_var "$sess" "@ide_term_height" "IDE_TERM_HEIGHT")"
            bar_h="$(clamp_dim "$saved_bh" "$win_h" "$(( win_h / 4 ))")"
            pair_h="$(clamp_dim "$(( win_h - bar_h ))" "$win_h" "$(( win_h * 3 / 4 ))")"
            anchor_pane="$(tmux list-panes -t "$main_win" -F "#{pane_id}" 2>/dev/null | head -n 1)"
            if [ "$LAYOUT_BAR_BEFORE" = "1" ]; then
                tmux join-pane -d -f -v -l "$pair_h" -s "$target_pane" -t "$anchor_pane"
            else
                tmux join-pane -d -f -b -v -l "$pair_h" -s "$target_pane" -t "$anchor_pane"
            fi
        fi
    fi

    if [ "$role" = "editor" ] && [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-expr "execute('checktime') . execute('normal! zz')" >/dev/null 2>&1 || true
    fi
}

heal_split_for_role() {
    local sess="$1"
    local role="$2"
    local main_win="$3"
    local ai_pane="$4"
    local editor_pane="$5"
    local term_pane="$6"
    local cur_dir="$7"
    shift 7
    resolve_layout_roles "$sess"

    if [ "$role" = "$LAYOUT_BAR_ROLE" ]; then
        if [ "$LAYOUT_BAR_BEFORE" = "1" ]; then
            tmux split-window -b -f -v -P -F "#{pane_id}" -t "$main_win" -l 25% -c "$cur_dir" "$@"
        else
            tmux split-window -f -v -P -F "#{pane_id}" -t "$main_win" -l 25% -c "$cur_dir" "$@"
        fi
    else
        local sibling_role join_before="0" sibling_pane
        if [ "$role" = "$LAYOUT_LEFT_ROLE" ]; then
            sibling_role="$LAYOUT_RIGHT_ROLE"
            join_before="1"
        else
            sibling_role="$LAYOUT_LEFT_ROLE"
            join_before="0"
        fi
        sibling_pane="$(pane_for_role "$sibling_role" "$ai_pane" "$editor_pane" "$term_pane")"
        if pane_in_win "$sibling_pane" "$main_win"; then
            if [ "$join_before" = "1" ]; then
                tmux split-window -b -h -P -F "#{pane_id}" -t "$sibling_pane" -l 50% -c "$cur_dir" "$@"
            else
                tmux split-window -h -P -F "#{pane_id}" -t "$sibling_pane" -l 50% -c "$cur_dir" "$@"
            fi
        else
            if [ "$LAYOUT_BAR_BEFORE" = "1" ]; then
                tmux split-window -f -v -P -F "#{pane_id}" -t "$main_win" -l 75% -c "$cur_dir" "$@"
            else
                tmux split-window -b -f -v -P -F "#{pane_id}" -t "$main_win" -l 75% -c "$cur_dir" "$@"
            fi
        fi
    fi
}

park_role_pane() {
    local sess="$1"
    local role="$2"
    local main_win="$3"
    local ai_pane="$4"
    local editor_pane="$5"
    local term_pane="$6"
    local sock="${7:-}"
    local target_pane
    target_pane="$(pane_for_role "$role" "$ai_pane" "$editor_pane" "$term_pane")"
    pane_in_win "$target_pane" "$main_win" || return 0

    local vis_cnt
    vis_cnt="$(tmux list-panes -t "$main_win" 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${vis_cnt:-0}" -le 1 ]; then
        tmux display-message -d 2500 -t "=${sess}:" "Cannot hide the last visible IDE pane" 2>/dev/null || true
        return 0
    fi

    if [ "$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "1" ]; then
        tmux resize-pane -Z -t "$main_win" 2>/dev/null || true
    fi

    record_main_geometry "$sess" "$main_win" "$ai_pane" "$editor_pane" "$term_pane"

    local active_pane last_pane fallback_pane=""
    active_pane="$(tmux display-message -p -t "$main_win" "#{pane_id}" 2>/dev/null || true)"
    last_pane="$(tmux show-options -wqv -t "$main_win" @ide_last_pane 2>/dev/null || true)"
    if [ "$active_pane" = "$target_pane" ]; then
        if [ -n "$last_pane" ] && [ "$last_pane" != "$target_pane" ] && pane_in_win "$last_pane" "$main_win"; then
            fallback_pane="$last_pane"
        else
            case "$role" in
                term)
                    if pane_in_win "$editor_pane" "$main_win"; then
                        fallback_pane="$editor_pane"
                    elif pane_in_win "$ai_pane" "$main_win"; then
                        fallback_pane="$ai_pane"
                    fi
                    ;;
                editor)
                    if pane_in_win "$ai_pane" "$main_win"; then
                        fallback_pane="$ai_pane"
                    elif pane_in_win "$term_pane" "$main_win"; then
                        fallback_pane="$term_pane"
                    fi
                    ;;
                ai)
                    if pane_in_win "$editor_pane" "$main_win"; then
                        fallback_pane="$editor_pane"
                    elif pane_in_win "$term_pane" "$main_win"; then
                        fallback_pane="$term_pane"
                    fi
                    ;;
            esac
        fi
    fi

    tmux break-pane -d -s "$target_pane" -n "_ide_park_${role}" 2>/dev/null || true
    local park_win
    park_win="$(tmux display-message -p -t "$target_pane" "#{window_id}" 2>/dev/null || true)"
    if [ -n "$park_win" ] && [ "$park_win" != "$main_win" ]; then
        tmux set-option -w -t "$park_win" automatic-rename off 2>/dev/null || true
        tmux set-option -w -t "$park_win" allow-rename off 2>/dev/null || true
    fi
    if [ -n "$fallback_pane" ] && pane_in_win "$fallback_pane" "$main_win"; then
        tmux select-window -t "$main_win" 2>/dev/null || true
        tmux select-pane -t "$fallback_pane" 2>/dev/null || true
        if [ "$fallback_pane" = "$editor_pane" ] && [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
            nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
        fi
    fi
}

swap_ide_pane() {
    local raw_dir="${1:-}"
    local dir_flag=""
    case "${raw_dir,,}" in
        left|l|-l)   dir_flag="-L" ;;
        down|d|-d)   dir_flag="-D" ;;
        up|u|-u)     dir_flag="-U" ;;
        right|r|-r)  dir_flag="-R" ;;
        *)
            echo "Error: Invalid swap direction '$raw_dir'. Expected: left, down, up, or right." >&2
            return 1
            ;;
    esac

    local sess
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! session_exists "$sess"; then
        echo "Error: $(missing_session_msg "$sess")" >&2
        return 1
    fi

    local main_win editor_pane ai_pane term_pane
    editor_pane="$(resolve_role_pane "$sess" "editor" "@ide_editor_pane" "NVIM_IDE_PANE")"
    ai_pane="$(resolve_role_pane "$sess" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
    term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"
    main_win="$(resolve_main_win "$sess" "$editor_pane" "$ai_pane" "$term_pane")"
    [ -n "$main_win" ] || return 1

    if [ "$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "1" ]; then
        tmux resize-pane -Z -t "$main_win" 2>/dev/null || true
    fi

    local src_pane dst_pane
    src_pane="$(tmux display-message -p -t "$main_win" "#{pane_id}" 2>/dev/null || true)"
    [ -n "$src_pane" ] || return 0

    tmux select-pane -t "$src_pane" "$dir_flag" 2>/dev/null || true
    dst_pane="$(tmux display-message -p -t "$main_win" "#{pane_id}" 2>/dev/null || true)"

    if [ -n "$dst_pane" ] && [ "$dst_pane" != "$src_pane" ]; then
        tmux swap-pane -s "$src_pane" -t "$dst_pane"
        tmux select-pane -t "$src_pane"
        record_main_geometry "$sess" "$main_win" "$ai_pane" "$editor_pane" "$term_pane"
    fi
}

toggle_main_pane() {
    local mode="${1:-toggle}" # toggle | editor | focus-editor | ai | term | toggle-editor | toggle-ai | toggle-term
    local sess
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! session_exists "$sess"; then
        echo "Error: $(missing_session_msg "$sess")" >&2
        return 1
    fi

    local main_win editor_pane ai_pane term_pane layout_mode ai_cli cur_dir init_root sock
    editor_pane="$(resolve_role_pane "$sess" "editor" "@ide_editor_pane" "NVIM_IDE_PANE")"
    ai_pane="$(resolve_role_pane "$sess" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
    term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"
    main_win="$(resolve_main_win "$sess" "$editor_pane" "$ai_pane" "$term_pane")"
    layout_mode="$(get_ide_var "$sess" "@ide_layout_mode" "IDE_LAYOUT_MODE")"
    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    [ -z "$sock" ] && sock="${XDG_RUNTIME_DIR:-/tmp}/nvim-ide-${sess}.sock"
    rm -f "${sock}.tree" 2>/dev/null || true
    ai_cli="$(get_ide_var "$sess" "@ide_ai_cli" "IDE_AI_CLI")"
    [ -z "$ai_cli" ] && ai_cli="${IDE_AI_CLI:-agy}"
    init_root="$(get_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT")"
    tmux set-option -q -t "=${sess}:" status-position top 2>/dev/null || true

    # Geometry fallback if per-pane @ide_role tags were cleared on existing panes:
    # Top-Left (left==0, top==0) is AI, Bottom-Left (left==0, top>0) is Term, Right (left>0) is Editor
    if ! pane_exists "$ai_pane"; then
        ai_pane="$(tmux list-panes -t "$main_win" -F "#{pane_left} #{pane_top} #{pane_id} #{@ide_role}" | sort -n -k1,1 -k2,2 | awk '$1 == 0 && $2 == 0 && ($4 == "" || $4 == "ai") { print $3; exit }')"
        if [ -n "$ai_pane" ]; then
            tmux set-option -p -t "$ai_pane" @ide_role "ai" 2>/dev/null || true
            set_ide_var "$sess" "@ide_ai_pane" "IDE_AI_PANE" "$ai_pane"
        fi
    fi
    if ! pane_exists "$editor_pane"; then
        editor_pane="$(tmux list-panes -t "$main_win" -F "#{pane_left} #{pane_top} #{pane_id} #{@ide_role}" | sort -n -k1,1 -k2,2 | awk '$1 > 0 && ($4 == "" || $4 == "editor") { print $3; exit }')"
        if [ -n "$editor_pane" ]; then
            tmux set-option -p -t "$editor_pane" @ide_role "editor" 2>/dev/null || true
            set_ide_var "$sess" "@ide_editor_pane" "NVIM_IDE_PANE" "$editor_pane"
        fi
    fi
    if ! pane_exists "$term_pane"; then
        term_pane="$(tmux list-panes -t "$main_win" -F "#{pane_left} #{pane_top} #{pane_id} #{@ide_role}" | sort -n -k1,1 -k2,2 | awk '$1 == 0 && $2 > 0 && ($4 == "" || $4 == "term") { print $3; exit }')"
        if [ -n "$term_pane" ]; then
            tmux set-option -p -t "$term_pane" @ide_role "term" 2>/dev/null || true
            set_ide_var "$sess" "@ide_term_pane" "IDE_TERM_PANE" "$term_pane"
        fi
    fi

    cur_dir="$(tmux display-message -p -t "${editor_pane:-$main_win}" "#{pane_current_path}" 2>/dev/null || pwd)"
    [ -z "$init_root" ] && init_root="$cur_dir"

    local was_zoomed_before_heal="0"
    local ed_just_healed="0" ai_just_healed="0" term_just_healed="0"
    if ! pane_exists "$editor_pane" || ! pane_exists "$ai_pane" || { ! pane_exists "$term_pane" && { [ "${layout_mode:-3pane}" != "2pane" ] || [ "$mode" = "term" ] || [ "$mode" = "toggle-term" ]; }; }; then
        was_zoomed_before_heal="$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)"
        if [ "$was_zoomed_before_heal" = "1" ]; then
            tmux resize-pane -Z -t "$main_win"
        fi
    fi

    # Self-heal Editor pane if closed
    if ! pane_exists "$editor_pane"; then
        editor_pane="$(heal_split_for_role "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$cur_dir" -e "IDE_SESSION=$sess" -e "IDE_AI_CLI=$ai_cli" -e "NVIM_IDE_SOCKET=$sock" -e "IDE_INITIAL_ROOT=$init_root")"
        if [ -n "$editor_pane" ]; then
            ed_just_healed="1"
            tmux set-option -p -t "$editor_pane" @ide_role "editor" 2>/dev/null || true
            set_ide_var "$sess" "@ide_editor_pane" "NVIM_IDE_PANE" "$editor_pane"
            if command -v nvim >/dev/null 2>&1; then
                tmux send-keys -t "$editor_pane" " nvim --listen '$sock'" C-m
            elif command -v vim >/dev/null 2>&1; then
                tmux send-keys -t "$editor_pane" " vim" C-m
            fi
        fi
    fi

    # Self-heal AI Agent pane if closed
    if ! pane_exists "$ai_pane"; then
        ai_pane="$(heal_split_for_role "$sess" "ai" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$cur_dir" -e "IDE_SESSION=$sess" -e "IDE_AI_CLI=$ai_cli" -e "NVIM_IDE_SOCKET=$sock" -e "NVIM_IDE_PANE=$editor_pane" -e "IDE_INITIAL_ROOT=$init_root")"
        if [ -n "$ai_pane" ]; then
            ai_just_healed="1"
            tmux set-option -p -t "$ai_pane" @ide_role "ai" 2>/dev/null || true
            set_ide_var "$sess" "@ide_ai_pane" "IDE_AI_PANE" "$ai_pane"
            local ai_run_cmd
            if ai_run_cmd="$(resolve_ai_cmd "$ai_cli")"; then
                tmux send-keys -t "$ai_pane" " $ai_run_cmd" C-m
            fi
        fi
    fi

    # Self-heal Shell pane if closed (in 3pane mode or when explicitly jumping to/toggling term)
    if ! pane_exists "$term_pane" && { [ "${layout_mode:-3pane}" != "2pane" ] || [ "$mode" = "term" ] || [ "$mode" = "toggle-term" ]; }; then
        term_pane="$(heal_split_for_role "$sess" "term" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$cur_dir" -e "IDE_SESSION=$sess" -e "IDE_AI_CLI=$ai_cli" -e "NVIM_IDE_SOCKET=$sock" -e "NVIM_IDE_PANE=$editor_pane" -e "IDE_INITIAL_ROOT=$init_root")"
        term_just_healed="1"
        tmux set-option -p -t "$term_pane" @ide_role "term" 2>/dev/null || true
        set_ide_var "$sess" "@ide_term_pane" "IDE_TERM_PANE" "$term_pane"
    fi

    if [ "$was_zoomed_before_heal" = "1" ] && [ "$(tmux display-message -p -t "$main_win" "#{window_zoomed_flag}" 2>/dev/null || echo 0)" = "0" ]; then
        tmux resize-pane -Z -t "$main_win"
    fi

    local active_pane active_role last_pane
    active_pane="$(tmux display-message -p -t "$main_win" "#{pane_id}" 2>/dev/null || true)"
    active_role="$(tmux show-options -pqv -t "$active_pane" @ide_role 2>/dev/null || true)"
    last_pane="$(tmux show-options -wqv -t "$main_win" @ide_last_pane 2>/dev/null || true)"

    case "$mode" in
        toggle|ai)
            if [ "$active_pane" = "$ai_pane" ] || [ "$active_role" = "ai" ]; then
                if pane_is_parked "$editor_pane" "$main_win" && ! pane_in_win "$term_pane" "$main_win"; then
                    unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                fi
                if pane_in_win "$editor_pane" "$main_win"; then
                    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
                        nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
                    fi
                    focus_pane_preserving_zoom "$main_win" "$editor_pane"
                elif pane_in_win "$term_pane" "$main_win"; then
                    focus_pane_preserving_zoom "$main_win" "$term_pane"
                else
                    unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                    focus_pane_preserving_zoom "$main_win" "$editor_pane"
                fi
            else
                unpark_role_pane "$sess" "ai" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                focus_pane_preserving_zoom "$main_win" "$ai_pane"
            fi
            ;;
        editor)
            if [ "$active_pane" = "$editor_pane" ] || [ "$active_role" = "editor" ]; then
                if [ -n "$last_pane" ] && [ "$last_pane" != "$editor_pane" ] && pane_in_win "$last_pane" "$main_win"; then
                    focus_pane_preserving_zoom "$main_win" "$last_pane"
                elif pane_in_win "$ai_pane" "$main_win"; then
                    focus_pane_preserving_zoom "$main_win" "$ai_pane"
                elif pane_in_win "$term_pane" "$main_win"; then
                    focus_pane_preserving_zoom "$main_win" "$term_pane"
                else
                    unpark_role_pane "$sess" "ai" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                    focus_pane_preserving_zoom "$main_win" "$ai_pane"
                fi
            else
                unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
                    nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
                fi
                focus_pane_preserving_zoom "$main_win" "$editor_pane"
            fi
            ;;
        focus-editor)
            unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
            if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
                nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
            fi
            focus_pane_preserving_zoom "$main_win" "$editor_pane"
            ;;
        term)
            if [ "$active_pane" = "$term_pane" ] || [ "$active_role" = "term" ]; then
                if [ -n "$last_pane" ] && [ "$last_pane" != "$term_pane" ] && pane_in_win "$last_pane" "$main_win"; then
                    if [ "$last_pane" = "$editor_pane" ] && [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
                        nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
                    fi
                    focus_pane_preserving_zoom "$main_win" "$last_pane"
                elif pane_in_win "$editor_pane" "$main_win"; then
                    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
                        nvim --headless --server "$sock" --remote-expr "execute('checktime')" >/dev/null 2>&1 || true
                    fi
                    focus_pane_preserving_zoom "$main_win" "$editor_pane"
                elif pane_in_win "$ai_pane" "$main_win"; then
                    focus_pane_preserving_zoom "$main_win" "$ai_pane"
                else
                    unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                    focus_pane_preserving_zoom "$main_win" "$editor_pane"
                fi
            else
                unpark_role_pane "$sess" "term" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                focus_pane_preserving_zoom "$main_win" "$term_pane"
            fi
            ;;
        toggle-editor)
            if [ "$ed_just_healed" = "1" ] || pane_is_parked "$editor_pane" "$main_win"; then
                unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                focus_pane_preserving_zoom "$main_win" "$editor_pane"
            else
                park_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
            fi
            ;;
        toggle-ai)
            if [ "$ai_just_healed" = "1" ] || pane_is_parked "$ai_pane" "$main_win"; then
                unpark_role_pane "$sess" "ai" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                focus_pane_preserving_zoom "$main_win" "$ai_pane"
            else
                park_role_pane "$sess" "ai" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
            fi
            ;;
        toggle-term)
            if [ "$term_just_healed" = "1" ] || pane_is_parked "$term_pane" "$main_win"; then
                unpark_role_pane "$sess" "term" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
                focus_pane_preserving_zoom "$main_win" "$term_pane"
            else
                park_role_pane "$sess" "term" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
            fi
            ;;
    esac
}

open_in_editor() {
    local filepath="$1"
    local focus="${2:-1}"
    local sess sock prev_pane dir base
    if [[ "$filepath" != /* ]]; then
        dir="$(dirname -- "$filepath")"
        base="$(basename -- "$filepath")"
        if [ -d "$dir" ]; then
            filepath="$(cd -- "$dir" && pwd -P)/$base"
        else
            filepath="$PWD/${filepath#./}"
        fi
    fi
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! session_exists "$sess"; then
        echo "Error: $(missing_session_msg "$sess")" >&2
        return 1
    fi
    prev_pane="$(tmux display-message -p -t "=${sess}:" "#{pane_id}" 2>/dev/null || true)"
    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    if [ "$focus" = "1" ]; then
        toggle_main_pane "focus-editor"
    else
        local main_win editor_pane ai_pane term_pane
        editor_pane="$(resolve_role_pane "$sess" "editor" "@ide_editor_pane" "NVIM_IDE_PANE")"
        ai_pane="$(resolve_role_pane "$sess" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
        term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"
        main_win="$(resolve_main_win "$sess" "$editor_pane" "$ai_pane" "$term_pane")"
        if pane_is_parked "$editor_pane" "$main_win"; then
            unpark_role_pane "$sess" "editor" "$main_win" "$ai_pane" "$editor_pane" "$term_pane" "$sock"
        elif ! pane_exists "$editor_pane"; then
            toggle_main_pane "focus-editor"
        fi
    fi
    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-expr "execute(\"if luaeval('type(_G.IdeTree) == \\\"table\\\" and type(_G.IdeTree.focus_code_win) == \\\"function\\\"') | call v:lua.IdeTree.focus_code_win() | elseif (&filetype ==# 'netrw' || &filetype ==# 'ide_tree') && winnr('\\$') > 1 | wincmd p | endif\")" >/dev/null 2>&1 || true
        nvim --headless --server "$sock" --remote "$filepath" >/dev/null 2>&1 || true
    fi
    if [ "$focus" = "0" ] && pane_exists "$prev_pane"; then
        tmux select-pane -t "$prev_pane" 2>/dev/null || true
    fi
}

run_ai_popup() {
    local sess
    sess="$(resolve_target_session "$TARGET_ARG")"
    tmux set-option -t "=ai-${sess}:" status off >/dev/null 2>&1 || true
    local ai_cli
    ai_cli="$(get_ide_var "$sess" "@ide_ai_cli" "IDE_AI_CLI")"
    [ -z "$ai_cli" ] && ai_cli="${IDE_AI_CLI:-agy}"
    local ai_cmd
    if ai_cmd="$(resolve_ai_cmd "$ai_cli")"; then
        eval "$ai_cmd" || true
    fi
    exec "${SHELL:-/bin/zsh}" -l
}

quit_ide() {
    local sess sock modified mod_expr
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! session_exists "$sess"; then
        missing_session_msg "$sess"
        echo
        return 0
    fi

    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    if [ "$FORCE_QUIT" != "1" ] && [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        mod_expr='len(filter(getbufinfo({"bufmodified": 1}), "getbufvar(v:val.bufnr, \"&buftype\") ==# \"\" && (!empty(v:val.name) || join(getbufline(v:val.bufnr, 1, \"$\"), \"\") !~# \"^\\\\s*$\")"))'
        modified="$(nvim --headless --server "$sock" --remote-expr "$mod_expr" 2>/dev/null | tr -cd '0-9' || echo 0)"
        if [ "${modified:-0}" -gt 0 ] 2>/dev/null; then
            toggle_main_pane "focus-editor" || true
            nvim --headless --server "$sock" --remote-send "<C-\\><C-n>:redraw! | echohl ErrorMsg | echo \"Unsaved changes in ${modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q (:Q!) to force-quit\" | echohl None<CR>" >/dev/null 2>&1 || true
            tmux display-message -d 4000 -t "=${sess}:" "Unsaved changes in ${modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q to force-quit" 2>/dev/null || true
            echo "Aborted quit: unsaved changes in Neovim buffer(s). Save first or use 'ide quit --force' (Alt+Shift+Q)." >&2
            return 1
        fi
    fi

    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        # <Cmd> runs :qall! without entering the command line, so the Editor's `:qa` -> `:Q` abbreviations
        # never fire: `:Q` spawns its own `ide --quit`, which would outlive this session and quit another.
        if nvim --headless --server "$sock" --remote-send "<C-\\><C-n><Cmd>qall!<CR>" >/dev/null 2>&1; then
            # Let the Editor exit cleanly (it removes its socket) before its pane is killed, without waiting on a wedged one
            for _ in $(seq 1 30); do
                [ -S "$sock" ] || break
                sleep 0.1
            done
        fi
    fi

    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
    if [ -n "$sock" ]; then
        rm -f "$sock" "${sock}.tree"
    fi
    rm -f "${RUNTIME_DIR}/nvim-${sess}.sock" "${RUNTIME_DIR}/nvim-ide-${sess}.sock" "${RUNTIME_DIR}/nvim-ide-${sess}.sock.tree"
    tmux kill-session -t "=ai-${sess}" 2>/dev/null || true
    tmux kill-session -t "=agy-${sess}" 2>/dev/null || true
    tmux kill-session -t "=$sess" 2>/dev/null || true
    if [ "$ACTION" = "kill" ]; then
        echo "Terminated IDE session: $sess"
    fi
}

cd_ide_workspace() {
    local raw_target="${1:-$PWD}"
    local sess init_root cur_workdir target_dir sock term_pane term_cmd term_path escaped_dir
    sess="$(resolve_target_session "$TARGET_ARG")"
    if ! session_exists "$sess"; then
        echo "Error: $(missing_session_msg "$sess")" >&2
        return 1
    fi

    init_root="$(get_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT")"
    cur_workdir="$(get_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR")"
    [ -z "$cur_workdir" ] && cur_workdir="${init_root:-$PWD}"

    if [ "$raw_target" = "--reset" ] || [ "$raw_target" = "~" ] || [ "$raw_target" = "-" ]; then
        if [ -n "$init_root" ] && [ -d "$init_root" ]; then
            target_dir="$init_root"
        else
            target_dir="$cur_workdir"
        fi
    elif [[ "$raw_target" == /* ]]; then
        target_dir="$raw_target"
    else
        if [ -d "$cur_workdir/$raw_target" ]; then
            target_dir="$cur_workdir/$raw_target"
        elif [ -n "$init_root" ] && [ -d "$init_root/$raw_target" ]; then
            target_dir="$init_root/$raw_target"
        else
            target_dir="$PWD/$raw_target"
        fi
    fi

    if [ ! -d "$target_dir" ]; then
        echo "Error: Directory '$target_dir' does not exist." >&2
        return 1
    fi
    target_dir="$(cd "$target_dir" && pwd -P)"
    [ -z "$init_root" ] && set_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT" "$target_dir"
    set_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR" "$target_dir"

    # 0. Update Tmux session default working directory for new panes/popups
    tmux attach-session -t "=$sess" -c "$target_dir" >/dev/null 2>&1 || true

    sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
    term_pane="$(resolve_role_pane "$sess" "term" "@ide_term_pane" "IDE_TERM_PANE")"

    escaped_dir="${target_dir//\'/\'\'}"

    # 1. Update Main Neovim Editor (@ide_role=editor) working directory and in-process IdeTree root
    if [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1; then
        nvim --headless --server "$sock" --remote-expr "execute('cd ' . fnameescape('$escaped_dir'))" >/dev/null 2>&1 || true
        nvim --headless --server "$sock" --remote-expr "v:lua.IdeTree.set_root('$escaped_dir')" >/dev/null 2>&1 || true
    fi

    # 2. Update Bottom-Left Terminal Shell (@ide_role=term) if idle at zsh/bash/sh prompt
    # (Never respawn or kill the running AI Agent in @ide_ai_pane!)
    if [ "${IDE_CD_SKIP_SHELL:-0}" != "1" ] && pane_exists "$term_pane"; then
        term_cmd="$(tmux display-message -p -t "$term_pane" "#{pane_current_command}" 2>/dev/null || true)"
        term_path="$(tmux display-message -p -t "$term_pane" "#{pane_current_path}" 2>/dev/null || true)"
        if [[ "$term_cmd" == zsh* || "$term_cmd" == bash* || "$term_cmd" == sh* ]] && [ "$term_path" != "$target_dir" ]; then
            tmux send-keys -t "$term_pane" C-u " builtin cd -- $(printf '%q' "$target_dir")" C-m
        fi
    fi

    tmux display-message -d 2500 -t "=${sess}:" "IDE Working Directory -> $target_dir" 2>/dev/null || true
}

copy_to_system_clipboard() {
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/ide-clip.XXXXXX")"
    cat > "$tmp"
    if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        tmux load-buffer "$tmp" 2>/dev/null || true
    fi
    if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xsel -ip < "$tmp" 2>/dev/null || true
        xsel -ib < "$tmp" 2>/dev/null || true
    elif command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        nohup xclip -selection primary -i < "$tmp" >/dev/null 2>&1 &
        nohup xclip -selection clipboard -i < "$tmp" >/dev/null 2>&1 &
    fi
    if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-copy --primary < "$tmp" >/dev/null 2>&1 || true
        wl-copy < "$tmp" >/dev/null 2>&1 || true
    fi
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy < "$tmp" 2>/dev/null || true
    fi
    rm -f "$tmp"
}

paste_from_system_clipboard() {
    local target_pane="${1:-}"
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/ide-paste.XXXXXX")"
    : > "$tmp"

    if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xsel -op > "$tmp" 2>/dev/null || true
        if [ ! -s "$tmp" ]; then
            xsel -ob > "$tmp" 2>/dev/null || true
        fi
    fi
    if [ ! -s "$tmp" ] && command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        xclip -selection primary -t UTF8_STRING -o > "$tmp" 2>/dev/null || \
            xclip -selection primary -o > "$tmp" 2>/dev/null || \
            xclip -selection clipboard -t UTF8_STRING -o > "$tmp" 2>/dev/null || \
            xclip -selection clipboard -o > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v wl-paste >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-paste --primary --no-newline > "$tmp" 2>/dev/null || \
            wl-paste --no-newline > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v pbpaste >/dev/null 2>&1; then
        pbpaste > "$tmp" 2>/dev/null || true
    fi
    if [ ! -s "$tmp" ] && command -v tmux >/dev/null 2>&1; then
        tmux show-buffer > "$tmp" 2>/dev/null || true
    fi

    if [ -s "$tmp" ] && command -v tmux >/dev/null 2>&1; then
        tmux load-buffer "$tmp" 2>/dev/null || true
        if [ -n "$target_pane" ]; then
            tmux paste-buffer -p -t "$target_pane" 2>/dev/null || true
        else
            tmux paste-buffer -p 2>/dev/null || true
        fi
    fi
    rm -f "$tmp"
}

open_browser_url() {
    local url="$1"
    [ -z "$url" ] && return 1
    if command -v xdg-open >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        nohup xdg-open "$url" >/dev/null 2>&1 &
        return 0
    elif command -v google-chrome >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        nohup google-chrome "$url" >/dev/null 2>&1 &
        return 0
    elif command -v open >/dev/null 2>&1; then
        nohup open "$url" >/dev/null 2>&1 &
        return 0
    fi
    return 1
}

# Machine-local link rules keep private hostnames and path conventions out of this repository.
# The rules file ($IDE_LINK_RULES, default ${XDG_CONFIG_HOME:-~/.config}/ide/links.sh) is an
# untracked Bash snippet defining `ide_resolve_link WORD CWD`, which prints the URL to open for
# WORD and returns 0, or returns non-zero to fall through to local file handling.
resolve_private_link() {
    local link_word="$1" link_cwd="$2"
    local rules="${IDE_LINK_RULES:-${XDG_CONFIG_HOME:-$HOME/.config}/ide/links.sh}"
    [ -r "$rules" ] || return 1
    (
        # shellcheck source=/dev/null
        . "$rules"
        declare -F ide_resolve_link >/dev/null || exit 1
        ide_resolve_link "$link_word" "$link_cwd"
    )
}

PARSE_PATH=""
PARSE_LINE=""
parse_file_target() {
    local raw="$1"
    PARSE_PATH=""
    PARSE_LINE=""
    if [[ "$raw" == file://* ]]; then
        raw="${raw#file://}"
        raw="${raw#localhost}"
    fi
    if [ ! -e "$raw" ] && [[ "$raw" == *%[0-9A-Fa-f][0-9A-Fa-f]* ]]; then
        raw="$(printf '%b' "${raw//%/\\x}")"
    fi
    if [[ "$raw" =~ ^(.+)#L?([0-9]+)([-:][Ll]?[0-9]+)?$ ]]; then
        raw="${BASH_REMATCH[1]}"
        PARSE_LINE="${BASH_REMATCH[2]}"
    elif [ ! -e "$raw" ] && [[ "$raw" =~ ^([^:]+):([0-9]+)(:[0-9]+)?(-[Ll]?[0-9]+(:[0-9]+)?)?$ ]]; then
        raw="${BASH_REMATCH[1]}"
        PARSE_LINE="${BASH_REMATCH[2]}"
    fi
    if [ ! -e "$raw" ] && [[ "$raw" == *%[0-9A-Fa-f][0-9A-Fa-f]* ]]; then
        raw="$(printf '%b' "${raw//%/\\x}")"
    fi
    PARSE_PATH="$raw"
}

resolve_ai_brain_dirs() {
    local cwd="${1:-$PWD}"
    local sess workdir="" init_root=""
    sess="$(resolve_target_session "$TARGET_ARG" 2>/dev/null || true)"
    if session_exists "$sess"; then
        workdir="$(get_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR")"
        init_root="$(get_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT")"
    fi

    local roots_list="" d phys
    for d in "$init_root" "$workdir" "$cwd"; do
        [ -n "$d" ] || continue
        d="${d%/}"
        roots_list="${roots_list}|${d}|"
        if [ -d "$d" ]; then
            phys="$(cd "$d" 2>/dev/null && pwd -P || true)"
            [ -n "$phys" ] && roots_list="${roots_list}|${phys%/}|"
        fi
    done

    local hist brain_base cid
    for hist in "$HOME"/.gemini/*/cli/history.jsonl; do
        [ -f "$hist" ] || continue
        brain_base="${hist%/cli/history.jsonl}/brain"
        [ -d "$brain_base" ] || continue
        while IFS= read -r cid; do
            [ -n "$cid" ] && [ -d "$brain_base/$cid" ] && printf "%s\n" "$brain_base/$cid"
        done < <(awk -v roots="$roots_list" '
            index($0, "\"conversationId\"") && index($0, "\"workspace\"") {
                cid = ""; ws = ""
                if (match($0, /"conversationId"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                    s = substr($0, RSTART, RLENGTH)
                    sub(/^.*"conversationId"[[:space:]]*:[[:space:]]*"/, "", s)
                    sub(/"$/, "", s)
                    cid = s
                }
                if (match($0, /"workspace"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
                    s = substr($0, RSTART, RLENGTH)
                    sub(/^.*"workspace"[[:space:]]*:[[:space:]]*"/, "", s)
                    sub(/"$/, "", s)
                    sub(/^file:\/\//, "", s)
                    sub(/\/+$/, "", s)
                    ws = s
                }
                if (cid != "" && ws != "" && index(roots, "|" ws "|") > 0) {
                    order[++n] = cid
                    seen[cid] = n
                }
            }
            END {
                for (i = n; i >= 1; i--) {
                    c = order[i]
                    if (seen[c] == i) {
                        print c
                    }
                }
            }
        ' "$hist" 2>/dev/null)
    done
}

resolve_ai_markdown_link() {
    local target_label="$1"
    local cwd="${2:-$PWD}"
    [ -n "$target_label" ] || return 1

    local -a search_files=()
    local bdir f
    while IFS= read -r bdir; do
        [ -n "$bdir" ] || continue
        [ -f "$bdir/.system_generated/logs/transcript.jsonl" ] && search_files+=("$bdir/.system_generated/logs/transcript.jsonl")
        for f in "$bdir"/*.md; do
            [ -f "$f" ] && search_files+=("$f")
        done
    done < <(resolve_ai_brain_dirs "$cwd")

    if [ "${#search_files[@]}" -eq 0 ]; then
        local newest_t=""
        for f in "$HOME"/.gemini/*/brain/*/.system_generated/logs/transcript.jsonl; do
            [ -f "$f" ] || continue
            if [ -z "$newest_t" ] || [ "$f" -nt "$newest_t" ]; then
                newest_t="$f"
            fi
        done
        if [ -n "$newest_t" ]; then
            search_files+=("$newest_t")
            bdir="${newest_t%/.system_generated/logs/transcript.jsonl}"
            for f in "$bdir"/*.md; do
                [ -f "$f" ] && search_files+=("$f")
            done
        fi
    fi

    [ "${#search_files[@]}" -gt 0 ] || return 1

    local matched_url=""
    matched_url="$(awk -v target="$target_label" '
        index($0, "](file://") {
            line = $0
            while ((p = index(line, "](file://")) > 0) {
                prefix = substr(line, 1, p - 1)
                rest = substr(line, p + 2)
                lb = 0
                for (i = length(prefix); i >= 1; i--) {
                    if (substr(prefix, i, 1) == "[") {
                        lb = i
                        break
                    }
                }
                endp = match(rest, /[)[:space:]"'\''\\]/)
                url = (endp > 0) ? substr(rest, 1, endp - 1) : rest
                if (lb > 0 && url ~ /^file:\/\//) {
                    lbl = substr(prefix, lb + 1)
                    gsub(/^[`*]+|[`*]+$/, "", lbl)
                    if (lbl == target) {
                        best = url
                    } else {
                        stem = lbl
                        sub(/^.*\/+/, "", stem)
                        sub(/^\.+/, "", stem)
                        sub(/\.[A-Za-z0-9_+-]+$/, "", stem)
                        if (stem != "" && stem == target) {
                            stem_best = url
                        }
                    }
                }
                line = (endp > 0) ? substr(rest, endp) : ""
            }
        }
        END {
            if (best != "") print best
            else if (stem_best != "") print stem_best
        }
    ' "${search_files[@]}" 2>/dev/null || true)"

    if [ -n "$matched_url" ]; then
        printf "%s" "$matched_url"
        return 0
    fi
    return 1
}

resolve_workspace_file() {
    local cand="$1"
    local cwd="${2:-$PWD}"
    [ -z "$cand" ] && return 1
    [[ "$cand" == \~/* ]] && cand="$HOME/${cand#\~/}"
    if [[ "$cand" == /* ]]; then
        if [ -f "$cand" ] || [ -d "$cand" ]; then
            printf "%s" "$cand"
            return 0
        fi
        return 1
    fi

    local sess workdir="" init_root=""
    sess="$(resolve_target_session "$TARGET_ARG" 2>/dev/null || true)"
    if session_exists "$sess"; then
        workdir="$(get_ide_var "$sess" "@ide_workdir" "IDE_WORKDIR")"
        init_root="$(get_ide_var "$sess" "@ide_initial_root" "IDE_INITIAL_ROOT")"
    fi

    local base_dir
    for base_dir in "$cwd" "$workdir" "$init_root"; do
        if [ -n "$base_dir" ] && { [ -f "$base_dir/$cand" ] || [ -d "$base_dir/$cand" ]; }; then
            printf "%s" "$base_dir/$cand"
            return 0
        fi
    done

    # Basename / partial-path fallback via git ls-files when an AI link renders only `[init.lua:191-194]`
    if command -v git >/dev/null 2>&1; then
        local git_root rel
        for base_dir in "$cwd" "$workdir" "$init_root"; do
            [ -n "$base_dir" ] && [ -d "$base_dir" ] || continue
            git_root="$(git -C "$base_dir" rev-parse --show-toplevel 2>/dev/null || true)"
            [ -n "$git_root" ] || continue
            if [ -f "$git_root/$cand" ] || [ -d "$git_root/$cand" ]; then
                printf "%s" "$git_root/$cand"
                return 0
            fi
            if [[ "$cand" == */* ]] && { [ -f "$git_root/${cand#*/}" ] || [ -d "$git_root/${cand#*/}" ]; }; then
                printf "%s" "$git_root/${cand#*/}"
                return 0
            fi
            local -a matches=()
            while IFS= read -r rel; do
                [ -n "$rel" ] && [ -f "$git_root/$rel" ] && matches+=("$git_root/$rel")
            done < <(git -C "$git_root" ls-files --cached --others --exclude-standard 2>/dev/null | awk -v t="$cand" '$0 == t || index($0, "/" t) == length($0) - length(t) + 1 { print }')
            if [ "${#matches[@]}" -eq 1 ]; then
                printf "%s" "${matches[0]}"
                return 0
            fi
            break
        done
    fi

    # Non-git workspace fallback (e.g. Mercurial or plain directory): check non-hidden subdirectories up to 3 levels deep
    for base_dir in "$init_root" "$workdir" "$cwd"; do
        [ -n "$base_dir" ] && [ -d "$base_dir" ] || continue
        local -a glob_matches=()
        local m
        for m in "$base_dir"/*/"$cand" "$base_dir"/*/*/"$cand" "$base_dir"/*/*/*/"$cand"; do
            [ -f "$m" ] && glob_matches+=("$m")
        done
        if [ "${#glob_matches[@]}" -eq 1 ]; then
            printf "%s" "${glob_matches[0]}"
            return 0
        fi
        break
    done

    # Fallback to AI artifact directories (`~/.gemini/*/brain/*/<cand>` and `~/.claude/plans/<cand>`) for bare plan filenames
    if [[ "$cand" != */* ]]; then
        local bdir artifact newest_artifact=""
        while IFS= read -r bdir; do
            if [ -n "$bdir" ] && [ -f "$bdir/$cand" ]; then
                printf "%s" "$bdir/$cand"
                return 0
            fi
        done < <(resolve_ai_brain_dirs "$cwd")
        for artifact in "$HOME"/.gemini/*/brain/*/"$cand" "${IDE_CLAUDE_DIR:-$HOME/.claude}/plans/$cand"; do
            if [ -f "$artifact" ]; then
                if [ -z "$newest_artifact" ] || [ "$artifact" -nt "$newest_artifact" ]; then
                    newest_artifact="$artifact"
                fi
            fi
        done
        if [ -n "$newest_artifact" ]; then
            printf "%s" "$newest_artifact"
            return 0
        fi
    fi
    return 1
}

open_file_or_dir_target() {
    local fpath="$1"
    local line="${2:-}"
    if [ -f "$fpath" ]; then
        open_in_editor "$fpath" "1" || return 0
        if [ -n "$line" ]; then
            local sess sock
            sess="$(resolve_target_session "$TARGET_ARG")"
            sock="$(get_ide_var "$sess" "@ide_socket" "NVIM_IDE_SOCKET")"
            [ -n "$sock" ] && [ -S "$sock" ] && command -v nvim >/dev/null 2>&1 && \
                nvim --headless --server "$sock" --remote-expr "execute('$line') . execute('normal! zz')" >/dev/null 2>&1 || true
        fi
        return 0
    elif [ -d "$fpath" ]; then
        cd_ide_workspace "$fpath" || true
        return 0
    fi
    return 1
}

resolve_and_open_target() {
    local raw_target="$1"
    local cwd="$2"
    parse_file_target "$raw_target"
    [ -n "$PARSE_PATH" ] || return 1
    if open_file_or_dir_target "$PARSE_PATH" "$PARSE_LINE"; then
        return 0
    fi
    local resolved=""
    if resolved="$(resolve_workspace_file "$PARSE_PATH" "$cwd")" && [ -n "$resolved" ]; then
        open_file_or_dir_target "$resolved" "$PARSE_LINE" && return 0
    fi
    return 1
}

open_ide_link() {
    local href="${1:-}"
    local word="${2:-}"
    local cwd="${3:-$PWD}"
    tmux set-option -gq word-separators " ()[]{}<>\"'\`,;*" 2>/dev/null || true

    # 1. Explicit OSC 8 hyperlink (`#{mouse_hyperlink}`) from the prompt or an AI CLI (`file://...`, `https://...`)
    if [ -n "$href" ]; then
        if [[ "$href" == file://* ]]; then
            if resolve_and_open_target "$href" "$cwd"; then
                return 0
            fi
        elif [[ "$href" == http://* || "$href" == https://* ]]; then
            open_browser_url "$href"
            return $?
        fi
    fi

    # 2. Fallback to clicked word (`#{mouse_word}`) when clicking plain text, markdown `[label](file://...)`, or prompt tokens
    word="${word#"${word%%[![:space:]]*}"}"
    word="${word%"${word##*[![:space:]]}"}"
    [ -z "$word" ] && return 0

    local bracket_label=""
    local md_label_re='\[([^]]+)\]\('
    if [[ "$word" =~ $md_label_re ]]; then
        bracket_label="${BASH_REMATCH[1]}"
        while [[ "$bracket_label" == [\(\[\{\<\"\'\`]* ]]; do
            bracket_label="${bracket_label#?}"
        done
        while [[ "$bracket_label" == *[\)\]\}\>\"\'\`,\;.:] ]]; do
            bracket_label="${bracket_label%?}"
        done
    fi

    local file_url_re='(file://[^])>"'\''`[:space:]]+)'
    if [[ "$word" =~ $file_url_re ]]; then
        local embedded_href="${BASH_REMATCH[1]}"
        while [[ "$embedded_href" == *[,\;.] ]] && [ ! -e "${embedded_href#file://}" ]; do
            embedded_href="${embedded_href%?}"
        done
        if resolve_and_open_target "$embedded_href" "$cwd"; then
            return 0
        fi
    fi

    local md_link_re='\[[^]]*\]\(([^)[:space:]]+)\)'
    if [[ "$word" =~ $md_link_re ]]; then
        word="${BASH_REMATCH[1]}"
    fi

    # Strip AI CLI tool-call wrappers such as `Read(~/path/file)` or `Edit(~/.gemini/.../walkthrough.md)`
    local tool_wrap_re='^(Read|Edit|Write|View|Update|Create|Bash)\((.+)$'
    if [[ "$word" =~ $tool_wrap_re ]]; then
        word="${BASH_REMATCH[2]}"
        word="${word%)}"
    fi

    # Strip surrounding punctuation/brackets/quotes and trailing colons (e.g. file.rs:42:13:, (file.rs:42:13):)
    while [[ "$word" == [\(\[\{\<\"\'\`]* ]]; do
        word="${word#?}"
    done
    while [[ "$word" == *[\)\]\}\>\"\'\`,\;.:] ]]; do
        word="${word%?}"
    done
    [ -z "$word" ] && return 0

    if [[ "$word" == http://* || "$word" == https://* ]]; then
        open_browser_url "$word"
        return $?
    fi

    # Machine-local link rules (see resolve_private_link) take precedence over local paths
    local private_url=""
    if private_url="$(resolve_private_link "$word" "$cwd")" && [ -n "$private_url" ]; then
        open_browser_url "$private_url"
        return $?
    fi

    # Check if the clicked token is the rendered label of a `[label](file:///path#Lline)` link in the AI conversation
    local ai_md_url=""
    if ai_md_url="$(resolve_ai_markdown_link "$word" "$cwd")" && [ -n "$ai_md_url" ]; then
        if resolve_and_open_target "$ai_md_url" "$cwd"; then
            return 0
        fi
    fi

    # Check if word is a local file path (optionally with #L<line>, :line:col, or :start-end ranges)
    if resolve_and_open_target "$word" "$cwd"; then
        return 0
    fi

    # If a tool-call path was middle-truncated with `...` (e.g. `~/.gemini/.../walkthrough.md`), try its basename
    if [[ "$word" == *...* ]] && [[ "$word" == */* ]]; then
        local trunc_base="${word##*/}"
        if [ -n "$trunc_base" ] && [ "$trunc_base" != "$word" ]; then
            if ai_md_url="$(resolve_ai_markdown_link "$trunc_base" "$cwd")" && [ -n "$ai_md_url" ]; then
                if resolve_and_open_target "$ai_md_url" "$cwd"; then
                    return 0
                fi
            fi
            if resolve_and_open_target "$trunc_base" "$cwd"; then
                return 0
            fi
        fi
    fi

    # If a markdown link wrapped across terminal lines (truncating the URL), fall back to its `[label]`
    if [ -n "$bracket_label" ] && [ "$bracket_label" != "$word" ]; then
        if resolve_and_open_target "$bracket_label" "$cwd"; then
            return 0
        fi
    fi
}

if [ "$ACTION" = "copy" ]; then
    copy_to_system_clipboard
    exit 0
elif [ "$ACTION" = "paste" ]; then
    paste_from_system_clipboard "$TARGET_ARG"
    exit 0
elif [ "$ACTION" = "open-link" ]; then
    open_ide_link "${LINK_HREF:-}" "${LINK_WORD:-}" "${LINK_CWD:-}"
    exit 0
elif [ "$ACTION" = "open" ]; then
    open_in_editor "$OPEN_FILE" "1"
    exit 0
elif [ "$ACTION" = "preview" ]; then
    open_in_editor "$OPEN_FILE" "0"
    exit 0
elif [ "$ACTION" = "cd" ]; then
    cd_ide_workspace "$CD_TARGET"
    exit $?
elif [ "$ACTION" = "toggle" ]; then
    toggle_main_pane "toggle"
    exit 0
elif [ "$ACTION" = "show-editor" ]; then
    toggle_main_pane "editor"
    exit 0
elif [ "$ACTION" = "focus-editor" ]; then
    toggle_main_pane "focus-editor"
    exit 0
elif [ "$ACTION" = "show-ai" ]; then
    toggle_main_pane "ai"
    exit 0
elif [ "$ACTION" = "show-term" ]; then
    toggle_main_pane "term"
    exit 0
elif [ "$ACTION" = "toggle-editor" ]; then
    toggle_main_pane "toggle-editor"
    exit 0
elif [ "$ACTION" = "toggle-ai" ]; then
    toggle_main_pane "toggle-ai"
    exit 0
elif [ "$ACTION" = "toggle-term" ]; then
    toggle_main_pane "toggle-term"
    exit 0
elif [ "$ACTION" = "swap" ]; then
    swap_ide_pane "$SWAP_DIR"
    exit $?
elif [ "$ACTION" = "run-ai-popup" ]; then
    run_ai_popup
    exit 0
elif [ "$ACTION" = "quit" ]; then
    quit_ide
    exit $?
fi

if [ "$ACTION" = "list" ]; then
    tmux list-sessions 2>/dev/null || echo "No active tmux sessions."
    exit 0
fi

if [ "$ACTION" = "kill" ]; then
    FORCE_QUIT="1"
    quit_ide
    exit 0
fi

TARGET_DIR="${TARGET_ARG:-$PWD}"
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

SESSION="$(sanitize_session_name "$TARGET_DIR")"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
NVIM_SOCKET="${RUNTIME_DIR}/nvim-ide-${SESSION}.sock"

# Ensure X11 / Wayland display & auth variables are populated for Tmux & Neovim clipboard (xclip / wl-copy)
if [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ]; then
    export DISPLAY=":0"
fi
uid_num="$(id -u 2>/dev/null || true)"
if [ -n "$uid_num" ] && [ -d "/run/user/$uid_num" ]; then
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$uid_num/wayland-0" ]; then
        export WAYLAND_DISPLAY="wayland-0"
    fi
    if [ -z "${XAUTHORITY:-}" ]; then
        for auth_candidate in "/run/user/$uid_num"/.mutter-Xwaylandauth.*; do
            if [ -f "$auth_candidate" ]; then
                export XAUTHORITY="$auth_candidate"
                break
            fi
        done
    fi
fi

if ! session_exists "$SESSION"; then
    # Clean up any stale socket from an abnormal exit
    rm -f "$NVIM_SOCKET" "${NVIM_SOCKET}.tree"

    COLS="$(tput cols 2>/dev/null || echo 160)"
    LINES="$(tput lines 2>/dev/null || echo 48)"
    [ "$COLS" -lt 80 ] && COLS=160
    [ "$LINES" -lt 24 ] && LINES=48

    # Create Window 1 with Top-Left Pane as AI Agent (@ide_role=ai)
    PANE_AI="$(tmux new-session -d -P -F "#{pane_id}" -s "$SESSION" -n "ide" -c "$TARGET_DIR" -x "$COLS" -y "$LINES" -e "IDE_SESSION=$SESSION" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
    MAIN_WIN="$(tmux display-message -p -t "$PANE_AI" "#{window_id}")"
    tmux set-option -p -t "$PANE_AI" @ide_role "ai"

    # Split horizontally (-h -l 50%) to create Top-Right 50% Main Editor pane (@ide_role=editor)
    PANE_EDITOR="$(tmux split-window -h -P -F "#{pane_id}" -t "$PANE_AI" -l 50% -c "$TARGET_DIR" -e "IDE_SESSION=$SESSION" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
    tmux set-option -p -t "$PANE_EDITOR" @ide_role "editor"

    set_ide_var "$SESSION" "@ide_session" "IDE_SESSION" "$SESSION"
    set_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI" "$IDE_AI_CLI"
    set_ide_var "$SESSION" "@ide_socket" "NVIM_IDE_SOCKET" "$NVIM_SOCKET"
    set_ide_var "$SESSION" "@ide_initial_root" "IDE_INITIAL_ROOT" "$TARGET_DIR"
    set_ide_var "$SESSION" "@ide_workdir" "IDE_WORKDIR" "$TARGET_DIR"
    set_ide_var "$SESSION" "@ide_main_win" "IDE_MAIN_WIN" "$MAIN_WIN"
    set_ide_var "$SESSION" "@ide_editor_pane" "NVIM_IDE_PANE" "$PANE_EDITOR"
    set_ide_var "$SESSION" "@ide_ai_pane" "IDE_AI_PANE" "$PANE_AI"
    set_ide_var "$SESSION" "@ide_layout_mode" "IDE_LAYOUT_MODE" "$LAYOUT_MODE"

    if [ "$LAYOUT_MODE" = "3pane" ]; then
        # Split full window vertically (-f -v -l 25%) to create Bottom 100% width x 25% height Shell pane (@ide_role=term),
        # leaving Top-Left AI Agent (50%x75%) and Top-Right Main Editor (50%x75%) side-by-side at eye level
        PANE_TERM="$(tmux split-window -f -v -P -F "#{pane_id}" -t "$MAIN_WIN" -l 25% -c "$TARGET_DIR" -e "IDE_SESSION=$SESSION" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "NVIM_IDE_PANE=$PANE_EDITOR" -e "IDE_INITIAL_ROOT=$TARGET_DIR")"
        tmux set-option -p -t "$PANE_TERM" @ide_role "term"
        set_ide_var "$SESSION" "@ide_term_pane" "IDE_TERM_PANE" "$PANE_TERM"
    fi

    if command -v nvim >/dev/null 2>&1; then
        if [ -f "$TARGET_DIR/README.md" ]; then
            tmux send-keys -t "$PANE_EDITOR" " nvim --listen '$NVIM_SOCKET' $(printf '%q' "$TARGET_DIR/README.md")" C-m
        else
            tmux send-keys -t "$PANE_EDITOR" " nvim --listen '$NVIM_SOCKET'" C-m
        fi
    elif command -v vim >/dev/null 2>&1; then
        tmux send-keys -t "$PANE_EDITOR" " vim" C-m
    fi

    if AI_RUN_CMD="$(resolve_ai_cmd "$IDE_AI_CLI")"; then
        tmux send-keys -t "$PANE_AI" " $AI_RUN_CMD" C-m
    fi

    tmux select-window -t "$MAIN_WIN"
    tmux select-pane -t "$PANE_AI"
else
    # Only update IDE_AI_CLI on an existing session when --ai was explicitly passed
    if [ "$AI_CLI_FROM_FLAG" = "1" ]; then
        EXISTING_AI_CLI="$(get_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI")"
        set_ide_var "$SESSION" "@ide_ai_cli" "IDE_AI_CLI" "$IDE_AI_CLI"
        if [ "$IDE_AI_CLI" != "$EXISTING_AI_CLI" ]; then
            tmux kill-session -t "=ai-${SESSION}" 2>/dev/null || true
            AI_PANE_ID="$(resolve_role_pane "$SESSION" "ai" "@ide_ai_pane" "IDE_AI_PANE")"
            ED_PANE_ID="$(resolve_role_pane "$SESSION" "editor" "@ide_editor_pane" "NVIM_IDE_PANE")"
            INIT_ROOT_VAL="$(get_ide_var "$SESSION" "@ide_initial_root" "IDE_INITIAL_ROOT")"
            [ -z "$INIT_ROOT_VAL" ] && INIT_ROOT_VAL="$TARGET_DIR"
            if pane_exists "$AI_PANE_ID"; then
                tmux respawn-pane -k -t "$AI_PANE_ID" -c "$TARGET_DIR" -e "IDE_SESSION=$SESSION" -e "IDE_AI_CLI=$IDE_AI_CLI" -e "NVIM_IDE_SOCKET=$NVIM_SOCKET" -e "NVIM_IDE_PANE=$ED_PANE_ID" -e "IDE_INITIAL_ROOT=$INIT_ROOT_VAL" 2>/dev/null || \
                    tmux respawn-pane -k -t "$AI_PANE_ID" -c "$TARGET_DIR" "env IDE_SESSION='$SESSION' IDE_AI_CLI='$IDE_AI_CLI' NVIM_IDE_SOCKET='$NVIM_SOCKET' NVIM_IDE_PANE='$ED_PANE_ID' IDE_INITIAL_ROOT='$INIT_ROOT_VAL' ${SHELL:-/bin/zsh} -l" 2>/dev/null || true
                if AI_RUN_CMD="$(resolve_ai_cmd "$IDE_AI_CLI")"; then
                    tmux send-keys -t "$AI_PANE_ID" " $AI_RUN_CMD" C-m
                fi
            fi
        fi
    fi
fi

for display_var in DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS; do
    if [ -n "${!display_var:-}" ]; then
        tmux set-environment -t "=$SESSION" "$display_var" "${!display_var}" 2>/dev/null || true
    fi
done

if [ -f "$HOME/.tmux.conf" ]; then
    tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
fi
tmux set-option -q -t "=${SESSION}:" status-position top 2>/dev/null || true

if [ "$DETACH_MODE" = "1" ]; then
    exit 0
fi

if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$SESSION"
else
    exec tmux attach-session -t "=$SESSION"
fi
