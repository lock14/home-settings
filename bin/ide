USAGE_TEXT = """Usage: ide [OPTIONS] [DIRECTORY]

Launch or attach to a Solarized Dark Tmux + Neovim IDE workspace session.

Options:
  --3pane                  Launch default 3-pane layout (Top-Left 50%x75% AI, Top-Right 50%x75% Editor, Bottom 100%x25% Shell)
  --2pane                  Launch 2-pane layout (Left 50%x100% AI, Right 50%x100% Editor)
  --ai, --agent <CLI>      Select AI CLI agent: agy (default), claude, or codex (overrides $IDE_AI_CLI)
  --open <FILE> [LINE]     Open <FILE> in the Main Editor pane via RPC and focus Editor
  --preview <FILE> [LINE]  Preview <FILE> in the Main Editor pane via RPC without changing focus
  cd, --cd [DIR]           Dive into <DIR> (or --reset / ~ for initial root), setting Working Directory across Editor and Shell
  -s, --sessions [SESSION] Open interactive multi-session IDE workspace switcher (Alt+s / Prefix+s)
  --next-attention [SESSION] Jump to oldest IDE session waiting for AI attention in urgency and FIFO order (Alt+Shift+S / Prefix+S)
  --agent-state <STATE> [--message <TEXT>] [SESSION] Record deterministic AI lifecycle state: running, approval, quota, done, or idle
  --ack-ai [SESSION...]    Acknowledge AI attention across one or more IDE sessions
  --open-pr [SESSION]      Open cached pull or merge request URL for an IDE session
  --send <PAYLOAD> [SESSION] Dispatch context (--stdin, --ref <PATH>[:L1[-L2]], --text <TEXT>, --no-focus, --switch) to AI Agent
  --toggle [SESSION]       Toggle focus between the AI Agent and the Text Editor (unparking if hidden)
  --show-editor [SESSION]  Focus the Text Editor pane (unparking if hidden), or bounce back if already focused
  --show-ai [SESSION]      Focus the AI Agent pane (unparking if hidden), or bounce back if already focused
  --show-term [SESSION]    Focus the Interactive Shell pane (unparking if hidden), or bounce back if already focused
  --toggle-editor [SESSION] Hide or reappear the Text Editor pane (Alt+Shift+E)
  --toggle-ai [SESSION]    Hide or reappear the AI Agent pane
  --toggle-term [SESSION]  Hide or reappear the Interactive Shell pane (Alt+Shift+T)
  --swap <DIR> [SESSION]   Swap the active pane with its neighbor in <DIR> (left|down|up|right, Alt+Shift+H/J/K/L)
  --monitor, --top         Launch interactive system monitor with btop -> htop -> top fallback (Alt+m / Prefix+m)
  --keys                   Display the Solarized Dark IDE keybinding cheatsheet (Alt+? / Prefix+?)
  refresh, -r, --refresh [NAME] Refresh tmux top bar, Editor CWDs, and idle Shell panes across all (or target) IDE sessions (Prefix+r)
  quit, -q, --quit [NAME...] Safely quit IDE session(s) NAME (checks for unsaved Neovim buffers first)
  -f, --force              Force-quit when used with --quit (discards unsaved Neovim buffers)
  --detach                 Create/update workspace session in background without attaching
  kill, --kill [NAME...]   Force-quit IDE session(s) NAME without the unsaved-buffer check
  --list [--plain]         List active IDE workspace sessions with agent CLI, state, Git branch, and directory
  -h, --help               Show this help message and exit

Without NAME / SESSION, session commands act only on the ide session of the calling pane
(outside tmux: the current directory's session), never on any other tmux session.

Environment Variables:
  IDE_AI_CLI               AI CLI tool for the AI Agent pane: agy (default), claude, or codex
  IDE_BROWSER              Optional browser executable for opening http(s):// links
  IDE_NOTIFY               Local desktop banner policy: 0 (default), 1 / unfocused, or always
  IDE_LINK_RULES           Untracked Ctrl+click link, session-naming, notification, and VCS hooks (default: ${XDG_CONFIG_HOME:-~/.config}/ide/links.sh)
                           defining `ide_resolve_link`, `ide_session_name`, `ide_notify`, or `ide_vcs_summary`"""


def usage(file=sys.stdout) -> None:
    print(USAGE_TEXT, file=file)


def run_tmux(*args: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess:
    if input_bytes is not None:
        return subprocess.run(
            ["tmux", *args],
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return subprocess.run(
        ["tmux", *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )


def tmux_out(*args: str) -> str:
    res = run_tmux(*args)
    return (res.stdout or "").rstrip("\r\n") if isinstance(res.stdout, str) else ""


def is_socket_path(path: str | Path) -> bool:
    try:
        st = os.stat(path)
        return stat.S_ISSOCK(st.st_mode)
    except OSError:
        return False


def safe_getcwd() -> str:
    pwd = os.environ.get("PWD") or ""
    try:
        cwd = os.getcwd()
        st_dot = os.stat(".")
        if pwd.startswith("/") and os.path.isdir(pwd):
            st_pwd = os.stat(pwd)
            if st_dot.st_dev != st_pwd.st_dev or st_dot.st_ino != st_pwd.st_ino:
                os.chdir(pwd)
                return pwd
        if st_dot.st_nlink > 0:
            return cwd
    except OSError:
        pass
    for cand in (
        pwd,
        os.environ.get("IDE_WORKDIR") or "",
        os.environ.get("IDE_INITIAL_ROOT") or "",
        os.path.expanduser("~"),
        "/",
    ):
        if cand and cand.startswith("/") and os.path.isdir(cand):
            try:
                os.chdir(cand)
            except OSError:
                pass
            return cand
    return "/"


def is_ssh_session(target_arg: str = "") -> bool:
    for var in ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT"):
        if os.environ.get(var):
            return True
    if (os.environ.get("TMUX") or os.environ.get("TMUX_TMPDIR")) and shutil.which("tmux"):
        env_lines: list[str] = []
        if target_arg and target_arg.startswith("%"):
            env_lines.extend(tmux_out("show-environment", "-t", target_arg).splitlines())
        else:
            sess = (
                target_arg
                if (target_arg and session_exists(target_arg))
                else (resolve_target_session(target_arg) if target_arg else current_ide_session())
            )
            if sess and session_exists(sess):
                env_lines.extend(tmux_out("show-environment", "-t", f"={sess}").splitlines())
            elif os.environ.get("TMUX_PANE"):
                env_lines.extend(tmux_out("show-environment", "-t", os.environ["TMUX_PANE"]).splitlines())
        env_lines.extend(tmux_out("show-environment", "-g").splitlines())
        seen_vars: set[str] = set()
        for line in env_lines:
            for var in ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT"):
                if var in seen_vars:
                    continue
                if line == f"-{var}":
                    seen_vars.add(var)
                    continue
                prefix = f"{var}="
                if line.startswith(prefix):
                    seen_vars.add(var)
                    if len(line) > len(prefix):
                        return True
    return False


def discover_display_env(target_arg: str = "", ignore_tmux_env: bool = False) -> None:
    if any(os.environ.get(v) for v in ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT")):
        return
    if not ignore_tmux_env and is_ssh_session(target_arg):
        return
    if not ignore_tmux_env and (os.environ.get("TMUX") or os.environ.get("TMUX_TMPDIR")) and shutil.which("tmux"):
        env_lines: list[str] = []
        if target_arg and target_arg.startswith("%"):
            env_lines.extend(tmux_out("show-environment", "-t", target_arg).splitlines())
        else:
            sess = (
                target_arg
                if (target_arg and session_exists(target_arg))
                else (resolve_target_session(target_arg) if target_arg else current_ide_session())
            )
            if sess and session_exists(sess):
                env_lines.extend(tmux_out("show-environment", "-t", f"={sess}").splitlines())
            elif os.environ.get("TMUX_PANE"):
                env_lines.extend(tmux_out("show-environment", "-t", os.environ["TMUX_PANE"]).splitlines())
        env_lines.extend(tmux_out("show-environment", "-g").splitlines())
        seen_vars: set[str] = set()
        for line in env_lines:
            for var in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS"):
                if var in seen_vars or os.environ.get(var):
                    continue
                prefix = f"{var}="
                if line.startswith(prefix):
                    val = line[len(prefix):]
                    if val:
                        os.environ[var] = val
                        seen_vars.add(var)
    if not os.environ.get("DISPLAY") and is_socket_path("/tmp/.X11-unix/X0"):
        os.environ["DISPLAY"] = ":0"
    try:
        uid = os.getuid()
    except AttributeError:
        uid = None
    if uid is not None:
        run_dir = Path(f"/run/user/{uid}")
        if run_dir.is_dir():
            if not os.environ.get("WAYLAND_DISPLAY") and is_socket_path(run_dir / "wayland-0"):
                os.environ["WAYLAND_DISPLAY"] = "wayland-0"
            if not os.environ.get("DBUS_SESSION_BUS_ADDRESS") and is_socket_path(run_dir / "bus"):
                os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={run_dir / 'bus'}"
            if not os.environ.get("XAUTHORITY"):
                for auth_cand in sorted(run_dir.glob(".mutter-Xwaylandauth.*")):
                    if auth_cand.is_file():
                        os.environ["XAUTHORITY"] = str(auth_cand)
                        break


_NVIM_BIN_CACHE: str | None = None
_NVIM_BIN_RESOLVED = False


def _version_sort_key(bin_path: Path) -> tuple[int, ...]:
    ver_str = bin_path.parent.parent.name
    if ver_str == "latest":
        return (999999,)
    nums = [int(x) for x in re.findall(r"[0-9]+", ver_str)]
    return tuple(nums) if nums else (0,)


def resolve_nvim_bin() -> str | None:
    global _NVIM_BIN_CACHE, _NVIM_BIN_RESOLVED
    if _NVIM_BIN_RESOLVED:
        return _NVIM_BIN_CACHE
    _NVIM_BIN_RESOLVED = True
    cand = shutil.which("nvim")
    if cand:
        try:
            real = os.path.realpath(cand)
        except OSError:
            real = cand
        norm_cand = cand.replace("\\", "/")
        if "/mise/shims/" in norm_cand or os.path.basename(real) == "mise":
            mise_root = Path(cand).parent.parent
            installs_dir = mise_root / "installs" / "neovim"
            if installs_dir.is_dir():
                bins = sorted(installs_dir.glob("*/bin/nvim"), key=_version_sort_key)
                for b in reversed(bins):
                    if b.is_file() and os.access(b, os.X_OK):
                        _NVIM_BIN_CACHE = str(b)
                        return _NVIM_BIN_CACHE
            if shutil.which("mise"):
                env = os.environ.copy()
                if mise_root.is_dir() and "MISE_DATA_DIR" not in env:
                    env["MISE_DATA_DIR"] = str(mise_root)
                res = subprocess.run(
                    ["mise", "which", "nvim"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    env=env,
                    check=False,
                )
                if res.returncode == 0:
                    p = res.stdout.strip()
                    if p and os.path.isfile(p) and os.access(p, os.X_OK):
                        _NVIM_BIN_CACHE = p
                        return _NVIM_BIN_CACHE
        _NVIM_BIN_CACHE = cand
        return _NVIM_BIN_CACHE
    if shutil.which("mise"):
        res = subprocess.run(
            ["mise", "which", "nvim"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        if res.returncode == 0:
            p = res.stdout.strip()
            if p and os.path.isfile(p) and os.access(p, os.X_OK):
                _NVIM_BIN_CACHE = p
                return _NVIM_BIN_CACHE
    return None


def resolve_ai_cmd(cli: str) -> str | None:
    if cli == "claude":
        if shutil.which("claude"):
            return "claude"
    elif cli in ("codex", "openai"):
        if shutil.which("codex"):
            return "codex"
    elif cli == "agy":
        if shutil.which("agy"):
            return "agy"
    else:
        if shutil.which(cli) or (os.path.isfile(cli) and os.access(cli, os.X_OK)):
            return cli
        shell = os.environ.get("SHELL") or "/bin/zsh"
        return f"{shell} -ic {shlex.quote(cli)}"

    for fallback in ("agy", "claude", "codex"):
        if shutil.which(fallback):
            return fallback
    return None


def sanitize_name_token(raw: str) -> str:
    cleaned = re.sub(r"[.: ]", "-", raw)
    cleaned = re.sub(r"[^A-Za-z0-9_-]", "", cleaned).lstrip("-")
    return cleaned or "workspace"


def _call_ide_hook(fn_name: str, *args: str) -> str:
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    rules = os.environ.get("IDE_LINK_RULES") or os.path.join(xdg_cfg, "ide", "links.sh")
    try:
        with open(rules, "r", encoding="utf-8") as f:
            if fn_name not in f.read():
                return ""
    except OSError:
        return ""
    res = subprocess.run(
        [
            "bash",
            "-c",
            f'. "$1" && declare -F {fn_name} >/dev/null && {fn_name} "${{@:2}}"',
            "ide",
            rules,
            *args,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return (res.stdout or "").strip() if res.returncode == 0 else ""


def resolve_custom_session_name(target_dir: str) -> str:
    return _call_ide_hook("ide_session_name", target_dir)


def sanitize_session_name(raw: str) -> str:
    custom = resolve_custom_session_name(raw)
    if custom:
        return sanitize_name_token(custom)
    base = os.path.basename(raw.rstrip("/")) if raw.rstrip("/") else os.path.basename(raw)
    return sanitize_name_token(base)


def session_exists(sess: str) -> bool:
    return bool(sess) and run_tmux("has-session", "-t", f"={sess}").returncode == 0


def missing_session_msg(sess: str) -> str:
    if sess:
        return f"No active IDE session named '{sess}'."
    return "Not inside an ide session (pass a session name, such as 'ide --quit <dir>')."


def is_ide_session_meta(sess_name: str, ide_sess: str, ide_sock: str, ide_win: str) -> bool:
    if not sess_name or re.match(r"^(ai|agy)-", sess_name):
        return False
    return bool(ide_sess or ide_sock or ide_win or sess_name.startswith("ide-"))


def check_is_ide_session(sess: str) -> bool:
    if not sess or re.match(r"^(ai|agy)-", sess):
        return False
    info = tmux_out(
        "display-message", "-p", "-t", f"={sess}:",
        "#{session_name}\t#{@ide_session}\t#{@ide_socket}\t#{@ide_main_win}",
    )
    if not info or "\t" not in info:
        return False
    parts = (info.split("\t") + ["", "", "", ""])[:4]
    return is_ide_session_meta(parts[0], parts[1], parts[2], parts[3])


def current_ide_session() -> str:
    tmux_env = os.environ.get("TMUX", "")
    if not tmux_env:
        return ""
    parts = tmux_env.split(",")
    if len(parts) < 3:
        return ""
    server_pid = parts[-2]
    last_part = parts[-1].lstrip("$")
    tmux_pane = os.environ.get("TMUX_PANE", "")
    target = tmux_pane if tmux_pane else (f"${last_part}" if last_part else "")
    if not target:
        return ""
    found = tmux_out(
        "display-message", "-p", "-t", target,
        "#{pid}\t#{session_name}\t#{@ide_session}\t#{@ide_socket}\t#{@ide_main_win}",
    )
    if not found or "\t" not in found:
        return ""
    fparts = (found.split("\t") + ["", "", "", "", ""])[:5]
    pid, sess_name, ide_sess, ide_sock, ide_win = fparts[0], fparts[1], fparts[2], fparts[3], fparts[4]
    if pid != server_pid:
        return ""
    if is_ide_session_meta(sess_name, ide_sess, ide_sock, ide_win):
        return sess_name
    return ""


def resolve_target_session(arg: str = "") -> str:
    if arg.startswith("#{") and arg.endswith("}"):
        arg = ""
    if arg:
        if session_exists(arg):
            return arg
        if os.path.isdir(arg):
            return sanitize_session_name(os.path.abspath(arg))
        return sanitize_name_token(arg)
    if os.environ.get("TMUX"):
        return current_ide_session()
    return sanitize_session_name(safe_getcwd())


def get_ide_var(sess: str, opt_name: str, env_name: str) -> str:
    val = tmux_out("show-options", "-qv", "-t", f"={sess}:", opt_name)
    if not val:
        env_line = tmux_out("show-environment", "-t", f"={sess}", env_name)
        prefix = f"{env_name}="
        if env_line.startswith(prefix):
            val = env_line[len(prefix):]
    return val


def normalize_pane_cwd(raw_cwd: str, sess: str = "", target_arg: str = "") -> str:
    if raw_cwd and os.path.isdir(raw_cwd):
        return raw_cwd
    if not sess and (os.environ.get("TMUX") or target_arg):
        sess = resolve_target_session(target_arg)
    workdir = ""
    init_root = ""
    if sess and session_exists(sess):
        workdir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
        init_root = get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
    workdir = workdir or os.environ.get("IDE_WORKDIR") or ""
    init_root = init_root or os.environ.get("IDE_INITIAL_ROOT") or ""
    anchors = [a.rstrip("/") for a in (workdir, init_root, os.environ.get("PWD") or "") if a and os.path.isdir(a)]
    clean_raw = raw_cwd.rstrip("/") if raw_cwd else ""
    if clean_raw.startswith("/"):
        for anc in anchors:
            if anc.endswith(clean_raw):
                return anc
            cur = os.path.dirname(clean_raw)
            while cur and cur != "/":
                if anc.endswith(cur):
                    cand = anc + clean_raw[len(cur):]
                    if os.path.isdir(cand):
                        return cand
                cur = os.path.dirname(cur)
    for anc in anchors:
        return anc
    return safe_getcwd()


def set_ide_var(sess: str, opt_name: str, env_name: str, val: str) -> None:
    run_tmux(
        "set-option", "-q", "-t", f"={sess}:", opt_name, val,
        ";",
        "set-environment", "-t", f"={sess}", env_name, val,
    )


def set_ide_vars(sess: str, pairs: list[tuple[str, str, str]]) -> None:
    if not pairs:
        return
    cmd: list[str] = []
    for opt_name, env_name, val in pairs:
        if cmd:
            cmd.append(";")
        cmd.extend([
            "set-option", "-q", "-t", f"={sess}:", opt_name, val,
            ";",
            "set-environment", "-t", f"={sess}", env_name, val,
        ])
    run_tmux(*cmd)


def pane_exists(pane: str) -> bool:
    return bool(pane) and tmux_out("display-message", "-p", "-t", pane, "#{pane_id}") == pane


def window_exists(win: str) -> bool:
    return bool(win) and tmux_out("display-message", "-p", "-t", win, "#{window_id}") == win


def pane_in_win(pane: str, win: str) -> bool:
    return bool(pane) and bool(win) and tmux_out("display-message", "-p", "-t", pane, "#{window_id}") == win


def pane_is_parked(pane: str, win: str) -> bool:
    if not pane or not win:
        return False
    info = tmux_out("display-message", "-p", "-t", pane, "#{pane_id}\t#{window_id}")
    if "\t" not in info:
        return False
    pid, wid = info.split("\t", 1)
    return pid == pane and wid != win


def resolve_main_win(sess: str, editor_pane: str = "", ai_pane: str = "", term_pane: str = "") -> str:
    main_win = get_ide_var(sess, "@ide_main_win", "IDE_MAIN_WIN")
    if window_exists(main_win):
        wname = tmux_out("display-message", "-p", "-t", main_win, "#{window_name}")
        if not wname.startswith("_ide_park_"):
            return main_win
    for p in (editor_pane, ai_pane, term_pane):
        if pane_exists(p):
            info = tmux_out("display-message", "-p", "-t", p, "#{window_id}\t#{window_name}")
            if "\t" in info:
                wid, wname = info.split("\t", 1)
                if wid and not wname.startswith("_ide_park_"):
                    set_ide_var(sess, "@ide_main_win", "IDE_MAIN_WIN", wid)
                    return wid
    win_lines = tmux_out("list-windows", "-t", f"={sess}", "-F", "#{window_id}\t#{window_name}").splitlines()
    main_win = ""
    for line in win_lines:
        if "\t" in line:
            wid, wname = line.split("\t", 1)
            if not wname.startswith("_ide_park_"):
                main_win = wid
                break
    if not main_win and win_lines:
        main_win = win_lines[0].split("\t", 1)[0]
    if main_win:
        set_ide_var(sess, "@ide_main_win", "IDE_MAIN_WIN", main_win)
    return main_win


def resolve_role_pane(sess: str, role: str, opt_name: str, env_name: str) -> str:
    pane = get_ide_var(sess, opt_name, env_name)
    if not pane_exists(pane):
        pane = ""
        for line in tmux_out("list-panes", "-s", "-t", f"={sess}:", "-F", "#{pane_id}\t#{@ide_role}").splitlines():
            if "\t" in line:
                pid, prole = line.split("\t", 1)
                if prole == role:
                    pane = pid
                    break
        if pane:
            set_ide_var(sess, opt_name, env_name, pane)
    return pane


def focus_pane_preserving_zoom(win: str, target_pane: str) -> None:
    info = tmux_out("display-message", "-p", "-t", win, "#{pane_id}\t#{window_zoomed_flag}")
    cur_pane, was_zoomed = (info.split("\t", 1) + ["0"])[:2] if "\t" in info else (info, "0")
    cmd: list[str] = []
    if cur_pane and cur_pane != target_pane:
        cmd.extend(["set-option", "-w", "-t", win, "@ide_last_pane", cur_pane, ";"])
    cmd.extend(["select-window", "-t", win, ";", "select-pane", "-t", target_pane])
    run_tmux(*cmd)
    if was_zoomed == "1" and tmux_out("display-message", "-p", "-t", win, "#{window_zoomed_flag}") == "0":
        run_tmux("resize-pane", "-Z", "-t", target_pane)


def clamp_dim(val_str: str, total: int, fallback: int) -> int:
    min_v = max(4, total // 10)
    max_v = max(min_v, total - min_v)
    try:
        val = int(val_str)
        if val <= 0:
            val = fallback
    except (ValueError, TypeError):
        val = fallback
    return max(min_v, min(max_v, val))


def pane_for_role(role: str, ai_pane: str, editor_pane: str, term_pane: str) -> str:
    if role == "ai":
        return ai_pane
    if role == "editor":
        return editor_pane
    if role == "term":
        return term_pane
    return ""


def resolve_layout_roles(sess: str) -> tuple[str, str, str, str]:
    raw = tmux_out(
        "display-message",
        "-p",
        "-t",
        f"={sess}:",
        "#{@ide_editor_before}\t#{@ide_term_before}\t#{@ide_bar_role}\t#{@ide_bar_before}\t#{@ide_left_role}\t#{@ide_right_role}",
    )
    parts = raw.split("\t") if "\t" in raw else []
    ed_before = (parts[0] if len(parts) > 0 and parts[0] else "") or get_ide_var(sess, "@ide_editor_before", "IDE_EDITOR_BEFORE")
    term_before = (parts[1] if len(parts) > 1 and parts[1] else "") or get_ide_var(sess, "@ide_term_before", "IDE_TERM_BEFORE")
    bar_role = (parts[2] if len(parts) > 2 and parts[2] else "") or get_ide_var(sess, "@ide_bar_role", "IDE_BAR_ROLE") or "term"
    bar_before = (
        (parts[3] if len(parts) > 3 and parts[3] else "")
        or get_ide_var(sess, "@ide_bar_before", "IDE_BAR_BEFORE")
        or (term_before or "0")
    )
    left_role = (parts[4] if len(parts) > 4 and parts[4] else "") or get_ide_var(sess, "@ide_left_role", "IDE_LEFT_ROLE")
    right_role = (parts[5] if len(parts) > 5 and parts[5] else "") or get_ide_var(sess, "@ide_right_role", "IDE_RIGHT_ROLE")

    if (
        not left_role
        or not right_role
        or left_role == right_role
        or left_role == bar_role
        or right_role == bar_role
    ):
        if bar_role == "term":
            if ed_before == "1":
                left_role, right_role = "editor", "ai"
            else:
                left_role, right_role = "ai", "editor"
        elif bar_role == "ai":
            if ed_before == "1":
                left_role, right_role = "editor", "term"
            else:
                left_role, right_role = "term", "editor"
        elif bar_role == "editor":
            left_role, right_role = "ai", "term"
    return bar_role, bar_before, left_role, right_role


def record_main_geometry(sess: str, main_win: str, ai_pane: str, editor_pane: str, term_pane: str) -> None:
    coords: dict[str, tuple[int, int, int, int]] = {}
    for line in tmux_out(
        "list-panes", "-t", main_win, "-F", "#{pane_id}\t#{pane_left}\t#{pane_top}\t#{pane_width}\t#{pane_height}"
    ).splitlines():
        parts = line.split("\t")
        if len(parts) == 5:
            try:
                coords[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]))
            except ValueError:
                pass

    ai_in = ai_pane in coords
    ed_in = editor_pane in coords
    term_in = term_pane in coords
    ai_left, ai_top, ai_w, ai_h = coords.get(ai_pane, (0, 0, 0, 0))
    ed_left, ed_top, ed_w, ed_h = coords.get(editor_pane, (0, 0, 0, 0))
    term_left, term_top, term_w, term_h = coords.get(term_pane, (0, 0, 0, 0))

    updates: list[tuple[str, str, str]] = []

    if ai_in and ed_in and term_in:
        bar_role = ""
        pair_a = pair_b = ""
        pa_left = pa_top = pa_w = pb_left = pb_w = bar_top = bar_h = 0
        if ai_top == ed_top and term_top != ai_top:
            pair_a, pa_left, pa_top, pa_w = "ai", ai_left, ai_top, ai_w
            pair_b, pb_left, pb_w = "editor", ed_left, ed_w
            bar_role, bar_top, bar_h = "term", term_top, term_h
        elif ed_top == term_top and ai_top != ed_top:
            pair_a, pa_left, pa_top, pa_w = "editor", ed_left, ed_top, ed_w
            pair_b, pb_left, pb_w = "term", term_left, term_w
            bar_role, bar_top, bar_h = "ai", ai_top, ai_h
        elif ai_top == term_top and ed_top != ai_top:
            pair_a, pa_left, pa_top, pa_w = "ai", ai_left, ai_top, ai_w
            pair_b, pb_left, pb_w = "term", term_left, term_w
            bar_role, bar_top, bar_h = "editor", ed_top, ed_h

        if bar_role:
            if pa_left <= pb_left:
                left_role, left_w = pair_a, pa_w
                right_role, right_w = pair_b, pb_w
            else:
                left_role, left_w = pair_b, pb_w
                right_role, right_w = pair_a, pa_w
            bar_before = "1" if bar_top < pa_top else "0"
            updates.extend([
                ("@ide_bar_role", "IDE_BAR_ROLE", bar_role),
                ("@ide_bar_before", "IDE_BAR_BEFORE", bar_before),
                ("@ide_term_before", "IDE_TERM_BEFORE", bar_before),
            ])
            if bar_h > 0:
                updates.extend([
                    ("@ide_bar_height", "IDE_BAR_HEIGHT", str(bar_h)),
                    ("@ide_term_height", "IDE_TERM_HEIGHT", str(bar_h)),
                ])
            updates.extend([
                ("@ide_left_role", "IDE_LEFT_ROLE", left_role),
                ("@ide_right_role", "IDE_RIGHT_ROLE", right_role),
            ])
            if left_w > 0:
                updates.append(("@ide_left_width", "IDE_LEFT_WIDTH", str(left_w)))
            if right_w > 0:
                updates.append(("@ide_right_width", "IDE_RIGHT_WIDTH", str(right_w)))

            if bar_role == "term":
                if ed_w > 0:
                    updates.append(("@ide_editor_width", "IDE_EDITOR_WIDTH", str(ed_w)))
                if ai_w > 0:
                    updates.append(("@ide_ai_width", "IDE_AI_WIDTH", str(ai_w)))
            elif left_role == "editor" or right_role == "editor":
                if ed_w > 0:
                    updates.append(("@ide_editor_width", "IDE_EDITOR_WIDTH", str(ed_w)))
            elif left_role == "ai" or right_role == "ai":
                if ai_w > 0:
                    updates.append(("@ide_ai_width", "IDE_AI_WIDTH", str(ai_w)))

            updates.append(("@ide_editor_before", "IDE_EDITOR_BEFORE", "1" if left_role == "editor" else "0"))
            swapped = "0" if (bar_role == "term" and bar_before == "0" and left_role == "ai") else "1"
            updates.append(("@ide_swapped", "IDE_SWAPPED", swapped))
            set_ide_vars(sess, updates)
            return

    r1 = r2 = r3 = ""
    l1 = t1 = w1 = h1 = l2 = t2 = w2 = h2 = 0
    if ai_in and ed_in and not term_in:
        r1, l1, t1, w1, h1 = "ai", ai_left, ai_top, ai_w, ai_h
        r2, l2, t2, w2, h2 = "editor", ed_left, ed_top, ed_w, ed_h
        r3 = "term"
    elif ai_in and term_in and not ed_in:
        r1, l1, t1, w1, h1 = "ai", ai_left, ai_top, ai_w, ai_h
        r2, l2, t2, w2, h2 = "term", term_left, term_top, term_w, term_h
        r3 = "editor"
    elif ed_in and term_in and not ai_in:
        r1, l1, t1, w1, h1 = "editor", ed_left, ed_top, ed_w, ed_h
        r2, l2, t2, w2, h2 = "term", term_left, term_top, term_w, term_h
        r3 = "ai"

    if r1 and r2:
        if t1 == t2:
            if l1 <= l2:
                left_role, left_w = r1, w1
                right_role, right_w = r2, w2
            else:
                left_role, left_w = r2, w2
                right_role, right_w = r1, w1
            updates.extend([
                ("@ide_bar_role", "IDE_BAR_ROLE", r3),
                ("@ide_left_role", "IDE_LEFT_ROLE", left_role),
                ("@ide_right_role", "IDE_RIGHT_ROLE", right_role),
            ])
            if left_w > 0:
                updates.append(("@ide_left_width", "IDE_LEFT_WIDTH", str(left_w)))
            if right_w > 0:
                updates.append(("@ide_right_width", "IDE_RIGHT_WIDTH", str(right_w)))
            if r3 == "term":
                if ed_w > 0:
                    updates.append(("@ide_editor_width", "IDE_EDITOR_WIDTH", str(ed_w)))
                if ai_w > 0:
                    updates.append(("@ide_ai_width", "IDE_AI_WIDTH", str(ai_w)))
            if left_role == "editor":
                updates.extend([
                    ("@ide_editor_before", "IDE_EDITOR_BEFORE", "1"),
                    ("@ide_swapped", "IDE_SWAPPED", "1"),
                ])
            else:
                updates.append(("@ide_editor_before", "IDE_EDITOR_BEFORE", "0"))
                if r3 == "term":
                    updates.append(("@ide_swapped", "IDE_SWAPPED", "0"))
        else:
            bar_role, _, _, _ = resolve_layout_roles(sess)
            bar_h = 0
            bar_before = "0"
            if r1 == bar_role:
                bar_h = h1
                if t1 < t2:
                    bar_before = "1"
            elif r2 == bar_role:
                bar_h = h2
                if t2 < t1:
                    bar_before = "1"
            else:
                updates.append(("@ide_bar_role", "IDE_BAR_ROLE", r2))
                bar_h = h2
                if t2 < t1:
                    bar_before = "1"
            updates.extend([
                ("@ide_bar_before", "IDE_BAR_BEFORE", bar_before),
                ("@ide_term_before", "IDE_TERM_BEFORE", bar_before),
            ])
            if bar_h > 0:
                updates.extend([
                    ("@ide_bar_height", "IDE_BAR_HEIGHT", str(bar_h)),
                    ("@ide_term_height", "IDE_TERM_HEIGHT", str(bar_h)),
                ])
        set_ide_vars(sess, updates)


def _nvim_rpc_env() -> dict[str, str]:
    env = os.environ.copy()
    if not env.get("NVIM_LOG_FILE"):
        env["NVIM_LOG_FILE"] = "/dev/null"
    return env


def nvim_remote_expr(sock: str, expr: str) -> str:
    nvim_bin = resolve_nvim_bin()
    if not sock or not is_socket_path(sock) or not nvim_bin:
        return ""
    try:
        res = subprocess.run(
            [nvim_bin, "--headless", "--server", sock, "--remote-expr", expr],
            env=_nvim_rpc_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
        return (res.stdout or "").strip()
    except subprocess.TimeoutExpired:
        return ""


def nvim_remote_send(sock: str, keys: str) -> bool:
    nvim_bin = resolve_nvim_bin()
    if not sock or not is_socket_path(sock) or not nvim_bin:
        return False
    try:
        res = subprocess.run(
            [nvim_bin, "--headless", "--server", sock, "--remote-send", keys],
            env=_nvim_rpc_env(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
        return res.returncode == 0
    except subprocess.TimeoutExpired:
        return False


def _nvim_recover_cwd_ex(fallback_dir: str = "") -> str:
    fb_esc = (
        fallback_dir.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("'", "''")
    )
    return (
        '"if exists(\\"*luaeval\\") | silent! call luaeval(\'(function() '
        "local u=vim.uv or vim.loop; if not u then return end; "
        "local function rec() "
        f'for _,c in ipairs({{vim.env.PWD or \\"\\",vim.env.IDE_WORKDIR or \\"\\",vim.env.IDE_INITIAL_ROOT or \\"\\",\\"{fb_esc}\\",vim.env.HOME or \\"\\"}}) do '
        'if c and c~=\\"\\" and vim.fn.isdirectory(c)==1 then '
        'local d,s=u.fs_stat(\\".\\"),u.fs_stat(c); '
        "if not u.cwd() or not d or d.nlink==0 or (vim.fn.haslocaldir()==0 and vim.fn.haslocaldir(-1,0)==0 and s and (d.dev~=s.dev or d.ino~=s.ino)) then "
        "pcall(vim.fn.chdir,c); vim.env.PWD=c end; return c end end; return nil end; "
        "rec(); "
        'if vim.fs and type(vim.fs.abspath)==\\"function\\" and not vim.fs._hs_abspath_wrapped then '
        "local orig=vim.fs.abspath; vim.fs._hs_abspath_wrapped=true; "
        "vim.fs.abspath=function(p) "
        "if not u.cwd() then rec() end; "
        "local ok,r=pcall(orig,p); if ok then return r end; "
        'local fb=rec() or vim.env.HOME or \\"/\\"; '
        'if type(p)==\\"string\\" then '
        'if p:sub(1,1)==\\"~\\" then p=vim.fs.normalize(p) end; '
        'if p:sub(1,1)==\\"/\\" then return vim.fs.normalize(p) end; '
        'return vim.fs.normalize(fb:gsub(\\"/+$\\",\\"\\")..\\"/\\"..p) end; '
        "return orig(p) end end end)()') | endif\""
    )


def nvim_recover_and_checktime(sock: str, fallback_dir: str = "", extra_ex: str = "") -> None:
    steps = [_nvim_recover_cwd_ex(fallback_dir), '"silent! checktime"']
    if extra_ex:
        steps.append(f'"{extra_ex}"')
    nvim_remote_expr(sock, f"execute([{', '.join(steps)}])")


def nvim_remote_file(sock: str, filepath: str, line: str = "", fallback_dir: str = "") -> None:
    escaped = filepath.replace("'", "''")
    fb_dir = fallback_dir
    if not fb_dir and filepath.startswith("/"):
        cand_dir = os.path.dirname(filepath)
        if os.path.isdir(cand_dir):
            fb_dir = cand_dir
    line_num = int(line) if line.isdigit() and int(line) > 0 else 0
    line_step = (
        f", 'keepjumps silent! call cursor({line_num}, 1) | silent! normal! zz'"
        if line_num > 0
        else ""
    )
    nvim_remote_expr(
        sock,
        'execute(['
        f"{_nvim_recover_cwd_ex(fb_dir)}, "
        '"if exists(\\"*luaeval\\") | silent! call luaeval(\'package.loaded[\\"mini.files\\"] and require(\\"mini.files\\").close()\') | endif", '
        '"if &filetype ==# \'netrw\' && winnr(\'\\$\') > 1 | wincmd p | endif", '
        '"stopinsert", '
        '"silent! normal! m\'", '
        f"'if fnamemodify(bufname(\"%\"), \":p\") !=# fnamemodify(' . string('{escaped}') . ', \":p\") | keepjumps silent! edit ' . fnameescape('{escaped}') . ' | endif'"
        f"{line_step}])",
    )


def unpark_role_pane(
    sess: str,
    role: str,
    main_win: str,
    ai_pane: str,
    editor_pane: str,
    term_pane: str,
    sock: str = "",
) -> None:
    target_pane = pane_for_role(role, ai_pane, editor_pane, term_pane)
    if not pane_is_parked(target_pane, main_win):
        return

    win_info = tmux_out(
        "display-message", "-p", "-t", main_win, "#{window_zoomed_flag}\t#{window_width}\t#{window_height}"
    )
    parts = win_info.split("\t")
    if parts and parts[0] == "1":
        run_tmux("resize-pane", "-Z", "-t", main_win)
    try:
        win_w = int(parts[1]) if len(parts) > 1 else 160
        win_h = int(parts[2]) if len(parts) > 2 else 48
    except ValueError:
        win_w, win_h = 160, 48
    if win_w < 20:
        win_w = 160
    if win_h < 10:
        win_h = 48

    bar_role, bar_before, left_role, right_role = resolve_layout_roles(sess)
    first_pane = (tmux_out("list-panes", "-t", main_win, "-F", "#{pane_id}").splitlines() or [""])[0]

    if role == bar_role:
        saved_h = get_ide_var(sess, "@ide_bar_height", "IDE_BAR_HEIGHT") or get_ide_var(
            sess, "@ide_term_height", "IDE_TERM_HEIGHT"
        )
        bar_h = clamp_dim(saved_h, win_h, win_h // 4)
        if bar_before == "1":
            run_tmux("join-pane", "-d", "-f", "-b", "-v", "-l", str(bar_h), "-s", target_pane, "-t", first_pane)
        else:
            run_tmux("join-pane", "-d", "-f", "-v", "-l", str(bar_h), "-s", target_pane, "-t", first_pane)
    else:
        if role == left_role:
            sibling_role, join_before = right_role, True
        else:
            sibling_role, join_before = left_role, False
        sibling_pane = pane_for_role(sibling_role, ai_pane, editor_pane, term_pane)
        if pane_in_win(sibling_pane, main_win):
            if join_before:
                saved_w = get_ide_var(sess, "@ide_left_width", "IDE_LEFT_WIDTH")
            else:
                saved_w = get_ide_var(sess, "@ide_right_width", "IDE_RIGHT_WIDTH")
            if not saved_w:
                if role == "editor":
                    saved_w = get_ide_var(sess, "@ide_editor_width", "IDE_EDITOR_WIDTH")
                elif role == "ai":
                    saved_w = get_ide_var(sess, "@ide_ai_width", "IDE_AI_WIDTH")
            target_w = clamp_dim(saved_w, win_w, win_w // 2)
            if join_before:
                run_tmux("join-pane", "-d", "-b", "-h", "-l", str(target_w), "-s", target_pane, "-t", sibling_pane)
            else:
                run_tmux("join-pane", "-d", "-h", "-l", str(target_w), "-s", target_pane, "-t", sibling_pane)
        else:
            saved_bh = get_ide_var(sess, "@ide_bar_height", "IDE_BAR_HEIGHT") or get_ide_var(
                sess, "@ide_term_height", "IDE_TERM_HEIGHT"
            )
            bar_h = clamp_dim(saved_bh, win_h, win_h // 4)
            pair_h = clamp_dim(str(win_h - bar_h), win_h, (win_h * 3) // 4)
            if bar_before == "1":
                run_tmux("join-pane", "-d", "-f", "-v", "-l", str(pair_h), "-s", target_pane, "-t", first_pane)
            else:
                run_tmux("join-pane", "-d", "-f", "-b", "-v", "-l", str(pair_h), "-s", target_pane, "-t", first_pane)

    park_opt, park_env = {
        "ai": ("@ide_ai_parked", "IDE_AI_PARKED"),
        "editor": ("@ide_ed_parked", "IDE_ED_PARKED"),
        "term": ("@ide_term_parked", "IDE_TERM_PARKED"),
    }.get(role, ("", ""))
    if park_opt:
        set_ide_var(sess, park_opt, park_env, "0")

    if role == "editor":
        nvim_recover_and_checktime(sock, get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR") or get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT"), "silent! normal! zz")


def heal_split_for_role(
    sess: str,
    role: str,
    main_win: str,
    ai_pane: str,
    editor_pane: str,
    term_pane: str,
    cur_dir: str,
    extra_args: list[str],
) -> str:
    if "FORCE_HYPERLINK=1" not in extra_args:
        extra_args = [*extra_args, "-e", "FORCE_HYPERLINK=1"]
    bar_role, bar_before, left_role, right_role = resolve_layout_roles(sess)
    if role == bar_role:
        flags = ["-b", "-f", "-v"] if bar_before == "1" else ["-f", "-v"]
        return tmux_out(
            "split-window", *flags, "-P", "-F", "#{pane_id}", "-t", main_win, "-l", "25%", "-c", cur_dir, *extra_args
        )
    if role == left_role:
        sibling_role, join_before = right_role, True
    else:
        sibling_role, join_before = left_role, False
    sibling_pane = pane_for_role(sibling_role, ai_pane, editor_pane, term_pane)
    if pane_in_win(sibling_pane, main_win):
        flags = ["-b", "-h"] if join_before else ["-h"]
        return tmux_out(
            "split-window", *flags, "-P", "-F", "#{pane_id}", "-t", sibling_pane, "-l", "50%", "-c", cur_dir, *extra_args
        )
    flags = ["-f", "-v"] if bar_before == "1" else ["-b", "-f", "-v"]
    return tmux_out(
        "split-window", *flags, "-P", "-F", "#{pane_id}", "-t", main_win, "-l", "75%", "-c", cur_dir, *extra_args
    )


def park_role_pane(
    sess: str,
    role: str,
    main_win: str,
    ai_pane: str,
    editor_pane: str,
    term_pane: str,
    sock: str = "",
) -> None:
    target_pane = pane_for_role(role, ai_pane, editor_pane, term_pane)
    if not pane_in_win(target_pane, main_win):
        return

    vis_panes = tmux_out("list-panes", "-t", main_win, "-F", "#{pane_id}").splitlines()
    if len(vis_panes) <= 1:
        run_tmux("display-message", "-d", "2500", "-t", f"={sess}:", "Cannot hide the last visible IDE pane")
        return

    if tmux_out("display-message", "-p", "-t", main_win, "#{window_zoomed_flag}") == "1":
        run_tmux("resize-pane", "-Z", "-t", main_win)

    record_main_geometry(sess, main_win, ai_pane, editor_pane, term_pane)

    active_pane = tmux_out("display-message", "-p", "-t", main_win, "#{pane_id}")
    last_pane = tmux_out("show-options", "-wqv", "-t", main_win, "@ide_last_pane")
    fallback_pane = ""
    if active_pane == target_pane:
        if last_pane and last_pane != target_pane and pane_in_win(last_pane, main_win):
            fallback_pane = last_pane
        else:
            candidates = {
                "term": (editor_pane, ai_pane),
                "editor": (ai_pane, term_pane),
                "ai": (editor_pane, term_pane),
            }.get(role, ())
            for cand in candidates:
                if pane_in_win(cand, main_win):
                    fallback_pane = cand
                    break

    run_tmux("break-pane", "-d", "-s", target_pane, "-n", f"_ide_park_{role}")
    park_opt, park_env = {
        "ai": ("@ide_ai_parked", "IDE_AI_PARKED"),
        "editor": ("@ide_ed_parked", "IDE_ED_PARKED"),
        "term": ("@ide_term_parked", "IDE_TERM_PARKED"),
    }.get(role, ("", ""))
    if park_opt:
        set_ide_var(sess, park_opt, park_env, "1")
    park_win = tmux_out("display-message", "-p", "-t", target_pane, "#{window_id}")
    if park_win and park_win != main_win:
        run_tmux(
            "set-option", "-w", "-t", park_win, "automatic-rename", "off",
            ";",
            "set-option", "-w", "-t", park_win, "allow-rename", "off",
        )
    if fallback_pane and pane_in_win(fallback_pane, main_win):
        run_tmux("select-window", "-t", main_win, ";", "select-pane", "-t", fallback_pane)
        if fallback_pane == editor_pane:
            nvim_recover_and_checktime(sock, get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR") or get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT"))


def swap_ide_pane(raw_dir: str, target_arg: str) -> int:
    dir_map = {
        "left": "-L", "l": "-L", "-l": "-L",
        "down": "-D", "d": "-D", "-d": "-D",
        "up": "-U", "u": "-U", "-u": "-U",
        "right": "-R", "r": "-R", "-r": "-R",
    }
    dir_flag = dir_map.get(raw_dir.lower())
    if not dir_flag:
        print(f"Error: Invalid swap direction '{raw_dir}'. Expected: left, down, up, or right.", file=sys.stderr)
        return 1

    sess = resolve_target_session(target_arg)
    if not session_exists(sess):
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    editor_pane = resolve_role_pane(sess, "editor", "@ide_editor_pane", "NVIM_IDE_PANE")
    ai_pane = resolve_role_pane(sess, "ai", "@ide_ai_pane", "IDE_AI_PANE")
    term_pane = resolve_role_pane(sess, "term", "@ide_term_pane", "IDE_TERM_PANE")
    main_win = resolve_main_win(sess, editor_pane, ai_pane, term_pane)
    if not main_win:
        return 1

    if tmux_out("display-message", "-p", "-t", main_win, "#{window_zoomed_flag}") == "1":
        run_tmux("resize-pane", "-Z", "-t", main_win)

    src_pane = tmux_out("display-message", "-p", "-t", main_win, "#{pane_id}")
    if not src_pane:
        return 0

    run_tmux("select-pane", "-t", src_pane, dir_flag)
    dst_pane = tmux_out("display-message", "-p", "-t", main_win, "#{pane_id}")

    if dst_pane and dst_pane != src_pane:
        run_tmux("swap-pane", "-s", src_pane, "-t", dst_pane, ";", "select-pane", "-t", src_pane)
        record_main_geometry(sess, main_win, ai_pane, editor_pane, term_pane)
    return 0


def send_editor_launch_keys(pane_id: str, sock: str, initial_file: str = "") -> None:
    nvim_bin = resolve_nvim_bin()
    if nvim_bin:
        run_tmux("set-option", "-p", "-t", pane_id, "@ide_nvim_launch_ts", str(int(time.time())))
        path_nvim = shutil.which("nvim")
        use_bare = os.path.basename(nvim_bin) == "nvim" and "/mise/" not in nvim_bin and nvim_bin == path_nvim
        cmd_name = "nvim" if use_bare else shlex.quote(nvim_bin)
        if initial_file:
            run_tmux("send-keys", "-t", pane_id, f" {cmd_name} --listen '{sock}' {shlex.quote(initial_file)}", "C-m")
        else:
            run_tmux("send-keys", "-t", pane_id, f" {cmd_name} --listen '{sock}'", "C-m")
    elif shutil.which("vim"):
        run_tmux("set-option", "-p", "-t", pane_id, "@ide_nvim_launch_ts", str(int(time.time())))
        run_tmux("send-keys", "-t", pane_id, " vim", "C-m")


def ensure_editor_nvim_running(editor_pane: str, sock: str, initial_file: str = "") -> bool:
    if not editor_pane or not sock:
        return False
    if is_socket_path(sock):
        return False
    if not resolve_nvim_bin():
        return False
    info = tmux_out("display-message", "-p", "-t", editor_pane, "#{pane_current_command}\t#{@ide_nvim_launch_ts}")
    parts = (info.split("\t") + ["", ""])[:2]
    cmd, launch_ts = parts[0].strip(), parts[1].strip()
    if not cmd or "nvim" in cmd or cmd in ("vim", "vi"):
        return False
    if launch_ts.isdigit() and (int(time.time()) - int(launch_ts)) < 5:
        return False
    send_editor_launch_keys(editor_pane, sock, initial_file)
    return True


def toggle_main_pane(mode: str, target_arg: str, skip_checktime: bool = False) -> int:
    sess = resolve_target_session(target_arg)
    if not sess:
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    snap = run_tmux(
        "display-message", "-p", "-t", f"={sess}:",
        "OPTS\t#{@ide_editor_pane}\t#{@ide_ai_pane}\t#{@ide_term_pane}\t#{@ide_main_win}\t#{@ide_layout_mode}\t#{@ide_socket}\t#{@ide_ai_cli}\t#{@ide_initial_root}",
        ";",
        "list-panes", "-s", "-t", f"={sess}:", "-F",
        "PANE\t#{pane_id}\t#{window_id}\t#{window_name}\t#{@ide_role}\t#{pane_left}\t#{pane_top}\t#{pane_current_path}",
    )
    if snap.returncode != 0 or not snap.stdout:
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    editor_pane = ai_pane = term_pane = main_win = layout_mode = sock = ai_cli = init_root = ""
    panes_by_id: dict[str, tuple[str, str, str, int, int, str]] = {}
    for line in snap.stdout.splitlines():
        if line.startswith("OPTS\t"):
            op = (line.split("\t")[1:] + [""] * 8)[:8]
            editor_pane, ai_pane, term_pane, main_win, layout_mode, sock, ai_cli, init_root = op
        elif line.startswith("PANE\t"):
            pp = line.split("\t")
            if len(pp) >= 8:
                try:
                    panes_by_id[pp[1]] = (pp[2], pp[3], pp[4], int(pp[5]), int(pp[6]), pp[7])
                except ValueError:
                    pass

    def resolve_cached_role(cur_p: str, role: str, opt_name: str, env_name: str) -> str:
        if cur_p and cur_p in panes_by_id:
            return cur_p
        fallback_p = get_ide_var(sess, opt_name, env_name)
        if fallback_p and fallback_p in panes_by_id:
            return fallback_p
        for pid, (_, _, prole, _, _, _) in panes_by_id.items():
            if prole == role:
                set_ide_var(sess, opt_name, env_name, pid)
                return pid
        return ""

    editor_pane = resolve_cached_role(editor_pane, "editor", "@ide_editor_pane", "NVIM_IDE_PANE")
    ai_pane = resolve_cached_role(ai_pane, "ai", "@ide_ai_pane", "IDE_AI_PANE")
    term_pane = resolve_cached_role(term_pane, "term", "@ide_term_pane", "IDE_TERM_PANE")

    if not main_win or not any(wid == main_win and not wname.startswith("_ide_park_") for wid, wname, _, _, _, _ in panes_by_id.values()):
        main_win = resolve_main_win(sess, editor_pane, ai_pane, term_pane)

    if not sock:
        sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
    if not sock:
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
        sock = f"{runtime_dir}/nvim-ide-{sess}.sock"
    if not ai_cli:
        ai_cli = os.environ.get("IDE_AI_CLI") or "agy"

    if not ai_pane or not editor_pane or not term_pane:
        rows = [
            (left, top, pid, prole)
            for pid, (wid, _, prole, left, top, _) in panes_by_id.items()
            if wid == main_win
        ]
        rows.sort(key=lambda r: (r[0], r[1]))
        if not ai_pane:
            for l, t, pid, prole in rows:
                if l == 0 and t == 0 and prole in ("", "ai"):
                    ai_pane = pid
                    run_tmux("set-option", "-p", "-t", ai_pane, "@ide_role", "ai")
                    set_ide_var(sess, "@ide_ai_pane", "IDE_AI_PANE", ai_pane)
                    break
        if not editor_pane:
            for l, t, pid, prole in rows:
                if l > 0 and prole in ("", "editor"):
                    editor_pane = pid
                    run_tmux("set-option", "-p", "-t", editor_pane, "@ide_role", "editor")
                    set_ide_var(sess, "@ide_editor_pane", "NVIM_IDE_PANE", editor_pane)
                    break
        if not term_pane:
            for l, t, pid, prole in rows:
                if l == 0 and t > 0 and prole in ("", "term"):
                    term_pane = pid
                    run_tmux("set-option", "-p", "-t", term_pane, "@ide_role", "term")
                    set_ide_var(sess, "@ide_term_pane", "IDE_TERM_PANE", term_pane)
                    break

    raw_cur_dir = (
        (panes_by_id[editor_pane][5] if editor_pane in panes_by_id else "")
        or (panes_by_id[ai_pane][5] if ai_pane in panes_by_id else "")
    )
    cur_dir = normalize_pane_cwd(raw_cur_dir, sess=sess)
    if not init_root:
        init_root = cur_dir

    need_term = (layout_mode or "3pane") != "2pane" or mode in ("term", "focus-term", "toggle-term")
    ed_just_healed = False
    ai_just_healed = False
    term_just_healed = False

    if not editor_pane or not ai_pane or (not term_pane and need_term):
        was_zoomed_before_heal = tmux_out("display-message", "-p", "-t", main_win, "#{window_zoomed_flag}") or "0"
        if was_zoomed_before_heal == "1":
            run_tmux("resize-pane", "-Z", "-t", main_win)

        if not editor_pane:
            editor_pane = heal_split_for_role(
                sess, "editor", main_win, ai_pane, editor_pane, term_pane, cur_dir,
                ["-e", f"IDE_SESSION={sess}", "-e", f"IDE_AI_CLI={ai_cli}", "-e", f"NVIM_IDE_SOCKET={sock}", "-e", f"IDE_INITIAL_ROOT={init_root}", "-e", "FORCE_HYPERLINK=1"],
            )
            if editor_pane:
                ed_just_healed = True
                run_tmux("set-option", "-p", "-t", editor_pane, "@ide_role", "editor")
                set_ide_vars(sess, [
                    ("@ide_editor_pane", "NVIM_IDE_PANE", editor_pane),
                    ("@ide_ed_parked", "IDE_ED_PARKED", "0"),
                ])
                send_editor_launch_keys(editor_pane, sock)

        if not ai_pane:
            ai_pane = heal_split_for_role(
                sess, "ai", main_win, ai_pane, editor_pane, term_pane, cur_dir,
                ["-e", f"IDE_SESSION={sess}", "-e", f"IDE_AI_CLI={ai_cli}", "-e", f"NVIM_IDE_SOCKET={sock}", "-e", f"NVIM_IDE_PANE={editor_pane}", "-e", f"IDE_INITIAL_ROOT={init_root}", "-e", "FORCE_HYPERLINK=1"],
            )
            if ai_pane:
                ai_just_healed = True
                run_tmux("set-option", "-p", "-t", ai_pane, "@ide_role", "ai")
                set_ide_vars(sess, [
                    ("@ide_ai_pane", "IDE_AI_PANE", ai_pane),
                    ("@ide_ai_parked", "IDE_AI_PARKED", "0"),
                    ("@ide_ai_state_ts", "IDE_AI_STATE_TS", str(int(time.time()))),
                ])
                ai_run_cmd = resolve_ai_cmd(ai_cli)
                if ai_run_cmd:
                    run_tmux("send-keys", "-t", ai_pane, f" {ai_run_cmd}", "C-m")

        if not term_pane and need_term:
            term_pane = heal_split_for_role(
                sess, "term", main_win, ai_pane, editor_pane, term_pane, cur_dir,
                ["-e", f"IDE_SESSION={sess}", "-e", f"IDE_AI_CLI={ai_cli}", "-e", f"NVIM_IDE_SOCKET={sock}", "-e", f"NVIM_IDE_PANE={editor_pane}", "-e", f"IDE_INITIAL_ROOT={init_root}", "-e", "FORCE_HYPERLINK=1"],
            )
            if term_pane:
                term_just_healed = True
                run_tmux("set-option", "-p", "-t", term_pane, "@ide_role", "term")
                set_ide_vars(sess, [
                    ("@ide_term_pane", "IDE_TERM_PANE", term_pane),
                    ("@ide_term_parked", "IDE_TERM_PARKED", "0"),
                ])

        if was_zoomed_before_heal == "1" and tmux_out("display-message", "-p", "-t", main_win, "#{window_zoomed_flag}") == "0":
            run_tmux("resize-pane", "-Z", "-t", main_win)

    win_state = tmux_out("display-message", "-p", "-t", main_win, "#{pane_id}\t#{@ide_role}\t#{@ide_last_pane}")
    wparts = (win_state.split("\t") + ["", "", ""])[:3]
    active_pane, active_role, last_pane = wparts[0], wparts[1], wparts[2]

    if mode in ("toggle", "ai"):
        if active_pane == ai_pane or active_role == "ai":
            if pane_is_parked(editor_pane, main_win) and not pane_in_win(term_pane, main_win):
                unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
            if pane_in_win(editor_pane, main_win):
                if not ensure_editor_nvim_running(editor_pane, sock) and not skip_checktime:
                    nvim_recover_and_checktime(sock, cur_dir)
                focus_pane_preserving_zoom(main_win, editor_pane)
            elif pane_in_win(term_pane, main_win):
                focus_pane_preserving_zoom(main_win, term_pane)
            else:
                unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
                ensure_editor_nvim_running(editor_pane, sock)
                focus_pane_preserving_zoom(main_win, editor_pane)
        else:
            unpark_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, sock)
            focus_pane_preserving_zoom(main_win, ai_pane)
    elif mode == "focus-ai":
        unpark_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, sock)
        focus_pane_preserving_zoom(main_win, ai_pane)
    elif mode == "editor":
        if active_pane == editor_pane or active_role == "editor":
            if ed_just_healed or ensure_editor_nvim_running(editor_pane, sock):
                focus_pane_preserving_zoom(main_win, editor_pane)
            elif last_pane and last_pane != editor_pane and pane_in_win(last_pane, main_win):
                focus_pane_preserving_zoom(main_win, last_pane)
            elif pane_in_win(ai_pane, main_win):
                focus_pane_preserving_zoom(main_win, ai_pane)
            elif pane_in_win(term_pane, main_win):
                focus_pane_preserving_zoom(main_win, term_pane)
            else:
                unpark_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, sock)
                focus_pane_preserving_zoom(main_win, ai_pane)
        else:
            unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
            if not ensure_editor_nvim_running(editor_pane, sock) and not skip_checktime:
                nvim_recover_and_checktime(sock, cur_dir)
            focus_pane_preserving_zoom(main_win, editor_pane)
    elif mode == "focus-editor":
        unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, "" if skip_checktime else sock)
        if not ensure_editor_nvim_running(editor_pane, sock) and not skip_checktime:
            nvim_recover_and_checktime(sock, cur_dir)
        focus_pane_preserving_zoom(main_win, editor_pane)
    elif mode == "term":
        if active_pane == term_pane or active_role == "term":
            if last_pane and last_pane != term_pane and pane_in_win(last_pane, main_win):
                if last_pane == editor_pane:
                    if not ensure_editor_nvim_running(editor_pane, sock) and not skip_checktime:
                        nvim_recover_and_checktime(sock, cur_dir)
                focus_pane_preserving_zoom(main_win, last_pane)
            elif pane_in_win(editor_pane, main_win):
                if not ensure_editor_nvim_running(editor_pane, sock) and not skip_checktime:
                    nvim_recover_and_checktime(sock, cur_dir)
                focus_pane_preserving_zoom(main_win, editor_pane)
            elif pane_in_win(ai_pane, main_win):
                focus_pane_preserving_zoom(main_win, ai_pane)
            else:
                unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
                ensure_editor_nvim_running(editor_pane, sock)
                focus_pane_preserving_zoom(main_win, editor_pane)
        else:
            unpark_role_pane(sess, "term", main_win, ai_pane, editor_pane, term_pane, sock)
            focus_pane_preserving_zoom(main_win, term_pane)
    elif mode == "focus-term":
        unpark_role_pane(sess, "term", main_win, ai_pane, editor_pane, term_pane, sock)
        focus_pane_preserving_zoom(main_win, term_pane)
    elif mode == "toggle-editor":
        if ed_just_healed or pane_is_parked(editor_pane, main_win):
            unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
            ensure_editor_nvim_running(editor_pane, sock)
            focus_pane_preserving_zoom(main_win, editor_pane)
        else:
            park_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, sock)
    elif mode == "toggle-ai":
        if ai_just_healed or pane_is_parked(ai_pane, main_win):
            unpark_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, sock)
            focus_pane_preserving_zoom(main_win, ai_pane)
        else:
            park_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, sock)
    elif mode == "toggle-term":
        if term_just_healed or pane_is_parked(term_pane, main_win):
            unpark_role_pane(sess, "term", main_win, ai_pane, editor_pane, term_pane, sock)
            focus_pane_preserving_zoom(main_win, term_pane)
        else:
            park_role_pane(sess, "term", main_win, ai_pane, editor_pane, term_pane, sock)

    ack_ai_session(sess, from_hook=True, refresh_always=False)
    return 0


def open_in_editor(filepath: str, focus: bool, target_arg: str, line: str = "") -> int:
    cwd = normalize_pane_cwd(safe_getcwd(), target_arg=target_arg)
    if filepath.startswith("~/"):
        filepath = os.path.expanduser(filepath)
    exact_ws = "" if filepath.startswith("//") else resolve_workspace_file(filepath, cwd, target_arg)
    if filepath.startswith("//") or not exact_ws:
        private_url = resolve_private_link(filepath, cwd, target_arg)
        if private_url and private_url.startswith("file://"):
            p_path, p_line = parse_file_target(private_url, cwd)
            if p_path:
                filepath = p_path
                if not line and p_line:
                    line = p_line
        elif filepath.startswith("file://") or not os.path.exists(filepath):
            p_path, p_line = parse_file_target(filepath, cwd)
            if p_path:
                filepath = p_path
                if not line and p_line:
                    line = p_line
    if not filepath.startswith("/"):
        ws_resolved = resolve_workspace_file(filepath, cwd, target_arg)
        if ws_resolved:
            d = os.path.dirname(ws_resolved) or "."
            b = os.path.basename(ws_resolved)
            filepath = os.path.join(os.path.realpath(d), b) if os.path.isdir(d) else ws_resolved
        else:
            d = os.path.dirname(filepath) or "."
            b = os.path.basename(filepath)
            if os.path.isdir(d):
                filepath = os.path.join(os.path.realpath(d), b)
            else:
                rel = filepath[2:] if filepath.startswith("./") else filepath
                filepath = os.path.join(cwd, rel)

    sess = resolve_target_session(target_arg)
    if not session_exists(sess):
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    prev_pane = "" if focus else tmux_out("display-message", "-p", "-t", f"={sess}:", "#{pane_id}")
    sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
    if focus:
        toggle_main_pane("focus-editor", target_arg, skip_checktime=True)
    else:
        editor_pane = resolve_role_pane(sess, "editor", "@ide_editor_pane", "NVIM_IDE_PANE")
        ai_pane = resolve_role_pane(sess, "ai", "@ide_ai_pane", "IDE_AI_PANE")
        term_pane = resolve_role_pane(sess, "term", "@ide_term_pane", "IDE_TERM_PANE")
        main_win = resolve_main_win(sess, editor_pane, ai_pane, term_pane)
        if pane_is_parked(editor_pane, main_win):
            unpark_role_pane(sess, "editor", main_win, ai_pane, editor_pane, term_pane, "")
            ensure_editor_nvim_running(editor_pane, sock)
        elif not pane_exists(editor_pane):
            toggle_main_pane("focus-editor", target_arg, skip_checktime=True)
        else:
            ensure_editor_nvim_running(editor_pane, sock)

    if not sock:
        sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
    if sock and is_socket_path(sock) and resolve_nvim_bin():
        ws_dir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR") or get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT") or cwd
        nvim_remote_file(sock, filepath, line, fallback_dir=ws_dir)
    if not focus and pane_exists(prev_pane):
        run_tmux("select-pane", "-t", prev_pane)
    return 0


def run_ai_popup(target_arg: str) -> None:
    sess = resolve_target_session(target_arg)
    run_tmux("set-option", "-t", f"=ai-{sess}:", "status", "off")
    ai_cli = get_ide_var(sess, "@ide_ai_cli", "IDE_AI_CLI") or os.environ.get("IDE_AI_CLI") or "agy"
    ai_cmd = resolve_ai_cmd(ai_cli)
    if ai_cmd:
        subprocess.run(ai_cmd, shell=True, check=False)
    shell = os.environ.get("SHELL") or "/bin/zsh"
    os.execvp(shell, [shell, "-l"])


def quit_ide(target_args: list[str] | str, force_quit: bool, is_kill: bool) -> int:
    if isinstance(target_args, str):
        raw_targets = [target_args] if target_args else [""]
    else:
        raw_targets = list(target_args) if target_args else [""]

    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    except (OSError, ValueError):
        pass

    cur_sess = current_ide_session()
    resolved_targets: list[tuple[str, str]] = []
    seen_sess: set[str] = set()
    for raw in raw_targets:
        sess = resolve_target_session(raw)
        dedup_key = sess or f"__empty_{raw}"
        if dedup_key in seen_sess:
            continue
        seen_sess.add(dedup_key)
        resolved_targets.append((raw, sess))

    rc = 0
    to_kill: list[tuple[str, str]] = []
    for raw, sess in resolved_targets:
        if not sess or not session_exists(sess):
            print(missing_session_msg(sess))
            continue

        sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
        if not force_quit and sock and is_socket_path(sock) and resolve_nvim_bin():
            mod_expr = (
                'len(filter(getbufinfo({"bufmodified": 1}), '
                '"getbufvar(v:val.bufnr, \\"&buftype\\") ==# \\"\\" && '
                '(!empty(v:val.name) || join(getbufline(v:val.bufnr, 1, \\"$\\"), \\"\\") !~# \\"^\\\\\\\\s*$\\")"))'
            )
            raw_mod = re.sub(r"[^0-9]", "", nvim_remote_expr(sock, mod_expr))
            modified = int(raw_mod) if raw_mod else 0
            if modified > 0:
                toggle_main_pane("focus-editor", raw or sess)
                nvim_remote_send(
                    sock,
                    f'<C-\\><C-n>:redraw! | echohl ErrorMsg | echo "Unsaved changes in {modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q (:Q!) to force-quit" | echohl None<CR>',
                )
                run_tmux(
                    "display-message", "-d", "4000", "-t", f"={sess}:",
                    f"Unsaved changes in {modified} buffer(s)! Save (:wqa) or press Alt+Shift+Q to force-quit",
                )
                print(
                    "Aborted quit: unsaved changes in Neovim buffer(s). Save first or use 'ide quit --force' (Alt+Shift+Q).",
                    file=sys.stderr,
                )
                rc = 1
                continue

        to_kill.append((sess, sock))

    if not to_kill:
        return rc

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    for sess, sock in to_kill:
        if sock and is_socket_path(sock) and resolve_nvim_bin():
            if nvim_remote_send(sock, "<C-\\><C-n><Cmd>qall!<CR>"):
                for _ in range(30):
                    if not is_socket_path(sock):
                        break
                    time.sleep(0.1)

        for p in (
            sock,
            f"{runtime_dir}/nvim-{sess}.sock",
            f"{runtime_dir}/nvim-ide-{sess}.sock",
        ):
            if p:
                try:
                    os.unlink(p)
                except OSError:
                    pass

    killing_set = {sess for sess, _ in to_kill}
    if os.environ.get("IDE_IN_POPUP") == "1":
        other_ide = [
            e for e in classify_ide_fleet(include_git=False, cur_sess="")
            if str(e["sess"]) not in killing_set
        ]
        if other_ide:
            next_sess = str(other_ide[0]["sess"])
            for sess, _ in to_kill:
                for cl in tmux_out("list-clients", "-t", f"={sess}", "-F", "#{client_name}").splitlines():
                    cl_s = cl.strip()
                    if cl_s:
                        run_tmux("switch-client", "-c", cl_s, "-t", f"={next_sess}")

    if is_kill:
        for sess, _ in to_kill:
            print(f"Terminated IDE session: {sess}")
        try:
            sys.stdout.flush()
        except OSError:
            pass

    kill_order = [sess for sess, _ in to_kill if sess != cur_sess]
    if cur_sess and cur_sess in killing_set:
        kill_order.append(cur_sess)

    for sess in kill_order:
        for target_sess in (f"=ai-{sess}", f"=agy-{sess}", f"={sess}"):
            run_tmux("kill-session", "-t", target_sess)

    refresh_fleet_topbar()
    return rc


def cd_ide_workspace(raw_target: str, target_arg: str) -> int:
    sess = resolve_target_session(target_arg)
    if not session_exists(sess):
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    init_root = get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
    cur_workdir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR") or init_root or safe_getcwd()

    if raw_target in ("--reset", "~", "-"):
        target_dir = init_root if (init_root and os.path.isdir(init_root)) else cur_workdir
    elif raw_target.startswith("/"):
        target_dir = raw_target
    else:
        cand1 = os.path.join(cur_workdir, raw_target)
        cand2 = os.path.join(init_root, raw_target) if init_root else ""
        if os.path.isdir(cand1):
            target_dir = cand1
        elif cand2 and os.path.isdir(cand2):
            target_dir = cand2
        else:
            target_dir = os.path.join(safe_getcwd(), raw_target)

    if not os.path.isdir(target_dir):
        print(f"Error: Directory '{target_dir}' does not exist.", file=sys.stderr)
        return 1
    target_dir = os.path.realpath(target_dir)
    updates = [("@ide_workdir", "IDE_WORKDIR", target_dir)]
    if not init_root:
        updates.append(("@ide_initial_root", "IDE_INITIAL_ROOT", target_dir))
    set_ide_vars(sess, updates)

    run_tmux("attach-session", "-t", f"={sess}", "-c", target_dir)

    sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
    term_pane = resolve_role_pane(sess, "term", "@ide_term_pane", "IDE_TERM_PANE")
    escaped_dir = target_dir.replace("'", "''")

    if sock and is_socket_path(sock) and resolve_nvim_bin():
        nvim_remote_expr(
            sock,
            f"execute('cd ' . fnameescape('{escaped_dir}'))",
        )

    if os.environ.get("IDE_CD_SKIP_SHELL", "0") != "1" and pane_exists(term_pane):
        info = tmux_out("display-message", "-p", "-t", term_pane, "#{pane_current_command}\t#{pane_current_path}")
        if "\t" in info:
            term_cmd, term_path = info.split("\t", 1)
            if term_cmd.startswith(("zsh", "bash", "sh")) and term_path != target_dir:
                run_tmux("send-keys", "-t", term_pane, "C-u", f" builtin cd -- {shlex.quote(target_dir)}", "C-m")

    run_tmux("display-message", "-d", "2500", "-t", f"={sess}:", f"IDE Working Directory -> {target_dir}")
    return 0


def copy_to_system_clipboard(target_arg: str = "") -> None:
    data = sys.stdin.buffer.read()
    with tempfile.NamedTemporaryFile(prefix="ide-clip.", delete=False) as tf:
        tf.write(data)
        tmp_path = tf.name

    def run_clip_in(cmd: list[str]) -> None:
        try:
            with open(tmp_path, "rb") as f_in:
                subprocess.run(
                    cmd,
                    stdin=f_in,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=2,
                    check=False,
                )
        except (OSError, subprocess.SubprocessError):
            pass

    try:
        if shutil.which("tmux"):
            if run_tmux("load-buffer", "-w", tmp_path).returncode != 0:
                run_tmux("load-buffer", tmp_path)
        if not is_ssh_session(target_arg):
            if os.environ.get("DISPLAY"):
                if shutil.which("xsel"):
                    run_clip_in(["xsel", "-ip"])
                    run_clip_in(["xsel", "-ib"])
                elif shutil.which("xclip"):
                    for sel in ("primary", "clipboard"):
                        try:
                            with open(tmp_path, "rb") as fx:
                                subprocess.Popen(
                                    ["xclip", "-selection", sel, "-i"],
                                    stdin=fx,
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL,
                                    start_new_session=True,
                                )
                        except OSError:
                            pass
            if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
                run_clip_in(["wl-copy", "--primary"])
                run_clip_in(["wl-copy"])
            if shutil.which("pbcopy"):
                run_clip_in(["pbcopy"])
    finally:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass


def paste_from_system_clipboard(target_pane: str) -> None:
    raw_target = target_pane or os.environ.get("TMUX_PANE", "")
    if not target_pane:
        target_pane = raw_target
        if not target_pane:
            sess = current_ide_session()
            if sess:
                target_pane = f"={sess}:"
                raw_target = sess
    data = b""

    def try_cmd(cmd: list[str]) -> bytes:
        try:
            res = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=2,
                check=False,
            )
            return res.stdout if res.returncode == 0 and res.stdout else b""
        except (OSError, subprocess.SubprocessError):
            return b""

    ssh_active = is_ssh_session(raw_target)
    has_display = bool(os.environ.get("DISPLAY"))
    if ssh_active and shutil.which("tmux"):
        data = try_cmd(["tmux", "show-buffer"])

    if not ssh_active:
        if not data and has_display:
            if shutil.which("xsel"):
                data = try_cmd(["xsel", "-ob"]) or try_cmd(["xsel", "-op"])
            if not data and shutil.which("xclip"):
                for args in (
                    ["xclip", "-selection", "clipboard", "-t", "UTF8_STRING", "-o"],
                    ["xclip", "-selection", "clipboard", "-o"],
                    ["xclip", "-selection", "primary", "-t", "UTF8_STRING", "-o"],
                    ["xclip", "-selection", "primary", "-o"],
                ):
                    data = try_cmd(args)
                    if data:
                        break
        if not data and os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
            data = try_cmd(["wl-paste", "--no-newline"]) or try_cmd(["wl-paste", "--primary", "--no-newline"])
        if not data and shutil.which("pbpaste"):
            data = try_cmd(["pbpaste"])
    if not data and shutil.which("tmux"):
        data = try_cmd(["tmux", "show-buffer"])

    if data and shutil.which("tmux"):
        run_tmux("load-buffer", "-", input_bytes=data)
        if target_pane:
            if tmux_out("display-message", "-p", "-t", target_pane, "#{pane_in_mode}") == "1":
                run_tmux("copy-mode", "-q", "-t", target_pane)
            run_tmux("paste-buffer", "-p", "-t", target_pane)


def resolve_private_link(link_word: str, link_cwd: str, target_arg: str = "") -> str:
    sess = ""
    if not os.environ.get("IDE_WORKDIR") or not os.environ.get("IDE_INITIAL_ROOT") or (link_cwd and not os.path.isdir(link_cwd)):
        sess = resolve_target_session(target_arg) if (os.environ.get("TMUX") or target_arg) else ""
        if sess and session_exists(sess):
            wdir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
            init_root = get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
            if wdir and not os.environ.get("IDE_WORKDIR"):
                os.environ["IDE_WORKDIR"] = wdir
            if init_root and not os.environ.get("IDE_INITIAL_ROOT"):
                os.environ["IDE_INITIAL_ROOT"] = init_root
    link_cwd = normalize_pane_cwd(link_cwd, sess=sess, target_arg=target_arg)
    return _call_ide_hook("ide_resolve_link", link_word, link_cwd)


_RE_FILE_URI = re.compile(r"(file://[^()\s\]>\"'`\\]+(?:\([^()\s\]>\"'`\\]*\)[^()\s\]>\"'`\\]*)*)")
_RE_SCHEME = re.compile(r"(?:https?|file)://[A-Za-z0-9\-._~:/?#@!$&*+,;=%]+")
_WRAP_REF_RE = re.compile(r"(?:(?:https?|file):)?//[A-Za-z0-9\-._~:/?#@!$&*+,;=%]+")
_RE_LINE_COL = re.compile(r"^(.+?):[Ll]?([0-9]+)(:[0-9]+)?(-[Ll]?[0-9]+(:[0-9]+)?)?$")
_RE_HASH_LINE = re.compile(r"^(.+)#[Ll]?([0-9]+)(?::[0-9]+)?(?:[-:][Ll]?[0-9]+(?::[0-9]+)?)?$")
_RE_MD_LABEL = re.compile(r"\[(`[^`\r\n]+`|[^\[\]\r\n]+(?:\[[^\[\]\r\n]*\][^\[\]\r\n]*)*)\]\(")
_RE_MD_LINK = re.compile(
    r"\[(?:`[^`\r\n]+`|[^\[\]\r\n]*(?:\[[^\[\]\r\n]*\][^\[\]\r\n]*)*)\]\(([^()\s]+(?:\([^()\s]*\)[^()\s]*)*)\)"
)
_RE_MD_DEST_TAIL = re.compile(r"^[^(\[\s]*\]\(([^()\s]+(?:\([^()\s]*\)[^()\s]*)*)\)")
_RE_TOOL_CALL = re.compile(r"^(Read|Edit|Write|View|Update|Create|Bash)\((.+)$")
_RE_PCT_ENC = re.compile(r"%[0-9A-Fa-f]{2}")
_RE_FRAG_ID = re.compile(r"^[A-Za-z0-9_.:-]+$")


def parse_file_target(raw: str, cwd: str = "") -> tuple[str, str]:
    def _exists(p: str) -> bool:
        if not p:
            return False
        if os.path.exists(p):
            return True
        if cwd and not p.startswith("/"):
            return os.path.exists(os.path.join(cwd, p))
        return False

    line = ""
    had_file_scheme = raw.startswith("file://")
    if had_file_scheme:
        raw = raw[7:]
        if raw.startswith("localhost/"):
            raw = raw[9:]
        elif not raw.startswith("/") and "/" in raw:
            raw = raw[raw.index("/"):]

    m_hash = _RE_HASH_LINE.match(raw)
    if m_hash:
        raw, line = m_hash.group(1), m_hash.group(2)
    elif "#" in os.path.basename(raw) and not _exists(raw) and not _exists(urllib.parse.unquote(raw)):
        base_raw, frag = raw.rsplit("#", 1)
        base_unq = urllib.parse.unquote(base_raw)
        if _exists(base_raw) or _exists(base_unq):
            raw = base_raw
        elif had_file_scheme and not _exists(urllib.parse.unquote(raw).rsplit(":", 1)[0]):
            raw = base_raw
        elif (
            os.path.splitext(base_unq)[1]
            and not os.path.splitext(frag.split(":", 1)[0])[1]
            and _RE_FRAG_ID.match(frag)
        ):
            raw = base_raw

    if not _exists(raw) and _RE_PCT_ENC.search(raw):
        raw = urllib.parse.unquote(raw)
        if not line and "#" in os.path.basename(raw) and not _exists(raw):
            m_hash2 = _RE_HASH_LINE.match(raw)
            if m_hash2:
                raw, line = m_hash2.group(1), m_hash2.group(2)

    if not line and not _exists(raw):
        m_col = _RE_LINE_COL.match(raw)
        if m_col:
            raw, line = m_col.group(1), m_col.group(2)

    if not _exists(raw) and _RE_PCT_ENC.search(raw):
        raw = urllib.parse.unquote(raw)
    return raw, line


def strip_token_wrappers(s: str) -> str:
    s = s.lstrip("([{\"<'`")
    while s:
        if s.startswith("//") and s.endswith(("/...", "/..")):
            break
        if s[-1] in ">\"'`,;.:":
            s = s[:-1]
        elif s[-1] == ")" and s.count(")") > s.count("("):
            s = s[:-1]
        elif s[-1] == "]" and s.count("]") > s.count("["):
            s = s[:-1]
        elif s[-1] == "}" and s.count("}") > s.count("{"):
            s = s[:-1]
        else:
            break
    return s


def resolve_workspace_file(cand: str, cwd: str, target_arg: str) -> str:
    if not cand:
        return ""
    if cand.startswith("~/"):
        cand = os.path.expanduser(cand)
    if cand.startswith("/"):
        return cand if (os.path.isfile(cand) or os.path.isdir(cand)) else ""

    sess = resolve_target_session(target_arg) if (os.environ.get("TMUX") or target_arg) else ""
    workdir = ""
    init_root = ""
    if sess and session_exists(sess):
        workdir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
        init_root = get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")

    for base_dir in (cwd, workdir, init_root):
        if base_dir:
            full = os.path.join(base_dir, cand)
            if os.path.isfile(full) or os.path.isdir(full):
                return full

    if shutil.which("git"):
        for base_dir in (cwd, workdir, init_root):
            if not base_dir or not os.path.isdir(base_dir):
                continue
            res = subprocess.run(
                ["git", "-C", base_dir, "rev-parse", "--show-toplevel"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
            git_root = (res.stdout or "").strip() if res.returncode == 0 else ""
            if not git_root:
                continue
            full = os.path.join(git_root, cand)
            if os.path.isfile(full) or os.path.isdir(full):
                return full
            if "/" in cand:
                stripped = cand.split("/", 1)[1]
                full2 = os.path.join(git_root, stripped)
                if os.path.isfile(full2) or os.path.isdir(full2):
                    return full2
            ls_res = subprocess.run(
                ["git", "-C", git_root, "ls-files", "--cached", "--others", "--exclude-standard"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
            if ls_res.returncode == 0:
                suffix = "/" + cand
                matches = []
                for rel in ls_res.stdout.splitlines():
                    if rel == cand or rel.endswith(suffix):
                        p = os.path.join(git_root, rel)
                        if os.path.isfile(p):
                            matches.append(p)
                if len(matches) == 1:
                    return matches[0]
            break

    for base_dir in (init_root, workdir, cwd):
        if not base_dir or not os.path.isdir(base_dir):
            continue
        base_path = Path(base_dir)
        glob_matches: list[str] = []
        for pat in (f"*/{cand}", f"*/*/{cand}", f"*/*/*/{cand}"):
            for m in base_path.glob(pat):
                if m.is_file():
                    glob_matches.append(str(m))
        if len(glob_matches) == 1:
            return glob_matches[0]
        break

    return ""


_resolve_workspace_file = resolve_workspace_file


def open_file_or_dir_target(fpath: str, line: str, target_arg: str) -> bool:
    if os.path.isfile(fpath):
        open_in_editor(fpath, True, target_arg, line)
        return True
    if os.path.isdir(fpath):
        cd_ide_workspace(fpath, target_arg)
        return True
    return False


def resolve_and_open_target(raw_target: str, cwd: str, target_arg: str, fallback_line: str = "") -> bool:
    parse_path, parse_line = parse_file_target(raw_target, cwd)
    if not parse_line and fallback_line:
        parse_line = fallback_line
    if not parse_path:
        return False
    if not parse_path.startswith("/") and not parse_path.startswith("~/"):
        resolved = _resolve_workspace_file(parse_path, cwd, target_arg)
        if resolved:
            return open_file_or_dir_target(resolved, parse_line, target_arg)
    if open_file_or_dir_target(parse_path, parse_line, target_arg):
        return True
    resolved = _resolve_workspace_file(parse_path, cwd, target_arg)
    if resolved:
        return open_file_or_dir_target(resolved, parse_line, target_arg)
    return False


_URL_CHARS_RE = re.compile(r"^[A-Za-z0-9\-._~:/?#@!$&*+,;=%]+$")
_URL_TAIL_RE = re.compile(r"((?:(?:https?|file):)?//[A-Za-z0-9\-._~:/?#@!$&*+,;=%]+)[)\]>\"'`,;.]*$")


def open_browser_url(url: str, target_arg: str = "") -> bool:
    if not url:
        return False
    sess = (
        resolve_target_session(target_arg)
        if (os.environ.get("TMUX") or os.environ.get("TMUX_TMPDIR") or target_arg)
        else ""
    )
    has_tmux = bool(os.environ.get("TMUX")) or (bool(sess) and session_exists(sess))
    ssh_active = is_ssh_session(sess or target_arg)
    if has_tmux and shutil.which("tmux"):
        if run_tmux("load-buffer", "-w", "-", input_bytes=url.encode("utf-8")).returncode != 0:
            run_tmux("load-buffer", "-", input_bytes=url.encode("utf-8"))
        if ssh_active:
            msg = f"Copied URL to clipboard (OSC 52): {url}"
            if sess and session_exists(sess):
                run_tmux("display-message", "-d", "4000", "-t", f"={sess}:", msg)
            elif os.environ.get("TMUX_PANE"):
                run_tmux("display-message", "-d", "4000", "-t", os.environ["TMUX_PANE"], msg)
    ide_browser = (os.environ.get("IDE_BROWSER") or "").strip()
    if ide_browser:
        parts = [ide_browser] if (os.path.isfile(ide_browser) and os.access(ide_browser, os.X_OK)) else shlex.split(ide_browser)
        if parts and (shutil.which(parts[0]) or (os.path.isfile(parts[0]) and os.access(parts[0], os.X_OK))):
            subprocess.Popen([*parts, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    has_display = not ssh_active and bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    for browser in (("xdg-open", "google-chrome") if has_display else ()) + (() if ssh_active else ("open",)):
        if shutil.which(browser):
            subprocess.Popen([browser, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return bool(ssh_active and has_tmux)


def _resolve_capture_pane_targets(target_arg: str = "") -> list[list[str]]:
    if not shutil.which("tmux"):
        return []
    if not (os.environ.get("TMUX") or os.environ.get("TMUX_TMPDIR") or target_arg):
        return []
    sess = ""
    if target_arg and target_arg.startswith("%"):
        pane_target = ["-t", target_arg]
    else:
        sess = resolve_target_session(target_arg)
        if sess and session_exists(sess):
            pane_target = ["-t", f"={sess}:"]
        elif os.environ.get("TMUX_PANE"):
            pane_target = ["-t", os.environ["TMUX_PANE"]]
        else:
            return []
    pane_targets = [pane_target]
    if not (target_arg and target_arg.startswith("%")) and sess and session_exists(sess):
        for pid in tmux_out("list-panes", "-t", f"={sess}:", "-F", "#{pane_id}").splitlines():
            if pid and ["-t", pid] not in pane_targets:
                pane_targets.append(["-t", pid])
    return pane_targets


def unsplit_wrapped_url(word: str, target_arg: str = "") -> str:
    if not word:
        return word
    pane_targets = _resolve_capture_pane_targets(target_arg)
    for pt in pane_targets:
        joined_out = tmux_out("capture-pane", "-p", "-J", *pt)
        if joined_out:
            for m in _WRAP_REF_RE.finditer(joined_out):
                full = strip_token_wrappers(m.group(0))
                if len(full) > len(word) and (full.startswith(word) or full.endswith(word)):
                    return full
        raw_lines = tmux_out("capture-pane", "-p", *pt).splitlines()
        for idx, line in enumerate(raw_lines):
            m_tail = _URL_TAIL_RE.search(line.strip())
            if not m_tail:
                continue
            first_frag = strip_token_wrappers(m_tail.group(1))
            frags = [first_frag]
            cur_line = line.rstrip()
            j = idx + 1
            while j < len(raw_lines) and (
                frags[-1].endswith(("-", "/", "_", "=", "?", "&", "#")) or len(cur_line) >= 60
            ):
                next_s = raw_lines[j].strip()
                if not next_s:
                    break
                first_tok = next_s.split()[0]
                cont = strip_token_wrappers(first_tok)
                if not cont or cont.startswith(("http://", "https://", "file://", "//")) or not _URL_CHARS_RE.match(cont):
                    break
                frags.append(cont)
                cur_line = raw_lines[j].rstrip()
                if len(next_s.split()) > 1:
                    break
                j += 1
            if len(frags) > 1:
                full = "".join(frags)
                if word in frags or full.startswith(word) or full.endswith(word):
                    return full
    return word


_stitch_wrapped_tmux_word = unsplit_wrapped_url


def _unwrap_tool_or_token(word: str) -> str:
    word = strip_token_wrappers(word)
    m_tool = _RE_TOOL_CALL.match(word)
    if m_tool:
        word = m_tool.group(2)
        if word.endswith(")"):
            word = word[:-1]
        word = strip_token_wrappers(word)
    return word


def _extract_word_target(raw_word: str, cwd: str = "") -> tuple[str, str]:
    w = raw_word.strip()
    m_lbl = _RE_MD_LABEL.search(w)
    if m_lbl:
        w = m_lbl.group(1)
    return parse_file_target(_unwrap_tool_or_token(w), cwd)


_TMUX_WORD_SEPS = " ()[]{}<>\"'`,;*"
_SGR_RE = re.compile(r"\x1b\[[0-9;:]*m")
_SPLIT_OSC8_RE = re.compile(
    r"\x1b\]8;[^;\x1b]*;([^\x1b\r\n]+)\x1b\\([^\x1b\r\n]+)\x1b\]8;;\x1b\\([()\[\]{}<>\"'`,;*]*[^\x1b\s()\[\]{}<>\"'`,;*]+)"
)
_SUFFIX_OSC8_RE = re.compile(
    r"([^\x1b\s()\[\]{}<>\"'`,;*]+)\x1b\]8;[^;\x1b]*;([^\x1b\r\n\x07]+)(?:\x1b\\|\x07)([^\x1b\s()\[\]{}<>\"'`,;*]+)\x1b\]8;;(?:\x1b\\|\x07)"
)
_CONT_LINE_RE = re.compile(r"^[ \t]*\r?\n[ \t]*([^\x1b\s()\[\]{}<>\"'`,;*]+)")


def recover_split_osc8_href(word: str, target_arg: str = "") -> str:
    clean_word = strip_token_wrappers(word.strip())
    if not clean_word:
        return ""
    clean_word_nostar = clean_word.rstrip("*")
    pane_targets = _resolve_capture_pane_targets(target_arg)
    for pt in pane_targets:
        esc_out = tmux_out("capture-pane", "-e", "-p", "-J", "-S", "-500", *pt)
        if not esc_out:
            continue
        clean_esc = _SGR_RE.sub("", esc_out)
        matches = list(_SPLIT_OSC8_RE.finditer(clean_esc))
        for m in reversed(matches):
            cand_href, pfx, sfx = m.group(1), m.group(2), m.group(3)
            combined = pfx + sfx
            if combined == clean_word or strip_token_wrappers(combined) == clean_word:
                return cand_href
        sfx_matches = list(_SUFFIX_OSC8_RE.finditer(clean_esc))
        for m in reversed(sfx_matches):
            pfx, cand_href, sfx = m.group(1), m.group(2), m.group(3)
            combined = pfx + sfx
            if (
                combined in (clean_word, clean_word_nostar)
                or strip_token_wrappers(combined) in (clean_word, clean_word_nostar)
                or pfx in (clean_word, clean_word_nostar)
                or strip_token_wrappers(pfx) in (clean_word, clean_word_nostar)
            ):
                return cand_href
        for m in reversed(matches):
            cand_href, pfx, sfx = m.group(1), m.group(2), m.group(3)
            combined = pfx + sfx
            sfx_stripped = sfx.lstrip(_TMUX_WORD_SEPS)
            if len(pfx) == 1 and len(sfx_stripped) >= 2 and (
                sfx_stripped == clean_word or strip_token_wrappers(sfx_stripped) == clean_word
            ):
                return cand_href
            if parse_file_target(strip_token_wrappers(combined))[0] == clean_word:
                return cand_href
            if sfx.endswith(("-", "_", ".", "/", ":")):
                m_cont = _CONT_LINE_RE.match(clean_esc[m.end():])
                if m_cont:
                    cont = strip_token_wrappers(m_cont.group(1))
                    full_comb = strip_token_wrappers(combined + cont)
                    if full_comb == clean_word or (len(cont) >= 3 and cont == clean_word):
                        return cand_href
    return ""


def _jump_nvim_markdown_anchor(anchor: str, target_arg: str, focus: bool = True) -> bool:
    slug = urllib.parse.unquote(anchor.lstrip("#").strip()).lower()
    if not slug:
        return False
    sess = resolve_target_session(target_arg)
    if not sess or not session_exists(sess):
        return False
    if focus:
        toggle_main_pane("focus-editor", target_arg, skip_checktime=True)
    sock = get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
    if not sock or not is_socket_path(sock) or not resolve_nvim_bin():
        return False
    esc_slug = slug.replace("\\", "\\\\").replace("'", "\\'")
    lua_expr = (
        f"(function() local s = '{esc_slug}'; "
        "local ok, p = pcall(vim.treesitter.get_parser, 0, 'markdown'); "
        "if not ok or not p then return 0 end; "
        "local t = (p:parse(true) or {})[1]; "
        "if not t then return 0 end; "
        "local q = vim.treesitter.query.parse('markdown', '(atx_heading (inline) @h)'); "
        "local seen = {}; "
        "for _, n in q:iter_captures(t:root(), 0) do "
        "local h = vim.treesitter.get_node_text(n, 0):gsub('^%s+', ''):gsub('%s+$', ''):gsub('%[(.-)%]%b()', '%1'):gsub('%[(.-)%]%b[]', '%1'):gsub('<[^>]+>', ''):gsub('–', ''):gsub('—', ''):gsub('‘', ''):gsub('’', ''):gsub('“', ''):gsub('”', ''); "
        "h = vim.fn.tolower(h):gsub('%p', function(c) return (c == '-' or c == '_') and c or '' end):gsub(' ', '-'); "
        "local c = seen[h] or 0; seen[h] = c + 1; "
        "if (c == 0 and h == s) or (string.format('%s-%d', h, c) == s) then "
        "local l = (n:range()) + 1; "
        "vim.cmd(\"normal! m'\"); "
        "vim.cmd(string.format('keepjumps call cursor(%d, 1) | normal! ^zz', l)); "
        "return l end end; return 0 end)()"
    )
    out = nvim_remote_expr(sock, f'luaeval("{lua_expr.replace(chr(34), chr(92) + chr(34))}")')
    return bool(out and out != "0")


def _open_osc8_href(href: str, word: str, cwd: str, target_arg: str) -> int | None:
    if href.startswith("#"):
        return 0 if _jump_nvim_markdown_anchor(href, target_arg) else None
    if not href.startswith("file://"):
        private_url = resolve_private_link(href, cwd, target_arg)
        if private_url:
            href = private_url
    if href.startswith("file://") or not _RE_SCHEME.match(href):
        href_path, href_line = parse_file_target(href, cwd)
        if not href_line and word:
            word_path, word_line = _extract_word_target(word, cwd)
            if word_line and os.path.basename(href_path) == os.path.basename(word_path):
                href_line = word_line
        frag = href.rsplit("#", 1)[1] if (not href_line and "#" in href) else ""
        if resolve_and_open_target(href, cwd, target_arg, fallback_line=href_line):
            if frag:
                _jump_nvim_markdown_anchor(frag, target_arg, focus=False)
            return 0
    elif href.startswith(("http://", "https://")):
        return 0 if open_browser_url(href, target_arg) else 1
    return None


def _open_embedded_file_uri(word: str, lbl_path: str, lbl_line: str, cwd: str, target_arg: str) -> bool:
    m_file_url = _RE_FILE_URI.search(word)
    if not m_file_url:
        return False
    embedded_href = _stitch_wrapped_tmux_word(m_file_url.group(1), target_arg)
    while embedded_href and embedded_href[-1] in ",;." and not os.path.exists(embedded_href[7:]):
        embedded_href = embedded_href[:-1]
    emb_path, emb_line = parse_file_target(embedded_href, cwd)
    fb_line = lbl_line if (not emb_line and lbl_line and os.path.basename(emb_path) == os.path.basename(lbl_path)) else ""
    return resolve_and_open_target(embedded_href, cwd, target_arg, fallback_line=fb_line)


def _normalize_clicked_word(word: str) -> str:
    m_md_link = _RE_MD_LINK.search(word)
    if m_md_link:
        word = m_md_link.group(1)
    else:
        m_dest = _RE_MD_DEST_TAIL.match(word)
        if m_dest:
            word = m_dest.group(1)
    return _unwrap_tool_or_token(word)


def open_ide_link(href: str, word: str, cwd: str, target_arg: str) -> int:
    cwd = normalize_pane_cwd(cwd, target_arg=target_arg)
    run_tmux("set-option", "-gq", "word-separators", _TMUX_WORD_SEPS)

    if not href and word:
        href = recover_split_osc8_href(word, target_arg)

    if href:
        osc8_rc = _open_osc8_href(href, word, cwd, target_arg)
        if osc8_rc is not None:
            return osc8_rc

    word = word.strip()
    if not word:
        return 0

    bracket_label = ""
    lbl_path = ""
    lbl_line = ""
    m_lbl = _RE_MD_LABEL.search(word)
    if m_lbl:
        bracket_label = strip_token_wrappers(m_lbl.group(1))
        lbl_path, lbl_line = parse_file_target(bracket_label, cwd)

    if _open_embedded_file_uri(word, lbl_path, lbl_line, cwd, target_arg):
        return 0

    word = _normalize_clicked_word(word)
    if not word:
        return 0

    word = _stitch_wrapped_tmux_word(word, target_arg)
    private_url = resolve_private_link(word, cwd, target_arg)
    if private_url:
        if private_url.startswith("file://"):
            priv_path, priv_line = parse_file_target(private_url, cwd)
            fb_priv_line = (
                lbl_line
                if (not priv_line and lbl_line and os.path.basename(priv_path) == os.path.basename(lbl_path))
                else ""
            )
            priv_frag = private_url.rsplit("#", 1)[1] if (not priv_line and not fb_priv_line and "#" in private_url) else ""
            if resolve_and_open_target(private_url, cwd, target_arg, fallback_line=fb_priv_line):
                if priv_frag:
                    _jump_nvim_markdown_anchor(priv_frag, target_arg, focus=False)
                return 0
        return 0 if open_browser_url(private_url, target_arg) else 1

    if word.startswith(("http://", "https://")):
        return 0 if open_browser_url(word, target_arg) else 1

    word_path_cand, word_line_cand = parse_file_target(word, cwd)
    fb_word_line = (
        lbl_line
        if (not word_line_cand and lbl_line and os.path.basename(word_path_cand) == os.path.basename(lbl_path))
        else ""
    )
    if resolve_and_open_target(word, cwd, target_arg, fallback_line=fb_word_line):
        return 0

    if "..." in word and "/" in word:
        trunc_base = word.rsplit("/", 1)[-1]
        if trunc_base and trunc_base != word and resolve_and_open_target(trunc_base, cwd, target_arg, fallback_line=lbl_line):
            return 0

    if bracket_label and bracket_label != word:
        lbl_priv = resolve_private_link(bracket_label, cwd, target_arg)
        if lbl_priv and lbl_priv.startswith("file://") and resolve_and_open_target(lbl_priv, cwd, target_arg):
            return 0
        if resolve_and_open_target(bracket_label, cwd, target_arg):
            return 0

    return 0


def status_click(x_str: str, target_arg: str) -> int:
    try:
        x = int(x_str)
    except (ValueError, TypeError):
        return 0
    sess = resolve_target_session(target_arg)
    if not sess or not session_exists(sess):
        return 0

    info = tmux_out(
        "display-message", "-p", "-t", f"={sess}:",
        "#{@ide_role}\t#{@ide_ai_cli}\t#{window_zoomed_flag}\t#{status-left}",
    )
    parts = (info.split("\t") + ["", "", "", ""])[:4]
    role = parts[0] or "ai"
    ai_cli = parts[1] or "AI"
    zoomed = parts[2] == "1"
    status_left_raw = parts[3]

    if status_left_raw:
        plain_left = re.sub(r"#\[[^\]]*\]", "", status_left_raw).replace("#S", sess)
        raw_left_len = sum(2 if (0x1F300 <= ord(ch) <= 0x1FAFF or ch == "✨") else 1 for ch in plain_left)
        left_len = min(48, raw_left_len)
    else:
        left_len = min(48, len(sess) + 6)
    rel = x - left_len
    if rel < 0:
        return 0

    ai_w = 1 + (2 if role == "ai" else 0) + 2 + len(ai_cli) + 8
    ed_w = (2 if role == "editor" else 0) + 16
    term_w = (2 if role == "term" else 0) + 16

    ai_end = ai_w + 1
    ed_end = ai_w + 3 + ed_w + 1
    term_end = ai_w + 3 + ed_w + 3 + term_w

    if rel <= ai_end:
        return toggle_main_pane("ai", sess)
    if rel <= ed_end:
        return toggle_main_pane("editor", sess)
    if rel <= term_end or not zoomed:
        return toggle_main_pane("term", sess)
    run_tmux("resize-pane", "-Z", "-t", f"={sess}:")
    return 0


DEFAULT_THEME_HEX = {
    "BASE03": "#002B36",
    "BASE02": "#073642",
    "BASE01": "#586E75",
    "BASE00": "#657B83",
    "BASE0": "#839496",
    "BASE1": "#93A1A1",
    "BASE2": "#EEE8D5",
    "BASE3": "#FDF6E3",
    "YELLOW": "#B58900",
    "ORANGE": "#CB4B16",
    "RED": "#DC322F",
    "MAGENTA": "#D33682",
    "VIOLET": "#6C71C4",
    "BLUE": "#268BD2",
    "CYAN": "#2AA198",
    "GREEN": "#859900",
}

_THEME_KV_RE = re.compile(r'^([A-Z0-9_]+)="?(#[0-9A-Fa-f]{6})"?$')


def _hex_to_fg(hex_code: str) -> str:
    h = hex_code.lstrip("#")
    if len(h) != 6:
        return ""
    try:
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return f"\033[38;2;{r};{g};{b}m"
    except ValueError:
        return ""


def load_active_palette() -> tuple[dict[str, str], dict[str, str]]:
    hex_map = dict(DEFAULT_THEME_HEX)
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    active_file = os.path.join(xdg_cfg, "home-settings", "active-theme.theme")
    try:
        with open(active_file, "r", encoding="utf-8") as fh:
            for raw_line in fh:
                m = _THEME_KV_RE.match(raw_line.strip())
                if m and m.group(1) in hex_map:
                    hex_map[m.group(1)] = m.group(2)
    except OSError:
        pass
    esc_map = {k: _hex_to_fg(v) for k, v in hex_map.items()}
    esc_map["RESET"] = "\033[0m"
    return hex_map, esc_map


def build_fzf_env(hex_map: dict[str, str]) -> dict[str, str]:
    env = os.environ.copy()
    xdg_cfg = env.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    theme_env_path = os.path.join(xdg_cfg, "home-settings", "theme-env.sh")
    loaded_opts = ""
    try:
        with open(theme_env_path, "r", encoding="utf-8") as fh:
            for raw_line in fh:
                stripped = raw_line.strip()
                if stripped.startswith("export FZF_DEFAULT_OPTS="):
                    rhs = stripped[len("export FZF_DEFAULT_OPTS="):]
                    try:
                        parts = shlex.split(rhs, posix=True)
                        if len(parts) == 1:
                            loaded_opts = parts[0]
                    except ValueError:
                        pass
                    if not loaded_opts and len(rhs) >= 2 and rhs[0] == rhs[-1] and rhs[0] in ("'", '"'):
                        loaded_opts = rhs[1:-1]
    except OSError:
        pass
    if loaded_opts:
        env["FZF_DEFAULT_OPTS"] = loaded_opts
    elif env.get("TMUX") and shutil.which("tmux"):
        tmux_fzf = tmux_out("show-environment", "-g", "FZF_DEFAULT_OPTS")
        if tmux_fzf.startswith("FZF_DEFAULT_OPTS=") and tmux_fzf[17:]:
            env["FZF_DEFAULT_OPTS"] = tmux_fzf[17:]
    if not env.get("FZF_DEFAULT_OPTS"):
        env["FZF_DEFAULT_OPTS"] = (
            f"--color=bg+:{hex_map['BASE02']},bg:{hex_map['BASE03']},spinner:{hex_map['GREEN']},"
            f"hl:{hex_map['BASE01']},fg:{hex_map['BASE0']},header:{hex_map['BASE01']},"
            f"info:{hex_map['YELLOW']},pointer:{hex_map['GREEN']},marker:{hex_map['GREEN']},"
            f"fg+:{hex_map['BASE1']},prompt:{hex_map['YELLOW']},hl+:{hex_map['BLUE']} "
            "--layout=reverse --border=rounded --info=inline --no-scrollbar"
        )
    return env


def _pids_with_children(pids: set[int]) -> set[int]:
    if not pids:
        return set()
    found: set[int] = set()
    my_pid = os.getpid()
    if os.path.isfile(f"/proc/{my_pid}/task/{my_pid}/children"):
        for pid in pids:
            task_dir = f"/proc/{pid}/task"
            try:
                tids = os.listdir(task_dir)
            except OSError:
                continue
            for tid in tids:
                try:
                    with open(f"{task_dir}/{tid}/children", "r", encoding="utf-8") as fh:
                        if fh.read().strip():
                            found.add(pid)
                            break
                except OSError:
                    continue
        return found

    if os.path.isfile("/proc/stat"):
        try:
            for entry in os.listdir("/proc"):
                if not entry.isdigit():
                    continue
                try:
                    with open(f"/proc/{entry}/stat", "r", encoding="utf-8", errors="replace") as fh:
                        stat_txt = fh.read()
                except OSError:
                    continue
                rparen = stat_txt.rfind(")")
                if rparen < 0:
                    continue
                fields = stat_txt[rparen + 2:].split(None, 2)
                if len(fields) >= 2 and fields[1].isdigit():
                    ppid = int(fields[1])
                    if ppid in pids:
                        found.add(ppid)
                        if len(found) == len(pids):
                            break
            return found
        except OSError:
            pass

    try:
        res = subprocess.run(
            ["ps", "-eo", "ppid="],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.5,
            check=False,
        )
        if res.returncode == 0 and res.stdout:
            for tok in res.stdout.split():
                if tok.isdigit():
                    ppid = int(tok)
                    if ppid in pids:
                        found.add(ppid)
    except (OSError, subprocess.SubprocessError):
        pass
    return found


_BARE_SHELL_CMD_RE = re.compile(
    r"^-?(?:(?:ba|z|da|k|mk|a|tc|c|fi)?sh|nu|elvish|xonsh|pwsh)$",
    re.IGNORECASE,
)


def _is_bare_shell_cmd(cmd: str) -> bool:
    s = os.path.basename(cmd.strip())
    return not s or bool(_BARE_SHELL_CMD_RE.match(s))


def pane_has_child_procs(pane_pid: str, pane_cmd: str = "") -> bool:
    p = pane_pid.strip()
    if not p.isdigit():
        return False
    pid = int(p)
    if pid <= 0:
        return False
    if pane_cmd.strip() and not _is_bare_shell_cmd(pane_cmd):
        return True
    return pid in _pids_with_children({pid})


def _list_ide_sessions_with_server_status() -> tuple[list[dict[str, str]], bool]:
    res = run_tmux(
        "list-sessions",
        "-F",
        "#{session_name}\t#{session_activity}\t#{session_last_attached}\t#{session_attached}\t#{@ide_session}\t#{@ide_socket}\t#{@ide_main_win}\t#{@ide_ai_pane}\t#{@ide_ai_cli}\t#{@ide_workdir}\t#{@ide_initial_root}\t#{@ide_ai_state}\t#{@ide_ai_attn}\t#{@ide_ai_attn_ts}\t#{@ide_ai_state_ts}",
    )
    if res.returncode != 0:
        return ([], False)
    if not res.stdout:
        return ([], True)
    items: list[dict[str, str]] = []
    for line in res.stdout.splitlines():
        cols = (line.split("\t") + [""] * 15)[:15]
        (
            sess_name,
            activity,
            last_attached,
            attached,
            ide_sess,
            ide_sock,
            ide_win,
            ai_pane,
            ai_cli,
            workdir,
            init_root,
            ai_state,
            ai_attn,
            ai_attn_ts,
            ai_state_ts,
        ) = cols
        if not is_ide_session_meta(sess_name, ide_sess, ide_sock, ide_win):
            continue
        items.append({
            "sess": sess_name,
            "activity": activity,
            "last_attached": last_attached,
            "attached": attached,
            "ide_sess": ide_sess,
            "ide_sock": ide_sock,
            "ide_win": ide_win,
            "ai_pane": ai_pane,
            "ai_cli": ai_cli or "agy",
            "workdir": workdir or init_root,
            "init_root": init_root or workdir,
            "ai_state": ai_state,
            "ai_attn": ai_attn,
            "ai_attn_ts": ai_attn_ts,
            "ai_state_ts": ai_state_ts,
        })
    return (items, True)


def list_ide_sessions_raw() -> list[dict[str, str]]:
    items, _ = _list_ide_sessions_with_server_status()
    return items


def _parse_attn_ts(raw_ts: str, fallback: float) -> float:
    s = raw_ts.strip()
    if not s:
        return fallback
    try:
        val = float(s)
        return val if val > 0 else fallback
    except ValueError:
        return fallback


def _format_elapsed_age(state_ts: float, now: float | None = None) -> str:
    if state_ts <= 0:
        return ""
    cur = time.time() if now is None else now
    delta = max(0, int(cur - state_ts))
    if delta < 60:
        return f"{delta}s"
    if delta < 3600:
        return f"{delta // 60}m"
    if delta < 86400:
        return f"{delta // 3600}h"
    return f"{delta // 86400}d"


def _char_cell_width(ch: str) -> int:
    cp = ord(ch)
    if 0xE000 <= cp <= 0xF8FF or 0xF0000 <= cp <= 0x10FFFF:
        return 1
    if unicodedata.combining(ch):
        return 0
    if cp >= 0x1F300 or unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1


def _visible_width(text: str) -> int:
    clean = _SGR_RE.sub("", text)
    return sum(_char_cell_width(ch) for ch in clean)


def _pad_visible(text: str, width: int) -> str:
    pad = max(0, width - _visible_width(text))
    return text + (" " * pad)


def _trunc_visible(text: str, max_w: int, suffix: str = "…") -> str:
    if _visible_width(text) <= max_w:
        return text
    sfx_w = _visible_width(suffix)
    budget = max(0, max_w - sfx_w)
    out: list[str] = []
    used = 0
    for ch in text:
        cw = _char_cell_width(ch)
        if used + cw > budget:
            break
        out.append(ch)
        used += cw
    return "".join(out) + suffix


def _locate_git_dirs(workdir: str) -> tuple[str, str, str]:
    if not workdir:
        return ("", "", "")
    cur = os.path.abspath(workdir)
    try:
        start_dev = os.stat(cur).st_dev
    except OSError:
        return ("", "", "")

    worktree_root = ""
    gitdir = ""
    while True:
        dot_git = os.path.join(cur, ".git")
        try:
            st = os.stat(dot_git)
        except OSError:
            st = None
        if st is not None:
            if stat.S_ISDIR(st.st_mode):
                worktree_root = cur
                gitdir = dot_git
                break
            if stat.S_ISREG(st.st_mode):
                try:
                    with open(dot_git, "r", encoding="utf-8", errors="replace") as fh:
                        first_line = fh.readline().strip()
                except OSError:
                    first_line = ""
                if first_line.lower().startswith("gitdir:"):
                    gd_raw = first_line.split(":", 1)[1].strip()
                    if gd_raw:
                        gitdir = gd_raw if os.path.isabs(gd_raw) else os.path.normpath(os.path.join(cur, gd_raw))
                        worktree_root = cur
                        break
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        try:
            if os.stat(parent).st_dev != start_dev:
                break
        except OSError:
            break
        cur = parent

    if not gitdir:
        return ("", "", "")

    commondir = gitdir
    commondir_file = os.path.join(gitdir, "commondir")
    if os.path.isfile(commondir_file):
        try:
            with open(commondir_file, "r", encoding="utf-8", errors="replace") as fh:
                common_rel = fh.readline().strip().rstrip("/")
        except OSError:
            common_rel = ""
        if common_rel and common_rel != ".":
            commondir = (
                common_rel
                if os.path.isabs(common_rel)
                else os.path.normpath(os.path.join(gitdir, common_rel))
            )
    return (worktree_root, gitdir, commondir)


def _build_forge_pr_url(raw_url: str, pr_num: str, forge_hint: str = "") -> str:
    if not raw_url or not pr_num.isdigit() or int(pr_num) <= 0:
        return ""
    scheme = "https"
    rest = raw_url.strip()
    has_scheme = False
    is_http = False
    if rest.startswith("http://"):
        scheme = "http"
        rest = rest[len("http://"):]
        has_scheme = True
        is_http = True
    elif rest.startswith("https://"):
        scheme = "https"
        rest = rest[len("https://"):]
        has_scheme = True
        is_http = True
    elif rest.startswith(("ssh://", "git://", "git+ssh://")):
        rest = rest.split("://", 1)[1]
        has_scheme = True
    elif rest.startswith("file://"):
        rest = "localhost/" + rest[len("file://"):]
        has_scheme = True
    elif rest.startswith("/"):
        rest = "localhost" + rest
        has_scheme = True

    host = ""
    repo_path = ""
    if has_scheme:
        if "/" not in rest:
            return ""
        host, repo_path = rest.split("/", 1)
        if "@" in host:
            host = host.rsplit("@", 1)[1]
        if not is_http and ":" in host and not host.endswith("]"):
            host = host.rsplit(":", 1)[0]
    elif ":" in rest and ("/" not in rest or "/" not in rest.split(":", 1)[0]):
        host, repo_path = rest.split(":", 1)
        if "@" in host:
            host = host.rsplit("@", 1)[1]
    elif "/" in rest:
        host, repo_path = rest.split("/", 1)
        if "@" in host:
            host = host.rsplit("@", 1)[1]
    else:
        return ""

    repo_path = repo_path.strip("/")
    if repo_path.endswith(".git"):
        repo_path = repo_path[:-4].rstrip("/")
    if not host or not repo_path:
        return ""

    host_l = host.lower()
    forge = forge_hint.strip().lower()
    if not forge:
        if "github" in host_l:
            forge = "github"
        elif "gitlab" in host_l:
            forge = "gitlab"
        elif host_l == "bitbucket.org":
            forge = "bitbucket-cloud"
        elif "bitbucket" in host_l or "stash" in host_l:
            forge = "bitbucket-server"
        elif any(k in host_l for k in ("codeberg", "gitea", "forgejo")):
            forge = "gitea"
        else:
            forge = "github"

    if forge == "gitlab":
        return f"{scheme}://{host}/{repo_path}/-/merge_requests/{pr_num}"
    if forge in ("bitbucket-cloud", "bitbucket_cloud"):
        return f"https://bitbucket.org/{repo_path}/pull-requests/{pr_num}"
    if forge in ("bitbucket-server", "bitbucket_server", "bitbucket-dc", "stash"):
        bb_path = repo_path[4:] if repo_path.startswith("scm/") else repo_path
        if "/scm/" in bb_path:
            bb_path = bb_path.split("/scm/", 1)[1]
        if "/" in bb_path:
            rem_part, repo = bb_path.rsplit("/", 1)
            proj = rem_part.rsplit("/", 1)[-1]
        else:
            proj = bb_path
            repo = bb_path
        if proj.startswith("~"):
            return f"{scheme}://{host}/users/{proj[1:]}/repos/{repo}/pull-requests/{pr_num}"
        return f"{scheme}://{host}/projects/{proj.upper()}/repos/{repo}/pull-requests/{pr_num}"
    if forge in ("gitea", "forgejo", "codeberg"):
        return f"{scheme}://{host}/{repo_path}/pulls/{pr_num}"
    return f"{scheme}://{host}/{repo_path}/pull/{pr_num}"


_RE_PULL_MERGE_REF = re.compile(
    r"^refs/(?:(pull)/([1-9][0-9]*)/head|(merge-requests)/([1-9][0-9]*)/head|(pull-requests)/([1-9][0-9]*)/(?:from|head))$"
)
_SAFE_HTTP_URL_RE = re.compile(r"^https?://[^\s\x00-\x1f\x7f]+$", re.IGNORECASE)


def _sanitize_http_url(raw_url: str) -> str:
    cand = raw_url.strip()
    return cand if (cand and _SAFE_HTTP_URL_RE.match(cand)) else ""


def _unescape_git_cfg_str(raw: str) -> str:
    out: list[str] = []
    i = 0
    n = len(raw)
    while i < n:
        ch = raw[i]
        if ch == "\\" and i + 1 < n:
            nxt = raw[i + 1]
            out.append({"n": "\n", "t": "\t", "b": "\b"}.get(nxt, nxt))
            i += 2
        else:
            out.append(ch)
            i += 1
    return "".join(out)


def _parse_git_section_header(s: str) -> tuple[str, str] | None:
    if not s.startswith("["):
        return None
    in_quote = False
    close_idx = -1
    i = 1
    n = len(s)
    while i < n:
        ch = s[i]
        if in_quote:
            if ch == "\\" and i + 1 < n:
                i += 2
                continue
            if ch == '"':
                in_quote = False
        else:
            if ch == '"':
                in_quote = True
            elif ch == "]":
                close_idx = i
                break
        i += 1
    if close_idx < 0:
        return None
    rem = s[close_idx + 1:].strip()
    if rem and rem[0] not in ("#", ";"):
        return None
    hdr = s[1:close_idx].strip()
    if '"' in hdr:
        q_start = hdr.index('"')
        q_end = hdr.rfind('"')
        if q_end <= q_start:
            return None
        sec_type = hdr[:q_start].strip().lower()
        sec_name = _unescape_git_cfg_str(hdr[q_start + 1:q_end])
        return (sec_type, sec_name)
    if "." in hdr:
        sec_type, sec_name = hdr.split(".", 1)
        return (sec_type.strip().lower(), sec_name.strip())
    return (hdr.lower(), "")


def _parse_git_cfg_value(v_raw: str) -> str:
    s = v_raw.lstrip()
    in_quote = False
    out: list[str] = []
    last_keep = 0
    i = 0
    n = len(s)
    while i < n:
        ch = s[i]
        if in_quote:
            if ch == "\\" and i + 1 < n:
                nxt = s[i + 1]
                out.append({"n": "\n", "t": "\t", "b": "\b"}.get(nxt, nxt))
                last_keep = len(out)
                i += 2
                continue
            if ch == '"':
                in_quote = False
                last_keep = len(out)
                i += 1
                continue
            out.append(ch)
            last_keep = len(out)
        else:
            if ch in ("#", ";"):
                break
            if ch == '"':
                in_quote = True
                i += 1
                continue
            if ch == "\\" and i + 1 < n:
                nxt = s[i + 1]
                out.append({"n": "\n", "t": "\t", "b": "\b"}.get(nxt, nxt))
                last_keep = len(out)
                i += 2
                continue
            out.append(ch)
            if not ch.isspace():
                last_keep = len(out)
        i += 1
    return "".join(out[:last_keep])


def _git_glob_match(pat: str, text: str, icase: bool = False) -> bool:
    parts: list[str] = ["^"]
    i = 0
    n = len(pat)
    while i < n:
        if i == 0 and pat.startswith("**/"):
            parts.append("(?:.*/)?")
            i += 3
        elif pat.startswith("/**/", i):
            parts.append("(?:/|/.+/)")
            i += 4
        elif pat.startswith("**", i):
            parts.append(".*")
            i += 2
        elif pat[i] == "*":
            parts.append("[^/]*")
            i += 1
        elif pat[i] == "?":
            parts.append("[^/]")
            i += 1
        else:
            parts.append(re.escape(pat[i]))
            i += 1
    parts.append("$")
    return bool(re.match("".join(parts), text, re.IGNORECASE if icase else 0))


def _resolve_git_pr_badge(
    branch: str,
    upstream: str,
    gitdir: str,
    commondir: str,
    worktree_root: str = "",
) -> tuple[str, str]:
    if not branch or branch in ("-", "HEAD", "(detached)") or branch.startswith("@") or not gitdir:
        return ("", "")

    remote_urls: dict[str, str] = {}
    remote_forges: dict[str, str] = {}
    instead_of: dict[str, str] = {}
    seen_cfgs: set[str] = set()
    first_remote_name = ""
    branch_remote = ""
    branch_pr = ""
    branch_pr_url = ""
    merge_forge_hint = ""

    gitdir_cands: list[str] = []
    for raw_gd in (
        gitdir,
        os.path.realpath(gitdir),
        os.path.join(worktree_root, ".git") if worktree_root else "",
        os.path.join(os.path.realpath(worktree_root), ".git") if worktree_root else "",
    ):
        if raw_gd:
            norm_gd = raw_gd.rstrip("/") + "/"
            if norm_gd not in gitdir_cands:
                gitdir_cands.append(norm_gd)

    def _eval_include_if(cond: str, cfg_dir: str) -> bool:
        if cond.startswith("onbranch:"):
            b_pat = cond[len("onbranch:"):]
            if not b_pat:
                return False
            if b_pat.endswith("/"):
                b_pat += "**"
            return _git_glob_match(b_pat, branch, icase=False)
        icase = False
        if cond.startswith("gitdir/i:"):
            g_pat = cond[len("gitdir/i:"):]
            icase = True
        elif cond.startswith("gitdir:"):
            g_pat = cond[len("gitdir:"):]
        else:
            return False
        if not g_pat:
            return False
        if g_pat.startswith("~/"):
            g_pat = os.path.expanduser("~").rstrip("/") + "/" + g_pat[2:]
        elif g_pat.startswith("./"):
            g_pat = cfg_dir.rstrip("/") + "/" + g_pat[2:]
        elif not g_pat.startswith("/"):
            g_pat = "**/" + g_pat
        if g_pat.endswith("/"):
            g_pat += "**"
        return any(_git_glob_match(g_pat, cand, icase=icase) for cand in gitdir_cands)

    def parse_cfg(cfg_path: str, is_repo_cfg: bool, depth: int = 0) -> None:
        nonlocal first_remote_name, branch_remote, branch_pr, branch_pr_url, merge_forge_hint
        if depth > 4 or not cfg_path or cfg_path in seen_cfgs or not os.path.isfile(cfg_path):
            return
        seen_cfgs.add(cfg_path)
        try:
            with open(cfg_path, "r", encoding="utf-8", errors="replace") as fh:
                raw_lines = fh.readlines()
        except OSError:
            return

        logical_lines: list[str] = []
        idx = 0
        while idx < len(raw_lines):
            cur_l = raw_lines[idx].rstrip("\r\n")
            while cur_l.endswith("\\") and not cur_l.endswith("\\\\") and idx + 1 < len(raw_lines):
                idx += 1
                cur_l = cur_l[:-1] + raw_lines[idx].rstrip("\r\n").lstrip()
            logical_lines.append(cur_l)
            idx += 1

        cfg_dir = os.path.dirname(os.path.abspath(cfg_path))
        sec_type = ""
        sec_name = ""
        seen_url_in_sec = False
        for raw_l in logical_lines:
            s = raw_l.lstrip()
            if not s or s[0] in ("#", ";"):
                continue
            if s.startswith("["):
                seen_url_in_sec = False
                parsed_hdr = _parse_git_section_header(s)
                if parsed_hdr is None:
                    sec_type = ""
                    sec_name = ""
                    continue
                sec_type, sec_name = parsed_hdr
                if sec_type == "includeif":
                    sec_type = "include" if _eval_include_if(sec_name, cfg_dir) else ""
                    sec_name = ""
                elif sec_type not in ("remote", "branch", "url", "include"):
                    sec_type = ""
                    sec_name = ""
                continue
            if not sec_type or "=" not in s:
                continue
            k_raw, v_raw = s.split("=", 1)
            key = k_raw.strip().lower()
            val = _parse_git_cfg_value(v_raw)
            if not val:
                continue

            if sec_type == "remote":
                if key == "url" and not seen_url_in_sec:
                    remote_urls[sec_name] = val
                    seen_url_in_sec = True
                    if is_repo_cfg and not first_remote_name:
                        first_remote_name = sec_name
                elif key == "forge":
                    remote_forges[sec_name] = val.lower()
            elif sec_type == "branch" and sec_name == branch:
                if key == "remote":
                    branch_remote = val
                elif key == "pr" and val.isdigit() and int(val) > 0:
                    branch_pr = val
                elif key == "prurl":
                    safe_u = _sanitize_http_url(val)
                    if safe_u:
                        branch_pr_url = safe_u
                elif key == "merge":
                    m_ref = _RE_PULL_MERGE_REF.match(val)
                    if m_ref:
                        if m_ref.group(1):
                            if not branch_pr:
                                branch_pr = m_ref.group(2)
                            merge_forge_hint = "github"
                        elif m_ref.group(3):
                            if not branch_pr:
                                branch_pr = m_ref.group(4)
                            merge_forge_hint = "gitlab"
                        elif m_ref.group(5):
                            if not branch_pr:
                                branch_pr = m_ref.group(6)
                            merge_forge_hint = "bitbucket-server"
            elif sec_type == "url" and key == "insteadof":
                instead_of[val] = sec_name
            elif sec_type == "include" and key == "path":
                inc = os.path.expanduser(val) if val.startswith("~/") else val
                if not os.path.isabs(inc):
                    inc = os.path.join(cfg_dir, inc)
                parse_cfg(inc, is_repo_cfg, depth + 1)

    global_cfg = os.environ.get("GIT_CONFIG_GLOBAL", "").strip()
    if global_cfg:
        parse_cfg(global_cfg, False)
    else:
        xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        parse_cfg(os.path.join(xdg_cfg, "git", "config"), False)
        parse_cfg(os.path.expanduser("~/.gitconfig"), False)

    eff_common = commondir or gitdir
    if eff_common and os.path.realpath(eff_common) != os.path.realpath(gitdir):
        parse_cfg(os.path.join(eff_common, "config"), True)
    parse_cfg(os.path.join(gitdir, "config"), True)
    parse_cfg(os.path.join(gitdir, "config.worktree"), True)

    if branch_remote and branch_remote != "." and branch_remote in remote_urls:
        remote_name = branch_remote
    elif "/" in upstream and upstream.split("/", 1)[0] in remote_urls:
        remote_name = upstream.split("/", 1)[0]
    elif branch_remote and branch_remote != ".":
        remote_name = branch_remote
    elif "/" in upstream:
        remote_name = upstream.split("/", 1)[0]
    else:
        remote_name = "origin"

    first_remote_url = remote_urls.get(first_remote_name, "") if first_remote_name else ""
    remote_url = remote_urls.get(remote_name) or remote_urls.get("origin") or first_remote_url
    if remote_url and instead_of:
        best_pfx = ""
        for pfx in instead_of:
            if remote_url.startswith(pfx) and len(pfx) > len(best_pfx):
                best_pfx = pfx
        if best_pfx:
            remote_url = instead_of[best_pfx] + remote_url[len(best_pfx):]

    first_remote_forge = remote_forges.get(first_remote_name, "") if first_remote_name else ""
    forge_hint = (
        remote_forges.get(remote_name)
        or remote_forges.get("origin")
        or first_remote_forge
        or merge_forge_hint
    )

    if branch_pr and branch_pr.isdigit() and int(branch_pr) > 0:
        pr_url = _sanitize_http_url(
            branch_pr_url or (_build_forge_pr_url(remote_url, branch_pr, forge_hint) if remote_url else "")
        )
        return (branch_pr, pr_url)

    if branch in ("main", "master", "trunk", "develop") or not eff_common:
        return ("", "")

    cache_dir = (
        os.environ.get("GIT_PR_CACHE_DIR")
        or os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "git-pr-prompt")
    )
    cand_common_paths: list[str] = []
    for cp in (os.path.realpath(eff_common), os.path.abspath(eff_common)):
        if cp and cp not in cand_common_paths:
            cand_common_paths.append(cp)

    best_ts = -1
    best_num = ""
    best_url = ""
    for cp in cand_common_paths:
        repo_key = re.sub(r"[^A-Za-z0-9._-]", "_", cp)
        state_file = os.path.join(cache_dir, f"{repo_key}.state")
        if not os.path.isfile(state_file):
            continue
        try:
            with open(state_file, "r", encoding="utf-8", errors="replace") as fh:
                for raw_l in fh:
                    parts = raw_l.rstrip("\r\n").split("|")
                    if len(parts) < 2 or parts[0] != branch:
                        continue
                    c_num = parts[1].strip()
                    c_url = _sanitize_http_url(parts[2]) if len(parts) > 2 else ""
                    c_ts_s = parts[3].strip() if len(parts) > 3 else ""
                    c_ts = int(c_ts_s) if c_ts_s.isdigit() else 0
                    if c_ts >= best_ts:
                        best_ts = c_ts
                        if c_num != "NONE" and c_num.isdigit() and int(c_num) > 0:
                            best_num = c_num
                            best_url = c_url
                        else:
                            best_num = ""
                            best_url = ""
                    break
        except OSError:
            continue

    if best_num:
        resolved_url = _sanitize_http_url(
            best_url or (_build_forge_pr_url(remote_url, best_num, forge_hint) if remote_url else "")
        )
        return (best_num, resolved_url)
    return ("", "")


def _call_vcs_summary_hook(workdir: str) -> tuple[str, bool, str, str] | None:
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    rules = os.environ.get("IDE_LINK_RULES") or os.path.join(xdg_cfg, "ide", "links.sh")
    try:
        with open(rules, "r", encoding="utf-8") as fh:
            if "ide_vcs_summary" not in fh.read():
                return None
    except OSError:
        return None
    try:
        res = subprocess.run(
            [
                "bash",
                "-c",
                '. "$1" && declare -F ide_vcs_summary >/dev/null && ide_vcs_summary "$2"',
                "ide",
                rules,
                workdir,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.4,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0 or not res.stdout:
        return None
    first_line = next((ln.strip() for ln in res.stdout.splitlines() if ln.strip()), "")
    if not first_line or "|" not in first_line:
        return None
    parts = first_line.split("|", 3)
    branch = parts[0].strip() or "-"
    dirty = (parts[1].strip().lower() in ("1", "true", "yes", "dirty", "*")) if len(parts) > 1 else False
    detail = (parts[2].strip() if len(parts) > 2 else "") or (
        f"{branch} (modified)" if dirty else f"{branch} (clean)"
    )
    url = _sanitize_http_url(parts[3]) if len(parts) > 3 else ""
    return (branch, dirty, detail, url)


def _git_summary(workdir: str) -> tuple[str, bool, str, str, str]:
    if not workdir or not os.path.isdir(workdir):
        return ("-", False, "not a git repository", "", "")
    custom_vcs = _call_vcs_summary_hook(workdir)
    worktree_root, gitdir, commondir = _locate_git_dirs(workdir)
    if custom_vcs is not None:
        return (custom_vcs[0], custom_vcs[1], custom_vcs[2], custom_vcs[3], worktree_root)
    env_git_dir = os.environ.get("GIT_DIR", "").strip()
    eff_gitdir = gitdir or (os.path.abspath(env_git_dir) if env_git_dir else "")
    eff_commondir = commondir or eff_gitdir
    if not shutil.which("git") or not eff_gitdir:
        return ("-", False, "not a git repository", "", "")
    try:
        res = subprocess.run(
            ["git", "-C", workdir, "--no-optional-locks", "status", "--porcelain=v2", "--branch"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.4,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ("-", False, "unavailable", "", "")
    if res.returncode != 0 or not res.stdout:
        return ("-", False, "not a git repository", "", "")
    branch = ""
    oid = ""
    upstream = ""
    staged = 0
    modified = 0
    untracked = 0
    for line in res.stdout.splitlines():
        if line.startswith("# branch.head "):
            branch = line[len("# branch.head "):].strip()
        elif line.startswith("# branch.oid "):
            oid = line[len("# branch.oid "):].strip()
        elif line.startswith("# branch.upstream "):
            upstream = line[len("# branch.upstream "):].strip()
        elif line.startswith("? "):
            untracked += 1
        elif line.startswith(("1 ", "2 ", "u ")):
            parts = line.split(" ", 2)
            xy = parts[1] if len(parts) > 1 else ".."
            if len(xy) >= 2:
                if xy[0] != ".":
                    staged += 1
                if xy[1] != ".":
                    modified += 1
    if branch in ("", "(detached)"):
        branch = f"@{oid[:7]}" if oid and oid != "(initial)" else "HEAD"
    pr_num, pr_url = _resolve_git_pr_badge(branch, upstream, eff_gitdir, eff_commondir, worktree_root)
    branch_badge = f"{branch}@{pr_num}" if pr_num else branch
    dirty = (staged + modified + untracked) > 0
    if not dirty:
        detail = f"{branch_badge} (clean)"
    else:
        counts = []
        if staged:
            counts.append(f"+{staged} staged")
        if modified:
            counts.append(f"~{modified} modified")
        if untracked:
            counts.append(f"?{untracked} untracked")
        detail = f"{branch_badge} ({', '.join(counts)})"
    return (branch_badge, dirty, detail, pr_url, worktree_root)


def _shorten_home(path: str) -> str:
    if not path:
        return "-"
    home = os.path.expanduser("~").rstrip("/")
    if home and (path == home or path.startswith(home + "/")):
        return "~" + path[len(home):]
    return path


def _state_color(state: str, esc: dict[str, str]) -> str:
    if state == "ATTN":
        return esc["ORANGE"]
    if state == "QUOTA":
        return esc["YELLOW"]
    if state == "WORKING":
        return esc["CYAN"]
    if state == "DONE":
        return esc["GREEN"]
    if state == "IDLE":
        return esc["BASE0"]
    return esc["BASE01"]


def _format_attn_summary(fleet: list[dict[str, object]]) -> str:
    attn_items = sorted(
        (
            (0 if str(e["state"]) == "ATTN" else 1, float(e["attn_ts"]), str(e["sess"]))
            for e in fleet
            if bool(e["needs_attn"])
        ),
        key=lambda x: (x[0], x[1], x[2]),
    )
    if not attn_items:
        return ""
    if len(attn_items) == 1:
        return attn_items[0][2]
    return f"{attn_items[0][2]} +{len(attn_items) - 1}"


def classify_ide_fleet(
    include_git: bool = True,
    cur_sess: str = "",
    git_only_sess: str = "",
) -> list[dict[str, object]]:
    raw_sessions = list_ide_sessions_raw()
    if not raw_sessions:
        return []

    panes_res = run_tmux(
        "list-panes",
        "-a",
        "-F",
        "#{session_name}\t#{window_id}\t#{window_name}\t#{pane_id}\t#{pane_pid}\t#{pane_active}\t#{window_active}\t#{@ide_role}\t#{pane_current_path}\t#{pane_current_command}\t#{window_activity}",
    )
    panes_by_sess: dict[str, list[tuple[str, str, str, str, str, str, str, str, str, str]]] = {}
    if panes_res.returncode == 0 and panes_res.stdout:
        for line in panes_res.stdout.splitlines():
            pcols = (line.split("\t") + [""] * 11)[:11]
            panes_by_sess.setdefault(pcols[0], []).append(
                (pcols[1], pcols[2], pcols[3], pcols[4], pcols[5], pcols[6], pcols[7], pcols[8], pcols[9], pcols[10])
            )

    preview_pane_by_sess: dict[str, str] = {}
    active_role_by_sess: dict[str, str] = {}
    fallback_dir_by_sess: dict[str, str] = {}
    ai_pid_by_sess: dict[str, int] = {}
    ai_cmd_by_sess: dict[str, str] = {}
    win_act_by_sess: dict[str, int] = {}

    for item in raw_sessions:
        sess = item["sess"]
        spanes = panes_by_sess.get(sess, [])
        rec_ai = item["ai_pane"]
        ai_pid_str = ""
        ai_cmd_str = ""
        visible_ai = ""
        active_vis_pane = ""
        first_vis_pane = ""
        act_role = ""
        fb_dir = ""
        max_win_act = 0
        for _, wname, pid, ppid, p_act, w_act, prole, ppath, pcmd, w_act_ts in spanes:
            if rec_ai and pid == rec_ai and not ai_pid_str:
                ai_pid_str = ppid
                ai_cmd_str = pcmd
            if w_act_ts.isdigit():
                max_win_act = max(max_win_act, int(w_act_ts))
            if wname.startswith("_ide_park_"):
                continue
            if not first_vis_pane:
                first_vis_pane = pid
            if not fb_dir and ppath:
                fb_dir = ppath
            if w_act == "1" and p_act == "1":
                active_vis_pane = pid
                act_role = prole or "shell"
            if rec_ai and pid == rec_ai:
                visible_ai = pid
        if not ai_pid_str:
            for _, _, _, ppid, _, _, prole, _, pcmd, _ in spanes:
                if prole == "ai":
                    ai_pid_str = ppid
                    ai_cmd_str = pcmd
                    break
        if not visible_ai:
            for _, wname, pid, _, _, _, prole, _, _, _ in spanes:
                if wname.startswith("_ide_park_"):
                    continue
                if prole == "ai":
                    visible_ai = pid
                    break
        preview_pane_by_sess[sess] = visible_ai or active_vis_pane or first_vis_pane
        active_role_by_sess[sess] = act_role or "ai"
        fallback_dir_by_sess[sess] = fb_dir
        win_act_by_sess[sess] = max_win_act
        if ai_pid_str.strip().isdigit():
            ai_pid_by_sess[sess] = int(ai_pid_str.strip())
            ai_cmd_by_sess[sess] = ai_cmd_str.strip()

    alive_child_pids = _pids_with_children(set(ai_pid_by_sess.values()))
    stale_cleanup_cmds: list[str] = []
    now_ts = time.time()

    fleet: list[dict[str, object]] = []
    for item in raw_sessions:
        sess = item["sess"]
        workdir = item["workdir"] or fallback_dir_by_sess.get(sess, "")
        if include_git:
            if not git_only_sess or sess == git_only_sess:
                git_branch, git_dirty, git_detail, git_pr_url, worktree_root = _git_summary(workdir)
            else:
                worktree_root, _, _ = _locate_git_dirs(workdir)
                git_branch, git_dirty, git_detail, git_pr_url = ("-", False, "-", "")
        else:
            git_branch, git_dirty, git_detail, git_pr_url, worktree_root = ("-", False, "-", "", "")

        sess_act = int(item["activity"]) if item["activity"].isdigit() else 0
        raw_last_att = item.get("last_attached", "")
        last_att = int(raw_last_att) if raw_last_att.isdigit() else 0
        win_act = win_act_by_sess.get(sess, 0)
        act_ts = max(sess_act, last_att, win_act)
        ai_pid = ai_pid_by_sess.get(sess, 0)
        ai_cmd = ai_cmd_by_sess.get(sess, "")
        has_child = bool(ai_pid) and (
            ai_pid in alive_child_pids or not _is_bare_shell_cmd(ai_cmd)
        )
        raw_state = item["ai_state"].strip().lower()
        raw_attn = item["ai_attn"].strip()
        raw_attn_ts = item["ai_attn_ts"].strip()
        raw_state_ts = item.get("ai_state_ts", "").strip()
        needs_attn = False
        state_ts = 0.0

        if not has_child:
            state = "SHELL"
            attn_ts = 0.0
            state_label = "SHELL"
            if raw_state or raw_attn not in ("", "0") or raw_attn_ts or raw_state_ts:
                if stale_cleanup_cmds:
                    stale_cleanup_cmds.append(";")
                stale_cleanup_cmds.extend([
                    "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state", "",
                    ";",
                    "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn", "0",
                    ";",
                    "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn_ts", "",
                    ";",
                    "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state_ts", "",
                ])
        else:
            needs_attn = bool(raw_attn == "1")
            attn_ts = _parse_attn_ts(raw_attn_ts, float(act_ts or now_ts)) if needs_attn else 0.0
            if raw_state == "approval" or (raw_attn == "1" and raw_state != "done"):
                state = "ATTN"
            elif raw_state == "quota":
                state = "QUOTA"
            elif raw_state == "running":
                state = "WORKING"
            elif raw_state == "done":
                state = "DONE"
            elif raw_state == "idle":
                state = "IDLE"
            else:
                state = "-"
            state_ts = _parse_attn_ts(raw_state_ts, 0.0)
            if state_ts <= 0 and state in ("ATTN", "DONE") and raw_attn_ts:
                state_ts = _parse_attn_ts(raw_attn_ts, 0.0)
            if state in ("ATTN", "QUOTA", "WORKING", "DONE", "IDLE") and state_ts > 0:
                state_label = f"{state} {_format_elapsed_age(state_ts, now_ts)}"
            else:
                state_label = state

        fleet.append({
            "sess": sess,
            "ai_cli": item["ai_cli"] or "agy",
            "state": state,
            "state_label": state_label,
            "state_ts": state_ts,
            "needs_attn": needs_attn,
            "attn_ts": attn_ts,
            "workdir": workdir,
            "short_path": _shorten_home(workdir),
            "git_branch": git_branch,
            "git_dirty": git_dirty,
            "git_detail": git_detail,
            "git_pr_url": git_pr_url,
            "worktree_root": os.path.realpath(worktree_root) if worktree_root else "",
            "worktree_peers": [],
            "preview_pane": preview_pane_by_sess.get(sess, ""),
            "active_role": active_role_by_sess.get(sess, "ai"),
            "attached": item["attached"] not in ("", "0"),
            "activity": act_ts,
            "last_attached": last_att,
            "window_activity": win_act,
            "is_current": sess == cur_sess,
        })

    def _fleet_sort_key(entry: dict[str, object]) -> tuple[int, int, float, int, int, int, int, str]:
        st = str(entry["state"])
        needs_attn_flag = bool(entry["needs_attn"])
        sess_name = str(entry["sess"])
        if st == "ATTN":
            sub = 0 if needs_attn_flag else 1
            ts = float(entry["attn_ts"]) if needs_attn_flag else (float(entry.get("state_ts") or 0.0) or float(entry["activity"]))
            return (0, sub, ts, 0, 0, 0, 0, sess_name)
        if st == "DONE" and needs_attn_flag:
            return (1, 0, float(entry["attn_ts"]), 0, 0, 0, 0, sess_name)
        is_cur = 0 if bool(entry["is_current"]) else 1
        neg_act = -int(entry["activity"])
        neg_att = -int(entry.get("last_attached", 0))
        neg_win = -int(entry.get("window_activity", 0))
        if st == "WORKING":
            return (2, 0, 0.0, is_cur, neg_act, neg_att, neg_win, sess_name)
        if st == "QUOTA":
            return (2, 1, 0.0, is_cur, neg_act, neg_att, neg_win, sess_name)
        if st == "SHELL":
            return (4, 0, 0.0, is_cur, neg_act, neg_att, neg_win, sess_name)
        return (3, 0, 0.0, is_cur, neg_act, neg_att, neg_win, sess_name)

    fleet.sort(key=_fleet_sort_key)

    if include_git:
        by_worktree: dict[str, list[dict[str, object]]] = {}
        for entry in fleet:
            wt = str(entry.get("worktree_root") or "")
            if wt:
                by_worktree.setdefault(wt, []).append(entry)
        for peers in by_worktree.values():
            if len(peers) >= 2 and any(str(p["state"]) == "WORKING" for p in peers):
                for entry in peers:
                    entry["worktree_peers"] = [str(p["sess"]) for p in peers if p is not entry]

    if stale_cleanup_cmds:
        active_cnt = sum(1 for e in fleet if e["state"] == "WORKING")
        stale_cleanup_cmds.extend([
            ";",
            "set-option", "-gq", "@ide_fleet_count", str(len(fleet)),
            ";",
            "set-option", "-gq", "@ide_fleet_active", str(active_cnt),
            ";",
            "set-option", "-gq", "@ide_attn_summary", _format_attn_summary(fleet),
            ";",
            "refresh-client", "-S",
        ])
        run_tmux(*stale_cleanup_cmds)

    return fleet


def refresh_fleet_topbar() -> int:
    raw_sessions, server_up = _list_ide_sessions_with_server_status()
    if not server_up:
        return 0
    fleet = classify_ide_fleet(include_git=False, cur_sess="") if raw_sessions else []
    fleet_count = len(fleet)
    active_count = sum(1 for e in fleet if e["state"] == "WORKING")
    attn_summary = _format_attn_summary(fleet)

    run_tmux(
        "set-option", "-gq", "@ide_fleet_count", str(fleet_count),
        ";",
        "set-option", "-gq", "@ide_fleet_active", str(active_count),
        ";",
        "set-option", "-gq", "@ide_attn_summary", attn_summary,
        ";",
        "refresh-client", "-S",
    )
    return 0


def refresh_ide_sessions(target_arg: str, ide_self: str) -> int:
    raw_sessions, server_up = _list_ide_sessions_with_server_status()
    if target_arg:
        if not server_up:
            print(f"Error: {missing_session_msg(target_arg)}", file=sys.stderr)
            return 1
        sess = resolve_target_session(target_arg)
        if not sess or not session_exists(sess) or not check_is_ide_session(sess):
            print(f"Error: {missing_session_msg(sess or target_arg)}", file=sys.stderr)
            return 1
        target_items = [item for item in raw_sessions if item["sess"] == sess]
    else:
        if not server_up or not raw_sessions:
            print("No active IDE sessions.")
            return 0
        target_items = raw_sessions

    tmux_conf = os.path.expanduser("~/.tmux.conf")
    if os.path.isfile(tmux_conf):
        run_tmux("source-file", tmux_conf)

    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    active_theme_file = os.path.join(xdg_cfg, "home-settings", "active-theme.theme")
    tmux_theme_conf = os.path.join(xdg_cfg, "home-settings", "tmux-theme.conf")
    if os.path.isfile(active_theme_file):
        theme_id = ""
        try:
            with open(active_theme_file, "r", encoding="utf-8") as fh:
                for line in fh:
                    s = line.strip()
                    if s.startswith("THEME_ID="):
                        theme_id = s.split("=", 1)[1].strip().strip('"').strip("'")
                        break
        except OSError:
            pass
        if theme_id:
            sib_theme = os.path.join(os.path.dirname(os.path.abspath(ide_self)), "theme") if ide_self else ""
            theme_bin = (
                sib_theme
                if (sib_theme and os.path.isfile(sib_theme) and os.access(sib_theme, os.X_OK))
                else (shutil.which("theme") or "")
            )
            if theme_bin:
                try:
                    subprocess.run(
                        [theme_bin, "--set", theme_id, "--no-live"],
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=5,
                        check=False,
                    )
                except (OSError, subprocess.SubprocessError):
                    pass
    if os.path.isfile(tmux_theme_conf):
        run_tmux("source-file", tmux_theme_conf)

    panes_res = run_tmux(
        "list-panes",
        "-a",
        "-F",
        "#{session_name}\t#{pane_id}\t#{pane_pid}\t#{pane_in_mode}\t#{@ide_role}\t#{pane_current_command}",
    )
    panes_by_sess: dict[str, list[tuple[str, str, str, str, str]]] = {}
    cand_shell_pids: set[int] = set()
    if panes_res.returncode == 0 and panes_res.stdout:
        for line in panes_res.stdout.splitlines():
            pcols = (line.split("\t") + [""] * 6)[:6]
            s_name, p_id, p_pid, p_mode, p_role, p_cmd = pcols
            panes_by_sess.setdefault(s_name, []).append((p_id, p_pid, p_mode, p_role, p_cmd))
            if p_pid.strip().isdigit():
                cand_shell_pids.add(int(p_pid.strip()))

    busy_pids = _pids_with_children(cand_shell_pids)
    has_nvim = bool(resolve_nvim_bin())
    home_dir = os.path.expanduser("~")
    editors_refreshed = 0
    shells_refreshed = 0

    for item in target_items:
        sess = item["sess"]
        fb_dir = ""
        for cand_d in (
            item.get("workdir", ""),
            item.get("init_root", ""),
            get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR"),
            get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT"),
            home_dir,
        ):
            if cand_d and os.path.isdir(cand_d):
                fb_dir = cand_d
                break

        sock = item.get("ide_sock", "") or get_ide_var(sess, "@ide_socket", "NVIM_IDE_SOCKET")
        if sock and is_socket_path(sock) and has_nvim:
            nvim_recover_and_checktime(sock, fb_dir)
            editors_refreshed += 1

        rec_term = get_ide_var(sess, "@ide_term_pane", "IDE_TERM_PANE")
        for p_id, p_pid, p_mode, p_role, p_cmd in panes_by_sess.get(sess, []):
            if p_role != "term" and p_id != rec_term:
                continue
            if p_mode.strip() == "1":
                continue
            cmd_name = os.path.basename(p_cmd.strip()).lstrip("-").lower()
            p_pid_int = int(p_pid.strip()) if p_pid.strip().isdigit() else 0
            if cmd_name in ("zsh", "bash") and p_pid_int > 0 and p_pid_int not in busy_pids:
                if cmd_name == "zsh":
                    reload_cmd = " [ -f ~/.zshrc-addendum ] && source ~/.zshrc-addendum; typeset -f _hs_recover_stale_cwd >/dev/null 2>&1 && _hs_recover_stale_cwd"
                else:
                    reload_cmd = " [ -f ~/.bashrc-addendum ] && source ~/.bashrc-addendum; declare -F _hs_recover_stale_cwd >/dev/null 2>&1 && _hs_recover_stale_cwd"
                run_tmux("send-keys", "-t", p_id, "C-u", reload_cmd, "C-m")
                shells_refreshed += 1

    refresh_fleet_topbar()
    msg = f"Refreshed {len(target_items)} IDE session(s) ({editors_refreshed} editor(s), {shells_refreshed} shell(s))"
    if os.environ.get("TMUX") or os.environ.get("IDE_CLIENT"):
        msg_sess = target_items[0]["sess"] if len(target_items) == 1 else current_ide_session()
        if msg_sess and session_exists(msg_sess):
            run_tmux("display-message", "-d", "2500", "-t", f"={msg_sess}:", msg)
        else:
            run_tmux("display-message", "-d", "2500", msg)
    print(msg)
    return 0


def _session_has_focused_client(sess: str) -> bool:
    if not sess:
        return False
    out = tmux_out("list-clients", "-t", f"={sess}", "-F", "#{client_flags}")
    if not out:
        return False
    for line in out.splitlines():
        flags = {tok.strip() for tok in line.split(",") if tok.strip()}
        if "focused" in flags:
            return True
    return False


def _inspect_session_ai_view(sess: str) -> dict[str, object]:
    raw = tmux_out(
        "display-message",
        "-p",
        "-t",
        f"={sess}:",
        "#{window_id}\t#{window_name}\t#{window_zoomed_flag}\t#{@ide_role}\t#{@ide_main_win}\t#{@ide_ai_parked}\t#{@ide_ai_state}\t#{@ide_ai_attn}\t#{@ide_ai_attn_ts}\t#{@ide_ai_state_ts}\t#{@ide_ai_cli}\t#{@ide_workdir}\t#{@ide_initial_root}",
    )
    parts = (raw.split("\t") + [""] * 13)[:13]
    (
        win_id,
        wname,
        zoomed,
        prole,
        main_win,
        ai_parked,
        ai_state,
        ai_attn,
        ai_attn_ts,
        ai_state_ts,
        ai_cli,
        workdir,
        init_root,
    ) = (p.strip() for p in parts)
    has_focus = _session_has_focused_client(sess)
    ai_visible = (
        has_focus
        and not wname.startswith("_ide_park_")
        and (not main_win or win_id == main_win)
        and ai_parked != "1"
        and not (zoomed == "1" and prole != "ai")
    )
    ai_focused = ai_visible and prole == "ai"
    return {
        "ai_visible": ai_visible,
        "ai_focused": ai_focused,
        "ai_state": ai_state.lower(),
        "ai_attn": ai_attn,
        "ai_attn_ts": ai_attn_ts,
        "ai_state_ts": ai_state_ts,
        "ai_cli": ai_cli or "agy",
        "workdir": workdir or init_root,
    }


_HOOK_NOTIF_TYPE_RE = re.compile(r'"(?:notification_type|type)"\s*:\s*"([^"\\]+)"')


def _drain_hook_stdin(max_keep_bytes: int = 1048576, max_drain_bytes: int = 16777216) -> str:
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return ""
        fd = sys.stdin.fileno()
    except (OSError, ValueError, AttributeError):
        return ""
    chunks: list[bytes] = []
    kept = 0
    drained = 0
    started_json = False
    ended_json = False
    timeout = 0.02
    while drained < max_drain_bytes:
        try:
            ready, _, _ = select.select([fd], [], [], timeout)
        except (OSError, ValueError):
            break
        if not ready:
            break
        try:
            data = os.read(fd, min(65536, max_drain_bytes - drained))
        except OSError:
            break
        if not data:
            break
        if drained == 0:
            s_lead = data.lstrip()
            started_json = s_lead.startswith(b"{")
        drained += len(data)
        s_tail = data.rstrip()
        if s_tail:
            ended_json = s_tail.endswith(b"}")
        if kept < max_keep_bytes:
            take = data[: max_keep_bytes - kept]
            chunks.append(take)
            kept += len(take)
        timeout = 0.05 if (started_json and not ended_json) else 0.005
    return b"".join(chunks).decode("utf-8", errors="replace") if chunks else ""


def _parse_hook_metadata(stdin_raw: str, json_args: list[str]) -> tuple[str, str]:
    notif_type = ""
    msg = ""
    candidates: list[str] = list(json_args)
    if stdin_raw.strip():
        candidates.append(stdin_raw.strip())
    for raw in candidates:
        s = raw.strip()
        if not s.startswith("{"):
            continue
        obj = None
        if s.endswith("}"):
            try:
                parsed = json.loads(s)
                if isinstance(parsed, dict):
                    obj = parsed
            except ValueError:
                obj = None
        if obj is not None:
            if not notif_type:
                nt = obj.get("notification_type") or obj.get("type") or ""
                if isinstance(nt, str) and nt.strip():
                    notif_type = nt.strip().lower()
            if not msg:
                for k in ("message", "last-assistant-message", "last_assistant_message", "summary", "title"):
                    val = obj.get(k)
                    if isinstance(val, str) and val.strip():
                        cleaned = " ".join(val.split())
                        msg = (cleaned[:199] + "…") if len(cleaned) > 200 else cleaned
                        break
        elif not notif_type:
            m_nt = _HOOK_NOTIF_TYPE_RE.search(s)
            if m_nt and m_nt.group(1).strip():
                notif_type = m_nt.group(1).strip().lower()
    return (notif_type, msg)


def _resolve_ide_notify_policy(sess: str) -> str:
    raw = ""
    if "IDE_NOTIFY" in os.environ and os.environ["IDE_NOTIFY"].strip() != "":
        raw = os.environ["IDE_NOTIFY"]
    elif "IDE_NOTIFY" in os.environ and not os.environ.get("TMUX"):
        raw = os.environ["IDE_NOTIFY"]
    else:
        seen_in_sess = False
        if sess:
            sess_line = tmux_out("show-environment", "-t", f"={sess}", "IDE_NOTIFY").strip()
            if sess_line == "-IDE_NOTIFY":
                seen_in_sess = True
                raw = ""
            elif sess_line.startswith("IDE_NOTIFY="):
                seen_in_sess = True
                raw = sess_line[len("IDE_NOTIFY="):]
        if not seen_in_sess:
            glob_line = tmux_out("show-environment", "-g", "IDE_NOTIFY").strip()
            if glob_line.startswith("IDE_NOTIFY="):
                raw = glob_line[len("IDE_NOTIFY="):]
    norm = raw.strip().lower()
    if norm in ("1", "true", "on", "yes", "unfocused"):
        return "unfocused"
    if norm == "always":
        return "always"
    return "off"


def _spawn_detached(cmd: list[str], env: dict[str, str] | None = None) -> bool:
    try:
        subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
            env=env,
        )
        return True
    except OSError:
        return False


def _escape_terminal_notifier(text: str) -> str:
    if text and text[0] in '[({<"\\':
        return "\\" + text
    return text


def _dispatch_agent_notification(
    state: str,
    sess: str,
    message: str,
    ai_visible: bool,
    ai_cli: str = "",
    workdir: str = "",
) -> None:
    eff_cli = ai_cli or get_ide_var(sess, "@ide_ai_cli", "IDE_AI_CLI") or "agy"
    eff_workdir = (
        workdir
        or get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
        or get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
        or ""
    )
    title = f"IDE [{sess}] · Approval needed" if state == "approval" else f"IDE [{sess}] · Turn complete"
    clean_msg = " ".join(message.split()) if message else ""
    if len(clean_msg) > 200:
        clean_msg = clean_msg[:199] + "…"
    body = clean_msg or (
        f"{eff_cli} is waiting for input in {sess}"
        if state == "approval"
        else f"{eff_cli} finished turn in {sess}"
    )

    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    rules = os.environ.get("IDE_LINK_RULES") or os.path.join(xdg_cfg, "ide", "links.sh")
    has_notify_hook = False
    try:
        with open(rules, "r", encoding="utf-8") as fh:
            has_notify_hook = "ide_notify" in fh.read()
    except OSError:
        has_notify_hook = False
    if has_notify_hook:
        _spawn_detached([
            "bash",
            "-c",
            '. "$1" && declare -F ide_notify >/dev/null && ide_notify "$2" "$3" "$4" "$5" "$6" "$7"',
            "ide",
            rules,
            state,
            sess,
            eff_cli,
            eff_workdir,
            title,
            body,
        ])

    policy = _resolve_ide_notify_policy(sess)
    if policy == "off" or is_ssh_session(sess):
        return
    if policy == "unfocused" and ai_visible:
        return

    sync_id = f"ide-{sess}"
    if sys.platform == "darwin":
        tn_bin = shutil.which("terminal-notifier")
        osa_bin = shutil.which("osascript")
        tn_title = _escape_terminal_notifier(title)
        tn_body = _escape_terminal_notifier(body)
        osa_script = "on run argv\ndisplay notification (item 2 of argv) with title (item 1 of argv)\nend run"
        if tn_bin and osa_bin:
            _spawn_detached([
                "sh",
                "-c",
                '"$1" -title "$2" -message "$3" -group "$4" || "$5" -e "$6" -- "$7" "$8"',
                "ide-notify",
                tn_bin,
                tn_title,
                tn_body,
                sync_id,
                osa_bin,
                osa_script,
                title,
                body,
            ])
        elif tn_bin:
            _spawn_detached([tn_bin, "-title", tn_title, "-message", tn_body, "-group", sync_id])
        elif osa_bin:
            _spawn_detached([osa_bin, "-e", osa_script, "--", title, body])
        return

    discover_display_env(sess)
    if not (
        os.environ.get("DBUS_SESSION_BUS_ADDRESS")
        or os.environ.get("DISPLAY")
        or os.environ.get("WAYLAND_DISPLAY")
    ):
        return
    esc_body = html.escape(body, quote=False)
    busctl_bin = shutil.which("busctl")
    nsend_bin = shutil.which("notify-send")
    env_copy = os.environ.copy()
    if busctl_bin and nsend_bin:
        _spawn_detached(
            [
                "sh",
                "-c",
                '"$1" --user --auto-start=no -- call org.freedesktop.Notifications /org/freedesktop/Notifications '
                'org.freedesktop.Notifications Notify \'susssasa{sv}i\' ide 0 "" "$2" "$3" 0 2 urgency y 1 '
                'x-canonical-private-synchronous s "$4" -1 || '
                '"$5" -a ide -u normal -h "string:x-canonical-private-synchronous:$4" -- "$2" "$3"',
                "ide-notify",
                busctl_bin,
                title,
                esc_body,
                sync_id,
                nsend_bin,
            ],
            env=env_copy,
        )
    elif busctl_bin:
        _spawn_detached(
            [
                busctl_bin,
                "--user",
                "--auto-start=no",
                "--",
                "call",
                "org.freedesktop.Notifications",
                "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications",
                "Notify",
                "susssasa{sv}i",
                "ide",
                "0",
                "",
                title,
                esc_body,
                "0",
                "2",
                "urgency",
                "y",
                "1",
                "x-canonical-private-synchronous",
                "s",
                sync_id,
                "-1",
            ],
            env=env_copy,
        )
    elif nsend_bin:
        _spawn_detached(
            [
                nsend_bin,
                "-a",
                "ide",
                "-u",
                "normal",
                "-h",
                f"string:x-canonical-private-synchronous:{sync_id}",
                "--",
                title,
                esc_body,
            ],
            env=env_copy,
        )


def set_agent_state(
    raw_state: str,
    target_arg: str,
    message: str = "",
    json_args: list[str] | None = None,
) -> int:
    stdin_raw = _drain_hook_stdin()
    state = raw_state.strip().lower()
    if state not in ("running", "approval", "quota", "done", "idle"):
        print(
            f"Error: Invalid '--agent-state' value '{raw_state}'. Expected: running, approval, quota, done, or idle.",
            file=sys.stderr,
        )
        return 1

    notif_type, meta_msg = _parse_hook_metadata(stdin_raw, json_args or [])
    if notif_type == "idle_prompt":
        return 0

    if target_arg:
        sess = resolve_target_session(target_arg)
        if not sess or not session_exists(sess) or not check_is_ide_session(sess):
            print(f"Error: {missing_session_msg(sess or target_arg)}", file=sys.stderr)
            return 1
    else:
        if not os.environ.get("TMUX"):
            return 0
        sess = current_ide_session()
        if not sess or not session_exists(sess):
            return 0

    view = _inspect_session_ai_view(sess)
    prev_state = str(view["ai_state"])
    prev_attn = "1" if str(view["ai_attn"]) == "1" else "0"
    cur_ts = str(view["ai_attn_ts"])
    cur_state_ts = str(view["ai_state_ts"])
    ai_visible = bool(view["ai_visible"])
    ai_focused = bool(view["ai_focused"])
    now = time.time()
    state_ts_val = cur_state_ts if (prev_state == state and cur_state_ts) else str(int(now))

    if state == "approval":
        next_attn = "1"
        attn_ts_val = cur_ts if (prev_attn == "1" and cur_ts) else f"{now:.6f}"
    elif state == "done":
        if ai_focused:
            next_attn = "0"
            attn_ts_val = ""
        else:
            next_attn = "1"
            attn_ts_val = cur_ts if (prev_attn == "1" and cur_ts) else f"{now:.6f}"
    else:
        next_attn = "0"
        attn_ts_val = ""

    run_tmux(
        "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state", state,
        ";",
        "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn", next_attn,
        ";",
        "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn_ts", attn_ts_val,
        ";",
        "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state_ts", state_ts_val,
    )

    refresh_fleet_topbar()
    if next_attn == "1" and state in ("approval", "done") and (prev_state != state or prev_attn != "1"):
        _dispatch_agent_notification(
            state,
            sess,
            message.strip() or meta_msg,
            ai_visible,
            ai_cli=str(view["ai_cli"]),
            workdir=str(view["workdir"]),
        )
    return 0


def ack_ai_session(
    targets: list[str] | str,
    from_hook: bool = False,
    refresh_always: bool = True,
    entering_ai: bool = False,
) -> int:
    raw_list = [targets] if isinstance(targets, str) else list(targets)
    cleaned_targets = [t for t in raw_list if t]
    resolved_sessions: list[str] = []
    if cleaned_targets:
        for t_arg in cleaned_targets:
            cand = resolve_target_session(t_arg)
            if cand and cand not in resolved_sessions:
                resolved_sessions.append(cand)
    elif os.environ.get("TMUX"):
        cur = current_ide_session()
        if cur:
            resolved_sessions.append(cur)

    should_refresh = refresh_always
    batch_cmds: list[str] = []
    now_s = str(int(time.time()))

    for sess in resolved_sessions:
        if not (sess and session_exists(sess) and check_is_ide_session(sess)):
            continue
        view = _inspect_session_ai_view(sess)
        ai_focused = bool(view["ai_focused"])
        ai_state = str(view["ai_state"])
        ai_attn = str(view["ai_attn"])
        cur_state_ts = str(view["ai_state_ts"])
        can_ack = ai_focused if from_hook else True
        direct_ai = ai_focused or entering_ai
        if can_ack and (
            ai_attn not in ("", "0")
            or ai_state == "done"
            or (ai_state == "approval" and direct_ai)
        ):
            if ai_state == "done":
                next_state = "idle"
            elif ai_state == "approval":
                next_state = "idle" if direct_ai else "approval"
            else:
                next_state = ai_state
            next_state_ts = (
                cur_state_ts
                if (next_state == ai_state and cur_state_ts)
                else (now_s if next_state else "")
            )
            if batch_cmds:
                batch_cmds.append(";")
            batch_cmds.extend([
                "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state", next_state,
                ";",
                "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn", "0",
                ";",
                "set-option", "-q", "-t", f"={sess}:", "@ide_ai_attn_ts", "",
                ";",
                "set-option", "-q", "-t", f"={sess}:", "@ide_ai_state_ts", next_state_ts,
            ])
            should_refresh = True
        elif ai_state in ("running", "quota", "approval", "done") or ai_attn not in ("", "0"):
            should_refresh = True

    if batch_cmds:
        run_tmux(*batch_cmds)
    if should_refresh:
        refresh_fleet_topbar()
    return 0


def open_session_pr(target_arg: str) -> int:
    if target_arg:
        sess = resolve_target_session(target_arg)
    elif os.environ.get("TMUX"):
        sess = current_ide_session()
    else:
        sess = ""
    if not sess or not session_exists(sess) or not check_is_ide_session(sess):
        print(f"Error: {missing_session_msg(sess or target_arg)}", file=sys.stderr)
        return 1
    workdir = (
        get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
        or get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
        or tmux_out("display-message", "-p", "-t", f"={sess}:", "#{pane_current_path}").strip()
    )
    _, _, _, raw_pr_url, _ = _git_summary(workdir)
    pr_url = _sanitize_http_url(raw_pr_url)
    if not pr_url:
        msg = f"No cached PR/MR URL for session '{sess}'."
        if os.environ.get("TMUX") or os.environ.get("IDE_CLIENT"):
            ide_client = _resolve_active_client()
            if ide_client:
                run_tmux("display-message", "-c", ide_client, "-d", "2500", msg)
            else:
                run_tmux("display-message", "-d", "2500", "-t", f"={sess}:", msg)
        else:
            print(msg, file=sys.stderr)
        return 1
    discover_display_env(sess)
    return 0 if open_browser_url(pr_url, sess) else 1


def next_attention(target_arg: str) -> int:
    resolved_arg = resolve_target_session(target_arg) if target_arg else ""
    origin_sess = resolved_arg if (resolved_arg and session_exists(resolved_arg)) else current_ide_session()
    fleet = classify_ide_fleet(include_git=False, cur_sess=origin_sess)
    attn_entries = [e for e in fleet if bool(e["needs_attn"])]
    if not attn_entries:
        refresh_fleet_topbar()
        if os.environ.get("TMUX") or os.environ.get("IDE_CLIENT"):
            run_tmux("display-message", "No IDE agents waiting for attention.")
        else:
            print("No IDE agents waiting for attention.")
        return 0

    oldest = str(attn_entries[0]["sess"])
    toggle_main_pane("focus-ai", oldest)
    ack_ai_session([oldest], from_hook=False, refresh_always=True, entering_ai=True)
    return switch_or_attach_session(oldest, origin_sess)


def list_ide_fleet(plain: bool = False) -> int:
    cur_sess = current_ide_session()
    if plain:
        fleet_plain = classify_ide_fleet(include_git=False, cur_sess=cur_sess)
        for entry in fleet_plain:
            print(str(entry["sess"]))
        return 0

    fleet = classify_ide_fleet(include_git=True, cur_sess=cur_sess)
    if not fleet:
        print("No active IDE sessions.")
        return 0

    use_color = sys.stdout.isatty() and not bool(os.environ.get("NO_COLOR"))
    _, esc = load_active_palette()
    state_labels = [str(e.get("state_label") or e["state"]) for e in fleet]
    sess_w = max(7, min(28, max(_visible_width(str(e["sess"])) for e in fleet)))
    cli_w = max(5, min(12, max(_visible_width(str(e["ai_cli"])) for e in fleet)))
    state_w = max(5, min(16, max(_visible_width(lbl) for lbl in state_labels)))
    git_labels = [
        f"{e['git_branch']}{'*' if e['git_dirty'] else ''}" if e["git_branch"] != "-" else "-"
        for e in fleet
    ]
    git_w = max(6, min(28, max(_visible_width(g) for g in git_labels)))

    if use_color:
        c_hdr = esc["BASE01"]
        c_rst = esc["RESET"]
        print(
            f"  {c_hdr}{'SESSION':<{sess_w}}  {'AGENT':<{cli_w}}  {'STATE':<{state_w}}  {'BRANCH':<{git_w}}  WORKSPACE{c_rst}"
        )
    else:
        print(f"  {'SESSION':<{sess_w}}  {'AGENT':<{cli_w}}  {'STATE':<{state_w}}  {'BRANCH':<{git_w}}  WORKSPACE")

    for entry, st_lbl, git_lbl in zip(fleet, state_labels, git_labels):
        sess = str(entry["sess"])
        ai_cli = str(entry["ai_cli"])
        state = str(entry["state"])
        short_path = str(entry["short_path"])
        is_cur = bool(entry["is_current"])
        needs_attn = bool(entry["needs_attn"])
        has_wt_warn = bool(entry.get("worktree_peers"))
        s_pad = _pad_visible(_trunc_visible(sess, sess_w), sess_w)
        c_pad = _pad_visible(_trunc_visible(ai_cli, cli_w), cli_w)
        st_pad = _pad_visible(_trunc_visible(st_lbl, state_w), state_w)
        g_pad = _pad_visible(_trunc_visible(git_lbl, git_w), git_w)
        if use_color:
            attn_c = esc["GREEN"] if state == "DONE" else esc["ORANGE"]
            if is_cur:
                marker = f"{esc['CYAN']}▸{esc['RESET']}"
            elif needs_attn:
                marker = f"{attn_c}󰂚{esc['RESET']}"
            else:
                marker = " "
            c_sess = esc["BASE1"] if is_cur else (attn_c if needs_attn else esc["BLUE"])
            c_state = _state_color(state, esc)
            c_git = esc["YELLOW"] if bool(entry["git_dirty"]) else (esc["GREEN"] if git_lbl != "-" else esc["BASE01"])
            wt_sfx = f" {esc['YELLOW']}!{esc['RESET']}" if has_wt_warn else ""
            print(
                f"{marker} {c_sess}{s_pad}{esc['RESET']}  "
                f"{esc['BASE0']}{c_pad}{esc['RESET']}  "
                f"{c_state}{st_pad}{esc['RESET']}  "
                f"{c_git}{g_pad}{esc['RESET']}  "
                f"{esc['BASE0']}{short_path}{esc['RESET']}{wt_sfx}"
            )
        else:
            marker = "*" if is_cur else ("!" if needs_attn else " ")
            wt_sfx = " !" if has_wt_warn else ""
            print(f"{marker} {s_pad}  {c_pad}  {st_pad}  {g_pad}  {short_path}{wt_sfx}")
    return 0


def build_sessions_lines(cur_sess: str = "") -> list[str]:
    if cur_sess and not session_exists(cur_sess):
        cur_sess = ""
    if not cur_sess:
        cl = os.environ.get("IDE_CLIENT", "").strip()
        if cl and not cl.startswith("#{"):
            cand = tmux_out("display-message", "-p", "-c", cl, "#{session_name}").strip()
            if cand and check_is_ide_session(cand):
                cur_sess = cand
        if not cur_sess:
            cur_sess = current_ide_session()
    fleet = classify_ide_fleet(include_git=True, cur_sess=cur_sess)
    if not fleet:
        return []
    _, esc = load_active_palette()
    state_labels = [str(e.get("state_label") or e["state"]) for e in fleet]
    sess_w = max(8, min(24, max(_visible_width(str(e["sess"])) for e in fleet)))
    cli_w = max(5, min(10, max(_visible_width(str(e["ai_cli"])) for e in fleet)))
    state_w = max(5, min(16, max(_visible_width(lbl) for lbl in state_labels)))
    git_labels = [
        f"{e['git_branch']}{'*' if e['git_dirty'] else ''}" if e["git_branch"] != "-" else "-"
        for e in fleet
    ]
    git_w = max(6, min(24, max(_visible_width(g) for g in git_labels)))
    rows: list[str] = []
    for entry, st_lbl, git_lbl in zip(fleet, state_labels, git_labels):
        sess = str(entry["sess"])
        ai_cli = str(entry["ai_cli"])
        state = str(entry["state"])
        short_path = str(entry["short_path"])
        is_cur = bool(entry["is_current"])
        needs_attn = bool(entry["needs_attn"])
        has_wt_warn = bool(entry.get("worktree_peers"))
        attn_c = esc["GREEN"] if state == "DONE" else esc["ORANGE"]
        s_pad = _pad_visible(_trunc_visible(sess, sess_w), sess_w)
        c_pad = _pad_visible(_trunc_visible(ai_cli, cli_w), cli_w)
        st_pad = _pad_visible(_trunc_visible(st_lbl, state_w), state_w)
        g_pad = _pad_visible(_trunc_visible(git_lbl, git_w), git_w)
        if is_cur:
            marker = f"{esc['CYAN']}▸{esc['RESET']}"
        elif needs_attn:
            marker = f"{attn_c}󰂚{esc['RESET']}"
        else:
            marker = " "
        c_sess = esc["BASE1"] if is_cur else (attn_c if needs_attn else esc["BLUE"])
        c_state = _state_color(state, esc)
        c_git = esc["YELLOW"] if bool(entry["git_dirty"]) else (esc["GREEN"] if git_lbl != "-" else esc["BASE01"])
        wt_sfx = f" {esc['YELLOW']}!{esc['RESET']}" if has_wt_warn else ""
        display = (
            f"{marker} {c_sess}{s_pad}{esc['RESET']}  "
            f"{esc['BASE0']}{c_pad}{esc['RESET']}  "
            f"{c_state}{st_pad}{esc['RESET']}  "
            f"{c_git}{g_pad}{esc['RESET']}  "
            f"{esc['BASE01']}{short_path}{esc['RESET']}{wt_sfx}"
        )
        rows.append(f"{sess}\t{display}")
    return rows


def render_session_preview(target_arg: str) -> int:
    sess = target_arg.strip()
    if not sess or not session_exists(sess):
        print("Session is no longer active.")
        return 0
    fleet = classify_ide_fleet(include_git=True, cur_sess=current_ide_session(), git_only_sess=sess)
    entry = next((e for e in fleet if str(e["sess"]) == sess), None)
    _, esc = load_active_palette()
    c_rst = esc["RESET"]
    if entry is None:
        print(f"{esc['BLUE']}{sess}{c_rst}")
        return 0

    ai_cli = str(entry["ai_cli"])
    state = str(entry["state"])
    state_label = str(entry.get("state_label") or state)
    short_path = str(entry["short_path"])
    git_branch = str(entry["git_branch"])
    git_detail = str(entry["git_detail"])
    preview_pane = str(entry["preview_pane"])
    active_role = str(entry["active_role"])
    peers = [str(p) for p in (entry.get("worktree_peers") or [])]
    c_state = _state_color(state, esc)
    c_git = esc["YELLOW"] if bool(entry["git_dirty"]) else (esc["GREEN"] if git_branch != "-" else esc["BASE01"])
    rule = "─" * 56

    print(f"{esc['BLUE']} {sess}{c_rst}  {esc['BASE01']}(focused: {active_role}){c_rst}")
    print(f"{esc['BASE01']}Agent    :{c_rst} {esc['CYAN']}{ai_cli}{c_rst}  {esc['BASE01']}State:{c_rst} {c_state}{state_label}{c_rst}")
    print(f"{esc['BASE01']}Workspace:{c_rst} {esc['BASE0']}{short_path}{c_rst}")
    print(f"{esc['BASE01']}Git      :{c_rst} {c_git}{git_detail}{c_rst}")
    if peers:
        print(f"{esc['BASE01']}Warning  :{c_rst} {esc['YELLOW']}Shared worktree with {', '.join(peers)}{c_rst}")
    print(f"{esc['BASE01']}{rule}{c_rst}")

    if preview_pane and pane_exists(preview_pane):
        cap = tmux_out("capture-pane", "-e", "-p", "-S", "-40", "-t", preview_pane)
        cap_lines = cap.splitlines()
        while cap_lines and not _SGR_RE.sub("", cap_lines[-1]).strip():
            cap_lines.pop()
        tail = cap_lines[-35:]
        if tail:
            print("\n".join(tail) + c_rst)
        else:
            print(f"{esc['BASE01']}(Viewport is empty){c_rst}")
    else:
        print(f"{esc['BASE01']}(No active pane in session){c_rst}")
    return 0


def _most_recent_client(target: str) -> str:
    if not target:
        return ""
    tmux_target = target if target.startswith("$") else f"={target}"
    lines = tmux_out("list-clients", "-t", tmux_target, "-F", "#{client_activity}\t#{client_name}").splitlines()
    best_act = -1
    best_client = ""
    for line in lines:
        parts = line.split("\t", 1)
        if len(parts) == 2 and parts[1].strip():
            act = int(parts[0]) if parts[0].strip().isdigit() else 0
            if act >= best_act:
                best_act = act
                best_client = parts[1].strip()
    return best_client


def _resolve_active_client(origin_sess: str = "") -> str:
    ide_client = os.environ.get("IDE_CLIENT", "").strip()
    if ide_client and not ide_client.startswith("#{"):
        return ide_client
    if origin_sess:
        found = _most_recent_client(origin_sess)
        if found:
            return found
    tmux_env = os.environ.get("TMUX", "")
    if tmux_env:
        parts = tmux_env.split(",")
        if len(parts) >= 3:
            last_part = parts[-1].lstrip("$")
            if last_part:
                found = _most_recent_client(f"${last_part}")
                if found:
                    return found
    cl = tmux_out("display-message", "-p", "#{client_name}").strip()
    return "" if cl.startswith("#{") else cl


def switch_or_attach_session(target_sess: str, origin_sess: str = "") -> int:
    if not target_sess or not session_exists(target_sess):
        return 1
    if os.environ.get("TMUX") or os.environ.get("IDE_CLIENT"):
        ide_client = _resolve_active_client(origin_sess)
        if ide_client:
            res = run_tmux("switch-client", "-c", ide_client, "-t", f"={target_sess}")
            if res.returncode == 0:
                return 0
        if os.environ.get("TMUX"):
            run_tmux("switch-client", "-t", f"={target_sess}")
            return 0
    if os.environ.get("IDE_NO_ATTACH", "0") == "1" or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return 0
    os.execvp("tmux", ["tmux", "attach-session", "-t", f"={target_sess}"])
    return 0


def _collect_launcher_dirs() -> list[str]:
    dirs: list[str] = []
    seen: set[str] = set()
    zoxide_bin = os.environ.get("IDE_ZOXIDE_BIN") or shutil.which("zoxide")
    if zoxide_bin:
        try:
            res = subprocess.run(
                [zoxide_bin, "query", "-l"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2.0,
                check=False,
            )
            if res.returncode == 0 and res.stdout:
                for raw in res.stdout.splitlines():
                    cand = raw.strip()
                    if cand and os.path.isdir(cand):
                        norm = os.path.abspath(cand)
                        if norm not in seen:
                            seen.add(norm)
                            dirs.append(norm)
        except (OSError, subprocess.SubprocessError):
            pass

    if not dirs:
        home = os.path.expanduser("~")
        if os.path.isdir(home):
            try:
                for entry in sorted(os.listdir(home)):
                    if entry.startswith("."):
                        continue
                    cand = os.path.join(home, entry)
                    if os.path.isdir(cand):
                        norm = os.path.abspath(cand)
                        if norm not in seen:
                            seen.add(norm)
                            dirs.append(norm)
            except OSError:
                pass
            if not dirs:
                dirs.append(os.path.abspath(home))
    return dirs


def _pick_workspace_directory(fzf_bin: str, env: dict[str, str]) -> str:
    dirs = _collect_launcher_dirs()
    if not dirs:
        return ""
    _, esc = load_active_palette()
    rows = [f"{d}\t{esc['BLUE']}{_shorten_home(d)}{esc['RESET']}" for d in dirs]
    dir_args = [
        fzf_bin,
        "--ansi",
        "--delimiter=\t",
        "--with-nth=2..",
        "--layout=reverse",
        "--info=inline-right",
        "--prompt=New IDE > ",
        "--header=Enter: launch workspace  Esc: back to sessions",
    ]
    proc = subprocess.run(
        dir_args,
        input="\n".join(rows) + "\n",
        stdout=subprocess.PIPE,
        text=True,
        env=env,
        check=False,
    )
    if proc.returncode != 0 or not proc.stdout:
        return ""
    first = proc.stdout.splitlines()[0].split("\t", 1)[0].strip()
    return first if (first and os.path.isdir(first)) else ""


def run_sessions_picker(target_arg: str, ide_self: str) -> int:
    resolved_arg = resolve_target_session(target_arg) if target_arg else ""
    origin_sess = resolved_arg if (resolved_arg and session_exists(resolved_arg)) else ""
    cur_sess = origin_sess if (origin_sess and check_is_ide_session(origin_sess)) else current_ide_session()
    if os.environ.get("TMUX") and os.environ.get("IDE_IN_POPUP") != "1" and os.environ.get("IDE_NO_POPUP") != "1":
        client_name = _resolve_active_client(origin_sess or cur_sess)
        raw_cur = (
            tmux_out("display-message", "-p", "-c", client_name, "#{session_name}")
            if client_name
            else (origin_sess or tmux_out("display-message", "-p", "#{session_name}"))
        )
        if re.match(r"^(ai|agy)-", raw_cur):
            if client_name:
                run_tmux("detach-client", "-t", client_name)
            else:
                run_tmux("detach-client")
            return 0
        if client_name:
            popup_cmd = ["display-popup", "-c", client_name]
            inner_cmd = f"IDE_IN_POPUP=1 IDE_CLIENT={shlex.quote(client_name)} {shlex.quote(ide_self)} --sessions"
            if cur_sess:
                inner_cmd += f" {shlex.quote(cur_sess)}"
            popup_cmd.extend(["-E", "-w", "88%", "-h", "80%", inner_cmd])
            pop_res = run_tmux(*popup_cmd)
            if pop_res.returncode == 0 or not sys.stdin.isatty():
                return 0 if pop_res.returncode in (0, 130) else pop_res.returncode

    fzf_bin = os.environ.get("IDE_FZF_BIN") or shutil.which("fzf")
    if not fzf_bin:
        rows_plain = build_sessions_lines(cur_sess)
        if not rows_plain:
            if os.environ.get("TMUX"):
                run_tmux("display-message", "No active IDE sessions.")
            else:
                print("No active IDE sessions.")
            return 0
        return list_ide_fleet(plain=False)

    hex_map, _ = load_active_palette()
    env = build_fzf_env(hex_map)
    self_q = shlex.quote(ide_self)
    reload_cmd = f"{self_q} --sessions-lines" + (f" {shlex.quote(cur_sess)}" if cur_sess else "")
    quit_bind = f"ctrl-x:execute-silent({self_q} --quit {{+1}})+reload({reload_cmd})"
    ack_bind = f"ctrl-y:execute-silent({self_q} --ack-ai {{+1}})+reload({reload_cmd})"
    open_pr_bind = f"ctrl-o:execute-silent({self_q} --open-pr {{1}})"
    preview_cmd = f"{self_q} --session-preview {{1}}"
    fzf_args = [
        fzf_bin,
        "--ansi",
        "--delimiter=\t",
        "--with-nth=2..",
        "--multi",
        "--layout=reverse",
        "--info=inline-right",
        "--prompt=IDE > ",
        "--header=Enter: switch  C-a/e/t: pane  C-y: ack  C-o: PR  M-n: new  C-x: quit  C-r: reload  Alt+s: close",
        "--expect=ctrl-a,ctrl-e,ctrl-t,alt-n",
        "--bind=alt-s:abort",
        f"--bind=ctrl-r:reload({reload_cmd})",
        f"--bind={ack_bind}",
        f"--bind={open_pr_bind}",
        f"--bind={quit_bind}",
        f"--preview={preview_cmd}",
        "--preview-window=right:56%:wrap",
    ]

    while True:
        rows = build_sessions_lines(cur_sess)
        if not rows:
            if os.environ.get("TMUX"):
                run_tmux("display-message", "No active IDE sessions.")
            else:
                print("No active IDE sessions.")
            return 0

        proc = subprocess.run(
            fzf_args,
            input="\n".join(rows) + "\n",
            stdout=subprocess.PIPE,
            text=True,
            env=env,
            check=False,
        )
        out_lines = proc.stdout.splitlines() if proc.stdout else []
        first_key = out_lines[0].strip() if out_lines else ""
        if proc.returncode not in (0, 1) or (proc.returncode == 1 and first_key != "alt-n") or not out_lines:
            return 0
        if first_key in ("", "enter", "ctrl-a", "ctrl-e", "ctrl-t", "alt-n"):
            pressed = first_key
            selected_line = out_lines[1] if len(out_lines) > 1 else ""
        else:
            pressed = ""
            selected_line = out_lines[0]

        if pressed == "alt-n":
            chosen_dir = _pick_workspace_directory(fzf_bin, env)
            if not chosen_dir:
                continue
            target_sess = sanitize_session_name(os.path.abspath(chosen_dir))
            launch_res = subprocess.run(
                [ide_self, "--detach", chosen_dir],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if session_exists(target_sess):
                rc = switch_or_attach_session(target_sess, origin_sess or cur_sess)
                ack_ai_session([target_sess], from_hook=True, refresh_always=False)
                return rc
            return launch_res.returncode

        chosen_sess = selected_line.split("\t", 1)[0].strip()
        if not chosen_sess or not session_exists(chosen_sess):
            return 0

        if pressed == "ctrl-a":
            toggle_main_pane("focus-ai", chosen_sess)
        elif pressed == "ctrl-e":
            toggle_main_pane("focus-editor", chosen_sess)
        elif pressed == "ctrl-t":
            toggle_main_pane("focus-term", chosen_sess)

        rc = switch_or_attach_session(chosen_sess, origin_sess or cur_sess)
        ack_ai_session([chosen_sess], from_hook=True, refresh_always=False)
        return rc


_SEND_REF_SPEC_RE = re.compile(r"^(.*?)(?:[:#][Ll]?([0-9]+)(?:-[Ll]?([0-9]+))?)?$")


def _format_ai_ref(raw_ref: str, sess: str, ai_pane: str) -> str:
    stripped = raw_ref.strip()
    raw_ai_cwd = tmux_out("display-message", "-p", "-t", ai_pane, "#{pane_current_path}").strip()
    ai_cwd = normalize_pane_cwd(raw_ai_cwd, sess=sess)
    workdir = get_ide_var(sess, "@ide_workdir", "IDE_WORKDIR")
    init_root = get_ide_var(sess, "@ide_initial_root", "IDE_INITIAL_ROOT")
    cand_roots = [r for r in (ai_cwd, workdir, init_root) if r]
    base_cwd = ai_cwd or workdir or init_root

    def _existing_target(path_str: str) -> str:
        if not path_str:
            return ""
        if os.path.isabs(path_str):
            return path_str if os.path.exists(path_str) else ""
        for root in cand_roots:
            joined = os.path.join(root, path_str)
            if os.path.exists(joined):
                return joined
        if os.path.exists(path_str):
            return os.path.abspath(path_str)
        return ""

    exact_existing = _existing_target(stripped)
    if exact_existing:
        raw_path, l1_s, l2_s = exact_existing, None, None
    else:
        m = _SEND_REF_SPEC_RE.match(stripped)
        if not m:
            return f"@{stripped} "
        raw_path, l1_s, l2_s = m.group(1), m.group(2), m.group(3)
        if not raw_path:
            raw_path = stripped
            l1_s = l2_s = None

    suffix = ""
    if l1_s and l2_s:
        lo, hi = max(1, min(int(l1_s), int(l2_s))), max(1, max(int(l1_s), int(l2_s)))
        suffix = f"#L{lo}" if lo == hi else f"#L{lo}-L{hi}"
    elif l1_s:
        suffix = f"#L{max(1, int(l1_s))}"

    resolved_existing = _existing_target(raw_path)
    if resolved_existing:
        abs_path = os.path.abspath(resolved_existing)
    elif os.path.isabs(raw_path):
        abs_path = os.path.abspath(raw_path)
    elif base_cwd:
        abs_path = os.path.abspath(os.path.join(base_cwd, raw_path))
    else:
        abs_path = os.path.abspath(raw_path)

    if os.path.exists(abs_path):
        real_file = os.path.realpath(abs_path)
    else:
        parent_dir = os.path.dirname(abs_path)
        real_parent = os.path.realpath(parent_dir) if os.path.isdir(parent_dir) else parent_dir
        real_file = os.path.join(real_parent, os.path.basename(abs_path))

    real_base = os.path.realpath(base_cwd) if base_cwd and os.path.isdir(base_cwd) else base_cwd

    in_workspace = False
    for cand_root in cand_roots:
        real_root = os.path.realpath(cand_root) if os.path.isdir(cand_root) else os.path.abspath(cand_root)
        if real_root == "/":
            continue
        try:
            if os.path.commonpath([real_file, real_root]) == real_root:
                in_workspace = True
                break
        except ValueError:
            pass

    if in_workspace and real_base:
        try:
            rel_path = os.path.relpath(real_file, real_base)
            display_path = rel_path
        except ValueError:
            display_path = real_file
    else:
        display_path = real_file

    return f"@{display_path}{suffix} "


def send_to_ai(
    send_mode: str,
    send_payload: str,
    no_focus: bool,
    switch_session: bool,
    target_arg: str,
) -> int:
    if not send_mode:
        print("Error: '--send' requires '--stdin', '--ref <PATH>', or '--text <TEXT>'.", file=sys.stderr)
        return 1

    origin_sess = current_ide_session() if os.environ.get("TMUX") else ""
    sess = resolve_target_session(target_arg)
    if not sess or not session_exists(sess):
        print(f"Error: {missing_session_msg(sess)}", file=sys.stderr)
        return 1

    stdin_text = ""
    if send_mode == "stdin":
        stdin_text = sys.stdin.buffer.read().decode("utf-8", errors="replace")
        if not stdin_text:
            return 0
    elif send_mode == "ref":
        if not send_payload.strip():
            return 0
    elif not send_payload:
        return 0

    eff_no_focus = False if switch_session else no_focus
    prev_pane = tmux_out("display-message", "-p", "-t", f"={sess}:", "#{pane_id}") if eff_no_focus else ""
    if not eff_no_focus:
        toggle_main_pane("focus-ai", sess)
        ai_pane = resolve_role_pane(sess, "ai", "@ide_ai_pane", "IDE_AI_PANE")
    else:
        editor_pane = resolve_role_pane(sess, "editor", "@ide_editor_pane", "NVIM_IDE_PANE")
        ai_pane = resolve_role_pane(sess, "ai", "@ide_ai_pane", "IDE_AI_PANE")
        term_pane = resolve_role_pane(sess, "term", "@ide_term_pane", "IDE_TERM_PANE")
        main_win = resolve_main_win(sess, editor_pane, ai_pane, term_pane)
        if not pane_exists(ai_pane):
            toggle_main_pane("focus-ai", sess)
            ai_pane = resolve_role_pane(sess, "ai", "@ide_ai_pane", "IDE_AI_PANE")
            if pane_exists(prev_pane):
                run_tmux("select-pane", "-t", prev_pane)
        elif pane_is_parked(ai_pane, main_win):
            unpark_role_pane(sess, "ai", main_win, ai_pane, editor_pane, term_pane, "")
            if pane_exists(prev_pane):
                run_tmux("select-pane", "-t", prev_pane)

    if not pane_exists(ai_pane):
        print(f"Error: Could not resolve AI pane for session '{sess}'.", file=sys.stderr)
        return 1

    if send_mode == "stdin":
        payload = stdin_text
    elif send_mode == "ref":
        payload = _format_ai_ref(send_payload, sess, ai_pane)
    else:
        payload = send_payload

    if not payload:
        return 0

    buf_name = f"_ide_send_{os.getpid()}"
    with tempfile.NamedTemporaryFile(prefix="ide-send.", delete=False) as tf:
        tf.write(payload.encode("utf-8"))
        tmp_path = tf.name
    try:
        if run_tmux("load-buffer", "-b", buf_name, tmp_path).returncode == 0:
            if tmux_out("display-message", "-p", "-t", ai_pane, "#{pane_in_mode}") == "1":
                run_tmux("copy-mode", "-q", "-t", ai_pane)
            paste_res = run_tmux("paste-buffer", "-p", "-d", "-b", buf_name, "-t", ai_pane)
            if paste_res.returncode != 0:
                run_tmux("paste-buffer", "-d", "-b", buf_name, "-t", ai_pane)
            run_tmux("delete-buffer", "-b", buf_name)
    finally:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass

    if switch_session:
        rc = switch_or_attach_session(sess, origin_sess)
        ack_ai_session([sess], from_hook=True, refresh_always=False)
        return rc
    return 0


def _looks_like_json_obj(raw: str) -> bool:
    s = raw.strip()
    return len(s) >= 2 and s.startswith("{") and s.endswith("}")


def main() -> int:
    raw_self = os.environ.pop("IDE_SELF", "")
    ide_self = os.path.abspath(raw_self) if raw_self else ""
    os.environ["FORCE_HYPERLINK"] = "1"
    argv = sys.argv[1:]
    if not shutil.which("tmux"):
        if "--list" in argv and "--plain" in argv:
            return 0
        if not any(a in ("-h", "--help", "--keys", "--help-keys", "--monitor", "--top", "--btop") for a in argv):
            print("Error: 'tmux' is not installed. Run './setup.sh' to install core packages.", file=sys.stderr)
            return 1

    layout_mode = "3pane"
    action = "launch"
    detach_mode = os.environ.get("IDE_NO_ATTACH", "0") == "1"
    force_quit = False
    plain_list = False
    ai_cli = os.environ.get("IDE_AI_CLI") or "agy"
    ai_cli_from_flag = False
    target_arg = ""
    target_args: list[str] = []
    open_file = ""
    open_line = ""
    cd_target = ""
    swap_dir = ""
    status_click_x = ""
    link_href = ""
    link_word = ""
    link_cwd = ""
    send_mode = ""
    send_payload = ""
    send_no_focus = False
    send_switch = False
    agent_state_val = ""
    agent_message = ""
    agent_json_args: list[str] = []
    ack_from_hook = False
    end_of_opts = False

    i = 0
    n = len(argv)
    while i < n:
        arg = argv[i]
        if end_of_opts:
            if action == "send" and not send_mode:
                send_mode = "text"
                send_payload = arg
            elif action == "agent-state" and _looks_like_json_obj(arg):
                agent_json_args.append(arg)
            else:
                target_arg = arg
                target_args.append(arg)
            i += 1
        elif arg == "--":
            end_of_opts = True
            i += 1
        elif arg == "--2pane":
            layout_mode = "2pane"
            i += 1
        elif arg == "--3pane":
            layout_mode = "3pane"
            i += 1
        elif arg in ("--ai", "--agent"):
            if i + 1 >= n or argv[i + 1].startswith("-"):
                print(f"Error: '{arg}' requires an argument (agy, claude, or codex).", file=sys.stderr)
                return 1
            ai_cli = argv[i + 1]
            ai_cli_from_flag = True
            i += 2
        elif arg.startswith(("--ai=", "--agent=")):
            ai_cli = arg.split("=", 1)[1]
            ai_cli_from_flag = True
            i += 1
        elif arg in ("--open", "--preview") or arg.startswith(("--open=", "--preview=")):
            if "=" in arg:
                opt_flag, open_file = arg.split("=", 1)
                action = "open" if opt_flag == "--open" else "preview"
                if not open_file:
                    print(f"Error: '{opt_flag}' requires a file path.", file=sys.stderr)
                    return 1
                next_idx = i + 1
            else:
                action = "open" if arg == "--open" else "preview"
                if i + 1 >= n:
                    print(f"Error: '{arg}' requires a file path.", file=sys.stderr)
                    return 1
                open_file = argv[i + 1]
                next_idx = i + 2
            if next_idx < n and re.match(r"^\+?[1-9][0-9]*$", argv[next_idx]):
                cand_line = argv[next_idx]
                if cand_line.startswith("+") or next_idx + 1 < n or not session_exists(cand_line):
                    open_line = cand_line.lstrip("+")
                    next_idx += 1
            i = next_idx
        elif arg == "--cd" or (arg == "cd" and action == "launch"):
            action = "cd"
            if i + 1 < n:
                cd_target = argv[i + 1]
                i += 2
            else:
                cd_target = safe_getcwd()
                i += 1
        elif arg in ("-s", "--sessions"):
            action = "sessions"
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                i += 2
            else:
                i += 1
        elif arg == "--sessions-lines":
            action = "sessions-lines"
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                i += 2
            else:
                i += 1
        elif arg == "--session-preview":
            action = "session-preview"
            if i + 1 >= n:
                print("Error: '--session-preview' requires a session name.", file=sys.stderr)
                return 1
            target_arg = argv[i + 1]
            i += 2
        elif arg == "--agent-state":
            action = "agent-state"
            if i + 1 >= n or argv[i + 1].startswith("-"):
                print("Error: '--agent-state' requires a state (running, approval, quota, done, or idle).", file=sys.stderr)
                return 1
            agent_state_val = argv[i + 1]
            if i + 2 < n and not argv[i + 2].startswith("-"):
                cand = argv[i + 2]
                if _looks_like_json_obj(cand):
                    agent_json_args.append(cand)
                else:
                    target_arg = cand
                    target_args.append(cand)
                i += 3
            else:
                i += 2
        elif arg.startswith("--agent-state="):
            action = "agent-state"
            agent_state_val = arg.split("=", 1)[1]
            if not agent_state_val:
                print("Error: '--agent-state' requires a state (running, approval, quota, done, or idle).", file=sys.stderr)
                return 1
            if i + 1 < n and not argv[i + 1].startswith("-"):
                cand = argv[i + 1]
                if _looks_like_json_obj(cand):
                    agent_json_args.append(cand)
                else:
                    target_arg = cand
                    target_args.append(cand)
                i += 2
            else:
                i += 1
        elif arg == "--message":
            if i + 1 >= n:
                print("Error: '--message' requires a text string.", file=sys.stderr)
                return 1
            agent_message = argv[i + 1]
            i += 2
        elif arg.startswith("--message="):
            agent_message = arg.split("=", 1)[1]
            i += 1
        elif arg == "--hook":
            ack_from_hook = True
            i += 1
        elif arg == "--ack-ai":
            action = "ack-ai"
            i += 1
        elif arg == "--open-pr":
            action = "open-pr"
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                target_args.append(argv[i + 1])
                i += 2
            else:
                i += 1
        elif arg.startswith("--open-pr="):
            action = "open-pr"
            target_arg = arg.split("=", 1)[1]
            if target_arg:
                target_args.append(target_arg)
            i += 1
        elif arg == "--send":
            action = "send"
            i += 1
        elif arg == "--stdin":
            action = "send"
            send_mode = "stdin"
            i += 1
        elif arg == "--ref":
            if i + 1 >= n:
                print("Error: '--ref' requires a file path.", file=sys.stderr)
                return 1
            action = "send"
            send_mode = "ref"
            send_payload = argv[i + 1]
            i += 2
        elif arg.startswith("--ref="):
            action = "send"
            send_mode = "ref"
            send_payload = arg.split("=", 1)[1]
            i += 1
        elif arg == "--text":
            if i + 1 >= n:
                print("Error: '--text' requires a text string.", file=sys.stderr)
                return 1
            action = "send"
            send_mode = "text"
            send_payload = argv[i + 1]
            i += 2
        elif arg.startswith("--text="):
            action = "send"
            send_mode = "text"
            send_payload = arg.split("=", 1)[1]
            i += 1
        elif arg == "--no-focus":
            send_no_focus = True
            send_switch = False
            i += 1
        elif arg == "--switch":
            send_switch = True
            send_no_focus = False
            i += 1
        elif arg in (
            "--toggle",
            "--show-editor",
            "--focus-editor",
            "--focus-ai",
            "--focus-term",
            "--show-ai",
            "--show-term",
            "--toggle-editor",
            "--toggle-ai",
            "--toggle-term",
            "--next-attention",
            "--refresh-attn",
            "--run-ai-popup",
            "--paste",
        ):
            action = arg[2:]
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                target_args.append(argv[i + 1])
                i += 2
            else:
                i += 1
        elif arg in ("-r", "--refresh", "--reload") or (arg == "refresh" and action == "launch"):
            action = "refresh"
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                target_args.append(argv[i + 1])
                i += 2
            else:
                i += 1
        elif arg == "--kill" or (arg == "kill" and action == "launch"):
            action = "kill"
            i += 1
        elif arg in ("-q", "--quit") or (arg == "quit" and action == "launch"):
            action = "quit"
            i += 1
        elif arg == "--swap":
            action = "swap"
            if i + 1 >= n or argv[i + 1].startswith("-"):
                print("Error: '--swap' requires a direction (left, down, up, or right).", file=sys.stderr)
                return 1
            swap_dir = argv[i + 1]
            if i + 2 < n and not argv[i + 2].startswith("-"):
                target_arg = argv[i + 2]
                i += 3
            else:
                i += 2
        elif arg.startswith("--swap="):
            action = "swap"
            swap_dir = arg.split("=", 1)[1]
            if not swap_dir:
                print("Error: '--swap' requires a direction (left, down, up, or right).", file=sys.stderr)
                return 1
            if i + 1 < n and not argv[i + 1].startswith("-"):
                target_arg = argv[i + 1]
                i += 2
            else:
                i += 1
        elif arg in ("--keys", "--help-keys"):
            action = "keys"
            i += 1
        elif arg in ("--monitor", "--top", "--btop"):
            action = "monitor"
            i += 1
        elif arg == "--status-click":
            action = "status-click"
            status_click_x = argv[i + 1] if i + 1 < n else "0"
            target_arg = argv[i + 2] if i + 2 < n else ""
            i += 3 if i + 2 < n else (2 if i + 1 < n else 1)
        elif arg == "--copy":
            action = "copy"
            i += 1
        elif arg == "--open-link":
            action = "open-link"
            rem = argv[i + 1:]
            if (
                len(rem) >= 3
                and os.path.isdir(rem[2])
                and (
                    len(rem) >= 4
                    or not (os.path.isabs(rem[1]) and os.path.isdir(rem[1]) and not os.path.isabs(rem[2]))
                )
            ):
                link_href, link_word, link_cwd = rem[0], rem[1], rem[2]
                if len(rem) >= 4:
                    target_arg = rem[3]
                    i += 5
                else:
                    i += 4
            elif len(rem) >= 2 and os.path.isdir(rem[1]):
                link_href, link_word, link_cwd = "", rem[0], rem[1]
                if len(rem) >= 3:
                    target_arg = rem[2]
                    i += 4
                else:
                    i += 3
            elif len(rem) >= 1 and os.path.isdir(rem[0]):
                link_href, link_word, link_cwd = "", "", rem[0]
                if len(rem) >= 2:
                    target_arg = rem[1]
                    i += 3
                else:
                    i += 2
            else:
                link_href = rem[0] if len(rem) >= 1 else ""
                link_word = rem[1] if len(rem) >= 2 else ""
                link_cwd = rem[2] if len(rem) >= 3 else ""
                if len(rem) >= 4:
                    target_arg = rem[3]
                    i += 5
                else:
                    i += 1 + min(len(rem), 3)
        elif arg in ("-f", "--force"):
            force_quit = True
            i += 1
        elif arg == "--detach":
            detach_mode = True
            i += 1
        elif arg == "--list":
            action = "list"
            i += 1
        elif arg == "--plain":
            plain_list = True
            if action == "launch":
                action = "list"
            i += 1
        elif arg in ("-h", "--help"):
            usage(sys.stdout)
            return 0
        elif arg.startswith("-"):
            print(f"Error: Unknown option '{arg}'", file=sys.stderr)
            usage(sys.stderr)
            return 1
        else:
            if action == "send" and not send_mode:
                send_mode = "text"
                send_payload = arg
            elif action == "agent-state" and _looks_like_json_obj(arg):
                agent_json_args.append(arg)
            else:
                target_arg = arg
                target_args.append(arg)
            i += 1

    if ai_cli in ("agy", "claude", "codex"):
        os.environ["IDE_AI_CLI"] = ai_cli
    elif ai_cli == "openai":
        os.environ["IDE_AI_CLI"] = "codex"
    elif shutil.which(ai_cli) or (os.path.isfile(ai_cli) and os.access(ai_cli, os.X_OK)) or not ai_cli_from_flag:
        os.environ["IDE_AI_CLI"] = ai_cli
    else:
        print(
            f"Error: Invalid AI CLI '{ai_cli}'. Supported values are: agy, claude, codex (or an executable on PATH).",
            file=sys.stderr,
        )
        return 1

    if action == "keys":
        os.execvp("bash", ["bash", ide_self, "--keys"])
    if action == "monitor":
        os.execvp("bash", ["bash", ide_self, "--monitor"])
    if action == "status-click":
        return status_click(status_click_x, target_arg)
    if action == "sessions":
        return run_sessions_picker(target_arg, ide_self)
    if action == "sessions-lines":
        for row in build_sessions_lines(target_arg):
            print(row)
        return 0
    if action == "session-preview":
        return render_session_preview(target_arg)
    if action == "agent-state":
        return set_agent_state(agent_state_val, target_arg, message=agent_message, json_args=agent_json_args)
    if action == "ack-ai":
        return ack_ai_session(target_args or target_arg, from_hook=ack_from_hook, refresh_always=True)
    if action == "open-pr":
        return open_session_pr(target_arg)
    if action == "next-attention":
        return next_attention(target_arg)
    if action == "refresh-attn":
        return refresh_fleet_topbar()
    if action == "refresh":
        return refresh_ide_sessions(target_arg, ide_self)
    if action == "send":
        return send_to_ai(send_mode, send_payload, send_no_focus, send_switch, target_arg)

    # Populate DISPLAY / WAYLAND_DISPLAY / XAUTHORITY before dispatching --copy, --paste, --open-link, or launch
    if action in ("copy", "paste", "open-link"):
        discover_display_env(target_arg)
    elif action == "launch":
        discover_display_env(target_arg, ignore_tmux_env=not bool(os.environ.get("TMUX")))

    if action == "copy":
        copy_to_system_clipboard(target_arg)
        return 0
    if action == "paste":
        paste_from_system_clipboard(target_arg)
        return 0
    if action == "open-link":
        return open_ide_link(link_href, link_word, link_cwd, target_arg)
    if action == "open":
        return open_in_editor(open_file, True, target_arg, open_line)
    if action == "preview":
        return open_in_editor(open_file, False, target_arg, open_line)
    if action == "cd":
        return cd_ide_workspace(cd_target, target_arg)
    if action == "toggle":
        return toggle_main_pane("toggle", target_arg)
    if action == "show-editor":
        return toggle_main_pane("editor", target_arg)
    if action in ("focus-editor", "focus-ai", "focus-term"):
        return toggle_main_pane(action, target_arg)
    if action == "show-ai":
        return toggle_main_pane("ai", target_arg)
    if action == "show-term":
        return toggle_main_pane("term", target_arg)
    if action in ("toggle-editor", "toggle-ai", "toggle-term"):
        return toggle_main_pane(action, target_arg)
    if action == "swap":
        return swap_ide_pane(swap_dir, target_arg)
    if action == "run-ai-popup":
        run_ai_popup(target_arg)
        return 0
    if action == "quit":
        return quit_ide(target_args, force_quit, False)
    if action == "list":
        return list_ide_fleet(plain=plain_list)
    if action == "kill":
        return quit_ide(target_args, True, True)

    target_dir = target_arg or safe_getcwd()
    if not os.path.isdir(target_dir):
        print(f"Error: Directory '{target_dir}' does not exist.", file=sys.stderr)
        return 1
    target_dir = os.path.abspath(target_dir)

    session = sanitize_session_name(target_dir)
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    nvim_socket = f"{runtime_dir}/nvim-ide-{session}.sock"
    ide_ai_cli = os.environ["IDE_AI_CLI"]
    ide_notify_env = os.environ.get("IDE_NOTIFY", "")

    if not session_exists(session):
        try:
            os.unlink(nvim_socket)
        except OSError:
            pass

        term_sz = shutil.get_terminal_size(fallback=(160, 48))
        cols = term_sz.columns if term_sz.columns >= 80 else 160
        lines = term_sz.lines if term_sz.lines >= 24 else 48

        base_env_args = [
            "-e", f"IDE_SESSION={session}",
            "-e", f"IDE_AI_CLI={ide_ai_cli}",
            "-e", f"NVIM_IDE_SOCKET={nvim_socket}",
            "-e", f"IDE_INITIAL_ROOT={target_dir}",
            "-e", "FORCE_HYPERLINK=1",
        ]
        if ide_notify_env:
            base_env_args.extend(["-e", f"IDE_NOTIFY={ide_notify_env}"])
        init_info = tmux_out(
            "new-session", "-d", "-P", "-F", "#{pane_id}\t#{window_id}",
            "-s", session, "-n", "ide", "-c", target_dir, "-x", str(cols), "-y", str(lines),
            *base_env_args,
        )
        pane_ai, main_win = (init_info.split("\t", 1) + [""])[:2]
        pane_editor = tmux_out(
            "split-window", "-h", "-P", "-F", "#{pane_id}",
            "-t", pane_ai, "-l", "50%", "-c", target_dir,
            *base_env_args,
        )

        var_pairs = [
            ("@ide_session", "IDE_SESSION", session),
            ("@ide_ai_cli", "IDE_AI_CLI", ide_ai_cli),
            ("@ide_socket", "NVIM_IDE_SOCKET", nvim_socket),
            ("@ide_initial_root", "IDE_INITIAL_ROOT", target_dir),
            ("@ide_workdir", "IDE_WORKDIR", target_dir),
            ("@ide_main_win", "IDE_MAIN_WIN", main_win),
            ("@ide_editor_pane", "NVIM_IDE_PANE", pane_editor),
            ("@ide_ai_pane", "IDE_AI_PANE", pane_ai),
            ("@ide_layout_mode", "IDE_LAYOUT_MODE", layout_mode),
            ("@ide_ai_parked", "IDE_AI_PARKED", "0"),
            ("@ide_ed_parked", "IDE_ED_PARKED", "0"),
            ("@ide_term_parked", "IDE_TERM_PARKED", "0" if layout_mode == "3pane" else "1"),
            ("@ide_ai_state", "IDE_AI_STATE", ""),
            ("@ide_ai_attn", "IDE_AI_ATTN", "0"),
            ("@ide_ai_attn_ts", "IDE_AI_ATTN_TS", ""),
            ("@ide_ai_state_ts", "IDE_AI_STATE_TS", str(int(time.time()))),
            ("@ide_force_hyperlink", "FORCE_HYPERLINK", "1"),
        ]

        pane_term = ""
        if layout_mode == "3pane":
            pane_term = tmux_out(
                "split-window", "-f", "-v", "-P", "-F", "#{pane_id}",
                "-t", main_win, "-l", "25%", "-c", target_dir,
                *base_env_args, "-e", f"NVIM_IDE_PANE={pane_editor}",
            )
            var_pairs.append(("@ide_term_pane", "IDE_TERM_PANE", pane_term))

        role_cmds = [
            "set-option", "-w", "-t", main_win, "automatic-rename", "off",
            ";",
            "set-option", "-w", "-t", main_win, "allow-rename", "off",
            ";",
            "set-option", "-p", "-t", pane_ai, "@ide_role", "ai",
            ";",
            "set-option", "-p", "-t", pane_editor, "@ide_role", "editor",
        ]
        if pane_term:
            role_cmds.extend([";", "set-option", "-p", "-t", pane_term, "@ide_role", "term"])
        run_tmux(*role_cmds)
        set_ide_vars(session, var_pairs)

        readme = os.path.join(target_dir, "README.md")
        send_editor_launch_keys(pane_editor, nvim_socket, readme if os.path.isfile(readme) else "")

        ai_run_cmd = resolve_ai_cmd(ide_ai_cli)
        if ai_run_cmd:
            run_tmux("send-keys", "-t", pane_ai, f" {ai_run_cmd}", "C-m")

        run_tmux("select-window", "-t", main_win, ";", "select-pane", "-t", pane_ai)
    else:
        ed_pane_existing = resolve_role_pane(session, "editor", "@ide_editor_pane", "NVIM_IDE_PANE")
        if pane_exists(ed_pane_existing):
            ensure_editor_nvim_running(ed_pane_existing, nvim_socket)
        if ai_cli_from_flag:
            existing_ai_cli = get_ide_var(session, "@ide_ai_cli", "IDE_AI_CLI")
            set_ide_var(session, "@ide_ai_cli", "IDE_AI_CLI", ide_ai_cli)
            if ide_ai_cli != existing_ai_cli:
                set_ide_vars(
                    session,
                    [
                        ("@ide_ai_state", "IDE_AI_STATE", ""),
                        ("@ide_ai_attn", "IDE_AI_ATTN", "0"),
                        ("@ide_ai_attn_ts", "IDE_AI_ATTN_TS", ""),
                        ("@ide_ai_state_ts", "IDE_AI_STATE_TS", str(int(time.time()))),
                    ],
                )
                run_tmux("kill-session", "-t", f"=ai-{session}")
                ai_pane_id = resolve_role_pane(session, "ai", "@ide_ai_pane", "IDE_AI_PANE")
                ed_pane_id = ed_pane_existing
                init_root_val = get_ide_var(session, "@ide_initial_root", "IDE_INITIAL_ROOT") or target_dir
                if pane_exists(ai_pane_id):
                    respawn_env_args = [
                        "-e", f"IDE_SESSION={session}",
                        "-e", f"IDE_AI_CLI={ide_ai_cli}",
                        "-e", f"NVIM_IDE_SOCKET={nvim_socket}",
                        "-e", f"NVIM_IDE_PANE={ed_pane_id}",
                        "-e", f"IDE_INITIAL_ROOT={init_root_val}",
                        "-e", "FORCE_HYPERLINK=1",
                    ]
                    if ide_notify_env:
                        respawn_env_args.extend(["-e", f"IDE_NOTIFY={ide_notify_env}"])
                    res = run_tmux(
                        "respawn-pane", "-k", "-t", ai_pane_id, "-c", target_dir,
                        *respawn_env_args,
                    )
                    if res.returncode != 0:
                        shell = os.environ.get("SHELL") or "/bin/zsh"
                        notify_kv = f"IDE_NOTIFY={shlex.quote(ide_notify_env)} " if ide_notify_env else ""
                        run_tmux(
                            "respawn-pane", "-k", "-t", ai_pane_id, "-c", target_dir,
                            f"env IDE_SESSION={shlex.quote(session)} IDE_AI_CLI={shlex.quote(ide_ai_cli)} "
                            f"NVIM_IDE_SOCKET={shlex.quote(nvim_socket)} NVIM_IDE_PANE={shlex.quote(ed_pane_id)} "
                            f"IDE_INITIAL_ROOT={shlex.quote(init_root_val)} {notify_kv}FORCE_HYPERLINK=1 {shlex.quote(shell)} -l",
                        )
                    ai_run_cmd = resolve_ai_cmd(ide_ai_cli)
                    if ai_run_cmd:
                        run_tmux("send-keys", "-t", ai_pane_id, f" {ai_run_cmd}", "C-m")

    caller_is_ssh = any(os.environ.get(v) for v in ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT")) or (
        bool(os.environ.get("TMUX")) and is_ssh_session("")
    )
    env_cmds: list[str] = [
        "set-environment", "-g", "FORCE_HYPERLINK", "1",
        ";",
        "set-environment", "-t", f"={session}", "FORCE_HYPERLINK", "1",
    ]
    if "IDE_NOTIFY" in os.environ:
        if ide_notify_env:
            env_cmds.extend([";", "set-environment", "-t", f"={session}", "IDE_NOTIFY", ide_notify_env])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", "IDE_NOTIFY", ide_notify_env])
        else:
            env_cmds.extend([";", "set-environment", "-t", f"={session}", "-u", "IDE_NOTIFY"])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", "-u", "IDE_NOTIFY"])
    for ssh_var in ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT"):
        ssh_val = os.environ.get(ssh_var)
        if caller_is_ssh and ssh_val:
            env_cmds.extend([";", "set-environment", "-t", f"={session}", ssh_var, ssh_val])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", ssh_var, ssh_val])
        elif not caller_is_ssh:
            env_cmds.extend([";", "set-environment", "-t", f"={session}", "-r", ssh_var])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", "-r", ssh_var])
    for display_var in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS"):
        val = os.environ.get(display_var)
        if val and not caller_is_ssh:
            env_cmds.extend([";", "set-environment", "-t", f"={session}", display_var, val])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", display_var, val])
        elif caller_is_ssh and display_var in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY"):
            env_cmds.extend([";", "set-environment", "-t", f"={session}", "-r", display_var])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", "-r", display_var])
        elif not caller_is_ssh and display_var in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY"):
            env_cmds.extend([";", "set-environment", "-t", f"={session}", "-u", display_var])
            if not os.environ.get("TMUX"):
                env_cmds.extend([";", "set-environment", "-g", "-u", display_var])
    run_tmux(*env_cmds)

    tmux_conf = os.path.expanduser("~/.tmux.conf")
    if os.path.isfile(tmux_conf):
        run_tmux("source-file", tmux_conf)
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    tmux_theme_conf = os.path.join(xdg_cfg, "home-settings", "tmux-theme.conf")
    if os.path.isfile(tmux_theme_conf):
        run_tmux("source-file", tmux_theme_conf)
    run_tmux("set-option", "-q", "-t", f"={session}:", "status-position", "top")
    refresh_fleet_topbar()

    if detach_mode:
        return 0

    if os.environ.get("TMUX"):
        os.execvp("tmux", ["tmux", "switch-client", "-t", f"={session}"])
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={session}"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
PY
if [ -z "${IDE_PY_BIN:-}" ]; then
    IDE_PY_BIN="python3"
    if [ -x /usr/bin/python3 ]; then
        IDE_PY_BIN="/usr/bin/python3"
    fi
fi
if [ -r /dev/fd/9 ] 9<<< "" 2>/dev/null; then
    IDE_SELF="${BASH_SOURCE[0]}" exec "$IDE_PY_BIN" -B /dev/fd/9 "$@" 9<<< "$IDE_PY_SRC"
else
    IDE_TMP_PY="$(mktemp "${TMPDIR:-/tmp}/ide-py.XXXXXX")"
    trap 'rm -f "$IDE_TMP_PY"' EXIT INT TERM
    printf '%s\n' "$IDE_PY_SRC" > "$IDE_TMP_PY"
    IDE_SELF="${BASH_SOURCE[0]}" "$IDE_PY_BIN" -B "$IDE_TMP_PY" "$@"
    exit $?
fi
