#!/usr/bin/env bash
# ==============================================================================
# bin/ide — Hybrid Terminal IDE Workspace Launcher (Tmux + Neovim RPC + AI)
# ==============================================================================
# Default Layout (--3pane, Inverted-T AI-First, Single Neovim Server, Zero _swap Window):
#   - Top-Left Pane (50% width × 75% height): AI Agent CLI (@ide_role=ai, initial focus)
#     controlled by $IDE_AI_CLI (agy | claude | codex)
#   - Top-Right Pane (50% width × 75% height): Main Editor (@ide_role=editor)
#     listening on $NVIM_IDE_SOCKET with live buffer reload (autoread/checktime),
#     mini.files (<leader>e), and Telescope git_status (<leader>gs)
#   - Bottom Pane (100% width × 25% height): Full-Width Interactive Shell (@ide_role=term)
#   - Floating Modal (Alt+Shift+a): Optional overlay popup
#
# Optional Layout (--2pane):
#   - Left Pane (50% width × 100% height): AI Agent CLI (@ide_role=ai, initial focus)
#   - Right Pane (50% width × 100% height): Main Editor (@ide_role=editor)
# ==============================================================================

set -euo pipefail
if { [ ! -d . ] || [ ! . -ef "${PWD:-}" ]; } && [[ "${PWD:-}" == /* ]] && [ -d "$PWD" ]; then
    builtin cd -- "$PWD" || true
fi
if [ "${IDE_STRICT_PATH:-0}" != "1" ]; then
    export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH:/usr/local/bin:/usr/bin:/bin"
fi

show_keys_cheatsheet() {
    if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/home-settings/theme-env.sh" ]; then
        # shellcheck source=/dev/null
        . "${XDG_CONFIG_HOME:-$HOME/.config}/home-settings/theme-env.sh"
    fi
    local c_orange="${_HS_ESC_ORANGE:-$'\033[38;2;203;75;22m'}"
    local c_blue="${_HS_ESC_BLUE:-$'\033[38;2;38;139;210m'}"
    local c_cyan="${_HS_ESC_CYAN:-$'\033[38;2;42;161;152m'}"
    local c_base0="${_HS_ESC_BASE0:-$'\033[38;2;131;148;150m'}"
    local c_base01="${_HS_ESC_BASE01:-$'\033[38;2;88;110;117m'}"
    local c_reset=$'\033[0m'
    local rule="────────────────────────────────────────────────────────────────────────────────────"

    printf '\n  %s IDE Workspace & Editor Keybindings%s%23s[q / Esc / Space to close]%s\n' "$c_orange" "$c_base01" "" "$c_reset"
    printf '  %s%s%s\n' "$c_base01" "$rule" "$c_reset"
    printf '  %s%-45s%sSESSIONS & WORKSPACE%s\n' "$c_blue" "PANES & LAYOUT" "$c_blue" "$c_reset"
    printf '  %s%-18s%s %-24s  %s%-18s%s %s%s\n' \
        "$c_cyan" "Alt+a / e / t" "$c_base0" "Focus AI, Editor, Shell" "$c_cyan" "Alt+s / Prefix+s" "$c_base0" "Switch IDE session" "$c_reset" \
        "$c_cyan" "Alt+h / j / k / l" "$c_base0" "Move focus between panes" "$c_cyan" "C-y/o/M-n (Alt+s)" "$c_base0" "Ack, open PR, new WS" "$c_reset" \
        "$c_cyan" "Alt+Shift+H/J/K/L" "$c_base0" "Swap active pane" "$c_cyan" "Alt+Shift+S" "$c_base0" "Jump to waiting AI" "$c_reset" \
        "$c_cyan" "Alt+Arrow / Drag" "$c_base0" "Resize pane (keys/mouse)" "$c_cyan" "Alt+m / Prefix+m" "$c_base0" "Open system monitor" "$c_reset" \
        "$c_cyan" "Alt+Shift+E" "$c_base0" "Hide or show Editor" "$c_cyan" "Click top bar" "$c_base0" "Focus, Help, or menu" "$c_reset" \
        "$c_cyan" "Alt+Shift+T" "$c_base0" "Hide or show Shell" "$c_cyan" "v [+line] <file>" "$c_base0" "Open file in Editor" "$c_reset" \
        "$c_cyan" "Alt+z" "$c_base0" "Toggle 100% pane zoom" "$c_cyan" "icd [dir|--reset]" "$c_base0" "Change workspace dir" "$c_reset" \
        "$c_cyan" "Prefix + | / -" "$c_base0" "Split pane right / below" "$c_cyan" ":Q / Alt+q / Alt+Q" "$c_base0" "Quit / force-quit IDE" "$c_reset" \
        "$c_cyan" "Prefix + b" "$c_base0" "Toggle top status bar" "$c_cyan" "Alt+? / Prefix+?" "$c_base0" "This key cheatsheet" "$c_reset"
    printf '\n  %s%-45s%sCLIPBOARD & LINKS%s\n' "$c_blue" "EDITOR (Space = Leader)" "$c_blue" "$c_reset"
    printf '  %s%-18s%s %-24s  %s%-18s%s %s%s\n' \
        "$c_cyan" "Space ff" "$c_base0" "Find files by name" "$c_cyan" "Mouse drag / 2x" "$c_base0" "Select text and copy" "$c_reset" \
        "$c_cyan" "Space fg" "$c_base0" "Search text (live grep)" "$c_cyan" "Alt+c" "$c_base0" "Copy & clear highlight" "$c_reset" \
        "$c_cyan" "Space gs" "$c_base0" "Review Git status" "$c_cyan" "Alt+v" "$c_base0" "Paste from clipboard" "$c_reset" \
        "$c_cyan" "Space m" "$c_base0" "Toggle Markdown preview" "$c_cyan" "Ctrl+Click" "$c_base0" "Open link or file path" "$c_reset" \
        "$c_cyan" "H / L  (Normal)" "$c_base0" "Prev / next buffer" "$c_cyan" "Alt+Click" "$c_base0" "Jump to LSP definition" "$c_reset" \
        "$c_cyan" "Ctrl+h / j / k / l" "$c_base0" "Move between splits" "$c_cyan" "Mouse4/5 or C-o/i" "$c_base0" "Jump back or forward" "$c_reset"
    printf '\n  %s%-45s%sSEND TO AI PROMPT%s\n' "$c_blue" "FILE TREE (mini.files)" "$c_blue" "$c_reset"
    printf '  %s%-18s%s %-24s  %s%-18s%s %s%s\n' \
        "$c_cyan" "Space e / Space E" "$c_base0" "Open mini.files tree" "$c_cyan" "Space a  (Visual)" "$c_base0" "Send selected lines" "$c_reset" \
        "$c_cyan" "h/l or Left/Right" "$c_base0" "Parent dir / open item" "$c_cyan" "Space il (Normal)" "$c_base0" "Send current line" "$c_reset" \
        "$c_cyan" "Enter  (in tree)" "$c_base0" "Open file or enter dir" "$c_cyan" "Space id (Normal)" "$c_base0" "Send diagnostics" "$c_reset" \
        "$c_cyan" "=      (in tree)" "$c_base0" "Apply file edits" "$c_cyan" ":IdeSend[!] [ws]" "$c_base0" "Stage to other WS" "$c_reset" \
        "$c_cyan" "g? / q (in tree)" "$c_base0" "Tree help / close tree" "$c_cyan" "a   (copy-mode)" "$c_base0" "Send shell selection" "$c_reset"

    if [ -t 0 ] && [ -t 1 ] && [ "${IDE_KEYS_NO_WAIT:-0}" != "1" ]; then
        local saved_tty="" key="" rest=""
        saved_tty="$(stty -g 2>/dev/null || true)"
        trap '[ -n "${saved_tty:-}" ] && stty "$saved_tty" 2>/dev/null || true; exit 0' EXIT INT TERM
        stty intr undef eof undef -echo 2>/dev/null || true
        while IFS= read -r -s -n 1 key; do
            if [ "$key" = $'\x1b' ]; then
                rest=""
                IFS= read -r -s -n 5 -t 0.02 rest || true
                if [ -z "$rest" ] || [ "$rest" = "?" ]; then
                    break
                fi
                continue
            fi
            case "$key" in
                q|Q|\?|" "|""|$'\r'|$'\n'|$'\x03'|$'\x04')
                    break
                    ;;
            esac
        done
    fi
}

run_system_monitor() {
    local mon=""
    for mon in btop htop top; do
        if command -v "$mon" >/dev/null 2>&1; then
            exec "$mon"
        fi
    done
    echo "Error: Neither 'btop', 'htop', nor 'top' is installed." >&2
    exit 1
}

if [ "$#" -eq 1 ] && { [ "$1" = "--keys" ] || [ "$1" = "--help-keys" ]; }; then
    show_keys_cheatsheet
    exit 0
fi

if [ "$#" -eq 1 ] && { [ "$1" = "--monitor" ] || [ "$1" = "--top" ] || [ "$1" = "--btop" ]; }; then
    run_system_monitor
fi

IFS= read -r -d '' IDE_PY_SRC <<'PY' || true
from __future__ import annotations

