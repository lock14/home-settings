#!/usr/bin/env bash
# bin/ide — Hybrid Terminal IDE Workspace Launcher (Tmux + Neovim RPC + AI)
# Domain modules live under libexec/ide_lib/.

set -euo pipefail
if { [ ! -d . ] || [ ! . -ef "${PWD:-}" ]; } && [[ "${PWD:-}" == /* ]] && [ -d "$PWD" ]; then
    builtin cd -- "$PWD" || true
fi

show_usage() {
    cat <<'EOF'
Usage: ide [OPTIONS] [DIRECTORY]

Launch or attach to a Solarized Dark Tmux + Neovim IDE workspace session.

Options:
  --3pane                  Launch default 3-pane layout (Top-Left 50%x75% AI, Top-Right 50%x75% Editor, Bottom 100%x25% Shell)
  --2pane                  Launch 2-pane layout (Left 50%x100% AI, Right 50%x100% Editor)
  --ai, --agent <CLI>      Select AI CLI agent: agy (default), claude, or codex (overrides $IDE_AI_CLI)
  --open <FILE> [LINE]     Open <FILE> in the Main Editor pane via RPC and focus Editor
  --preview <FILE> [LINE]  Preview <FILE> in the Main Editor pane via RPC without changing focus
  cd, --cd [DIR]           Dive into <DIR> (or --reset / ~ for initial root), setting Working Directory across Editor and Shell
  -s, --sessions [SESSION] Open interactive multi-session IDE workspace switcher (Alt+s / Prefix+s)
  -n, --new                Open interactive workspace directory picker to launch or switch to a session
  --next-attention [SESSION] Jump to oldest IDE session waiting for AI attention in urgency and FIFO order (Alt+Shift+S / Prefix+S)
  --agent-state <STATE> [--message <TEXT>] [SESSION] Record deterministic AI lifecycle state: running, approval, quota, done, or idle
  --ack-ai [SESSION...]    Acknowledge AI attention across one or more IDE sessions
  --open-pr [SESSION]      Open cached pull or merge request URL for an IDE session
  --send <PAYLOAD> [SESSION] Dispatch context (--stdin, --ref <PATH>[:L1[-L2]], --text <TEXT>, --no-focus, --switch) to AI Agent
  --toggle [SESSION]       Toggle focus between the AI Agent and the Text Editor (unparking if hidden)
  --show-editor [SESSION]  Focus the Text Editor pane (unparking if hidden), or bounce back if already focused
  --show-ai [SESSION]      Focus the AI Agent pane (unparking if hidden), or bounce back if already focused
  --show-term [SESSION]    Focus the Interactive Shell pane (unparking if hidden), or bounce back if already focused
  --toggle-editor [SESSION] Hide or reappear the Text Editor pane (Alt+Shift+E)
  --toggle-ai [SESSION]    Hide or reappear the AI Agent pane
  --toggle-term [SESSION]  Hide or reappear the Interactive Shell pane (Alt+Shift+T)
  --swap <DIR> [SESSION]   Swap the active pane with its neighbor in <DIR> (left|down|up|right, Alt+Shift+H/J/K/L)
  --monitor, --top         Launch interactive system monitor with btop -> htop -> top fallback (Alt+m / Prefix+m)
  --keys                   Display the Solarized Dark IDE keybinding cheatsheet (Alt+? / F1 / Prefix+?)
  refresh, -r, --refresh [NAME] Refresh tmux top bar and Editor themes and CWDs across all (or target) IDE sessions (Prefix+r)
  quit, -q, --quit [NAME...] Safely quit IDE session(s) NAME (checks for unsaved Neovim buffers first)
  -f, --force              Force-quit when used with --quit (discards unsaved Neovim buffers)
  --detach                 Create/update workspace session in background without attaching
  kill, --kill [NAME...]   Force-quit IDE session(s) NAME without the unsaved-buffer check
  --list [--plain]         List active IDE workspace sessions with agent CLI, state, VCS status, and directory
  -h, --help               Show this help message and exit

Without NAME / SESSION, session commands act only on the ide session of the calling pane
(outside tmux: the current directory's session), never on any other tmux session.

Environment Variables:
  IDE_AI_CLI               AI CLI tool for the AI Agent pane: agy (default), claude, or codex
  IDE_BROWSER              Optional browser executable for opening http(s):// links
  IDE_NOTIFY               Local desktop banner policy: 0 (default), 1 / unfocused, or always
  IDE_NERD_FONTS           Set to 0 / off to omit Nerd Font PUA icons across ide TUI surfaces (auto-disabled on TERM=dumb)
  IDE_WORKSPACE_DIRS       Optional colon-separated workspace directories surfaced in launcher and completions
  IDE_LINK_RULES           Untracked Ctrl+click link, workspace, session-naming, notification, and VCS hooks (default: ${XDG_CONFIG_HOME:-~/.config}/ide/links.sh)
                           defining `ide_resolve_link`, `ide_session_name`, `ide_workspace_dirs`, `ide_resolve_workspace`, `ide_notify`, or `ide_vcs_summary`
EOF
}

show_keys_cheatsheet() {
    local c_orange="" c_blue="" c_cyan="" c_base0="" c_base01="" c_reset=""
    local meta_lc title_pfx=" " hdr_pad="                "
    meta_lc="$(printf '%s|%s|%s|%s' "${TERM:-}" "${COLORTERM:-}" "${IDE_NERD_FONTS:-}" "${IDE_ASCII:-}" | tr '[:upper:]' '[:lower:]')"
    IFS='|' read -r term_lc ct_lc nf_lc asc_lc <<< "$meta_lc"
    if [ -n "${NO_COLOR:-}" ]; then
        :
    elif [ "$term_lc" = "dumb" ]; then
        c_orange=$'\033[1m'; c_blue=$'\033[1m'; c_cyan=$'\033[4m'; c_base01=$'\033[2m'; c_reset=$'\033[0m'
    elif [ "$ct_lc" = "256color" ] || [ "$ct_lc" = "8bit" ] || { [ -z "$ct_lc" ] && [[ "$term_lc" == *256* ]] && [ "$term_lc" != "xterm-256color" ] && [ "$term_lc" != "tmux-256color" ]; }; then
        c_orange=$'\033[38;5;166m'; c_blue=$'\033[38;5;33m'; c_cyan=$'\033[38;5;37m'; c_base0=$'\033[38;5;246m'; c_base01=$'\033[38;5;240m'; c_reset=$'\033[0m'
    elif [ "$ct_lc" = "truecolor" ] || [ "$ct_lc" = "24bit" ] || [ -z "$term_lc" ] || [ "$term_lc" = "xterm-256color" ] || [ "$term_lc" = "tmux-256color" ] || [[ "$term_lc" == xterm-ghostty* || "$term_lc" == xterm-kitty* || "$term_lc" == wezterm* || "$term_lc" == alacritty* || "$term_lc" == foot* ]]; then
        if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/home-settings/theme-env.sh" ]; then
            # shellcheck source=/dev/null
            . "${XDG_CONFIG_HOME:-$HOME/.config}/home-settings/theme-env.sh"
        fi
        c_orange="${_HS_ESC_ORANGE:-$'\033[38;2;203;75;22m'}"; c_blue="${_HS_ESC_BLUE:-$'\033[38;2;38;139;210m'}"; c_cyan="${_HS_ESC_CYAN:-$'\033[38;2;42;161;152m'}"
        c_base0="${_HS_ESC_BASE0:-$'\033[38;2;131;148;150m'}"; c_base01="${_HS_ESC_BASE01:-$'\033[38;2;88;110;117m'}"; c_reset=$'\033[0m'
    else
        c_orange=$'\033[91m'; c_blue=$'\033[34m'; c_cyan=$'\033[36m'; c_base0=$'\033[37m'; c_base01=$'\033[90m'; c_reset=$'\033[0m'
    fi
    case "|$term_lc|$asc_lc|$nf_lc|" in
        *"|dumb|"*|*"|1|"*|*"|true|"*|*"|0|"*|*"|off|"*|*"|false|"*|*"|no|"*|*"|ascii|"*) title_pfx=""; hdr_pad="                  " ;;
    esac

    printf ' %s%sIDE Workspace & Editor Keybindings%s%s[q / Esc / F1 to close]%s\n' "$c_orange" "$title_pfx" "$c_base01" "$hdr_pad" "$c_reset"
    printf ' %s── %sPANES & LAYOUT %s────────────────────  ── %sSESSIONS & WORKSPACE %s──────────%s\n' "$c_base01" "$c_blue" "$c_base01" "$c_blue" "$c_base01" "$c_reset"
    printf ' %s%-17s%s %-17s  %s%-17s%s %s%s\n' \
        "$c_cyan" "Alt+a / e / t" "$c_base0" "Focus AI/Ed/Shell" "$c_cyan" "Alt+s / Prefix+s" "$c_base0" "Switch IDE session" "$c_reset" \
        "$c_cyan" "Alt+h / j / k / l" "$c_base0" "Move pane focus" "$c_cyan" "Alt+l / h (Alt+s)" "$c_base0" "Dock / undock AI" "$c_reset" \
        "$c_cyan" "Alt+Shift+H/J/K/L" "$c_base0" "Swap active pane" "$c_cyan" "C-y/o/M-n (Alt+s)" "$c_base0" "Ack, PR, or new WS" "$c_reset" \
        "$c_cyan" "Alt+Arrow / Drag" "$c_base0" "Resize pane" "$c_cyan" "Alt+Shift+S" "$c_base0" "Jump to waiting AI" "$c_reset" \
        "$c_cyan" "Alt+Shift+E" "$c_base0" "Hide/show Editor" "$c_cyan" "Alt+m / Prefix+m" "$c_base0" "Open sys monitor" "$c_reset" \
        "$c_cyan" "Alt+Shift+T" "$c_base0" "Hide/show Shell" "$c_cyan" "Click top bar" "$c_base0" "Focus, Help, menu" "$c_reset" \
        "$c_cyan" "Alt+z | Pfx+|/-" "$c_base0" "Zoom | split pane" "$c_cyan" "v <f> / icd [dir]" "$c_base0" "Edit / workspace cd" "$c_reset" \
        "$c_cyan" "Prefix + b / r" "$c_base0" "Top bar / refresh" "$c_cyan" ":Q / Alt+q / M-Q" "$c_base0" "Quit / force-quit" "$c_reset"
    printf ' %s── %sEDITOR (Space = Leader) %s───────────  ── %sCLIPBOARD, LINKS & HELP %s───────%s\n' "$c_base01" "$c_blue" "$c_base01" "$c_blue" "$c_base01" "$c_reset"
    printf ' %s%-17s%s %-17s  %s%-17s%s %s%s\n' \
        "$c_cyan" "Space ff / fg" "$c_base0" "Find file / grep" "$c_cyan" "Mouse drag / 2x" "$c_base0" "Select & copy text" "$c_reset" \
        "$c_cyan" "Space gs" "$c_base0" "Review Git status" "$c_cyan" "Alt+c / Alt+v" "$c_base0" "Copy+clear / paste" "$c_reset" \
        "$c_cyan" "Space m" "$c_base0" "Markdown preview" "$c_cyan" "Ctrl/Alt+Click" "$c_base0" "Open link / LSP def" "$c_reset" \
        "$c_cyan" "H / L  (Normal)" "$c_base0" "Prev/next buffer" "$c_cyan" "Mouse4/5 or C-o/i" "$c_base0" "Jump back/forward" "$c_reset" \
        "$c_cyan" "Ctrl+h/j/k/l" "$c_base0" "Editor split nav" "$c_cyan" "Alt+? / Prefix+?" "$c_base0" "This key cheatsheet" "$c_reset"
    printf ' %s── %sFILE TREE (mini.files) %s────────────  ── %sSEND TO AI PROMPT %s─────────────%s\n' "$c_base01" "$c_blue" "$c_base01" "$c_blue" "$c_base01" "$c_reset"
    printf ' %s%-17s%s %-17s  %s%-17s%s %s%s\n' \
        "$c_cyan" "Space e / Space E" "$c_base0" "Open mini.files" "$c_cyan" "Space a  (Visual)" "$c_base0" "Send selected lines" "$c_reset" \
        "$c_cyan" "h/l or Left/Right" "$c_base0" "Parent / open" "$c_cyan" "Space il (Normal)" "$c_base0" "Send current line" "$c_reset" \
        "$c_cyan" "Enter  (in tree)" "$c_base0" "Open file / dir" "$c_cyan" "Space id (Normal)" "$c_base0" "Send diagnostics" "$c_reset" \
        "$c_cyan" "=      (in tree)" "$c_base0" "Apply file edits" "$c_cyan" ":IdeSend[!] [ws]" "$c_base0" "Stage to other WS" "$c_reset" \
        "$c_cyan" "g? / q (in tree)" "$c_base0" "Help / close tree" "$c_cyan" "a   (copy-mode)" "$c_base0" "Send copy selection" "$c_reset"

    if [ -t 0 ] && [ -t 1 ] && [ "${IDE_KEYS_NO_WAIT:-0}" != "1" ]; then
        local saved_tty="" key="" rest=""
        saved_tty="$(stty -g 2>/dev/null || true)"
        trap '[ -n "${saved_tty:-}" ] && stty "$saved_tty" 2>/dev/null || true; exit 0' EXIT INT TERM
        stty intr undef eof undef -echo 2>/dev/null || true
        while IFS= read -r -s -n 1 key; do
            if [ "$key" = $'\x1b' ]; then
                rest=""
                IFS= read -r -s -n 5 -t 0.02 rest || true
                case "$rest" in
                    ""|"?"|"OP"|"[11~"|"[[A")
                        break
                        ;;
                esac
                continue
            fi
            case "$key" in
                q|Q|\?|" "|""|$'\r'|$'\n'|$'\x03'|$'\x04')
                    break
                    ;;
            esac
        done
    fi
}

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            show_usage
            exit 0
            ;;
        --keys|--help-keys)
            show_keys_cheatsheet
            exit 0
            ;;
    esac
fi

if { [ "$#" -eq 1 ] && [ "$1" = "--plain" ]; } || \
   { [ "$#" -eq 2 ] && { { [ "$1" = "--list" ] && [ "$2" = "--plain" ]; } || { [ "$1" = "--plain" ] && [ "$2" = "--list" ]; }; }; }; then
    _ide_lookup_path="$PATH"
    if [ "${IDE_STRICT_PATH:-0}" != "1" ]; then
        _ide_lookup_path="$PATH:${HOME%/}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    fi
    _ide_tmux_bin="$(PATH="$_ide_lookup_path" command -v tmux 2>/dev/null || true)"
    if [ -z "$_ide_tmux_bin" ]; then
        exit 0
    fi
    if ! "$_ide_tmux_bin" list-sessions -F '#{session_name}' >/dev/null 2>&1; then
        exit 0
    fi
    unset _ide_lookup_path _ide_tmux_bin
fi

_ide_calibrate_path() {
    [ "${IDE_STRICT_PATH:-0}" = "1" ] && return 0
    local _ide_mise_dir _ide_shims _ide_inst_pfx _ide_rem _ide_new_path _ide_last_mise _ide_idx _ide_shims_added _ide_p _ide_cp
    if [ -n "${MISE_DATA_DIR:-}" ]; then
        _ide_mise_dir="$MISE_DATA_DIR"
    elif [ -n "${XDG_DATA_HOME:-}" ]; then
        _ide_mise_dir="${XDG_DATA_HOME%/}/mise"
    else
        _ide_mise_dir="${HOME%/}/.local/share/mise"
    fi
    while [ "$_ide_mise_dir" != "/" ] && [ "${_ide_mise_dir%/}" != "$_ide_mise_dir" ]; do
        _ide_mise_dir="${_ide_mise_dir%/}"
    done
    _ide_shims="$_ide_mise_dir/shims"
    _ide_inst_pfx="$_ide_mise_dir/installs/"
    case ":$PATH:" in
        */mise/installs/*|*"$_ide_inst_pfx"*)
            _ide_rem="${PATH}:"
            _ide_new_path=""
            _ide_last_mise=0
            _ide_idx=0
            while [ -n "$_ide_rem" ]; do
                _ide_p="${_ide_rem%%:*}"
                _ide_rem="${_ide_rem#*:}"
                _ide_cp="$_ide_p"
                while [ "$_ide_cp" != "/" ] && [ "${_ide_cp%/}" != "$_ide_cp" ]; do
                    _ide_cp="${_ide_cp%/}"
                done
                [ -z "$_ide_cp" ] || [ "$_ide_cp" = "$_ide_shims" ] && continue
                _ide_idx=$((_ide_idx + 1))
                case "$_ide_cp/" in
                    */mise/installs/*|"$_ide_inst_pfx"*) _ide_last_mise="$_ide_idx" ;;
                esac
            done
            _ide_rem="${PATH}:"
            _ide_idx=0
            _ide_shims_added=0
            while [ -n "$_ide_rem" ]; do
                _ide_p="${_ide_rem%%:*}"
                _ide_rem="${_ide_rem#*:}"
                _ide_cp="$_ide_p"
                while [ "$_ide_cp" != "/" ] && [ "${_ide_cp%/}" != "$_ide_cp" ]; do
                    _ide_cp="${_ide_cp%/}"
                done
                [ -z "$_ide_cp" ] || [ "$_ide_cp" = "$_ide_shims" ] && continue
                _ide_idx=$((_ide_idx + 1))
                if [ "$_ide_shims_added" -eq 0 ] && [ "$_ide_idx" -gt "$_ide_last_mise" ]; then
                    case "$_ide_cp" in
                        /opt/homebrew/bin|/opt/homebrew/sbin|/usr/local/sbin|/usr/local/bin|/usr/sbin|/usr/bin|/sbin|/bin)
                            _ide_new_path="${_ide_new_path:+$_ide_new_path:}$_ide_shims"
                            _ide_shims_added=1
                            ;;
                    esac
                fi
                _ide_new_path="${_ide_new_path:+$_ide_new_path:}$_ide_p"
            done
            [ "$_ide_shims_added" -eq 0 ] && _ide_new_path="${_ide_new_path:+$_ide_new_path:}$_ide_shims"
            export PATH="${HOME%/}/.local/bin:$_ide_new_path:/usr/local/bin:/usr/bin:/bin"
            ;;
        *)
            export PATH="$_ide_shims:${HOME%/}/.local/bin${PATH:+:$PATH}:/usr/local/bin:/usr/bin:/bin"
            ;;
    esac
}

run_system_monitor() {
    _ide_calibrate_path
    local mon=""
    for mon in btop htop top; do
        if command -v "$mon" >/dev/null 2>&1; then
            exec "$mon"
        fi
    done
    echo "Error: Neither 'btop', 'htop', nor 'top' is installed." >&2
    exit 1
}

if [ "$#" -eq 1 ] && { [ "$1" = "--monitor" ] || [ "$1" = "--top" ] || [ "$1" = "--btop" ]; }; then
    run_system_monitor
fi

IFS= read -r -d '' IDE_PY_SRC <<'PY' || true
from __future__ import annotations

import os
import sys

if not getattr(sys, "pycache_prefix", None):
    sys.dont_write_bytecode = True
if sys.version_info < (3, 11) and sys.path:
    sys.path.pop(0)

_raw_self = (
    os.environ.get("IDE_SELF")
    or globals().get("__file__")
    or sys._getframe(0).f_code.co_filename
)
_bin_dir = os.path.dirname(os.path.realpath(_raw_self))
_libexec_dir = os.path.join(os.path.dirname(_bin_dir), "libexec")
for _pkg_dir in (_libexec_dir, _bin_dir):
    if os.path.isdir(_pkg_dir) and _pkg_dir not in sys.path:
        sys.path.insert(0, _pkg_dir)

if __name__ == "__main__":
    from ide_lib.cli import main

    sys.exit(main())
else:
    from ide_lib.links import resolve_workspace_file
    from ide_lib.nvim_rpc import resolve_nvim_bin
    from ide_lib.sessions import _collect_launcher_dirs, _pick_workspace_directory
PY
if [ -z "${IDE_PY_BIN:-}" ]; then
    if [ -x /usr/bin/python3 ]; then
        IDE_PY_BIN="/usr/bin/python3"
    else
        _ide_calibrate_path
        IDE_PY_BIN="python3"
    fi
fi
if [ -z "${PYTHONPYCACHEPREFIX:-}" ]; then
    _ide_cache_base="${XDG_CACHE_HOME:-${HOME%/}/.cache}"
    if [ -n "$_ide_cache_base" ]; then
        export PYTHONPYCACHEPREFIX="${_ide_cache_base%/}/home-settings/pycache"
    fi
    unset _ide_cache_base
fi
PYTHONSAFEPATH=1 IDE_SELF="${BASH_SOURCE[0]}" exec "$IDE_PY_BIN" -S -c "$IDE_PY_SRC" "$@"
